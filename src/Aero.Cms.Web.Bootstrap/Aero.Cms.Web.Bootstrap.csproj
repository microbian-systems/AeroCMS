<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Aero.Cms.Web.Bootstrap</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Aero.Cms.AspNetCore</PackageId>
    <Title>Aero CMS ASP.NET Core Integration</Title>
    <Description>Package-first ASP.NET Core integration facade for adding Aero CMS to new or existing web applications.</Description>
    <PackageIcon>favicon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\favicon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hydro" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
