<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aero.Cms.Generated</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Source Generators as analyzers: the custom generators (BlockRendererGenerator,
      ContentTypeGenerator) emit [JsonSerializable] partial classes into THIS
      project. The built-in STJ JsonSourceGenerator sees them in the same
      compilation and produces the real JsonSerializerContext implementation.
    -->
    <ProjectReference Include="..\Aero.Cms.SourceGenerators\Aero.Cms.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />

    <!--
      Real types that the generated context references. These are the types
      with [JsonSerializable] attributes — BlockBase subtypes from Abstractions,
      ContentItem from Core, and supporting models.
    -->
    <ProjectReference Include="..\Aero.Cms.Abstractions\Aero.Cms.Abstractions.csproj" />
    <ProjectReference Include="..\Aero.Cms.Core\Aero.Cms.Core.csproj" />
  </ItemGroup>

</Project>
