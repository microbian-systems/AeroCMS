<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Aero.Cms.Client</PackageId>
    <Description>Reusable interactive WebAssembly services, components, and browser assets for Aero CMS hosts.</Description>
    <RootNamespace>Aero.Cms.Web.Client</RootNamespace>
    <AssemblyName>Aero.Cms.Client</AssemblyName>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Blazor.LocalStorage.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aero.Cms.Abstractions\Aero.Cms.Abstractions.csproj" AdditionalProperties="AeroCmsBrowserClient=true" />
    <ProjectReference Include="..\Aero.Cms.Contracts\Aero.Cms.Contracts.csproj" />
    <ProjectReference Include="..\Aero.Cms.Modules.Commerce.Client\Aero.Cms.Modules.Commerce.Client.csproj" AdditionalProperties="AeroCmsBrowserClient=true" />
    <ProjectReference Include="..\Aero.Cms.Shared\Aero.Cms.Shared.csproj" AdditionalProperties="AeroCmsBrowserClient=true" />
  </ItemGroup>

  <Target Name="AeroConfigureBrowserStaticWebAssetReferences"
          DependsOnTargets="PrepareProjectReferences"
          BeforeTargets="ResolveReferencedProjectsStaticWebAssetsConfiguration">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)"
                                        Condition="'%(_MSBuildProjectReferenceExistent.AdditionalProperties)' == 'AeroCmsBrowserClient=true'">
        <SetConfiguration>%(_MSBuildProjectReferenceExistent.SetConfiguration);AeroCmsBrowserClient=true</SetConfiguration>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>

</Project>
