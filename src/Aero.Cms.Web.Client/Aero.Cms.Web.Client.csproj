<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <!--
      This is the browser root for the manager. Set the variant as a global
      project property so NuGet restore and the entire MSBuild graph evaluate
      the same browser-safe dependency surface.
    -->
    <AeroCmsBrowserClient>true</AeroCmsBrowserClient>
    <!--
      The shared contract projects also have server-only project references.
      The browser root declares every project it actually executes and must not
      inherit those transitive server projects into its WebAssembly payload.
    -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>

    <!-- WASM Performance: trimming reduces download size significantly -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>

    <!-- Manager localization runs in InteractiveWebAssembly after hydration. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>

    <!-- WASM runtime optimizations -->
    <WasmNativeStripSymbols>true</WasmNativeStripSymbols>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <WasmDebugLevel Condition="'$(AeroCmsEnableWebAssemblyDebugging)' != 'true'">0</WasmDebugLevel>
    <IsPackable>false</IsPackable>
    <EnableDefaultTypeScriptItems>false</EnableDefaultTypeScriptItems>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>

  </PropertyGroup>

  <!-- Keep TypeScript build inputs out of NuGet contentFiles; only compiled wwwroot assets should ship. -->
  <ItemGroup>
    <Content Remove="tsconfig.json;libman.json;ts\**\*" />
    <None Remove="tsconfig.json;libman.json;ts\**\*" />
    <TypeScriptCompile Remove="ts\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tsconfig.json;libman.json;ts\**\*" Pack="false" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazor.LocalStorage.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.Sinks.OpenObserve" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aero.Cms.Abstractions\Aero.Cms.Abstractions.csproj"
                      AdditionalProperties="AeroCmsBrowserClient=true" />
    <ProjectReference Include="..\Aero.Cms.Contracts\Aero.Cms.Contracts.csproj"
                      AdditionalProperties="$(AeroCmsBrowserDependencyProperties)"
                      GlobalPropertiesToRemove="AeroCmsBrowserClient" />
    <ProjectReference Include="..\Aero.Cms.Shared\Aero.Cms.Shared.csproj"
                      AdditionalProperties="AeroCmsBrowserClient=true">
      <AeroBrowserBuildRoot>true</AeroBrowserBuildRoot>
    </ProjectReference>
    <ProjectReference Include="..\Aero.Cms.Modules.Commerce.Client\Aero.Cms.Modules.Commerce.Client.csproj"
                      AdditionalProperties="AeroCmsBrowserClient=true">
      <AeroBrowserBuildLeaf>true</AeroBrowserBuildLeaf>
    </ProjectReference>
    <ProjectReference Include="..\..\Aero\src\Aero.Core\Aero.Core.csproj"
                      AdditionalProperties="$(AeroCmsBrowserDependencyProperties)"
                      GlobalPropertiesToRemove="AeroCmsBrowserClient" />
  </ItemGroup>

  <Target Name="AeroCompileClientTypeScriptBeforeStaticWebAssets" BeforeTargets="DefineStaticWebAssets;ResolveProjectStaticWebAssets" Condition="Exists('$(MSBuildProjectDirectory)\tsconfig.json')">
    <PropertyGroup>
      <AeroTscToolExe Condition="'$(TscToolExe)' != ''">$(TscToolExe)</AeroTscToolExe>
      <AeroTscToolExe Condition="'$(AeroTscToolExe)' == ''">node</AeroTscToolExe>
    </PropertyGroup>
    <Exec Command="&quot;$(AeroTscToolExe)&quot; &quot;$(TSJavaScriptFile)&quot; -p &quot;$(MSBuildProjectDirectory)\tsconfig.json&quot;" />
  </Target>

  <!--
    Fail the build if a server implementation dependency crosses back into
    the manager WebAssembly payload. These assemblies are never valid browser
    resources, even when a referenced project happens to restore them.
  -->
  <Target Name="ValidateAeroBrowserDependencyBoundary"
          BeforeTargets="_ResolveBlazorWasmOutputs"
          DependsOnTargets="ResolveReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_AeroForbiddenBrowserReference
          Include="@(ReferenceCopyLocalPaths)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch(
            '%(Filename)',
            '^(Aero\.(Actors(\..*)?|Core\.Ai|Events|Models)|AeroDB\.Sable|Marten|Npgsql(\..*)?|RabbitMQ\.Client|WolverineFx(\..*)?|Microsoft\.CodeAnalysis(\..*)?)$'))" />
    </ItemGroup>
    <Error Condition="'@(_AeroForbiddenBrowserReference)' != ''"
           Text="Server-only assemblies reached the Aero manager WebAssembly payload: @(_AeroForbiddenBrowserReference->'%(Filename)', ', '). Mark their owning package or project references PrivateAssets='all', or add an explicit browser-safe contract boundary." />
  </Target>

</Project>
