<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <WasmNativeStripSymbols>true</WasmNativeStripSymbols>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <WasmDebugLevel Condition="'$(AeroCmsEnableWebAssemblyDebugging)' != 'true'">0</WasmDebugLevel>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Layout\**\*;wwwroot\**\*;_Imports.razor" />
    <None Remove="Layout\**\*;wwwroot\**\*;_Imports.razor" />
    <RazorComponent Remove="Layout\**\*.razor;_Imports.razor" />
    <Compile Include="Program.cs" />
    <ProjectReference Include="..\Aero.Cms.Client\Aero.Cms.Client.csproj" AdditionalProperties="AeroCmsBrowserClient=true" />
    <ProjectReference Include="..\Aero.Cms.Abstractions\Aero.Cms.Abstractions.csproj" AdditionalProperties="AeroCmsBrowserClient=true" />
    <ProjectReference Include="..\Aero.Cms.Modules.Commerce.Client\Aero.Cms.Modules.Commerce.Client.csproj" AdditionalProperties="AeroCmsBrowserClient=true" />
    <ProjectReference Include="..\Aero.Cms.Shared\Aero.Cms.Shared.csproj" AdditionalProperties="AeroCmsBrowserClient=true" />
  </ItemGroup>

  <Target Name="AeroConfigureBrowserStaticWebAssetReferences"
          DependsOnTargets="PrepareProjectReferences"
          BeforeTargets="ResolveReferencedProjectsStaticWebAssetsConfiguration">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)"
                                        Condition="'%(_MSBuildProjectReferenceExistent.AdditionalProperties)' == 'AeroCmsBrowserClient=true'">
        <SetConfiguration>%(_MSBuildProjectReferenceExistent.SetConfiguration);AeroCmsBrowserClient=true</SetConfiguration>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>

</Project>
