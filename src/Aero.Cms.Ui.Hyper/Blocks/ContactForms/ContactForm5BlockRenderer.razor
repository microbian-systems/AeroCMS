@* Contact Form 5 — HyperUI marketing/contact-forms/5 *@
@* Source: hyperui/public/examples/marketing/contact-forms/5.html, 5-dark.html *@
@using Aero.Cms.Ui.Hyper.Blocks.ContactForms
@if (Block is not null)
{
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
            <div class="md:py-4">
                @if (!string.IsNullOrEmpty(Block.Title))
                {
                    <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">@Block.Title</h2>
                }
                @if (!string.IsNullOrEmpty(Block.Description))
                {
                    <p class="mt-4 text-pretty text-gray-700 dark:text-gray-200">@Block.Description</p>
                }

                <dl class="mt-6 space-y-3">
                    <div>
                        <dt class="sr-only">Phone number</dt>
                        <dd class="grid grid-cols-[24px_1fr] items-center gap-2 text-gray-700 dark:text-gray-200">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="1.5" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                            </svg>
                            <span class="font-medium">@Block.PhoneLabel</span>
                        </dd>
                    </div>

                    <div>
                        <dt class="sr-only">Email</dt>
                        <dd class="grid grid-cols-[24px_1fr] items-center gap-2 text-gray-700 dark:text-gray-200">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="1.5" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                            </svg>
                            <span class="font-medium">@Block.EmailLabel</span>
                        </dd>
                    </div>

                    <div>
                        <dt class="sr-only">Location</dt>
                        <dd class="grid grid-cols-[24px_1fr] items-center gap-2 text-gray-700 dark:text-gray-200">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="1.5" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                            </svg>
                            <span class="font-medium">@Block.LocationLabel</span>
                        </dd>
                    </div>
                </dl>
            </div>

            <form action="@Block.FormAction" method="post"
                  class="space-y-4 rounded-lg border border-gray-300 bg-gray-100 p-6 dark:border-gray-600 dark:bg-gray-800">
                <div>
                    <label class="block text-sm font-medium text-gray-900 dark:text-white" for="cf5_name">@Block.NameLabel</label>
                    <input
                        class="mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                        id="cf5_name"
                        type="text"
                        placeholder="@Block.NamePlaceholder"
                    />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-900 dark:text-white" for="cf5_email">@Block.EmailFieldLabel</label>
                    <input
                        class="mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                        id="cf5_email"
                        type="email"
                        placeholder="@Block.EmailPlaceholder"
                    />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-900 dark:text-white" for="cf5_message">@Block.MessageLabel</label>
                    <textarea
                        class="mt-1 w-full resize-none rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                        id="cf5_message"
                        rows="4"
                        placeholder="@Block.MessagePlaceholder"
                    ></textarea>
                </div>

                <button
                    type="submit"
                    class="block w-full rounded-lg border border-indigo-600 bg-indigo-600 px-12 py-3 text-sm font-medium text-white transition-colors hover:bg-transparent hover:text-indigo-600 dark:hover:bg-indigo-700 dark:hover:text-white"
                >
                    @Block.CtaText
                </button>
            </form>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ContactForm5Block? Block { get; set; }
}
