@* Contact Form 4 — HyperUI marketing/contact-forms/4 *@
@* Source: hyperui/public/examples/marketing/contact-forms/4.html, 4-dark.html *@
@if (Block is not null)
{
    <form action="@Block.FormAction" method="post"
          class="mx-auto grid max-w-lg grid-cols-1 gap-4 rounded-lg border border-gray-300 bg-gray-100 p-6 sm:grid-cols-2 dark:border-gray-600 dark:bg-gray-800">
        <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-900 dark:text-white" for="cf4_name">@Block.NameLabel</label>
            <input
                class="mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                id="cf4_name"
                type="text"
                placeholder="@Block.NamePlaceholder"
            />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-900 dark:text-white" for="cf4_email">@Block.EmailLabel</label>
            <input
                class="mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                id="cf4_email"
                type="email"
                placeholder="@Block.EmailPlaceholder"
            />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-900 dark:text-white" for="cf4_phone">@Block.PhoneLabel</label>
            <input
                class="mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                id="cf4_phone"
                type="tel"
                placeholder="@Block.PhonePlaceholder"
            />
        </div>

        <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-900 dark:text-white" for="cf4_message">@Block.MessageLabel</label>
            <textarea
                class="mt-1 w-full resize-none rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                id="cf4_message"
                rows="4"
                placeholder="@Block.MessagePlaceholder"
            ></textarea>
        </div>

        <div class="md:col-span-2">
            <button
                type="submit"
                class="block w-full rounded-lg border border-indigo-600 bg-indigo-600 px-12 py-3 text-sm font-medium text-white transition-colors hover:bg-transparent hover:text-indigo-600 dark:hover:bg-indigo-700 dark:hover:text-white"
            >
                @Block.CtaText
            </button>
        </div>
    </form>
}

@code {
    [Parameter, EditorRequired]
    public ContactForm4Block? Block { get; set; }
}
