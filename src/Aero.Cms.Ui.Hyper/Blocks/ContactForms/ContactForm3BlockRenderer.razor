@* Contact Form 3 — HyperUI marketing/contact-forms/3 *@
@* Source: hyperui/public/examples/marketing/contact-forms/3.html, 3-dark.html *@
@if (Block is not null)
{
    <form action="@Block.FormAction" method="post"
          class="mx-auto max-w-md space-y-4 rounded-lg border border-gray-300 bg-gray-100 p-6 dark:border-gray-600 dark:bg-gray-800">
        <div>
            <label class="block text-sm font-medium text-gray-900 dark:text-white" for="cf3_name">@Block.NameLabel</label>
            <input
                class="mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                id="cf3_name"
                type="text"
                placeholder="@Block.NamePlaceholder"
            />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-900 dark:text-white" for="cf3_email">@Block.EmailLabel</label>
            <input
                class="mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                id="cf3_email"
                type="email"
                placeholder="@Block.EmailPlaceholder"
            />
        </div>

        <fieldset>
            <legend class="block text-sm font-medium text-gray-900 dark:text-white">@Block.InquiryLegend</legend>

            <div class="mt-2 space-y-2">
                <div class="flex items-center gap-2">
                    <input
                        class="size-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                        id="cf3_general"
                        type="checkbox"
                        name="inquiry-type"
                        value="general-inquiry"
                    />
                    <label class="block text-sm text-gray-900 dark:text-white" for="cf3_general">General Inquiry</label>
                </div>

                <div class="flex items-center gap-2">
                    <input
                        class="size-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                        id="cf3_support"
                        type="checkbox"
                        name="inquiry-type"
                        value="support"
                    />
                    <label class="block text-sm text-gray-900 dark:text-white" for="cf3_support">Support</label>
                </div>

                <div class="flex items-center gap-2">
                    <input
                        class="size-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                        id="cf3_feedback"
                        type="checkbox"
                        name="inquiry-type"
                        value="feedback"
                    />
                    <label class="block text-sm text-gray-900 dark:text-white" for="cf3_feedback">Feedback</label>
                </div>

                <div class="flex items-center gap-2">
                    <input
                        class="size-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                        id="cf3_other"
                        type="checkbox"
                        name="inquiry-type"
                        value="other"
                    />
                    <label class="block text-sm text-gray-900 dark:text-white" for="cf3_other">Other</label>
                </div>
            </div>
        </fieldset>

        <div>
            <label class="block text-sm font-medium text-gray-900 dark:text-white" for="cf3_message">@Block.MessageLabel</label>
            <textarea
                class="mt-1 w-full resize-none rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                id="cf3_message"
                rows="4"
                placeholder="@Block.MessagePlaceholder"
            ></textarea>
        </div>

        <button
            type="submit"
            class="block w-full rounded-lg border border-indigo-600 bg-indigo-600 px-12 py-3 text-sm font-medium text-white transition-colors hover:bg-transparent hover:text-indigo-600 dark:hover:bg-indigo-700 dark:hover:text-white"
        >
            @Block.CtaText
        </button>
    </form>
}

@code {
    [Parameter, EditorRequired]
    public ContactForm3Block? Block { get; set; }
}
