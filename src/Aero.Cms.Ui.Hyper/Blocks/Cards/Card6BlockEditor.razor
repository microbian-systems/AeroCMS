@using Aero.Cms.Ui.Hyper.Blocks.Cards

<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Title</label>
        <input class="w-full rounded-md shadow-xs sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.Name"
               @oninput="e => Block.Name = e.Value?.ToString() ?? string.Empty" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Card6Block Block { get; set; } = default!;
}
