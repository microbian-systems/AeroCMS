@* Cards 3 — HyperUI marketing/cards/3 *@
@* Source: hyperui/public/examples/marketing/cards/3.html *@
@using Aero.Cms.Ui.Hyper.Blocks.Cards
@if (Block is not null)
{
    <a href="@Block.CtaUrl" class="group relative block bg-black">
        <img
            alt=""
            src="@Block.ImageUrl"
            class="absolute inset-0 h-full w-full object-cover opacity-75 transition-opacity group-hover:opacity-50"
        />

        <div class="relative p-4 sm:p-6 lg:p-8">
            <p class="text-sm font-medium tracking-widest text-pink-500 uppercase">@Block.Subtitle</p>

            <p class="text-xl font-bold text-white sm:text-2xl">@Block.Title</p>

            <div class="mt-32 sm:mt-48 lg:mt-64">
                <div
                    class="translate-y-8 transform opacity-0 transition-all group-hover:translate-y-0 group-hover:opacity-100"
                >
                    <p class="text-sm text-white">
                        @Block.Description
                    </p>
                </div>
            </div>
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public Card3Block? Block { get; set; }
}
