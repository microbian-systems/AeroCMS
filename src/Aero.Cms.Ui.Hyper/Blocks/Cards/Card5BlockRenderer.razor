@* Cards 5 — HyperUI marketing/cards/5 *@
@* Source: hyperui/public/examples/marketing/cards/5.html *@
@using Aero.Cms.Ui.Hyper.Blocks.Cards
@if (Block is not null)
{
    <a href="@Block.CtaUrl" class="block rounded-lg p-4 shadow-xs shadow-indigo-100 dark:shadow-indigo-900/30">
        <img
            alt=""
            src="@Block.ImageUrl"
            class="h-56 w-full rounded-md object-cover"
        />

        <div class="mt-2">
            <dl>
                <div>
                    <dt class="sr-only">Price</dt>

                    <dd class="text-sm text-gray-500 dark:text-gray-400">@Block.Price</dd>
                </div>

                <div>
                    <dt class="sr-only">Address</dt>

                    <dd class="font-medium text-gray-900 dark:text-white">@Block.Title</dd>
                </div>
            </dl>

            <div class="mt-6 flex items-center gap-8 text-xs">
                @foreach (var feature in Block.Features)
                {
                    <div class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-2">
                        <svg
                            class="size-4 text-indigo-700 dark:text-indigo-400"
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="@feature.SvgPath"
                            />
                        </svg>

                        <div class="mt-1.5 sm:mt-0">
                            <p class="text-gray-500 dark:text-gray-400">@feature.Label</p>

                            <p class="font-medium text-gray-900 dark:text-white">@feature.Value</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public Card5Block? Block { get; set; }
}
