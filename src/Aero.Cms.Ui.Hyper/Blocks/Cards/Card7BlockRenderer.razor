@* Cards 7 — HyperUI marketing/cards/7 *@
@* Source: hyperui/public/examples/marketing/cards/7.html *@
@if (Block is not null)
{
    <a href="@Block.CtaUrl" class="block">
        <img
            alt=""
            src="@Block.ImageUrl"
            class="h-56 w-full rounded-se-3xl rounded-es-3xl object-cover sm:h-64 lg:h-72"
        />

        <div class="mt-4 sm:flex sm:items-center sm:justify-center sm:gap-4">
            <strong class="font-medium text-gray-900 dark:text-white">@Block.Title</strong>

            <span class="hidden sm:block sm:h-px sm:w-8 sm:bg-yellow-500"></span>

            <p class="mt-0.5 opacity-50 sm:mt-0 text-gray-700 dark:text-gray-200">@Block.Subtitle</p>
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public Card7Block? Block { get; set; }
}
