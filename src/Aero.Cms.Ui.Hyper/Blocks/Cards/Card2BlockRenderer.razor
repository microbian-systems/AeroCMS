@* Cards 2 — HyperUI marketing/cards/2 *@
@* Source: hyperui/public/examples/marketing/cards/2.html *@
@using Aero.Cms.Ui.Hyper.Blocks.Cards
@if (Block is not null)
{
    <a href="@Block.CtaUrl" class="block">
        <img
            alt=""
            src="@Block.ImageUrl"
            class="h-64 w-full object-cover sm:h-80 lg:h-96"
        />

        <h3 class="mt-4 text-lg font-bold text-gray-900 sm:text-xl dark:text-white">@Block.Title</h3>

        <p class="mt-2 max-w-sm text-gray-700 dark:text-gray-200">
            @Block.Description
        </p>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public Card2Block? Block { get; set; }
}
