@* Product Collections 3 — HyperUI marketing/product-collections/3 *@
@* Source: hyperui/public/examples/marketing/product-collections/3.html (light-only) *@
@using Aero.Cms.Ui.Hyper.Blocks.ProductCollections
@if (Block is not null && Block.Products.Count > 0)
{
    <section>
        <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
            <header>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white sm:text-3xl">@Block.Title</h2>
                <p class="mt-4 max-w-md text-gray-500 dark:text-gray-400">@Block.Description</p>
            </header>

            <div class="mt-8 sm:flex sm:items-center sm:justify-between">
                <div class="block sm:hidden">
                    <button class="flex cursor-pointer items-center gap-2 border-b border-gray-400 pb-1 text-gray-900 transition hover:border-gray-600 dark:border-gray-600 dark:text-white">
                        <span class="text-sm font-medium">Filters & Sorting</span>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 rtl:rotate-180">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </button>
                </div>

                <div class="hidden sm:flex sm:gap-4">
                    <div class="relative">
                        <details class="group [&_summary::-webkit-details-marker]:hidden">
                            <summary class="flex cursor-pointer items-center gap-2 border-b border-gray-400 pb-1 text-gray-900 transition hover:border-gray-600 dark:border-gray-600 dark:text-white">
                                <span class="text-sm font-medium">Availability</span>
                                <span class="transition group-open:-rotate-180">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                    </svg>
                                </span>
                            </summary>
                            <div class="z-50 group-open:absolute group-open:top-auto group-open:mt-2 ltr:group-open:start-0">
                                <div class="w-96 rounded-xs border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900">
                                    <header class="flex items-center justify-between p-4">
                                        <span class="text-sm text-gray-700 dark:text-gray-300">0 Selected</span>
                                        <button type="button" class="text-sm text-gray-900 underline underline-offset-4 dark:text-white">Reset</button>
                                    </header>
                                    <ul class="space-y-1 border-t border-gray-200 p-4 dark:border-gray-700">
                                        <li>
                                            <label for="FilterInStock_3" class="inline-flex items-center gap-2">
                                                <input type="checkbox" id="FilterInStock_3" class="size-5 rounded-xs border-gray-300 shadow-xs dark:border-gray-600" />
                                                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">In Stock (5+)</span>
                                            </label>
                                        </li>
                                        <li>
                                            <label for="FilterPreOrder_3" class="inline-flex items-center gap-2">
                                                <input type="checkbox" id="FilterPreOrder_3" class="size-5 rounded-xs border-gray-300 shadow-xs dark:border-gray-600" />
                                                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Pre Order (3+)</span>
                                            </label>
                                        </li>
                                        <li>
                                            <label for="FilterOutOfStock_3" class="inline-flex items-center gap-2">
                                                <input type="checkbox" id="FilterOutOfStock_3" class="size-5 rounded-xs border-gray-300 shadow-xs dark:border-gray-600" />
                                                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Out of Stock (10+)</span>
                                            </label>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </details>
                    </div>

                    <div class="relative">
                        <details class="group [&_summary::-webkit-details-marker]:hidden">
                            <summary class="flex cursor-pointer items-center gap-2 border-b border-gray-400 pb-1 text-gray-900 transition hover:border-gray-600 dark:border-gray-600 dark:text-white">
                                <span class="text-sm font-medium">Price</span>
                                <span class="transition group-open:-rotate-180">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                    </svg>
                                </span>
                            </summary>
                            <div class="z-50 group-open:absolute group-open:top-auto group-open:mt-2 ltr:group-open:start-0">
                                <div class="w-96 rounded-xs border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900">
                                    <header class="flex items-center justify-between p-4">
                                        <span class="text-sm text-gray-700 dark:text-gray-300">The highest price is $600</span>
                                        <button type="button" class="text-sm text-gray-900 underline underline-offset-4 dark:text-white">Reset</button>
                                    </header>
                                    <div class="border-t border-gray-200 p-4 dark:border-gray-700">
                                        <div class="flex justify-between gap-4">
                                            <label for="FilterPriceFrom_3" class="flex items-center gap-2">
                                                <span class="text-sm text-gray-600 dark:text-gray-400">$</span>
                                                <input type="number" id="FilterPriceFrom_3" placeholder="From"
                                                       class="w-full rounded-md border-gray-200 shadow-xs sm:text-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white" />
                                            </label>
                                            <label for="FilterPriceTo_3" class="flex items-center gap-2">
                                                <span class="text-sm text-gray-600 dark:text-gray-400">$</span>
                                                <input type="number" id="FilterPriceTo_3" placeholder="To"
                                                       class="w-full rounded-md border-gray-200 shadow-xs sm:text-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white" />
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </details>
                    </div>
                </div>

                <div class="hidden sm:block">
                    <label for="SortBy_3" class="sr-only">SortBy</label>
                    <select id="SortBy_3" class="h-10 rounded-xs border-gray-300 text-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white">
                        <option>Sort By</option>
                        <option value="Title, DESC">Title, DESC</option>
                        <option value="Title, ASC">Title, ASC</option>
                        <option value="Price, DESC">Price, DESC</option>
                        <option value="Price, ASC">Price, ASC</option>
                    </select>
                </div>
            </div>

            <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var product in Block.Products)
                {
                    <li>
                        <a href="@product.ProductUrl" class="group block overflow-hidden">
                            <img src="@product.ImageUrl" alt="@product.Name"
                                 class="h-87.5 w-full object-cover transition duration-500 group-hover:scale-105 sm:h-112.5" />
                            <div class="relative bg-white pt-3 dark:bg-gray-900">
                                <h3 class="text-xs text-gray-700 group-hover:underline group-hover:underline-offset-4 dark:text-gray-300">@product.Name</h3>
                                <p class="mt-2">
                                    <span class="sr-only">Regular Price</span>
                                    <span class="tracking-wider text-gray-900 dark:text-white">@product.Price</span>
                                </p>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public ProductCollection3Block? Block { get; set; }
}
