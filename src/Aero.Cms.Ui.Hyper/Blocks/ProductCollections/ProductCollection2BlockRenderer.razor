@* Product Collections 2 — HyperUI marketing/product-collections/2 *@
@* Source: hyperui/public/examples/marketing/product-collections/2.html (light-only) *@
@if (Block is not null && Block.Products.Count > 0)
{
    <section>
        <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
            <header class="text-center">
                <h2 class="text-xl font-bold text-gray-900 dark:text-white sm:text-3xl">@Block.Title</h2>
                <p class="mx-auto mt-4 max-w-md text-gray-500 dark:text-gray-400">@Block.Description</p>
            </header>

            <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var product in Block.Products)
                {
                    <li>
                        <a href="@product.ProductUrl" class="group block overflow-hidden">
                            <img src="@product.ImageUrl" alt="@product.Name"
                                 class="h-87.5 w-full object-cover transition duration-500 group-hover:scale-105 sm:h-112.5" />

                            <div class="relative bg-white pt-3 dark:bg-gray-900">
                                <h3 class="text-xs text-gray-700 group-hover:underline group-hover:underline-offset-4 dark:text-gray-300">
                                    @product.Name
                                </h3>
                                <p class="mt-2">
                                    <span class="sr-only">Regular Price</span>
                                    <span class="tracking-wider text-gray-900 dark:text-white">@product.Price</span>
                                </p>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public ProductCollection2Block? Block { get; set; }
}
