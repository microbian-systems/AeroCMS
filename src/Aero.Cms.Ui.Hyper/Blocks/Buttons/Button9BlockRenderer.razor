@* Button 9 — HyperUI marketing/buttons/9 *@
@* Source: hyperui/public/examples/marketing/buttons/9.html *@
@using Aero.Cms.Ui.Hyper.Blocks.Buttons
@if (Block is not null)
{
    var isHoverOut = string.Equals(Block.OffsetStyle, "hover-out", StringComparison.OrdinalIgnoreCase);
    var shadowCls = isHoverOut
        ? "translate-x-1.5 translate-y-1.5 transition-transform group-hover:translate-x-0 group-hover:translate-y-0"
        : "translate-x-0 translate-y-0 transition-transform group-hover:translate-x-1.5 group-hover:translate-y-1.5";

    // hover-out variant uses black text; hover-in inherits text color
    var textCls = isHoverOut ? "text-black" : "";

    <a class="group relative inline-block" href="@Block.Url">
        <span class="absolute inset-0 bg-yellow-300 @shadowCls"></span>
        <span class="relative inline-block border-2 border-current px-8 py-3 text-sm font-bold tracking-widest uppercase @textCls">
            @Block.Text
        </span>
    </a>
}
@code {
    [Parameter, EditorRequired]
    public Button9Block? Block { get; set; }
}
