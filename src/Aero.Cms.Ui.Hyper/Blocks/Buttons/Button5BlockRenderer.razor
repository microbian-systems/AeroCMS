@* Button 5 — HyperUI marketing/buttons/5 *@
@* Source: hyperui/public/examples/marketing/buttons/5.html *@
@using Aero.Cms.Ui.Hyper.Blocks.Buttons
@if (Block is not null)
{
    var isHoverOut = string.Equals(Block.OffsetStyle, "hover-out", StringComparison.OrdinalIgnoreCase);
    // hover-out: shadow visible, translates to 0 on hover
    // hover-in: at 0, translates outward on hover
    var shadowCls = isHoverOut
        ? "translate-x-0.5 translate-y-0.5 transition-transform group-hover:translate-x-0 group-hover:translate-y-0"
        : "translate-x-0 translate-y-0 transition-transform group-hover:translate-x-0.5 group-hover:translate-y-0.5";

    <a class="group relative inline-block text-sm font-medium text-indigo-600" href="@Block.Url">
        <span class="absolute inset-0 bg-indigo-600 @shadowCls"></span>
        <span class="relative block border border-current bg-white px-8 py-3"> @Block.Text </span>
    </a>
}
@code {
    [Parameter, EditorRequired]
    public Button5Block? Block { get; set; }
}
