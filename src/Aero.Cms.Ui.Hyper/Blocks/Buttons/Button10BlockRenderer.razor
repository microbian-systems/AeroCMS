@* Button 10 — HyperUI marketing/buttons/10 *@
@* Source: hyperui/public/examples/marketing/buttons/10.html *@
@if (Block is not null)
{
    var direction = Block.RevealDirection?.ToLowerInvariant() ?? "left";

    // Determine the reveal element classes based on direction
    var (revealCls, size) = direction switch
    {
        "right"  => ("absolute inset-y-0 right-0 w-0.5 bg-indigo-600 transition-all group-hover:w-full", ""),
        "bottom" => ("absolute inset-x-0 bottom-0 h-0.5 bg-indigo-600 transition-all group-hover:h-full", ""),
        "top"    => ("absolute inset-x-0 top-0 h-0.5 bg-indigo-600 transition-all group-hover:h-full", ""),
        _        => ("absolute inset-y-0 left-0 w-0.5 bg-indigo-600 transition-all group-hover:w-full", "")
    };

    <a class="group relative inline-block overflow-hidden border border-indigo-600 px-8 py-3" href="@Block.Url">
        <span class="@revealCls"></span>
        <span class="relative text-sm font-medium text-indigo-600 transition-colors group-hover:text-white">
            @Block.Text
        </span>
    </a>
}
@code {
    [Parameter, EditorRequired]
    public Button10Block? Block { get; set; }
}
