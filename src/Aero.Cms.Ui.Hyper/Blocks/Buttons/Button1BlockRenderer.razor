@* Button 1 — HyperUI marketing/buttons/1 *@
@* Source: hyperui/public/examples/marketing/buttons/1.html *@
@using Aero.Cms.Ui.Hyper.Blocks.Buttons
@if (Block is not null)
{
    var isSolid = string.Equals(Block.Style, "solid", StringComparison.OrdinalIgnoreCase);
    var cls = isSolid
        ? "inline-block rounded-sm border border-indigo-600 bg-indigo-600 px-12 py-3 text-sm font-medium text-white hover:bg-transparent hover:text-indigo-600"
        : "inline-block rounded-sm border border-indigo-600 px-12 py-3 text-sm font-medium text-indigo-600 hover:bg-indigo-600 hover:text-white";

    <a href="@Block.Url" class="@cls">@Block.Text</a>
}
@code {
    [Parameter, EditorRequired]
    public Button1Block? Block { get; set; }
}
