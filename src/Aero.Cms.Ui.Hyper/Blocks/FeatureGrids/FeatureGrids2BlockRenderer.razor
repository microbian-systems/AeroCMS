@* Feature Grids 2 — HyperUI marketing/feature-grids/2 *@
@* Source: hyperui/public/examples/marketing/feature-grids/2.html + 2-dark.html *@
@if (Block is not null)
{
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
            <div class="col-span-1">
                @if (!string.IsNullOrEmpty(Block.Title))
                {
                    <h2 class="text-3xl/tight font-bold text-gray-900 sm:text-4xl dark:text-white">@Block.Title</h2>
                }

                @if (!string.IsNullOrEmpty(Block.Description))
                {
                    <p class="mt-4 text-lg text-pretty text-gray-700 dark:text-gray-200">@Block.Description</p>
                }
            </div>

            <div class="space-y-6">
                @foreach (var item in Block.Items)
                {
                    <div class="flex items-start gap-4">
                        <div class="shrink-0 rounded-lg bg-gray-100 p-3 text-gray-700 dark:bg-gray-800 dark:text-gray-200">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="@item.Icon" />
                            </svg>
                        </div>

                        <div>
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">@item.Title</h3>
                            <p class="mt-1 text-gray-700 dark:text-gray-200">@item.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public FeatureGrids2Block? Block { get; set; }
}
