@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <FeatureGrids3BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private FeatureGrids3Block PreviewBlock => FeatureGrids3BlockMapper.FromNode(Node);
}
