@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <LogoClouds2BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private LogoClouds2Block PreviewBlock => LogoClouds2BlockMapper.FromNode(Node);
}
