@* Logo Clouds 3 — HyperUI marketing/logo-clouds/3 *@
@* Source: hyperui/public/examples/marketing/logo-clouds/3.html (light-only, no dark variant) *@
@using Aero.Cms.Ui.Hyper.Blocks.LogoClouds
@if (Block is not null && Block.LogoItems.Count > 0)
{
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="max-w-lg">
            @if (!string.IsNullOrEmpty(Block.Title))
            {
                <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">@Block.Title</h2>
            }
            @if (!string.IsNullOrEmpty(Block.Description))
            {
                <p class="mt-4 text-pretty text-gray-700">@Block.Description</p>
            }
        </div>

        <div class="mt-4 grid grid-cols-2 gap-px overflow-hidden rounded-lg *:bg-gray-100 md:grid-cols-4">
            @foreach (var logo in Block.LogoItems)
            {
                <div class="grid aspect-video place-content-center p-4 grayscale transition-[filter] hover:grayscale-0">
                    @((MarkupString)logo.SvgHtml)
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public LogoClouds3Block? Block { get; set; }
}
