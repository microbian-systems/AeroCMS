@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <LogoClouds4BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private LogoClouds4Block PreviewBlock => LogoClouds4BlockMapper.FromNode(Node);
}
