@* Logo Clouds 4 — HyperUI marketing/logo-clouds/4 *@
@* Source: hyperui/public/examples/marketing/logo-clouds/4.html (light-only, no dark variant) *@
@if (Block is not null && Block.LogoItems.Count > 0)
{
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-px overflow-hidden rounded-lg *:bg-gray-100 md:grid-cols-4">
            @foreach (var logo in Block.LogoItems)
            {
                <div class="grid aspect-video place-content-center p-4 grayscale transition-[filter] hover:grayscale-0">
                    @((MarkupString)logo.SvgHtml)
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public LogoClouds4Block? Block { get; set; }
}
