@* Logo Clouds 1 — HyperUI marketing/logo-clouds/1 *@
@* Source: hyperui/public/examples/marketing/logo-clouds/1.html (light-only, no dark variant) *@
@using Aero.Cms.Ui.Hyper.Blocks.LogoClouds
@if (Block is not null && Block.LogoItems.Count > 0)
{
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-px md:grid-cols-4">
            @foreach (var logo in Block.LogoItems)
            {
                <div class="grid place-content-center p-4 grayscale transition-[filter] hover:grayscale-0">
                    @((MarkupString)logo.SvgHtml)
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public LogoClouds1Block? Block { get; set; }
}
