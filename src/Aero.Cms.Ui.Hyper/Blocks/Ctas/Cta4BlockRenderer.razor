@* CTA 4 — HyperUI marketing/ctas/4 *@
@* Source: hyperui/public/examples/marketing/ctas/4.html, 4-dark.html *@
@using Aero.Cms.Ui.Hyper.Blocks.Ctas
@if (Block is not null)
{
    <section>
        <div class="mx-auto max-w-screen-2xl px-4 py-8 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="bg-gray-100 p-8 md:p-12 lg:px-16 lg:py-24 dark:bg-gray-800">
                    <div class="mx-auto max-w-xl text-center">
                        @if (!string.IsNullOrEmpty(Block.Title))
                        {
                            <h2 class="text-2xl font-bold text-gray-900 md:text-3xl dark:text-white">
                                @((MarkupString)Block.Title)
                            </h2>
                        }

                        @if (!string.IsNullOrEmpty(Block.Description))
                        {
                            <p class="hidden text-gray-700 sm:mt-4 sm:block dark:text-gray-200">
                                @((MarkupString)Block.Description)
                            </p>
                        }

                        <div class="mt-4 md:mt-8">
                            <a href="@Block.CtaUrl"
                               class="inline-block rounded-sm border border-blue-600 bg-blue-600 px-12 py-3 text-sm font-medium text-white transition-colors hover:bg-transparent hover:text-blue-600 dark:border-blue-300 dark:bg-blue-300 dark:text-gray-900 dark:hover:text-blue-300">
                                @Block.CtaText
                            </a>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 md:grid-cols-1 lg:grid-cols-2">
                    @if (!string.IsNullOrEmpty(Block.ImageUrl))
                    {
                        <img alt=""
                             src="@Block.ImageUrl"
                             class="h-40 w-full object-cover sm:h-56 md:h-full" />
                    }
                    @if (!string.IsNullOrEmpty(Block.ImageUrl2))
                    {
                        <img alt=""
                             src="@Block.ImageUrl2"
                             class="h-40 w-full object-cover sm:h-56 md:h-full" />
                    }
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public Cta4Block? Block { get; set; }
}
