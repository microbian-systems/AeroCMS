@* CTA 1 — HyperUI marketing/ctas/1 *@
@* Source: hyperui/public/examples/marketing/ctas/1.html, 1-dark.html *@
@using Aero.Cms.Ui.Hyper.Blocks.Ctas
@if (Block is not null)
{
    <section class="overflow-hidden bg-gray-50 sm:grid sm:grid-cols-2 dark:bg-gray-900">
        <div class="p-8 md:p-12 lg:px-16 lg:py-24">
            <div class="mx-auto max-w-xl text-center ltr:sm:text-left rtl:sm:text-right">
                @if (!string.IsNullOrEmpty(Block.Title))
                {
                    <h2 class="text-2xl font-bold text-gray-900 md:text-3xl dark:text-white">
                        @((MarkupString)Block.Title)
                    </h2>
                }

                @if (!string.IsNullOrEmpty(Block.Description))
                {
                    <p class="hidden text-gray-500 md:mt-4 md:block dark:text-gray-300">
                        @((MarkupString)Block.Description)
                    </p>
                }

                <div class="mt-4 md:mt-8">
                    <a href="@Block.CtaUrl"
                       class="inline-block rounded-sm bg-emerald-600 px-12 py-3 text-sm font-medium text-white transition hover:bg-emerald-700 focus:ring-2 focus:ring-yellow-400 focus:outline-hidden">
                        @Block.CtaText
                    </a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Block.ImageUrl))
        {
            <img alt=""
                 src="@Block.ImageUrl"
                 class="h-56 w-full object-cover sm:h-full" />
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public Cta1Block? Block { get; set; }
}
