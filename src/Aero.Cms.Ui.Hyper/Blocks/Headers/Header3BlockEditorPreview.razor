@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <Header3BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private Header3Block PreviewBlock => Header3BlockMapper.FromNode(Node);
}
