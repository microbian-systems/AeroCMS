<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Login Text</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.LoginText"
               @oninput="e => Block.LoginText = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Register Text</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.RegisterText"
               @oninput="e => Block.RegisterText = e.Value?.ToString() ?? string.Empty" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Header3Block Block { get; set; } = default!;
}
