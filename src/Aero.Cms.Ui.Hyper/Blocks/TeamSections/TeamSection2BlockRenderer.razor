@* Team Sections 2 — HyperUI marketing/team-sections/2 *@
@* Source: hyperui/public/examples/marketing/team-sections/2.html + 2-dark.html *@
@if (Block is not null && Block.Members.Count > 0)
{
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        @if (!string.IsNullOrEmpty(Block.Title))
        {
            <h2 class="text-center text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">@Block.Title</h2>
        }
        @if (!string.IsNullOrEmpty(Block.Description))
        {
            <p class="mx-auto mt-4 max-w-lg text-center text-gray-700 dark:text-gray-200">@Block.Description</p>
        }
        <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3">
            @foreach (var member in Block.Members)
            {
                <div>
                    <img src="@member.AvatarUrl" alt="@member.Name"
                         class="aspect-video rounded-sm object-cover" />

                    <div class="mt-4">
                        <div class="flex items-center justify-between gap-4">
                            <div>
                                <h3 class="text-lg/tight font-semibold text-gray-900 dark:text-white">@member.Name</h3>
                                <p class="mt-0.5 text-sm text-gray-700 dark:text-gray-200">@member.Role</p>
                            </div>

                            @if (!string.IsNullOrEmpty(member.LinkedInUrl))
                            {
                                <a href="@member.LinkedInUrl" target="_blank" rel="noreferrer"
                                   class="text-[#0072b1] transition-opacity hover:opacity-90 dark:text-white">
                                    <svg viewBox="0 0 20 20" fill="currentColor" class="size-7">
                                        <path d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z"
                                              clip-rule="evenodd" fill-rule="evenodd"></path>
                                    </svg>
                                </a>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(member.Description))
                        {
                            <p class="mt-2 text-pretty text-gray-700 dark:text-gray-200">@member.Description</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public TeamSection2Block? Block { get; set; }
}
