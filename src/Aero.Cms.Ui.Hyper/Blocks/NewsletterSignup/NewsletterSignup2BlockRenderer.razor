@* Newsletter Signup 2 — HyperUI marketing/newsletter-signup/2 *@
@* Source: hyperui/public/examples/marketing/newsletter-signup/2.html, 2-dark.html *@
@if (Block is not null)
{
    <div class="bg-gray-100 dark:bg-gray-800">
        <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            <div class="mx-auto max-w-prose text-center">
                @if (!string.IsNullOrEmpty(Block.Title))
                {
                    <h2 class="text-2xl font-semibold text-gray-900 sm:text-3xl dark:text-white">@Block.Title</h2>
                }
                @if (!string.IsNullOrEmpty(Block.Description))
                {
                    <p class="mt-4 text-pretty text-gray-700 dark:text-gray-200">@Block.Description</p>
                }
            </div>

            <form action="@Block.FormAction" method="post"
                  class="mx-auto mt-6 flex max-w-xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-center">
                <label for="NewsletterEmail2" class="flex-1">
                    <span class="sr-only">@Block.Placeholder</span>
                    <input
                        type="email"
                        id="NewsletterEmail2"
                        placeholder="@Block.Placeholder"
                        class="h-12 w-full rounded border-gray-300 shadow-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white"
                    />
                </label>

                <button
                    type="submit"
                    class="h-12 rounded-sm border border-indigo-600 bg-indigo-600 px-12 py-3 text-sm font-medium text-white hover:bg-transparent hover:text-indigo-600 dark:text-white dark:hover:bg-indigo-700 dark:hover:text-white"
                >
                    @Block.CtaText
                </button>
            </form>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public NewsletterSignup2Block? Block { get; set; }
}
