@* Product Cards 3 — HyperUI marketing/product-cards/3 *@
@* Source: hyperui/public/examples/marketing/product-cards/3.html *@
@using Aero.Cms.Ui.Hyper.Blocks.ProductCards
@if (Block is not null)
{
    <a href="@Block.CtaUrl" class="group block">
        <img
            src="@Block.ImageUrl"
            alt=""
            class="h-87.5 w-full object-cover sm:h-112.5"
        />

        <div class="mt-3 flex justify-between text-sm">
            <div>
                <h3 class="text-gray-900 group-hover:underline group-hover:underline-offset-4 dark:text-white">@Block.Title</h3>

                <p class="mt-1.5 text-xs text-pretty text-gray-500 dark:text-gray-400">
                    @Block.Description
                </p>
            </div>

            <p class="text-gray-900 dark:text-white">@Block.Price</p>
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public ProductCard3Block? Block { get; set; }
}
