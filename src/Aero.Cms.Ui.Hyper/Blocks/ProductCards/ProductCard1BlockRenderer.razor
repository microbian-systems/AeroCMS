@* Product Cards 1 — HyperUI marketing/product-cards/1 *@
@* Source: hyperui/public/examples/marketing/product-cards/1.html *@
@if (Block is not null)
{
    <a href="@Block.CtaUrl" class="group block overflow-hidden">
        <div class="relative h-87.5 sm:h-112.5">
            <img
                src="@Block.ImageUrl"
                alt=""
                class="absolute inset-0 h-full w-full object-cover opacity-100 group-hover:opacity-0"
            />

            <img
                src="@Block.ImageHoverUrl"
                alt=""
                class="absolute inset-0 h-full w-full object-cover opacity-0 group-hover:opacity-100"
            />
        </div>

        <div class="relative bg-white pt-3 dark:bg-gray-900">
            <h3 class="text-sm text-gray-700 group-hover:underline group-hover:underline-offset-4 dark:text-gray-200">@Block.Title</h3>

            <p class="mt-1.5 tracking-wide text-gray-900 dark:text-white">@Block.Price</p>
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public ProductCard1Block? Block { get; set; }
}
