<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Title</label>
        <input class="w-full rounded-md shadow-xs sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.Title"
               @oninput="e => Block.Title = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Description</label>
        <textarea rows="3" class="w-full rounded-md shadow-xs sm:text-sm"
                  style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                   value="@Block.Subtitle"
                   @oninput="e => Block.Subtitle = e.Value?.ToString() ?? string.Empty"></textarea>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ProductCard5Block Block { get; set; } = default!;
}
