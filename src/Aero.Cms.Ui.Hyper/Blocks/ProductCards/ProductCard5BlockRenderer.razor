@* Product Cards 5 — HyperUI marketing/product-cards/5 *@
@* Source: hyperui/public/examples/marketing/product-cards/5.html *@
@using Aero.Cms.Ui.Hyper.Blocks.ProductCards
@if (Block is not null)
{
    <a href="@Block.CtaUrl" class="group block">
        <img
            src="@Block.ImageUrl"
            alt=""
            class="h-87.5 w-full object-cover sm:h-112.5"
        />

        <div class="mt-1.5">
            <p class="text-xs text-gray-500 dark:text-gray-400">@Block.Subtitle</p>

            <div class="mt-1.5 flex gap-1">
                @foreach (var color in Block.Colors)
                {
                    <div>
                        <span class="block size-4 rounded-full" style="background-color: @color.Hex">
                            <span class="sr-only"> @color.Name </span>
                        </span>
                    </div>
                }
            </div>

            <div class="mt-3 flex justify-between text-sm">
                <h3 class="text-gray-900 group-hover:underline group-hover:underline-offset-4 dark:text-white">@Block.Title</h3>

                <p class="text-gray-900 dark:text-white">@Block.Price</p>
            </div>
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public ProductCard5Block? Block { get; set; }
}
