@* Announcement 5 — HyperUI marketing/announcements/5 *@
@* Source: hyperui/public/examples/marketing/announcements/5.html + 5-dark.html *@
@using Aero.Cms.Ui.Hyper.Blocks.Announcements
@if (Block is not null)
{
    <div class="fixed inset-x-0 bottom-0 z-auto p-4">
        <div class="rounded-xs border border-gray-200 bg-gray-100 px-4 py-2 text-gray-900 dark:border-gray-700 dark:bg-gray-800 dark:text-white">
            <p class="text-center font-medium">
                @if (!string.IsNullOrEmpty(Block.MainText))
                {
                    @Block.MainText
                }
                @if (!string.IsNullOrEmpty(Block.CtaText))
                {
                    <a href="@Block.CtaUrl" class="inline-block underline"> @Block.CtaText </a>
                }
            </p>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Announcement5Block? Block { get; set; }
}
