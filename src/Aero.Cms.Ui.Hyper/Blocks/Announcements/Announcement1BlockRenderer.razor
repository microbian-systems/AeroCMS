@* Announcement 1 — HyperUI marketing/announcements/1 *@
@* Source: hyperui/public/examples/marketing/announcements/1.html + 1-dark.html *@
@using Aero.Cms.Ui.Hyper.Blocks.Announcements
@if (Block is not null)
{
    <div class="border-b border-gray-200 bg-gray-100 px-4 py-2 text-gray-900 dark:border-gray-700 dark:bg-gray-800 dark:text-white">
        <p class="text-center font-medium">
            @if (!string.IsNullOrEmpty(Block.MainText))
            {
                @Block.MainText
            }
            @if (!string.IsNullOrEmpty(Block.CtaText))
            {
                <a href="@Block.CtaUrl" class="inline-block underline"> @Block.CtaText </a>
            }
        </p>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Announcement1Block? Block { get; set; }
}
