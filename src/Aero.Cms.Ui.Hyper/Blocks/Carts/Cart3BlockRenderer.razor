@* Cart 3 — HyperUI marketing/carts/3 *@
@* Source: hyperui/public/examples/marketing/carts/3.html *@
@if (Block is not null)
{
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <ul class="space-y-4">
            @foreach (var item in Block.Items)
            {
                <li class="flex items-center gap-4">
                    <img src="@item.ImageSrc" alt="@item.Name"
                         class="size-16 rounded-sm object-cover" />
                    <div>
                        <h3 class="text-sm text-gray-900 dark:text-white">@item.Name</h3>
                        <dl class="mt-0.5 space-y-px text-[10px] text-gray-600 dark:text-gray-300">
                            <div>
                                <dt class="inline">Size:</dt>
                                <dd class="inline">@item.Size</dd>
                            </div>
                            <div>
                                <dt class="inline">Color:</dt>
                                <dd class="inline">@item.Color</dd>
                            </div>
                        </dl>
                    </div>
                    <div class="flex flex-1 items-center justify-end gap-2">
                        <form>
                            <label for="Cart3Qty_@item.GetHashCode()" class="sr-only"> Quantity </label>
                            <input type="number" min="1" value="@item.Quantity"
                                   id="Cart3Qty_@item.GetHashCode()"
                                   class="h-8 w-12 rounded-sm border-gray-300 bg-white p-0 text-center text-xs text-gray-700 [-moz-appearance:textfield] focus:outline-hidden dark:border-gray-600 dark:bg-gray-900 dark:text-gray-200 [&::-webkit-inner-spin-button]:m-0 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:m-0 [&::-webkit-outer-spin-button]:appearance-none" />
                        </form>
                        <button class="text-gray-600 transition hover:text-red-600 dark:text-gray-300 dark:hover:text-red-300">
                            <span class="sr-only">Remove item</span>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="1.5" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                            </svg>
                        </button>
                    </div>
                </li>
            }
        </ul>

        <div class="mt-8 space-y-6 border-t border-gray-100 pt-8 dark:border-gray-800">
            <dl class="ms-auto max-w-sm space-y-1 text-sm text-gray-700 dark:text-gray-200">
                <div class="flex justify-between">
                    <dt>Subtotal</dt>
                    <dd>@Block.Subtotal</dd>
                </div>
                <div class="flex justify-between">
                    <dt>VAT</dt>
                    <dd>@Block.Vat</dd>
                </div>
                <div class="flex justify-between">
                    <dt>Discount</dt>
                    <dd>@Block.Discount</dd>
                </div>
                <div class="flex justify-between font-semibold">
                    <dt>Total</dt>
                    <dd>@Block.Total</dd>
                </div>
            </dl>

            <div class="flex items-center justify-end gap-4">
                <a href="@Block.ViewCartUrl"
                   class="block rounded-sm border border-gray-300 bg-gray-50 px-5 py-3 text-sm text-gray-700 transition-colors hover:text-gray-900 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:text-white">
                    @Block.ViewCartText (@Block.CartItemCount)
                </a>
                <a href="@Block.CheckoutUrl"
                   class="block rounded-sm border border-blue-600 bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-blue-700 hover:bg-blue-700 dark:border-blue-300 dark:bg-blue-300 dark:text-gray-900 dark:hover:border-blue-200 dark:hover:bg-blue-200">
                    @Block.CheckoutText
                </a>
            </div>

            <div class="text-end">
                <a href="@Block.ContinueShoppingUrl"
                   class="inline-block text-sm text-gray-600 underline underline-offset-4 transition-colors hover:text-gray-700 dark:text-gray-300 dark:hover:text-gray-200">
                    @Block.ContinueShoppingText
                </a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Cart3Block? Block { get; set; }
}
