@* Pricing 1 — HyperUI marketing/pricing/1 *@
@* Source: hyperui/public/examples/marketing/pricing/1.html (light-only, no dark variant) *@
@if (Block is not null && Block.Plans.Count > 0)
{
    <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
        @if (!string.IsNullOrEmpty(Block.Title))
        {
            <h2 class="text-center text-3xl font-bold text-gray-900 sm:text-4xl">@Block.Title</h2>
        }
        @if (!string.IsNullOrEmpty(Block.Description))
        {
            <p class="mx-auto mt-4 max-w-lg text-center text-gray-700">@Block.Description</p>
        }

        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:items-center md:gap-8">
            @foreach (var plan in Block.Plans)
            {
                var cardClass = plan.Highlighted
                    ? "rounded-2xl border border-indigo-600 p-6 shadow-xs ring-1 ring-indigo-600 sm:order-last sm:px-8 lg:p-12"
                    : "rounded-2xl border border-gray-200 p-6 shadow-xs sm:px-8 lg:p-12";

                var ctaClass = plan.Highlighted
                    ? "mt-8 block rounded-full border border-indigo-600 bg-indigo-600 px-12 py-3 text-center text-sm font-medium text-white hover:bg-indigo-700 hover:ring-1 hover:ring-indigo-700 focus:outline-hidden"
                    : "mt-8 block rounded-full border border-indigo-600 bg-white px-12 py-3 text-center text-sm font-medium text-indigo-600 hover:ring-1 hover:ring-indigo-600 focus:outline-hidden";

                <div class="@cardClass">
                    <div class="text-center">
                        <h2 class="text-lg font-medium text-gray-900">
                            @plan.Name
                            <span class="sr-only">Plan</span>
                        </h2>

                        <p class="mt-2 sm:mt-4">
                            <strong class="text-3xl font-bold text-gray-900 sm:text-4xl"> @plan.Price </strong>
                            <span class="text-sm font-medium text-gray-700">@plan.Period</span>
                        </p>
                    </div>

                    <ul class="mt-6 space-y-2">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="flex items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                     stroke-width="1.5" stroke="currentColor" class="size-5 text-indigo-700" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                <span class="text-gray-700"> @feature </span>
                            </li>
                        }
                    </ul>

                    <a href="@plan.CtaUrl" class="@ctaClass">
                        @plan.CtaText
                    </a>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Pricing1Block? Block { get; set; }
}
