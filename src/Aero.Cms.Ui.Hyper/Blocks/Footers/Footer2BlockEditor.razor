<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Copyright</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.Copyright"
               @oninput="e => Block.Copyright = e.Value?.ToString() ?? string.Empty" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Footer2Block Block { get; set; } = default!;
}
