@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <Footer6BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private Footer6Block PreviewBlock => Footer6BlockMapper.FromNode(Node);
}
