@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <Footer4BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private Footer4Block PreviewBlock => Footer4BlockMapper.FromNode(Node);
}
