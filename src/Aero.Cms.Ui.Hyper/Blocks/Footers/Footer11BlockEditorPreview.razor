@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <Footer11BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private Footer11Block PreviewBlock => Footer11BlockMapper.FromNode(Node);
}
