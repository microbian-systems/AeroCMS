<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Image URL</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.ImageUrl"
               @oninput="e => Block.ImageUrl = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Call Us Text</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.CallUsText"
               @oninput="e => Block.CallUsText = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Phone Number</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.PhoneNumber"
               @oninput="e => Block.PhoneNumber = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Copyright Text</label>
        <textarea rows="2" class="w-full rounded-md shadow-sm sm:text-sm"
                  style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                  value="@Block.CopyrightText"
                  @oninput="e => Block.CopyrightText = e.Value?.ToString() ?? string.Empty"></textarea>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Footer5Block Block { get; set; } = default!;
}
