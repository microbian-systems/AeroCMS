<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Newsletter Title</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.NewsletterTitle"
               @oninput="e => Block.NewsletterTitle = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Newsletter Description</label>
        <textarea rows="3" class="w-full rounded-md shadow-sm sm:text-sm"
                  style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                  value="@Block.NewsletterDescription"
                  @oninput="e => Block.NewsletterDescription = e.Value?.ToString() ?? string.Empty"></textarea>
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Email Placeholder</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.EmailPlaceholder"
               @oninput="e => Block.EmailPlaceholder = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Button Text</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.ButtonText"
               @oninput="e => Block.ButtonText = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Copyright</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.Copyright"
               @oninput="e => Block.Copyright = e.Value?.ToString() ?? string.Empty" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Footer1Block Block { get; set; } = default!;
}
