@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <Footer5BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private Footer5Block PreviewBlock => Footer5BlockMapper.FromNode(Node);
}
