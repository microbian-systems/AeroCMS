@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <Footer7BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private Footer7Block PreviewBlock => Footer7BlockMapper.FromNode(Node);
}
