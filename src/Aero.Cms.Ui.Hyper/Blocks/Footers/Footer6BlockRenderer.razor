                                    {
                                        <li>
                                            <a href="@link.Url" class="text-gray-700 transition hover:opacity-75 dark:text-gray-200">@link.Text</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Block.CompanyLinks.Count > 0)
                        {
                            <div>
                                <p class="font-medium text-gray-900 dark:text-white">Company</p>
                                <ul class="mt-6 space-y-4 text-sm">
                                    @foreach (var link in Block.CompanyLinks)
                                    {
                                        <li>
                                            <a href="@link.Url" class="text-gray-700 transition hover:opacity-75 dark:text-gray-200">@link.Text</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Block.HelpfulLinks.Count > 0)
                        {
                            <div>
                                <p class="font-medium text-gray-900 dark:text-white">Helpful Links</p>
                                <ul class="mt-6 space-y-4 text-sm">
                                    @foreach (var link in Block.HelpfulLinks)
                                    {
                                        <li>
                                            <a href="@link.Url" class="text-gray-700 transition hover:opacity-75 dark:text-gray-200">@link.Text</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    <div class="mt-8 border-t border-gray-100 pt-8 dark:border-gray-800">
                        @if (Block.BottomLinks.Count > 0)
                        {
                            <ul class="flex flex-wrap gap-4 text-xs">
                                @foreach (var link in Block.BottomLinks)
                                {
                                    <li>
                                        <a href="@link.Url" class="text-gray-500 transition hover:opacity-75 dark:text-gray-400">@link.Text</a>
                                    </li>
                                }
                            </ul>
                        }
                        @if (!string.IsNullOrEmpty(Block.CopyrightText))
                        {
                            <p class="mt-8 text-xs text-gray-500 dark:text-gray-400">
                                @((MarkupString)Block.CopyrightText)
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </footer>
}

@code {
    [Parameter, EditorRequired]
    public Footer6Block? Block { get; set; }
}
