@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <EmptyContent2BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private EmptyContent2Block PreviewBlock => EmptyContent2BlockMapper.FromNode(Node);
}
