@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <EmptyContent3BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private EmptyContent3Block PreviewBlock => EmptyContent3BlockMapper.FromNode(Node);
}
