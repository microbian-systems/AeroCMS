@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <EmptyContent4BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private EmptyContent4Block PreviewBlock => EmptyContent4BlockMapper.FromNode(Node);
}
