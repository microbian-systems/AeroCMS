@* Empty Content 5 — HyperUI marketing/empty-content/5 *@
@* Source: hyperui/public/examples/marketing/empty-content/5.html + 5-dark.html *@
@using Aero.Cms.Ui.Hyper.Blocks.EmptyContent
@if (Block is not null)
{
    <div class="flex min-h-screen items-center justify-center p-6">
        <div class="max-w-md text-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="1.5" stroke="currentColor"
                 class="mx-auto size-20 text-gray-400 dark:text-gray-500">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
            </svg>

            <h2 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">@Block.Title</h2>

            <p class="mt-4 text-pretty text-gray-700 dark:text-gray-200">@Block.Description</p>

            <div class="mt-6 space-y-2">
                @if (!string.IsNullOrEmpty(Block.CtaText))
                {
                    <a href="@Block.CtaUrl"
                       class="block w-full rounded-lg bg-indigo-600 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-indigo-700">
                        @Block.CtaText
                    </a>
                }
                @if (!string.IsNullOrEmpty(Block.CtaText2))
                {
                    <a href="@Block.CtaUrl2"
                       class="block w-full rounded-lg border border-indigo-600 px-6 py-3 text-sm font-medium text-indigo-600 transition-colors hover:bg-indigo-50 dark:border-gray-800 dark:text-white dark:hover:bg-gray-800">
                        @Block.CtaText2
                    </a>
                }
            </div>

            @if (!string.IsNullOrEmpty(Block.StatusText))
            {
                <p class="mt-6 text-sm text-gray-700 dark:text-gray-200">
                    Last restocked: <span class="font-medium">3 weeks ago</span>
                </p>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public EmptyContent5Block? Block { get; set; }
}
