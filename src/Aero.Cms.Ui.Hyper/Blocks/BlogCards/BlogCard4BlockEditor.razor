<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Title</label>
        <input class="w-full rounded-xs shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.MainText"
               @oninput="e => Block.MainText = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Date</label>
        <input class="w-full rounded-xs shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.PublishedAt"
               @oninput="e => Block.PublishedAt = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Tags (comma separated)</label>
        <input class="w-full rounded-xs shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@TagsDisplay"
               @oninput="e => TagsDisplay = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Link URL</label>
        <input class="w-full rounded-xs shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@Block.CtaUrl"
               @oninput="e => Block.CtaUrl = e.Value?.ToString() ?? string.Empty" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public BlogCard4Block Block { get; set; } = default!;

    private string TagsDisplay
    {
        get => string.Join(", ", Block.Tags);
        set => Block.Tags = value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
    }
}
