@* Blog Card 7 — HyperUI marketing/blog-cards/7 *@
@* Source: hyperui/public/examples/marketing/blog-cards/7.html (light-only, no dark variant) *@
@if (Block is not null)
{
    <article class="relative overflow-hidden rounded-lg shadow-sm transition hover:shadow-lg">
        @if (!string.IsNullOrEmpty(Block.ImageUrl))
        {
            <img alt="" src="@Block.ImageUrl"
                 class="absolute inset-0 h-full w-full object-cover" />
        }

        <div class="relative bg-linear-to-t from-gray-900/50 to-gray-900/25 pt-32 sm:pt-48 lg:pt-64">
            <div class="p-4 sm:p-6">
                @if (!string.IsNullOrEmpty(Block.PublishedAt))
                {
                    <time datetime="2022-10-10" class="block text-xs text-white/90">
                        @Block.PublishedAt
                    </time>
                }

                <a href="@Block.CtaUrl">
                    <h3 class="mt-0.5 text-lg text-white">
                        @((MarkupString)Block.MainText)
                    </h3>
                </a>

                @if (!string.IsNullOrEmpty(Block.Description))
                {
                    <p class="mt-2 line-clamp-3 text-sm/relaxed text-white/95">
                        @((MarkupString)Block.Description)
                    </p>
                }
            </div>
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired]
    public BlogCard7Block? Block { get; set; }
}
