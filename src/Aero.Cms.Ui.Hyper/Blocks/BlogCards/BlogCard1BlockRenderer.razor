@* Blog Card 1 — HyperUI marketing/blog-cards/1 *@
@* Source: hyperui/public/examples/marketing/blog-cards/1.html + 1-dark.html *@
@if (Block is not null)
{
    <article class="overflow-hidden rounded-lg shadow-sm transition hover:shadow-lg dark:shadow-gray-700/25">
        @if (!string.IsNullOrEmpty(Block.ImageUrl))
        {
            <img alt="" src="@Block.ImageUrl" class="h-56 w-full object-cover" />
        }

        <div class="bg-white p-4 sm:p-6 dark:bg-gray-900">
            @if (!string.IsNullOrEmpty(Block.PublishedAt))
            {
                <time datetime="2022-10-10" class="block text-xs text-gray-500 dark:text-gray-400">
                    @Block.PublishedAt
                </time>
            }

            <a href="@Block.CtaUrl">
                <h3 class="mt-0.5 text-lg text-gray-900 dark:text-white">
                    @((MarkupString)Block.MainText)
                </h3>
            </a>

            @if (!string.IsNullOrEmpty(Block.Description))
            {
                <p class="mt-2 line-clamp-3 text-sm/relaxed text-gray-500 dark:text-gray-400">
                    @((MarkupString)Block.Description)
                </p>
            }
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired]
    public BlogCard1Block? Block { get; set; }
}
