@* Blog Card 2 — HyperUI marketing/blog-cards/2 *@
@* Source: hyperui/public/examples/marketing/blog-cards/2.html + 2-dark.html *@
@using Aero.Cms.Ui.Hyper.Blocks.BlogCards
@if (Block is not null)
{
    <article class="group">
        @if (!string.IsNullOrEmpty(Block.ImageUrl))
        {
            <img alt="" src="@Block.ImageUrl"
                 class="h-56 w-full rounded-xl object-cover shadow-xl transition group-hover:grayscale-50 dark:shadow-gray-700/25" />
        }

        <div class="p-4">
            <a href="@Block.CtaUrl">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">
                    @((MarkupString)Block.MainText)
                </h3>
            </a>

            @if (!string.IsNullOrEmpty(Block.Description))
            {
                <p class="mt-2 line-clamp-3 text-sm/relaxed text-gray-500 dark:text-gray-400">
                    @((MarkupString)Block.Description)
                </p>
            }
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired]
    public BlogCard2Block? Block { get; set; }
}
