@* Blog Card 3 — HyperUI marketing/blog-cards/3 *@
@* Source: hyperui/public/examples/marketing/blog-cards/3.html + 3-dark.html *@
@using Aero.Cms.Ui.Hyper.Blocks.BlogCards
@if (Block is not null)
{
    <article class="overflow-hidden rounded-lg border border-gray-100 bg-white shadow-xs dark:border-gray-800 dark:bg-gray-900 dark:shadow-gray-700/25">
        @if (!string.IsNullOrEmpty(Block.ImageUrl))
        {
            <img alt="" src="@Block.ImageUrl" class="h-56 w-full object-cover" />
        }

        <div class="p-4 sm:p-6">
            <a href="@Block.CtaUrl">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">
                    @((MarkupString)Block.MainText)
                </h3>
            </a>

            @if (!string.IsNullOrEmpty(Block.Description))
            {
                <p class="mt-2 line-clamp-3 text-sm/relaxed text-gray-500 dark:text-gray-400">
                    @((MarkupString)Block.Description)
                </p>
            }

            @if (!string.IsNullOrEmpty(Block.CtaText))
            {
                <a href="@Block.CtaUrl"
                   class="group mt-4 inline-flex items-center gap-1 text-sm font-medium text-blue-600">
                    @Block.CtaText
                    <span aria-hidden="true" class="block transition-all group-hover:ms-0.5 rtl:rotate-180">
                        &rarr;
                    </span>
                </a>
            }
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired]
    public BlogCard3Block? Block { get; set; }
}
