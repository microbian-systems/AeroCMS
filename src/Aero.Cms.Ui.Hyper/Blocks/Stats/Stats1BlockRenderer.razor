@using Aero.Cms.Ui.Hyper.Blocks.Stats
@* Stats 1 — HyperUI marketing/stats/1 *@
@* Source: hyperui/public/examples/marketing/stats/1.html + 1-dark.html *@
@if (Block is not null && Block.Stats.Count > 0)
{
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            @if (!string.IsNullOrEmpty(Block.Title))
            {
                <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl dark:text-white">@Block.Title</h2>
            }

            @if (!string.IsNullOrEmpty(Block.Description))
            {
                <p class="mt-4 text-gray-500 sm:text-xl dark:text-gray-400">@Block.Description</p>
            }
        </div>

        <dl class="mt-6 grid grid-cols-1 gap-4 sm:mt-8 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var stat in Block.Stats)
            {
                <div class="flex flex-col rounded-lg border border-gray-100 px-4 py-8 text-center dark:border-gray-800">
                    <dt class="order-last text-lg font-medium text-gray-500 dark:text-gray-400">@stat.Label</dt>
                    <dd class="text-4xl font-extrabold text-blue-600 md:text-5xl">@stat.Value</dd>
                </div>
            }
        </dl>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Stats1Block? Block { get; set; }
}
