@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <Banner2BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private Banner2Block PreviewBlock => Banner2BlockMapper.FromNode(Node);
}
