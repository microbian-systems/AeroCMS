@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-neo-preview">
    <Banner3BlockRenderer Block="PreviewBlock" />
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private Banner3Block PreviewBlock => Banner3BlockMapper.FromNode(Node);
}
