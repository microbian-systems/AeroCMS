@using Aero.Cms.Shared.Services
@using Aero.Cms.Abstractions.Interfaces
@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Cms.Abstractions.Models
@using Aero.Cms.Contracts.Services
@using Aero.Core
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject ManagerThemeService Theme
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ICurrentSiteAccessor CurrentSiteAccessor
@inject AdminStateContainer AdminState
@inject ISitesHttpClient SitesClient
@inject AppState AppState
@inject IJSRuntime JS
@inject ILogger<ManagerHeader> Logger

<header class="pe-header" id="aero-header">
    <div class="pe-header-left">
        <a href="/manager" class="pe-logo">
            <div class="pe-logo-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
            </div>
            <span class="pe-logo-text">AERO</span>
        </a>

        @* Switch Site button *@
        @if (currentSite is not null)
        {
            <button class="pe-btn pe-btn-ghost pe-btn-sm" title="Switch Site (Ctrl+Shift+S)" @onclick="OpenSitePickerAsync">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path></svg>
                <span>@currentSite.Name</span>
            </button>
        }

        <span class="text-xs text-gray-400 mx-1.5">|</span>

        <nav class="pe-nav">
            <div class="relative" @onclick:stopPropagation>
                <button class="flex items-center gap-2 pe-btn pe-btn-ghost pe-btn-sm font-semibold"
                        @onclick="ToggleNavDropdown">
                    @if (currentSite is not null)
                    {
                        <span>@currentSite.Name</span>
                        <span class="text-xs text-gray-400 font-mono">| @currentSite.Id</span>
                    }
                    else
                    {
                        <span class="text-gray-400">No site selected</span>
                    }
                    <svg class="w-4 h-4 transition-transform duration-150" 
                         style="transform: @(_showNavDropdown ? "rotate(180deg)" : "rotate(0deg)")"
                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>

                @if (_showNavDropdown)
                {
                    <div class="absolute left-0 top-full mt-1 w-56 rounded-2xl shadow-2xl py-2 z-50"
                         style="background: var(--pe-bg-secondary); border: 1px solid var(--pe-border);"
                         @onclick="DismissNavDropdown">
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager" Match="NavLinkMatch.All">Dashboard</NavLink>
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager/pages">Pages</NavLink>
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager/posts">Posts</NavLink>
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager/media">Media</NavLink>
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager/navigations">Navigations</NavLink>
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager/aliases">Aliases</NavLink>
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager/docs">Docs</NavLink>
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager/modules">Modules</NavLink>
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager/taxonomy/categories">Taxonomy</NavLink>
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager/users">Users</NavLink>
                        <NavLink class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium hover:bg-[var(--pe-bg-tertiary)] transition-colors" style="color: var(--pe-text-secondary);" href="/manager/seo">SEO</NavLink>
                    </div>
                }
            </div>
        </nav>
    </div>

    <div class="pe-header-right">
        <div class="relative" @onclick:stopPropagation>
            <button class="pe-btn pe-btn-ghost pe-btn-sm flex items-center gap-2"
                    @onclick="ToggleUserDropdown">
                <div class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs uppercase"
                     style="background: color-mix(in srgb, var(--pe-primary) 15%, transparent); color: var(--pe-primary);">
                    @GetUserInitials()
                </div>
                <span class="hidden sm:inline text-sm font-medium" style="color: var(--pe-text-primary);">@(AppState.UserNickname ?? AppState.UserName ?? "User")</span>
                <svg class="w-4 h-4 transition-transform duration-150" 
                     style="transform: @(_showUserDropdown ? "rotate(180deg)" : "rotate(0deg)")"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>

            @if (_showUserDropdown)
            {
                <div class="absolute right-0 top-full mt-1 w-56 rounded-2xl shadow-2xl py-2 z-50"
                     style="background: var(--pe-bg-secondary); border: 1px solid var(--pe-border);"
                     @onclick="DismissUserDropdown">
                    
                    @* User info header *@
                    <div class="px-4 py-3 border-b" style="border-bottom-color: var(--pe-border);">
                        <p class="text-sm font-semibold" style="color: var(--pe-text-primary);">@(AppState.UserNickname ?? AppState.UserName ?? "User")</p>
                        <p class="text-xs" style="color: var(--pe-text-muted);">@AppState.UserEmail</p>
                    </div>

                    @* Theme toggle *@
                    <button class="flex items-center gap-3 w-full px-4 py-2.5 text-sm font-medium transition-colors hover:bg-[var(--pe-bg-tertiary)]"
                            style="color: var(--pe-text-secondary);"
                            @onclick="Theme.ToggleThemeAsync">
                        @if (Theme.IsDarkMode)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="5"></circle>
                                <line x1="12" y1="1" x2="12" y2="3"></line>
                                <line x1="12" y1="21" x2="12" y2="23"></line>
                                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                <line x1="1" y1="12" x2="3" y2="12"></line>
                                <line x1="21" y1="12" x2="23" y2="12"></line>
                                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                            </svg>
                            <span>Light Mode</span>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                            <span>Dark Mode</span>
                        }
                    </button>

                    @* Separator *@
                    <div class="my-1 border-t" style="border-top-color: var(--pe-border);"></div>

                    @* Logout *@
                    <button class="flex items-center gap-3 w-full px-4 py-2.5 text-sm font-medium transition-colors hover:bg-[var(--pe-bg-tertiary)]"
                            style="color: var(--pe-text-secondary);"
                            @onclick="LogoutAsync">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        <span>Sign out</span>
                    </button>
                </div>
            }
        </div>
    </div>
</header>

@* Site Picker Modal *@
@if (_showSitePicker)
{
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm"
             @onclick="DismissSitePicker">
            <div class="rounded-3xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden"
                 style="background: var(--pe-bg-secondary); border: 1px solid var(--pe-border);"
                 @onclick:stopPropagation>
                <div class="px-6 py-5 flex items-center justify-between" style="border-bottom: 1px solid var(--pe-border);">
                    <h3 class="text-lg font-bold" style="color: var(--pe-text-primary);">Switch Site</h3>
                <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="DismissSitePicker">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            <div class="px-6 py-4 max-h-80 overflow-y-auto space-y-2">
                @if (_loadingSites)
                {
                    <p class="text-sm text-center py-8" style="color: var(--pe-text-muted);">Loading sites...</p>
                }
                else if (_availableSites is null || _availableSites.Count == 0)
                {
                    <p class="text-sm text-center py-8" style="color: var(--pe-text-muted);">No sites available.</p>
                }
                else
                {
                    @foreach (var site in _availableSites)
                    {
                        var isActive = currentSite?.Id == site.Id;
                        <button class="w-full flex items-center gap-4 px-4 py-3 rounded-2xl text-left transition-all duration-150 hover:bg-[var(--pe-bg-hover)]"
                                style="@(isActive
                                    ? $"background: color-mix(in srgb, var(--pe-primary) 12%, transparent); border: 1px solid color-mix(in srgb, var(--pe-primary) 30%, transparent)"
                                    : $"background: var(--pe-bg-tertiary); border: 1px solid transparent")"
                                @onclick="() => SelectSiteAsync(site)">
                            <div class="flex-1 min-w-0">
                                <p class="font-semibold text-sm truncate" style="color: var(--pe-text-primary);">@site.Name</p>
                                <p class="text-xs truncate mt-0.5" style="color: var(--pe-text-muted);">@site.PrimaryHost</p>
                            </div>
                            @if (isActive)
                            {
                                <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--pe-primary);">Active</span>
                            }
                            else
                            {
                                <span class="text-xs font-medium" style="color: var(--pe-text-muted);">Switch</span>
                            }
                        </button>
                    }
                }
            </div>
                <div class="px-6 py-3 border-t text-center" style="border-top-color: var(--pe-border);">
                <a href="/manager/sites" class="text-xs hover:underline" style="color: var(--pe-primary);"
                   @onclick="DismissSitePicker">Manage sites</a>
            </div>
        </div>
    </div>
}

@code {
    private Aero.Cms.Abstractions.Models.SiteViewModel? currentSite;
    private bool _showSitePicker;
    private bool _showNavDropdown;
    private bool _showUserDropdown;
    private bool _loadingSites;
    private IReadOnlyList<SiteViewModel>? _availableSites;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ManagerHeader>? _dotNetRef;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        CurrentSiteAccessor.SiteChanged += OnSiteChanged;

        // Read from AdminStateContainer first (in-memory/localStorage), fall back to cookie API
        if (AdminState.CurrentSiteId.HasValue)
        {
            // State is already hydrated — construct a minimal SiteViewModel from cached values
            currentSite = new SiteViewModel
            {
                Id = AdminState.CurrentSiteId.Value,
                Name = AdminState.CurrentSiteName ?? "Site"
            };
        }
        else
        {
            try
            {
                currentSite = await CurrentSiteAccessor.GetCurrentSiteAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load current site for header display");
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Aero.Cms.Shared/Layout/ManagerHeader.razor.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerKeyboardShortcut", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task OnKeyboardShortcut()
    {
        if (_disposed) return;
        await ShowSitePickerAsync();
    }

    private async Task ShowSitePickerAsync()
    {
        if (_loadingSites) return;
        _showSitePicker = true;
        StateHasChanged();

        // Always fetch fresh site list (no caching — short TTL if needed)
        _loadingSites = true;
        try
        {
            var result = await SitesClient.GetAllAsync();
            if (result is Result<IReadOnlyList<SiteViewModel>, AeroError>.Ok ok)
                _availableSites = ok.Value;
            else
                _availableSites = [];
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load sites for manager site picker");
            _availableSites = [];
        }
        finally
        {
            _loadingSites = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleNavDropdown()
    {
        _showNavDropdown = !_showNavDropdown;
    }

    private void DismissNavDropdown()
    {
        _showNavDropdown = false;
    }

    private void ToggleUserDropdown()
    {
        _showUserDropdown = !_showUserDropdown;
    }

    private void DismissUserDropdown()
    {
        _showUserDropdown = false;
    }

    private string GetUserInitials()
    {
        var name = AppState.UserNickname ?? AppState.UserName;
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private void DismissSitePicker()
    {
        _showSitePicker = false;
    }

    private async Task SelectSiteAsync(SiteViewModel site)
    {
        await CurrentSiteAccessor.SetCurrentSiteAsync(site.Id);
        AdminState.SetSite(site.Id, site.Name ?? "Default Site");
        currentSite = site;
        _showSitePicker = false;
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async void OnSiteChanged()
    {
        try
        {
            // Read from AdminState (in-memory) instead of making an HTTP call
            if (AdminState.CurrentSiteId.HasValue)
            {
                currentSite = new SiteViewModel
                {
                    Id = AdminState.CurrentSiteId.Value,
                    Name = AdminState.CurrentSiteName ?? "Site"
                };
            }
            else
            {
                currentSite = await CurrentSiteAccessor.GetCurrentSiteAsync();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task OpenSitePickerAsync()
    {
        await ShowSitePickerAsync();
    }

    private async Task LogoutAsync()
    {
        try
        {
            await Http.PostAsync("api/v1/admin/auth/logout", content: null);
        }
        finally
        {
            Navigation.NavigateTo("/manager/login", forceLoad: true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        CurrentSiteAccessor.SiteChanged -= OnSiteChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregisterKeyboardShortcut");
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }

            _dotNetRef?.Dispose();
            await _module.DisposeAsync();
        }
    }
}
