@using Aero.Cms.Shared.Services
@using Aero.Cms.Abstractions.Interfaces
@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Cms.Abstractions.Models
@using Aero.Core
@using Aero.Core.Railway
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ManagerThemeService Theme
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ICurrentSiteAccessor CurrentSiteAccessor
@inject AdminStateContainer AdminState
@inject ISitesHttpClient SitesClient
@inject IJSRuntime JS
@inject ILogger<ManagerHeader> Logger

<header class="pe-header" id="aero-header">
    <div class="pe-header-left">
        <a href="/manager" class="pe-logo">
            <div class="pe-logo-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
            </div>
            <span class="pe-logo-text">AERO</span>
        </a>

        <nav class="pe-nav">
            <NavLink class="pe-nav-link" href="/manager" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink class="pe-nav-link" href="/manager/pages">Pages</NavLink>
            <NavLink class="pe-nav-link" href="/manager/posts">Posts</NavLink>
            <NavLink class="pe-nav-link" href="/manager/media">Media</NavLink>
            <NavLink class="pe-nav-link" href="/manager/navigations">Navigations</NavLink>
            <NavLink class="pe-nav-link" href="/manager/aliases">Aliases</NavLink>
            <NavLink class="pe-nav-link" href="/manager/docs">Docs</NavLink>
            <NavLink class="pe-nav-link" href="/manager/modules">Modules</NavLink>
            <NavLink class="pe-nav-link" href="/manager/taxonomy/categories">Taxonomy</NavLink>
            <NavLink class="pe-nav-link" href="/manager/users">Users</NavLink>
            <NavLink class="pe-nav-link" href="/manager/seo">SEO</NavLink>
        </nav>
    </div>

    <div class="pe-header-right">
        @* Current Site indicator *@
        @if (currentSite is not null)
        {
            <button class="pe-btn pe-btn-ghost pe-btn-sm" title="Switch Site (Ctrl+Shift+S)" @onclick="OpenSitePickerAsync">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path></svg>
                <span>@currentSite.Name</span>
            </button>
        }

        <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="Theme.ToggleThemeAsync" title="Toggle Light/Dark Mode">
            @if (Theme.IsDarkMode)
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
            }
            else
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            }
        </button>
        
        <div class="pe-user-profile">
            <button class="pe-btn pe-btn-ghost pe-btn-sm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span>Account</span>
            </button>
            <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="LogoutAsync">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                <span>Logout</span>
            </button>
        </div>
    </div>
</header>

@* Site Picker Modal *@
@if (_showSitePicker)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm"
         @onclick="DismissSitePicker">
        <div class="bg-white dark:bg-gray-900 rounded-3xl shadow-2xl border border-gray-100 dark:border-gray-800 w-full max-w-lg mx-4 overflow-hidden"
             @onclick:stopPropagation>
            <div class="px-6 py-5 border-b border-gray-100 dark:border-gray-800 flex items-center justify-between">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">Switch Site</h3>
                <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="DismissSitePicker">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            <div class="px-6 py-4 max-h-80 overflow-y-auto space-y-2">
                @if (_availableSites is null || _availableSites.Count == 0)
                {
                    <p class="text-sm text-gray-500 text-center py-8">No sites available.</p>
                }
                else
                {
                    @foreach (var site in _availableSites)
                    {
                        <button class="w-full flex items-center gap-4 px-4 py-3 rounded-2xl text-left transition-all duration-150
                                     @(currentSite?.Id == site.Id
                                         ? "bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-200 dark:border-indigo-800"
                                         : "bg-gray-50 dark:bg-gray-800/50 hover:bg-gray-100 dark:hover:bg-gray-800 border border-transparent")"
                                @onclick="() => SelectSiteAsync(site)">
                            <div class="flex-1 min-w-0">
                                <p class="font-semibold text-sm text-gray-900 dark:text-white truncate">@site.Name</p>
                                <p class="text-xs text-gray-500 truncate mt-0.5">@site.PrimaryHost</p>
                            </div>
                            @if (currentSite?.Id == site.Id)
                            {
                                <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">Active</span>
                            }
                            else
                            {
                                <span class="text-xs font-medium text-gray-400 dark:text-gray-500">Switch</span>
                            }
                        </button>
                    }
                }
            </div>
            <div class="px-6 py-3 border-t border-gray-100 dark:border-gray-800 text-center">
                <a href="/manager/sites" class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline"
                   @onclick="DismissSitePicker">Manage sites</a>
            </div>
        </div>
    </div>
}

@code {
    private Aero.Cms.Abstractions.Models.SiteViewModel? currentSite;
    private bool _showSitePicker;
    private bool _loadingSites;
    private IReadOnlyList<SiteViewModel>? _availableSites;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ManagerHeader>? _dotNetRef;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        CurrentSiteAccessor.SiteChanged += OnSiteChanged;
        try
        {
            currentSite = await CurrentSiteAccessor.GetCurrentSiteAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load current site for header display");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Aero.Cms.Shared/Layout/ManagerHeader.razor.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerKeyboardShortcut", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task OnKeyboardShortcut()
    {
        if (_disposed) return;
        await ShowSitePickerAsync();
    }

    private async Task ShowSitePickerAsync()
    {
        if (_loadingSites) return;
        _showSitePicker = true;
        StateHasChanged();

        if (_availableSites is null)
        {
            _loadingSites = true;
            try
            {
                var result = await SitesClient.GetAllAsync();
                if (result is Result<IReadOnlyList<SiteViewModel>, AeroError>.Ok ok)
                    _availableSites = ok.Value;
            }
            finally
            {
                _loadingSites = false;
            }
        }
    }

    private void DismissSitePicker()
    {
        _showSitePicker = false;
    }

    private async Task SelectSiteAsync(SiteViewModel site)
    {
        await CurrentSiteAccessor.SetCurrentSiteAsync(site.Id);
        AdminState.SetSite(site.Id, site.Name ?? "Default Site");
        currentSite = site;
        _showSitePicker = false;
    }

    private async void OnSiteChanged()
    {
        try
        {
            currentSite = await CurrentSiteAccessor.GetCurrentSiteAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task OpenSitePickerAsync()
    {
        await ShowSitePickerAsync();
    }

    private async Task LogoutAsync()
    {
        try
        {
            await Http.PostAsync("api/v1/admin/auth/logout", content: null);
        }
        finally
        {
            Navigation.NavigateTo("/manager/login", forceLoad: true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        CurrentSiteAccessor.SiteChanged -= OnSiteChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregisterKeyboardShortcut");
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }

            _dotNetRef?.Dispose();
            await _module.DisposeAsync();
        }
    }
}
