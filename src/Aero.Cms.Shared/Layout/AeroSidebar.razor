<aside class="pe-sidebar @(Side == SidebarSide.Right ? "pe-sidebar-right" : "") @(IsResizable ? "pe-sidebar-resizable" : "") @(IsCollapsed ? "collapsed" : "")"
       style="@SidebarStyle">
    <div class="pe-sidebar-header">
        @if (Side == SidebarSide.Left)
        {
            <button class="pe-collapse-btn" @onclick="Toggle" title="Toggle Sidebar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
        }
        
        @if (!IsCollapsed)
        {
            <span class="pe-sidebar-title">@Title</span>
        }

        @if (Side == SidebarSide.Right)
        {
            @if (IsResizable && !IsCollapsed)
            {
                <button class="pe-sidebar-width-btn"
                        type="button"
                        aria-pressed="@IsWidthExpanded"
                        title="@(IsWidthExpanded ? "Restore sidebar width" : "Expand sidebar width")"
                        @onclick="ToggleWidth">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="8 3 3 3 3 8"></polyline>
                        <line x1="3" y1="3" x2="9" y2="9"></line>
                        <polyline points="16 21 21 21 21 16"></polyline>
                        <line x1="15" y1="15" x2="21" y2="21"></line>
                    </svg>
                </button>
            }
            <button class="pe-collapse-btn" @onclick="Toggle" title="Toggle Sidebar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
        }
    </div>
    <div class="pe-sidebar-content">
        <CascadingValue Value="IsCollapsed">
            @ChildContent
        </CascadingValue>
    </div>
</aside>

@code {
    [Parameter] public string Title { get; set; } = "Navigation";
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public SidebarSide Side { get; set; } = SidebarSide.Left;
    [Parameter] public EventCallback<bool> IsCollapsedChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsResizable { get; set; }
    [Parameter] public int DefaultWidth { get; set; } = 260;
    [Parameter] public int ExpandedWidth { get; set; } = 460;
    [Parameter] public int MinimumWidth { get; set; } = 260;
    [Parameter] public int MaximumWidth { get; set; } = 640;

    private bool IsWidthExpanded { get; set; }

    private string? SidebarStyle => IsResizable
        ? $"--pe-sidebar-expanded-w: {(IsWidthExpanded ? ExpandedWidth : DefaultWidth)}px; "
          + $"--pe-sidebar-min-w: {MinimumWidth}px; --pe-sidebar-max-w: {MaximumWidth}px;"
        : null;

    private async Task Toggle()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }

    private void ToggleWidth() => IsWidthExpanded = !IsWidthExpanded;
}
