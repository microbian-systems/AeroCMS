@inherits LayoutComponentBase
@using Aero.Cms.Shared.Services
@using Aero.Cms.Shared.Layout
@using Aero.Cms.Contracts.Abstractions
@using Aero.Cms.Contracts.Models
@using Aero.Core
@using Aero.Core.Railway
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using System.Security.Claims
@using Aero.Cms.Contracts.Services
@inject ManagerThemeService ThemeService
@inject NavigationManager Navigation
@inject ICurrentSiteAccessor CurrentSiteAccessor
@inject AdminStateContainer AdminState
@inject AppState AppState
@inject ISitesHttpClient SitesClient
@implements IDisposable

<div class="pe-root" data-theme="@ThemeService.Theme">
    <ManagerHeader />

    @switch (shellState)
    {
        case ShellState.AuthPending:
            @Body
            break;

        case ShellState.Unauthenticated:
            @* Redirect handled in OnAfterRenderAsync *@
            break;

        case ShellState.SiteResolving:
            <div class="pe-editor-area flex items-center justify-center min-h-screen">
                <span class="text-sm text-gray-500">Loading site context...</span>
            </div>
            break;

        case ShellState.Ready:
            <div class="pe-main-layout">
                <AeroSidebar Title="Menu"
                             Side="SidebarSide.Left"
                             IsCollapsed="@ThemeService.IsSidebarCollapsed"
                             IsCollapsedChanged="@(async (c) => ThemeService.ToggleSidebar())">
                    <NavMenu IsCollapsed="@ThemeService.IsSidebarCollapsed" />
                </AeroSidebar>

                <div class="pe-editor-area">
                    @Body
                </div>

                <SectionOutlet SectionName="RightSidebar" />
            </div>
            break;
    }
</div>

<RadzenComponents />

@code {
    private enum ShellState { AuthPending, Unauthenticated, SiteResolving, Ready }

    private ShellState shellState = ShellState.AuthPending;
    private string? redirectTarget;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (relative.StartsWith("manager/login", StringComparison.OrdinalIgnoreCase) ||
            relative.StartsWith("manager/select-site", StringComparison.OrdinalIgnoreCase))
        {
            shellState = ShellState.Ready;
            return;
        }

        // Hydrate client-side state container on first load
        if (!AdminState.IsInitialized)
        {
            AdminState.LoadFromStorage();
        }

        shellState = ShellState.AuthPending;

        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                shellState = ShellState.Unauthenticated;
                redirectTarget = BuildLoginRedirectUrl(relative);
                return;
            }

            // Auth confirmed — set user info on AppState
            SetUserFromAuthState(authState);

            // Auth confirmed — resolve site context
            shellState = ShellState.SiteResolving;
            var siteId = AdminState.CurrentSiteId
                ?? await CurrentSiteAccessor.GetCurrentSiteIdAsync();

            if (AdminState.CurrentSiteId.HasValue)
            {
                await CurrentSiteAccessor.SetCurrentSiteAsync(AdminState.CurrentSiteId.Value);
            }

            // Final fallback: call the default site API (creates one if needed)
            if (siteId is null)
            {
                siteId = await TryGetDefaultSiteAsync();
            }

            if (siteId is null)
            {
                redirectTarget = "/manager/select-site";
                return;
            }

            // Set site on AppState
            AppState.SetSite(siteId.Value, AdminState.CurrentSiteName);

            shellState = ShellState.Ready;
            return;
        }

        // No cascading auth state available
        shellState = ShellState.Unauthenticated;
        redirectTarget = BuildLoginRedirectUrl(relative);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrWhiteSpace(redirectTarget))
        {
            Navigation.NavigateTo(redirectTarget, forceLoad: true);
        }

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }

    private static string BuildLoginRedirectUrl(string relative)
    {
        return string.IsNullOrWhiteSpace(relative) || relative.Equals("manager", StringComparison.OrdinalIgnoreCase)
            ? "/manager/login?returnUrl=%2Fmanager"
            : $"/manager/login?returnUrl={Uri.EscapeDataString("/" + relative)}";
    }

    private void SetUserFromAuthState(AuthenticationState authState)
    {
        var principal = authState.User;
        var userIdStr = principal.FindFirst("user_id")?.Value;
        var userName = principal.FindFirst(ClaimTypes.Name)?.Value;
        var email = principal.FindFirst(ClaimTypes.Email)?.Value;
        var nickname = principal.FindFirst("nickname")?.Value;
        var roles = principal.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
        var isAdmin = principal.HasClaim("is_admin", "true");

        if (userIdStr is not null && long.TryParse(userIdStr, out var userId))
        {
            AppState.SetUser(userId, userName ?? "", email, nickname, roles, isAdmin);

            // Load per-site permissions from claims
            var permValues = principal.FindAll("permission").Select(c => c.Value).ToList();
            AppState.LoadPermissions(permValues);
        }
        else
        {
            AppState.ClearUser();
        }
    }

    private async Task<long?> TryGetDefaultSiteAsync()
    {
        try
        {
            var result = await SitesClient.GetDefaultAsync();
            if (result is Result<SiteInfo, AeroError>.Ok ok)
            {
                AdminState.SetSite(ok.Value.Id, ok.Value.Name ?? "Default Site");
                // Also set the server-side cookie so DefaultSiteContext picks it up
                await CurrentSiteAccessor.SetCurrentSiteAsync(ok.Value.Id);
                return ok.Value.Id;
            }
        }
        catch { }
        return null;
    }
}
