@inherits LayoutComponentBase
@using Aero.Cms.Shared.Services
@using Aero.Cms.Shared.Layout
@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Cms.Abstractions.Models
@using Aero.Core
@using Aero.Core.Railway
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using Aero.Cms.Abstractions.Interfaces
@inject ManagerThemeService ThemeService
@inject NavigationManager Navigation
@inject ICurrentSiteAccessor CurrentSiteAccessor
@inject AdminStateContainer AdminState
@inject ISitesHttpClient SitesClient
@implements IDisposable

<div class="pe-root" data-theme="@ThemeService.Theme">
    <ManagerHeader />
    
    <div class="pe-main-layout">
        <AeroSidebar Title="Menu" 
                     Side="SidebarSide.Left" 
                     IsCollapsed="@ThemeService.IsSidebarCollapsed"
                     IsCollapsedChanged="@(async (c) => ThemeService.ToggleSidebar())">
            <NavMenu IsCollapsed="@ThemeService.IsSidebarCollapsed" />
        </AeroSidebar>

        <div class="pe-editor-area">
            @Body
        </div>

        <SectionOutlet SectionName="RightSidebar" />
    </div>
</div>

<RadzenComponents />

@code {
    private string? redirectTarget;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (relative.StartsWith("manager/login", StringComparison.OrdinalIgnoreCase) ||
            relative.StartsWith("manager/select-site", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // Hydrate client-side state container on first load
        if (!AdminState.IsInitialized)
        {
            AdminState.LoadFromStorage();
        }

        // Skip redirect if user is already authenticated (cookie present)
        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // After auth, check if a site has been selected
                // Try in-memory state first, then fall back to HTTP cookie call
                var siteId = AdminState.CurrentSiteId
                    ?? await CurrentSiteAccessor.GetCurrentSiteIdAsync();

                // Final fallback: call the default site API (creates one if needed)
                if (siteId is null)
                {
                    siteId = await TryGetDefaultSiteAsync();
                }

                if (siteId is null)
                {
                    redirectTarget = "/manager/select-site";
                    return;
                }
                return;
            }
        }

        redirectTarget = string.IsNullOrWhiteSpace(relative) || relative.Equals("manager", StringComparison.OrdinalIgnoreCase)
            ? "/manager/login?returnUrl=%2Fmanager"
            : $"/manager/login?returnUrl={Uri.EscapeDataString("/" + relative)}";
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(redirectTarget))
        {
            Navigation.NavigateTo(redirectTarget, forceLoad: true);
        }

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }

    private async Task<long?> TryGetDefaultSiteAsync()
    {
        try
        {
            var result = await SitesClient.GetDefaultAsync();
            if (result is Result<SiteViewModel, AeroError>.Ok ok)
            {
                AdminState.SetSite(ok.Value.Id, ok.Value.Name ?? "Default Site");
                return ok.Value.Id;
            }
        }
        catch { }
        return null;
    }
}
