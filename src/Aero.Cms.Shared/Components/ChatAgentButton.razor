@* Floating chat agent button that toggles a chat panel placeholder *@

<div class="fixed bottom-6 right-6 z-50">
    @if (IsOpen)
    {
        <div class="absolute bottom-16 right-0 w-80 max-h-[28rem] bg-white rounded-2xl shadow-2xl border border-gray-200 flex flex-col overflow-hidden">
            @* Chat header *@
            <div class="bg-gray-900 text-white px-4 py-3 flex items-center gap-3">
                <img src="@LogoUrl" alt="Aero" class="w-8 h-8 rounded-full" />
                <span class="font-medium text-sm">Aero Chat Agent</span>
                <button @onclick="ToggleChat" class="ml-auto p-1 hover:bg-gray-700 rounded-full transition-colors" aria-label="Close">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @* Chat body - placeholder *@
            <div class="flex-1 p-6 flex flex-col items-center justify-center text-gray-400 text-sm gap-3 min-h-[12rem]">
                <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
                <span>Chat agent coming soon...</span>
            </div>

            @* Chat input - placeholder *@
            <div class="border-t border-gray-200 p-3">
                <div class="flex gap-2">
                    <input type="text" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-400 focus:border-gray-400" placeholder="Type a message..." disabled />
                    <button class="px-3 py-2 bg-gray-100 rounded-lg text-gray-400 cursor-not-allowed" disabled aria-label="Send">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    }

    @* Floating action button *@
    <button @onclick="ToggleChat"
            class="w-14 h-14 rounded-full bg-gray-900 hover:bg-gray-800 shadow-lg flex items-center justify-center transition-all hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
            aria-label="Toggle chat agent">
        @if (IsOpen)
        {
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        }
        else
        {
            <img src="@LogoUrl" alt="Chat" class="w-9 h-9 rounded-full" />
        }
    </button>
</div>

@code {
    /// <summary>
    /// The URL for the logo image displayed on the chat button and header.
    /// Defaults to the Aero logo served from the shared library's static assets.
    /// </summary>
    [Parameter]
    public string LogoUrl { get; set; } = "/img/Aero.png";

    private bool IsOpen { get; set; }

    private void ToggleChat()
    {
        IsOpen = !IsOpen;
    }
}
