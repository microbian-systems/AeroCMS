@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Core.Railway
@inject IPagesHttpClient PagesApi
@inject NavigationManager Navigation
@inject Radzen.DialogService DialogService
@inject Radzen.ContextMenuService ContextMenuService
@inject Radzen.NotificationService NotificationService

<RadzenDataGrid TItem="PageTreeItem"
                Data="@_rootNodes"
                AllowRowSelectOnRowClick="true"
                RowClick="@OnRowClick"
                AllowColumnResize="true"
                RowRender="@RowRender"
                LoadChildData="@LoadChildData"
                CellContextMenu="@OnCellContextMenu"
                style="max-height: 70vh; overflow-y: auto;">
    <Columns>
        @* Checkbox column — multi-select *@
        <RadzenDataGridColumn TItem="PageTreeItem" Title="" Width="48px" Filterable="false" Sortable="false">
            <HeaderTemplate>
                <input type="checkbox"
                       @onchange="ToggleSelectAll"
                       checked="@AreAllVisibleSelected()"
                       @onclick:stopPropagation="true"
                       class="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" />
            </HeaderTemplate>
            <Template Context="node">
                <input type="checkbox"
                       checked="@_selectedIds.Contains(node.Id)"
                       @onchange="() => ToggleSelection(node.Id)"
                       @onclick:stopPropagation="true"
                       class="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" />
            </Template>
        </RadzenDataGridColumn>

        @* Icon / preview column *@
        <RadzenDataGridColumn TItem="PageTreeItem" Title="" Width="50px" Sortable="false">
            <Template Context="node">
                <button @onclick="() => PreviewAsync(node)" @onclick:stopPropagation="true"
                        class="hover:opacity-70 cursor-pointer border-0 bg-transparent p-0"
                        title="Preview page">
                    @if (node.HasChildren)
                    { <RadzenIcon Icon="folder_open" class="text-yellow-500" /> }
                    else
                    { <RadzenIcon Icon="description" class="text-gray-400" /> }
                </button>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="PageTreeItem" Property="@nameof(PageTreeItem.Title)" Title="Title" Width="250px" Sortable="true" />
        <RadzenDataGridColumn TItem="PageTreeItem" Property="@nameof(PageTreeItem.Slug)" Title="Slug" Width="180px" Sortable="true" />
        <RadzenDataGridColumn TItem="PageTreeItem" Title="Path" Width="300px" Sortable="true">
            <Template Context="node">
                <span class="text-gray-500 text-sm font-mono">@node.Path</span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PageTreeItem" Property="@nameof(PageTreeItem.PublicationState)" Title="Status" Width="110px" Sortable="true">
            <Template Context="node">
                <RadzenBadge Text="@node.PublicationState" BadgeStyle="@GetBadgeStyle(node.PublicationState)" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PageTreeItem" Property="@nameof(PageTreeItem.Depth)" Title="Depth" Width="70px" Sortable="true" />
        <RadzenDataGridColumn TItem="PageTreeItem" Title="Hidden" Width="70px" Sortable="true">
            <Template Context="node">
                @if (node.IsHidden)
                { <RadzenIcon Icon="visibility_off" class="text-gray-400" /> }
                else
                { <RadzenIcon Icon="visibility" class="text-green-500" /> }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PageTreeItem" Title="Actions" Width="170px" Sortable="false">
            <Template Context="node">
                <div class="flex gap-1">
                    <RadzenButton Icon="control_point" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => AddChildAsync(node))" Title="Add child page" />
                    <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => EditAsync(node))" />
                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => ConfirmDeleteAsync(node))" />
                </div>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@* Bulk delete bar *@
@if (_selectedIds.Count > 0)
{
    <div class="flex items-center gap-3 justify-end mt-3">
        <span style="color: var(--pe-text-muted);">@_selectedIds.Count selected</span>
        <RadzenButton Icon="delete" Text="Delete Selected"
                      ButtonStyle="ButtonStyle.Danger"
                      Variant="Variant.Outlined"
                      class="rounded-xl px-6 font-bold text-xs"
                      Click="@DeleteSelectedAsync" />
    </div>
}

@code {
    private List<PageTreeItem> _rootNodes = [];
    private string? _error;
    private HashSet<long> _selectedIds = [];

    /// <summary>
    /// Optional callback: when the icon column is clicked, fires so
    /// the parent page can show a preview overlay instead of navigating.
    /// </summary>
    [Parameter] public EventCallback<PageTreeItem> OnPreview { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadRootsAsync();
    }

    private async Task LoadRootsAsync()
    {
        _error = null;
        _selectedIds.Clear();
        try
        {
            var result = await PagesApi.GetChildrenAsync(parentId: null);
            _rootNodes = result is Result<IReadOnlyList<PageTreeItem>, AeroError>.Ok ok
                ? ok.Value.ToList()
                : [];
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task LoadChildData(DataGridLoadChildDataEventArgs<PageTreeItem> args)
    {
        try
        {
            var result = await PagesApi.GetChildrenAsync(args.Item!.Id);
            args.Data = result is Result<IReadOnlyList<PageTreeItem>, AeroError>.Ok ok
                ? ok.Value.ToList()
                : [];
        }
        catch { /* children silently fail */ }
    }

    private static void RowRender(RowRenderEventArgs<PageTreeItem> args)
    {
        args.Expandable = args.Data.HasChildren;
    }

    private static Radzen.BadgeStyle GetBadgeStyle(string state) => state switch
    {
        "Published" => Radzen.BadgeStyle.Success,
        "Draft" => Radzen.BadgeStyle.Secondary,
        "Archived" => Radzen.BadgeStyle.Dark,
        "InReview" => Radzen.BadgeStyle.Warning,
        "Scheduled" => Radzen.BadgeStyle.Info,
        _ => Radzen.BadgeStyle.Light
    };

    // ── Selection ──────────────────────────────────────────────────

    private bool AreAllVisibleSelected()
    {
        return _rootNodes.Count > 0 && _rootNodes.All(n => _selectedIds.Contains(n.Id));
    }

    private void ToggleSelection(long id)
    {
        if (_selectedIds.Contains(id))
            _selectedIds.Remove(id);
        else
            _selectedIds.Add(id);
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        if (args.Value is bool isChecked && isChecked)
        {
            foreach (var node in _rootNodes)
                _selectedIds.Add(node.Id);
        }
        else
        {
            _selectedIds.Clear();
        }
    }

    // ── Inline row actions ────────────────────────────────────────

    private async Task PreviewAsync(PageTreeItem node)
    {
        if (OnPreview.HasDelegate)
            await OnPreview.InvokeAsync(node);
        else
            Navigation.NavigateTo($"/manager/page/editor/{node.Id}");
    }

    private void EditAsync(PageTreeItem node)
    {
        Navigation.NavigateTo($"/manager/page/editor/{node.Id}");
    }

    private void AddChildAsync(PageTreeItem node)
    {
        Navigation.NavigateTo($"/manager/page/editor?parentId={node.Id}");
    }

    private void OnRowClick(DataGridRowMouseEventArgs<PageTreeItem> args)
    {
        if (args.Data is not null)
            Navigation.NavigateTo($"/manager/page/editor/{args.Data.Id}");
    }

    // ── Delete (with cascade support) ─────────────────────────────

    private async Task ConfirmDeleteAsync(PageTreeItem node)
    {
        if (node.HasChildren)
        {
            var choice = await DialogService.OpenAsync<CascadeDeleteDialog>(
                "Delete page",
                new Dictionary<string, object>
                {
                    ["Title"] = node.Title
                },
                new DialogOptions { Width = "520px", CloseDialogOnOverlayClick = false });

            if (choice is null or false) return;

            var action = choice?.ToString();
            if (action == "delete")
            {
                var result = await PagesApi.DeleteCascadeAsync(node.Id);
                if (result is Result<bool, AeroError>.Ok)
                    NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"Page '{node.Title}' and its descendants removed.");
                else
                    NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to delete page.");
            }
            else if (action == "unpublish")
            {
                var result = await PagesApi.UnpublishAsync(node.Id);
                if (result is Result<PageDetail, AeroError>.Ok)
                    NotificationService.Notify(NotificationSeverity.Success, "Draft", $"Page '{node.Title}' converted to draft. Children preserved.");
                else
                    NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to update page.");
            }
            await LoadRootsAsync();
        }
        else
        {
            var confirmed = await DialogService.Confirm(
                $"Delete page '{node.Title}'?", "Confirm Delete",
                new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
            if (confirmed == true)
            {
                await PagesApi.DeleteAsync(node.Id);
                await LoadRootsAsync();
            }
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selectedIds.Count == 0) return;

        var confirm = await DialogService.Confirm(
            $"Are you sure you want to delete {_selectedIds.Count} page(s)? This action cannot be undone.",
            "Delete Pages",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirm != true) return;

        var ids = _selectedIds.ToList();
        var result = await PagesApi.DeleteMultipleAsync(ids, deleteDescendants: false);

        if (result is Result<int, AeroError>.Ok ok)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"{ok.Value} page(s) removed.");
            _selectedIds.Clear();
            await LoadRootsAsync();
        }
        else if (result is Result<int, AeroError>.Failure f)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Delete Failed", f.Error.ToString());
        }
    }

    // ── Right-click context menu ──────────────────────────────────

    private void OnCellContextMenu(DataGridCellMouseEventArgs<PageTreeItem> args)
    {
        if (args.Data is null) return;

        ContextMenuService.Open(args,
        [
            new() { Text = "Edit", Value = "edit", Icon = "edit" },
            new() { Text = "Add child page", Value = "add-child", Icon = "control_point" },
            new() { Text = "Delete", Value = "delete", Icon = "delete" },
        ],
        (item) =>
        {
            var node = args.Data;
            switch (item.Value as string)
            {
                case "edit":
                    Navigation.NavigateTo($"/manager/page/editor/{node.Id}");
                    break;
                case "add-child":
                    Navigation.NavigateTo($"/manager/page/editor?parentId={node.Id}");
                    break;
                case "delete":
                    _ = ConfirmDeleteAsync(node);
                    break;
            }
        });
    }
}
