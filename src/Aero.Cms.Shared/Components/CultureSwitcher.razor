@if (Links.Count > 1)
{
    <nav class="@CssClass" aria-label="Language">
        <div class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white p-1 text-sm shadow-sm">
            @foreach (var link in Links)
            {
                if (link.IsActive)
                {
                    <span class="rounded px-2.5 py-1 font-semibold text-slate-950"
                          aria-current="true">
                        @link.Label
                    </span>
                }
                else
                {
                    <a class="rounded px-2.5 py-1 font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-slate-400"
                       href="@link.Href"
                       hreflang="@link.Hreflang">
                        @link.Label
                    </a>
                }
            }
        </div>
    </nav>
}
