@using Aero.Cms.Abstractions.Blocks.Common

@if (Block is not null)
{
    var hasHeaderImage = !string.IsNullOrEmpty(Block.BackgroundImageUrl);
    var headerStyle = hasHeaderImage
        ? $"background-image: linear-gradient(rgba(15, 23, 42, 0.6), rgba(15, 23, 42, 0.6)), url('{Block.BackgroundImageUrl}'); background-size: cover; background-position: center;"
        : "background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);";
    var headerTextClass = hasHeaderImage ? "text-white" : "text-slate-900";
    var subTextClass = hasHeaderImage ? "text-slate-200" : "text-slate-600";
    var fullWidthClass = Block.FullWidth
        ? "relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen"
        : "relative w-full";

    <header class="@fullWidthClass border-b border-slate-200 overflow-hidden" style="@headerStyle">
        <div class="max-w-7xl mx-auto px-4 py-20 sm:py-32 sm:px-6 lg:px-8 relative z-10 transition-all duration-700">
            @if (!string.IsNullOrEmpty(Block.Title))
            {
                <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-none @headerTextClass">
                    @Block.Title
                </h1>
            }

            @if (!string.IsNullOrEmpty(Block.Summary))
            {
                <p class="mt-6 text-lg sm:text-xl @subTextClass leading-relaxed max-w-2xl font-medium">
                    @Block.Summary
                </p>
            }
        </div>

        @if (!hasHeaderImage)
        {
            <div class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,transparent,black)] pointer-events-none"></div>
        }
    </header>
}

@code {
    [Parameter]
    public BoringHeroBlock? Block { get; set; }
}
