@using Markdig

@if (Block != null && !string.IsNullOrEmpty(Block.Content))
{
    <div class="markdown-block-content prose prose-slate max-w-none">
        @((MarkupString)Markdown.ToHtml(Block.Content))
    </div>
}

@code {
    [Parameter]
    public Aero.Cms.Abstractions.Blocks.Common.MarkdownBlock? Block { get; set; }
}
