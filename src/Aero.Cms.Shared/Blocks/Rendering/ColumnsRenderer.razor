@using Aero.Cms.Abstractions.Blocks.Common

@if (Block != null)
{
    var gapValue = Block.Gap is not null && int.TryParse(Block.Gap, out var g) ? g : 12;

    <div class="grid grid-cols-1 md:grid-cols-@(Block.Columns.Count > 0 ? Block.Columns.Count : 1) gap-@(gapValue / 4) @Block.RowClasses">
        @foreach (var column in Block.Columns)
        {
            <div class="@(column.ColumnClasses ?? "")">
                @if (column.Blocks is { Count: > 0 })
                {
                    @foreach (var nestedBlock in column.Blocks)
                    {
                        <BlockRenderer Block="nestedBlock" />
                    }
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public ColumnsBlock? Block { get; set; }
}
