@using Aero.Cms.Abstractions.Blocks.Neo

@if (Block != null)
{
    var cols = Block.Columns switch { 1 => "grid-cols-1", 2 => "grid-cols-2", 4 => "grid-cols-4", _ => "grid-cols-3" };
    <div class="grid @cols gap-4 my-8">
        @foreach (var img in Block.Images)
        {
            <img src="@img" class="w-full rounded-lg object-cover aspect-square" loading="lazy" />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public GalleryBlock? Block { get; set; }
}
