@using Aero.Cms.Abstractions.Blocks
@using Aero.Cms.Abstractions.Blocks.Layout
@using Aero.Cms.Core.Blocks
@using Aero.Cms.Abstractions.Http.Clients
@using global::Marten
@using Marten
@inject BlockRenderCache BlockCache
@inject IDocumentSession MartenSession

@if (Placement != null)
{
    @if (_block == null && !_loadingAttempted)
    {
        <span>Loading...</span>
    }
    else if (_block != null)
    {
        <BlockRenderer Block="_block" Navigation="_navigation" />
    }
    else if (_loadingAttempted)
    {
        <div class="text-red-500 p-2 border border-red-200 rounded bg-red-50 text-sm">
            Block with ID @Placement.BlockId not found
        </div>
    }
}

@code {
    [Parameter]
    public BlockPlacement? Placement { get; set; }

    private IBlock? _block;
    private NavigationDetail? _navigation;
    private bool _loadingAttempted;

    /// <summary>
    /// Resolves the block from the request-scoped BlockRenderCache instead of
    /// calling IBlockService.GetByIdAsync directly.
    /// 
    /// N+1 REMEDY: The page model (DynamicPageModel) preloads all block IDs
    /// from every LayoutRegion into BlockRenderCache in a single batch query
    /// BEFORE this component tree renders. This method performs an O(1)
    /// dictionary lookup instead of a database round-trip.
    /// 
    /// When the cache has NOT been preloaded (shouldn't happen in normal
    /// operation), the attempted flag prevents repeated failed lookups.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Placement is not null && (_block is null || _block.Id != Placement.BlockId))
        {
            _loadingAttempted = false;
            
            // O(1) dictionary lookup — no async, no DB, no HTTP.
            // The cache was populated by DynamicPageModel.PreloadBlockCacheAsync()
            // using a single batched Marten query (WHERE Id = ANY(@ids)).
            _block = BlockCache.GetBlock(Placement.BlockId);

            if (_block is NavigationBlock navBlock)
            {
                // Navigation blocks may need to load shared navigation structures.
                // This is a separate concern from the N+1 block-loading; the
                // NavigationBlock resolution remains asynchronous.
                if (navBlock.NavigationId > 0)
                {
                    // Note: NavigationBlock referenced by ID may also need batch-load
                    // in the future. For now, this is a second-hop lookup.
                    var sharedNav = await MartenSession.LoadAsync<NavigationBlock>(navBlock.NavigationId);
                    if (sharedNav is not null)
                    {
                        _navigation = MapToDetail(sharedNav);
                    }
                }

                if (_navigation is null && navBlock.Items is { Count: > 0 })
                {
                    _navigation = MapToDetail(navBlock);
                }
            }

            _loadingAttempted = true;
        }
    }

    private NavigationDetail MapToDetail(NavigationBlock nav)
    {
        return new NavigationDetail(
            nav.Id,
            nav.Name ?? string.Empty,
            string.Empty,
            nav.Items.Select(i => new NavigationItemDetail(
                i.Value.Id, 
                i.Value.Label ?? string.Empty, 
                i.Value.Url, 
                i.Value.PageId, 
                (int)i.Key, 
                null)).ToList(),
            DateTime.UtcNow,
            DateTime.UtcNow
        );
    }
}
