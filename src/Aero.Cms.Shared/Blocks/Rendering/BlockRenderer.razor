@using Aero.Cms.Abstractions.Blocks
@using Aero.Cms.Abstractions.Http.Clients
@using System.Linq

@if (Block is not null)
{
    if (TryResolveAdapter(Block.BlockType, out var adapter))
    {
        <ErrorBoundary @key="Block">
            <ChildContent>
                @adapter.Render(Block, new BlockRenderContext(Navigation: Navigation))
            </ChildContent>
            <ErrorContent>
                <div class="p-4 border border-red-200 bg-red-50 rounded text-red-700">
                    Block content is temporarily unavailable.
                </div>
            </ErrorContent>
        </ErrorBoundary>
    }
    else
    {
        <div class="p-4 border border-dashed border-gray-300 rounded text-gray-500 italic">
            Unknown block type: @Block.BlockType (@Block.GetType().Name)
        </div>
    }
}

@code {
    [Parameter]
    public IBlock? Block { get; set; }

    [Parameter]
    public NavigationDetail? Navigation { get; set; }

    [Inject]
    private IEnumerable<ICmsBlockRenderRegistry> BlockRenderRegistries { get; set; } = [];

    private bool TryResolveAdapter(string blockType, out ICmsBlockRenderAdapter adapter)
    {
        foreach (var registry in BlockRenderRegistries)
        {
            if (registry.TryGet(blockType, out adapter!))
            {
                return true;
            }
        }

        return CmsBlockRenderRegistry.TryGet(blockType, out adapter!);
    }
}
