@using Aero.Cms.Abstractions.Blocks.Common

@if (Block is null || Block.Items.Count == 0)
{
    <div class="p-4 border border-dashed border-gray-300 rounded text-gray-500 italic text-center">
        Empty carousel — add images to display.
    </div>
    return;
}

@{
    var showDots = Block.ControlLocation != "hidden";
    var dotsOverlay = Block.ControlLocation == "overlay";
    var showArrows = Block.ShowArrows;
    var itemCount = Block.Items.Count;
    var needsCarousel = itemCount > 1;
    var trackId = $"carousel-track-{Guid.NewGuid():N}";
}

@* ── Hide scrollbar across all browsers ── *@
<style>
    .carousel-track::-webkit-scrollbar { display: none; }
</style>

@* ── Infinite smooth-scrolling carousel (clone-based) ── *@
<div class="carousel-root relative rounded-lg bg-gray-100 overflow-hidden">

    @* ── Overlay left/right arrows (always use smooth scrollBy — clones handle wrap) ── *@
    @if (showArrows && needsCarousel)
    {
        <button type="button"
                class="carousel-arrow carousel-arrow-left absolute left-2 top-1/2 -translate-y-1/2 z-10 p-2 rounded-full bg-white/80 hover:bg-white shadow-md transition-colors"
                aria-label="Previous slide"
                onclick="document.getElementById('@trackId').scrollBy({left: -document.getElementById('@trackId').offsetWidth, behavior: 'smooth'})">
            <svg class="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </button>
        <button type="button"
                class="carousel-arrow carousel-arrow-right absolute right-2 top-1/2 -translate-y-1/2 z-10 p-2 rounded-full bg-white/80 hover:bg-white shadow-md transition-colors"
                aria-label="Next slide"
                onclick="document.getElementById('@trackId').scrollBy({left: document.getElementById('@trackId').offsetWidth, behavior: 'smooth'})">
            <svg class="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"/>
            </svg>
        </button>
    }

    @* ── Scrollable track ── *@
    <div id="@trackId"
         class="carousel-track flex overflow-x-auto @(needsCarousel ? "snap-x snap-mandatory" : "")"
         style="scrollbar-width: none; -ms-overflow-style: none;">

        @for (var i = 0; i < itemCount; i++)
        {
            var item = Block.Items[i];
            var imgSrc = ResolveImageSrc(item);

            <div id="carousel-slide-@i"
                 class="carousel-slide @(needsCarousel ? "snap-center" : "") shrink-0 w-full relative">

                @if (!string.IsNullOrEmpty(item.ActionUrl))
                {
                    <a href="@item.ActionUrl" class="block">
                        <img src="@imgSrc" alt="@item.AltText"
                             class="w-full h-auto object-cover" loading="lazy" />
                    </a>
                }
                else
                {
                    <img src="@imgSrc" alt="@item.AltText"
                         class="w-full h-auto object-cover" loading="lazy" />
                }

                @if (!string.IsNullOrEmpty(item.Caption))
                {
                    <div class="carousel-caption text-center py-3 px-4 text-sm text-gray-700 bg-white/90">
                        @item.Caption
                    </div>
                }
            </div>
        }
    </div>

    @* ── Dot indicators ── *@
    @if (showDots && needsCarousel)
    {
        <div class="carousel-dots flex justify-center gap-2 @(dotsOverlay ? "absolute bottom-3 left-0 right-0 z-10" : "py-3")">
            @for (var j = 0; j < itemCount; j++)
            {
                <button type="button"
                        onclick="document.getElementById('@trackId').scrollTo({left: (@j + 1) * document.getElementById('@trackId').offsetWidth, behavior: 'smooth'})"
                        class="carousel-dot w-2.5 h-2.5 rounded-full @(dotsOverlay ? "bg-white/70 hover:bg-white" : "bg-gray-300 hover:bg-gray-400") transition-colors inline-block"
                        aria-label="Go to slide @(j + 1)">
                </button>
            }
        </div>
    }
</div>

@* ── Infinite-loop setup + AutoPlay ── *@
@if (needsCarousel)
{
    <script>
        (function(){
            var el = document.getElementById('@trackId');
            if (!el || el.getAttribute('data-cr-init')) return;
            el.setAttribute('data-cr-init','1');
            var slides = Array.from(el.children);
            var n = slides.length;
            if (n < 2) return;

            // Clone first slide → append at end, clone last slide → prepend at start
            var c1 = slides[0].cloneNode(true);
            var cN = slides[n-1].cloneNode(true);
            if (c1.id) c1.removeAttribute('id');
            if (cN.id) cN.removeAttribute('id');
            el.appendChild(c1);
            el.insertBefore(cN, slides[0]);

            // Start at the real first slide
            el.scrollLeft = el.offsetWidth;

            // Debounced scroll-end handler for clone detection (50 ms after scroll stops)
            var timer, realN = n;
            el.addEventListener('scroll', function(){
                clearTimeout(timer);
                timer = setTimeout(function(){
                    var pos = Math.round(el.scrollLeft / el.offsetWidth);
                    if (pos === 0) {
                        el.scrollLeft = realN * el.offsetWidth;
                    } else if (pos === realN + 1) {
                        el.scrollLeft = el.offsetWidth;
                    }
                }, 50);
            });

            // AutoPlay
            if (@(Block.AutoPlay ? "true" : "false")) {
                setInterval(function(){
                    el.scrollBy({left: el.offsetWidth, behavior: 'smooth'});
                }, @(Block.Interval);
            }
        })();
    </script>
}

@code {
    [Parameter]
    public CarouselBlock? Block { get; set; }

    private static string ResolveImageSrc(Aero.Cms.Abstractions.Blocks.Common.CarouselItem item)
    {
        if (item.ImageMediaId > 0)
            return $"/api/media/{item.ImageMediaId}";

        if (!string.IsNullOrEmpty(item.Caption) &&
            (item.Caption.StartsWith('/') || item.Caption.StartsWith("http", StringComparison.OrdinalIgnoreCase)))
        {
            return item.Caption;
        }

        return string.Empty;
    }
}
