@using Aero.Cms.Abstractions.Blocks.Neo
@using Aero.Cms.Abstractions.Blocks.Neo.Styles
@using Aero.Cms.Shared.Pages.Manager.PageEditor.Catalog

@* ── NeoNodeRenderer — renders a single NeoPageNode ── *@
@* V1: Renders a section wrapper with known catalog IDs.
   Unknown catalog IDs render a placeholder comment.
   Nesting beyond MaxDepth is silently truncated.
   Uses INeoEditorCatalogProvider to resolve display names/icons
   for catalog-driven labeling instead of raw [catalogId] text. *@

@inject INeoEditorCatalogProvider Catalog

@if (Node is not null && NestingDepth <= MaxDepth)
{
    var catalogId = Node.CatalogId;
    var isContainer = Node.Kind is NeoPageNodeKind.Container or NeoPageNodeKind.Section;
    Catalog.TryGet(catalogId, out var catalogItem);

    @* A stable element is required for static SSR. Razor variable-tag syntax
       renders literal <> wrappers and drops attributes in HtmlRenderer output. *@
    <div class="neo-node neo-@(catalogId.Replace(".", "-")) neo-kind-@Node.Kind.ToString().ToLowerInvariant()"
         style="@NodeStyleCssRenderer.Render(Node.Style, Breakpoint)"
         data-catalog-id="@catalogId"
         data-node-id="@Node.NodeId">

        @switch (catalogId)
        {
            case "primitive.text":
            {
                <p class="neo-primitive-text">@GetStringProperty("text")</p>
                break;
            }

            case "primitive.container":
            {
                <div class="neo-primitive-container">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </div>
                break;
            }

            case "primitive.button":
            {
                <a class="neo-primitive-button"
                   href="@GetSafeLinkProperty("url")">
                    @GetStringProperty("text")
                </a>
                break;
            }

            case "primitive.image":
            {
                var imageUrl = GetSafeMediaProperty("url");
                <figure class="neo-primitive-image">
                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                    {
                        <img src="@imageUrl"
                             alt="@GetStringProperty("alt")"
                             loading="lazy" />
                    }
                    @if (!string.IsNullOrWhiteSpace(GetStringProperty("caption")))
                    {
                        <figcaption>@GetStringProperty("caption")</figcaption>
                    }
                </figure>
                break;
            }

            case "primitive.pill":
            {
                <span class="neo-primitive-pill">@GetStringProperty("text")</span>
                break;
            }

            case "primitive.icon":
            {
                <span class="neo-primitive-icon"
                      data-icon-name="@GetStringProperty("name")"
                      role="img"
                      aria-label="@GetStringProperty("label")"></span>
                break;
            }

            case "primitive.separator":
            {
                <hr class="neo-primitive-separator" />
                break;
            }

            case "preset.card":
            {
                <article class="neo-primitive-card">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </article>
                break;
            }

            @* Typed block references — render via catalog metadata *@
            case var _ when Node.Kind == NeoPageNodeKind.Block:
            {
                @if (catalogItem is not null)
                {
                    @* Catalog entry found — show display name + icon *@
                    <div class="neo-block" data-catalog-id="@catalogId"
                         title="@catalogItem.DisplayName">
                        <span class="neo-block-icon">@catalogItem.IconName</span>
                        <span class="neo-block-label">@catalogItem.DisplayName</span>
                    </div>
                }
                else
                {
                    @* Unknown block — render its catalog ID so content authors
                       can identify nodes that lack catalog definitions *@
                    <div class="neo-block-placeholder" data-catalog-id="@catalogId">
                        [@catalogId]
                    </div>
                }
                break;
            }

            @* Container/section nodes render children recursively *@
            case var _ when isContainer || Node.Children.Count > 0:
            {
                @if (catalogItem is not null)
                {
                    @* Section header with catalog display name *@
                    <div class="neo-section-header">
                        <span class="neo-section-icon">@catalogItem.IconName</span>
                        <span class="neo-section-label">@catalogItem.DisplayName</span>
                    </div>
                }
                @foreach (var child in Node.Children)
                {
                    <NeoNodeRenderer Node="child"
                                     NestingDepth="NestingDepth + 1"
                                     MaxDepth="MaxDepth"
                                     Breakpoint="Breakpoint" />
                }
                break;
            }

            @* Unknown catalog IDs render as placeholder in production *@
            default:
            {
                @if (catalogItem is not null)
                {
                    <div class="neo-node" data-catalog-id="@catalogId">
                        <span class="neo-node-icon">@catalogItem.IconName</span>
                        <span class="neo-node-label">@catalogItem.DisplayName</span>
                    </div>
                }
                else
                {
                    <div class="neo-node-placeholder" data-catalog-id="@catalogId">
                        @catalogId
                    </div>
                }
                break;
            }
        }
    </div>
}

@code {
    [Parameter]
    public NeoPageNode Node { get; set; } = default!;

    [Parameter]
    public int NestingDepth { get; set; }

    [Parameter]
    public int MaxDepth { get; set; } = 5;

    [Parameter]
    public EditorBreakpoint Breakpoint { get; set; } = EditorBreakpoint.Desktop;

    private string GetStringProperty(string name) =>
        Node.Properties.TryGetValue(name, out var value) &&
        value.ValueKind == System.Text.Json.JsonValueKind.String
            ? value.GetString() ?? string.Empty
            : string.Empty;

    private string GetSafeLinkProperty(string name)
    {
        var value = GetStringProperty(name).Trim();
        if (value.StartsWith('#') ||
            value.StartsWith('/') ||
            Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
            uri.Scheme is "http" or "https" or "mailto" or "tel")
        {
            return value;
        }

        return "#";
    }

    private string GetSafeMediaProperty(string name)
    {
        var value = GetStringProperty(name).Trim();
        if (value.StartsWith('/') ||
            Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
            uri.Scheme is "http" or "https")
        {
            return value;
        }

        return string.Empty;
    }
}
