@using Aero.Cms.Abstractions.Blocks.Neo
@using Aero.Cms.Abstractions.Blocks.Neo.Styles
@using Aero.Cms.Abstractions.Blocks.Editor
@using Microsoft.Extensions.DependencyInjection

@* Renders the canonical NeoPageNode tree for public pages.
   Authoring diagnostics stay in the editor; public output should be semantic
   HTML with no catalog labels leaking into the site. *@

@inject IServiceProvider Services

@if (Node is not null && NestingDepth <= MaxDepth)
{
    var catalogId = Node.CatalogId;
    var isContainer = Node.Kind is NeoPageNodeKind.Container or NeoPageNodeKind.Section;

    @* A stable element is required for static SSR. Razor variable-tag syntax
       renders literal <> wrappers and drops attributes in HtmlRenderer output. *@
    <div class="@NodeCssClass"
         style="@NodeStyleCssRenderer.Render(Node.Style, Breakpoint)"
         data-catalog-id="@catalogId"
         data-node-id="@Node.NodeId">

        @switch (catalogId)
        {
            case "primitive.text":
            case "text":
            {
                <p class="neo-primitive-text">@GetStringProperty("text", "content", "title")</p>
                break;
            }

            case "primitive.heading":
            {
                var headingText = GetStringProperty("text");
                @switch (GetIntProperty("level", 2))
                {
                    case 1:
                        <h1 class="neo-primitive-heading">@headingText</h1>
                        break;
                    case 3:
                        <h3 class="neo-primitive-heading">@headingText</h3>
                        break;
                    case 4:
                        <h4 class="neo-primitive-heading">@headingText</h4>
                        break;
                    case 5:
                        <h5 class="neo-primitive-heading">@headingText</h5>
                        break;
                    case 6:
                        <h6 class="neo-primitive-heading">@headingText</h6>
                        break;
                    default:
                        <h2 class="neo-primitive-heading">@headingText</h2>
                        break;
                }
                break;
            }

            case "boring_hero":
            {
                var imageUrl = GetSafeMediaProperty("backgroundImageUrl");
                var heroStyle = string.IsNullOrWhiteSpace(imageUrl)
                    ? string.Empty
                    : $"background-image:linear-gradient(rgba(15,23,42,.58),rgba(15,23,42,.58)),url('{imageUrl}');";
                <section class="neo-boring-hero" style="@heroStyle">
                    <div class="neo-boring-hero__content">
                        <h1>@GetStringProperty("title")</h1>
                        @if (!string.IsNullOrWhiteSpace(GetStringProperty("summary")))
                        {
                            <p>@GetStringProperty("summary")</p>
                        }
                    </div>
                </section>
                break;
            }

            case "primitive.container":
            {
                <div class="neo-primitive-container @NeoContainerLayoutCss.FromProperties(Node.Properties)">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </div>
                break;
            }

            case "primitive.flexbox":
            {
                <div class="neo-primitive-flexbox" style="@FlexboxStyle()">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </div>
                break;
            }

            case "primitive.css-grid":
            {
                <div class="neo-primitive-css-grid" style="@CssGridStyle()">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </div>
                break;
            }

            case "primitive.section":
            {
                <section class="neo-primitive-section">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </section>
                break;
            }

            case "primitive.article":
            {
                <article class="neo-primitive-article">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </article>
                break;
            }

            case "primitive.header":
            {
                <header class="neo-primitive-header">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </header>
                break;
            }

            case "primitive.footer":
            {
                <footer class="neo-primitive-footer">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </footer>
                break;
            }

            case "primitive.nav":
            {
                <nav class="neo-primitive-nav">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </nav>
                break;
            }

            case "primitive.aside":
            {
                <aside class="neo-primitive-aside">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </aside>
                break;
            }

            case "primitive.grid":
            {
                <div class="neo-primitive-grid" style="@GridStyle()">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </div>
                break;
            }

            case "primitive.grid-row":
            {
                <div class="neo-primitive-grid-row" style="@GridRowStyle()">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </div>
                break;
            }

            case "primitive.grid-cell":
            {
                <div class="neo-primitive-grid-cell" style="@GridCellStyle()">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </div>
                break;
            }

            case "primitive.button":
            {
                <a class="neo-primitive-button"
                   href="@GetSafeLinkProperty("url")">
                    @GetStringProperty("text")
                </a>
                break;
            }

            case "primitive.image":
            {
                var imageUrl = GetSafeMediaProperty("url");
                <figure class="neo-primitive-image">
                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                    {
                        <img src="@imageUrl"
                             alt="@GetStringProperty("alt")"
                             loading="lazy" />
                    }
                    @if (!string.IsNullOrWhiteSpace(GetStringProperty("caption")))
                    {
                        <figcaption>@GetStringProperty("caption")</figcaption>
                    }
                </figure>
                break;
            }

            case "video":
            case "primitive.video":
            {
                var videoUrl = GetSafeMediaProperty("url", "src");
                if (!string.IsNullOrWhiteSpace(videoUrl))
                {
                    <figure class="neo-primitive-video">
                        <video src="@videoUrl"
                               poster="@GetSafeMediaProperty("poster")"
                               controls
                               preload="metadata"></video>
                        @if (!string.IsNullOrWhiteSpace(GetStringProperty("caption")))
                        {
                            <figcaption>@GetStringProperty("caption")</figcaption>
                        }
                    </figure>
                }
                else if (!string.IsNullOrWhiteSpace(GetStringProperty("caption")))
                {
                    <div class="neo-primitive-media-placeholder">
                        @GetStringProperty("caption")
                    </div>
                }
                break;
            }

            case "audio":
            case "primitive.audio":
            {
                var audioUrl = GetSafeMediaProperty("url", "src");
                if (!string.IsNullOrWhiteSpace(audioUrl))
                {
                    <figure class="neo-primitive-audio">
                        <audio src="@audioUrl" controls preload="metadata"></audio>
                        @if (!string.IsNullOrWhiteSpace(GetStringProperty("caption")))
                        {
                            <figcaption>@GetStringProperty("caption")</figcaption>
                        }
                    </figure>
                }
                else if (!string.IsNullOrWhiteSpace(GetStringProperty("caption")))
                {
                    <div class="neo-primitive-media-placeholder">
                        @GetStringProperty("caption")
                    </div>
                }
                break;
            }

            case "primitive.pill":
            {
                <span class="neo-primitive-pill">@GetStringProperty("text")</span>
                break;
            }

            case "primitive.icon":
            {
                <span class="neo-primitive-icon"
                      data-icon-name="@GetStringProperty("name")"
                      role="img"
                      aria-label="@GetStringProperty("label")">
                    @IconGlyph
                </span>
                break;
            }

            case "primitive.blockquote":
            case "quote":
            {
                <blockquote class="neo-primitive-blockquote">
                    <p>@GetStringProperty("text", "content", "quote")</p>
                    @if (!string.IsNullOrWhiteSpace(GetStringProperty("citation")))
                    {
                        <cite>@GetStringProperty("citation")</cite>
                    }
                </blockquote>
                break;
            }

            case "primitive.code":
            {
                <pre class="neo-primitive-code"><code>@GetStringProperty("code")</code></pre>
                break;
            }

            case "markdown":
            {
                <div class="neo-primitive-html">@((MarkupString)MarkdownToHtml(GetStringProperty("content", "markdown", "text")))</div>
                break;
            }

            case "dynamic_template":
            {
                <div class="neo-primitive-template">
                    @if (Node.Children.Count == 0)
                    {
                        @GetStringProperty("template", "content")
                    }
                    else
                    {
                        @foreach (var child in Node.Children)
                        {
                            <NeoNodeRenderer Node="child"
                                             NestingDepth="NestingDepth + 1"
                                             MaxDepth="MaxDepth"
                                             Breakpoint="Breakpoint" />
                        }
                    }
                </div>
                break;
            }

            case "primitive.embed":
            {
                var embedUrl = GetSafeMediaProperty("url", "src");
                @if (!string.IsNullOrWhiteSpace(embedUrl))
                {
                    <iframe class="neo-primitive-embed"
                            src="@embedUrl"
                            title="@GetStringProperty("title")"
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"></iframe>
                }
                break;
            }

            case "gallery":
            case "primitive.gallery":
            {
                <div class="neo-primitive-gallery" role="list" aria-label="@GetStringProperty("label", "title")">
                    @if (Node.Children.Count == 0)
                    {
                        <div class="neo-primitive-media-placeholder">
                            @GetStringProperty("label", "title")
                        </div>
                    }
                    else
                    {
                        @foreach (var child in Node.Children)
                        {
                            <NeoNodeRenderer Node="child"
                                             NestingDepth="NestingDepth + 1"
                                             MaxDepth="MaxDepth"
                                             Breakpoint="Breakpoint" />
                        }
                    }
                </div>
                break;
            }

            case "carousel":
            case "primitive.carousel":
            {
                <div class="neo-primitive-carousel" role="region" aria-label="@GetStringProperty("label", "title")">
                    @if (Node.Children.Count == 0)
                    {
                        <div class="neo-primitive-media-placeholder">
                            @GetStringProperty("label", "title")
                        </div>
                    }
                    else
                    {
                        @foreach (var child in Node.Children)
                        {
                            <NeoNodeRenderer Node="child"
                                             NestingDepth="NestingDepth + 1"
                                             MaxDepth="MaxDepth"
                                             Breakpoint="Breakpoint" />
                        }
                    }
                </div>
                break;
            }

            case "columns":
            {
                <div class="neo-primitive-columns">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </div>
                break;
            }

            case "primitive.form":
            {
                <form class="neo-primitive-form">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </form>
                break;
            }

            case "raw_html" or "content":
            {
                <div class="neo-primitive-html">@((MarkupString)GetStringProperty("content", "html"))</div>
                break;
            }

            case "primitive.separator":
            {
                <hr class="neo-primitive-separator" />
                break;
            }

            case "preset.card":
            {
                <article class="neo-primitive-card">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </article>
                break;
            }

            case "hero":
            case "aero_features":
            case "aero_pricing":
            case "aero_cta":
            case "aero_faq":
            case "aero_testimonials":
            case "aero_blog":
            case "aero_teams":
            case "aero_contact":
            case "aero_portfolio":
            case "aero_table":
            case "aero_auth":
            {
                <section class="@GenericComponentClass">
                    @if (Node.Children.Count == 0)
                    {
                        <div class="neo-component__placeholder">
                            <p class="neo-component__kicker">Component</p>
                            <h2>@ComponentTitle</h2>
                            <p>@ComponentDescription</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var child in Node.Children)
                        {
                            <NeoNodeRenderer Node="child"
                                             NestingDepth="NestingDepth + 1"
                                             MaxDepth="MaxDepth"
                                             Breakpoint="Breakpoint" />
                        }
                    }
                </section>
                break;
            }

            @* Catalog-backed visual sections render through their registered block renderer.
               This keeps storage semantic while preserving the polished public UI. *@
            case var _ when TryMapLegacyBlock(out var catalogBlock):
            {
                <BlockRenderer Block="@catalogBlock" />
                break;
            }

            @* Legacy block references are only a defensive transition fallback. *@
            case var _ when Node.Kind == NeoPageNodeKind.Block:
            {
                @if (TryMapLegacyBlock(out var block))
                {
                    <BlockRenderer Block="@block" />
                }
                break;
            }

            @* Container/section nodes render children recursively *@
            case var _ when isContainer || Node.Children.Count > 0:
            {
                <div class="@GenericComponentClass">
                    @foreach (var child in Node.Children)
                    {
                        <NeoNodeRenderer Node="child"
                                         NestingDepth="NestingDepth + 1"
                                         MaxDepth="MaxDepth"
                                         Breakpoint="Breakpoint" />
                    }
                </div>
                break;
            }

            @* Unknown catalog IDs render nothing publicly. Authoring diagnostics belong in the editor. *@
            default:
            {
                break;
            }
        }
    </div>
}

@code {
    [Parameter]
    public NeoPageNode Node { get; set; } = default!;

    [Parameter]
    public int NestingDepth { get; set; }

    [Parameter]
    public int MaxDepth { get; set; } = 16;

    [Parameter]
    public EditorBreakpoint Breakpoint { get; set; } = EditorBreakpoint.Desktop;

    private string NodeCssClass
    {
        get
        {
            var catalogClass = Node.CatalogId.Replace(".", "-");
            var kindClass = Node.Kind.ToString().ToLowerInvariant();
            var fullWidthClass = GetBoolProperty("fullWidth") ? " neo-node--full-width" : string.Empty;

            return $"neo-node neo-{catalogClass} neo-kind-{kindClass}{fullWidthClass}";
        }
    }

    private string GenericComponentClass =>
        $"neo-component neo-component-{Node.CatalogId.Replace(".", "-").Replace("_", "-")}";

    private string ComponentTitle => FirstNonEmpty(
        GetStringProperty("title"),
        Node.CatalogId switch
        {
            "hero" => "Hero",
            "aero_features" => "Features",
            "aero_pricing" => "Pricing",
            "aero_cta" => "Call to action",
            "aero_faq" => "Frequently asked questions",
            "aero_testimonials" => "Testimonials",
            "aero_blog" => "Blog",
            "aero_teams" => "Team",
            "aero_contact" => "Contact",
            "aero_portfolio" => "Portfolio",
            "aero_table" => "Table",
            "aero_auth" => "Authentication",
            _ => "Component"
        });

    private string ComponentDescription => FirstNonEmpty(
        GetStringProperty("description", "summary", "content"),
        Node.CatalogId switch
        {
            "hero" => "Add background media, headline text, supporting copy, and calls to action.",
            "aero_features" => "Drop feature cards, icons, headings, and supporting copy into this section.",
            "aero_pricing" => "Compose pricing tiers, feature lists, and purchase actions.",
            "aero_cta" => "Build a focused conversion section with copy and buttons.",
            "aero_faq" => "Add questions and answers for common customer concerns.",
            "aero_testimonials" => "Collect quotes, names, roles, and images into a proof section.",
            "aero_blog" => "Arrange article cards or dynamic post summaries.",
            "aero_teams" => "Create team member cards with names, roles, bios, and photos.",
            "aero_contact" => "Add contact details, maps, or forms.",
            "aero_portfolio" => "Compose project cards and portfolio details.",
            "aero_table" => "Add rows, cells, and structured comparison content.",
            "aero_auth" => "Compose sign-in, sign-up, or account access content.",
            _ => "Drop child elements into this component to build the final layout."
        });

    private static string FirstNonEmpty(params string[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private string IconGlyph => GetStringProperty("name") switch
    {
        "check" => "✓",
        "x" or "x-circle" => "×",
        "heart" => "♡",
        "star" => "★",
        "sparkles" => "✦",
        "circle" => "●",
        _ => "•"
    };

    private string GetStringProperty(params string[] names)
    {
        foreach (var name in names)
        {
            if (Node.Properties.TryGetValue(name, out var value) &&
                value.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var text = value.GetString();
                if (!string.IsNullOrWhiteSpace(text))
                {
                    return text;
                }
            }
        }

        return string.Empty;
    }

    private string GetSafeLinkProperty(string name)
    {
        var value = GetStringProperty(name).Trim();
        if (value.StartsWith('#') ||
            value.StartsWith('/') ||
            Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
            uri.Scheme is "http" or "https" or "mailto" or "tel")
        {
            return value;
        }

        return "#";
    }

    private string GetSafeMediaProperty(params string[] names)
    {
        var value = GetStringProperty(names).Trim();
        if (value.StartsWith('/') ||
            Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
            uri.Scheme is "http" or "https")
        {
            return value;
        }

        return string.Empty;
    }

    private int GetIntProperty(string name, int fallback)
    {
        if (!Node.Properties.TryGetValue(name, out var value))
        {
            return fallback;
        }

        return value.ValueKind switch
        {
            System.Text.Json.JsonValueKind.Number when value.TryGetInt32(out var number) => number,
            System.Text.Json.JsonValueKind.String when int.TryParse(value.GetString(), out var number) => number,
            _ => fallback
        };
    }

    private bool GetBoolProperty(string name)
    {
        if (!Node.Properties.TryGetValue(name, out var value))
        {
            return false;
        }

        return value.ValueKind switch
        {
            System.Text.Json.JsonValueKind.True => true,
            System.Text.Json.JsonValueKind.False => false,
            System.Text.Json.JsonValueKind.String when bool.TryParse(value.GetString(), out var parsed) => parsed,
            _ => false
        };
    }

    private static string MarkdownToHtml(string value) =>
        string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : Markdig.Markdown.ToHtml(value);

    private string GridStyle()
    {
        var gap = Math.Max(0, GetIntProperty("gap", 4));
        return $"display:flex;flex-direction:column;gap:{gap * 0.25}rem;";
    }

    private string GridRowStyle()
    {
        var gap = Math.Max(0, GetIntProperty("gap", 4));
        return "display:grid;" +
               "grid-template-columns:repeat(auto-fit,minmax(min(16rem,100%),1fr));" +
               $"gap:{gap * 0.25}rem;align-items:start;";
    }

    private string GridCellStyle()
    {
        return "min-width:0;";
    }

    private string FlexboxStyle()
    {
        var direction = GetStringProperty("direction") is "column" ? "column" : "row";
        var wrap = GetBoolProperty("wrap") ? "wrap" : "nowrap";
        var justify = SafeJustify(GetStringProperty("justify"));
        var align = SafeAlign(GetStringProperty("align"));
        var gap = Math.Max(0, GetIntProperty("gap", 4));
        return $"display:flex;flex-direction:{direction};flex-wrap:{wrap};justify-content:{justify};align-items:{align};gap:{gap * 0.25}rem;";
    }

    private string CssGridStyle()
    {
        var columns = Math.Clamp(GetIntProperty("columns", 3), 1, 12);
        var gap = Math.Max(0, GetIntProperty("gap", 4));
        return $"display:grid;grid-template-columns:repeat({columns},minmax(0,1fr));gap:{gap * 0.25}rem;";
    }

    private static string SafeJustify(string value) => value switch
    {
        "center" => "center",
        "end" => "flex-end",
        "between" => "space-between",
        "around" => "space-around",
        "evenly" => "space-evenly",
        _ => "flex-start"
    };

    private static string SafeAlign(string value) => value switch
    {
        "start" => "flex-start",
        "center" => "center",
        "end" => "flex-end",
        _ => "stretch"
    };

    private bool TryMapLegacyBlock(out Aero.Cms.Abstractions.Blocks.BlockBase block)
    {
        block = default!;

        var definitionRegistry = Services.GetService<IPageEditorDefinitionRegistry>();
        if (definitionRegistry is null ||
            !definitionRegistry.TryGetDescriptor(Node.CatalogId, out var descriptor) ||
            descriptor.LegacyDefinition is null)
        {
            return NeoPageNodeLegacyBlockMapper.TryMap(Node, out block);
        }

        var editorBlock = NeoPageNodeEditorBlockMapper.ToEditorBlock(
            Node,
            descriptor.LegacyDefinition.CreateDefaultEditorBlock());
        if (descriptor.LegacyDefinition.ToBlockBase(editorBlock) is not { } mapped)
        {
            return NeoPageNodeLegacyBlockMapper.TryMap(Node, out block);
        }

        block = mapped;
        return true;
    }
}
