@using Aero.Cms.Abstractions.Blocks.Common
@using Aero.Cms.Core.Security
@namespace Aero.Cms.Shared.Blocks.Rendering
@inject ICmsHtmlSanitizer HtmlSanitizer

@if (Block is not null)
{
    @((MarkupString)HtmlSanitizer.Sanitize(Block.Content))
}

@code {
    [Parameter] public RawHtmlBlock Block { get; set; } = default!;
}
