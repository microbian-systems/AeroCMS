@using Aero.Cms.Core.Blocks
@using Aero.Cms.Abstractions.Blocks
@using System.Web
@using System.IO

@if (Block != null)
{
    @if (IsDirectVideoUrl(Block.SourceUrl))
    {
        <div class="embed my-6">
            <video controls
                   autoplay="@(Block.AutoPlay ? true : null)"
                   muted="@(Block.AutoPlay ? true : null)"
                   playsinline
                   style="width:100%;border-radius:8px;display:block;background:#000;">
                <source src="@Block.SourceUrl" />
            </video>
        </div>
    }
    else
    {
        <div class="embed my-6">
            <div class="relative w-full" style="padding-bottom: 56.25%;">
                <iframe 
                    src="@GetEmbedUrl()" 
                    class="absolute top-0 left-0 w-full h-full rounded-lg shadow-md"
                    frameborder="0" 
                    allow="@GetAllowAttribute()" 
                    allowfullscreen
                    loading="@(Block.AutoPlay ? "eager" : "lazy")">
                </iframe>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public EmbedBlock? Block { get; set; }

    /// <summary>
    /// Determines whether the URL points directly to a playable video file
    /// (mp4, webm, ogg, mov) rather than an embeddable page (YouTube, Vimeo).
    /// </summary>
    private static bool IsDirectVideoUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        // Strip query string to avoid Path.GetExtension confusion
        var path = url.Split('?')[0];
        var ext = Path.GetExtension(path)?.ToLowerInvariant();
        return ext is ".mp4" or ".webm" or ".ogg" or ".mov";
    }

    private string GetEmbedUrl()
    {
        if (Block == null) return string.Empty;

        var url = Block.SourceUrl;
        var type = Block.EmbedType.ToLowerInvariant();

        var result = type switch
        {
            "youtube" => ConvertToYouTubeEmbedUrl(url),
            "vimeo" => ConvertToVimeoEmbedUrl(url),
            _ => url
        };

        if (Block.AutoPlay && !string.IsNullOrEmpty(result))
        {
            var sep = result.Contains('?') ? '&' : '?';
            result += $"{sep}autoplay=1";
        }

        return result;
    }

    private string GetAllowAttribute()
    {
        if (Block == null) return string.Empty;
        
        var allow = Block.EmbedType.ToLowerInvariant() switch
        {
            "youtube" => "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture",
            "vimeo" => "autoplay; fullscreen; picture-in-picture",
            _ => string.Empty
        };

        // Ensure autoplay permission is included when auto-play is enabled
        if (Block.AutoPlay && !allow.Contains("autoplay"))
        {
            allow = string.IsNullOrEmpty(allow) ? "autoplay" : $"{allow}; autoplay";
        }

        return allow;
    }

    private string ConvertToYouTubeEmbedUrl(string url)
    {
        if (url.Contains("youtube.com/watch"))
        {
            var uri = new Uri(url);
            var query = HttpUtility.ParseQueryString(uri.Query);
            var videoId = query["v"];
            if (!string.IsNullOrEmpty(videoId))
            {
                return $"https://www.youtube.com/embed/{videoId}";
            }
        }

        if (url.Contains("youtu.be/"))
        {
            var videoId = url.Split('/').Last().Split('?').First();
            return $"https://www.youtube.com/embed/{videoId}";
        }

        return url;
    }

    private string ConvertToVimeoEmbedUrl(string url)
    {
        if (url.Contains("vimeo.com/"))
        {
            var videoId = url.Split('/').Last().Split('?').First();
            return $"https://player.vimeo.com/video/{videoId}";
        }

        return url;
    }
}
