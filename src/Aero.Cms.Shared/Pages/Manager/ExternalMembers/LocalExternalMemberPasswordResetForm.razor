@namespace Aero.Cms.Shared.Pages.Manager.ExternalMembers

<section class="rounded-lg border border-slate-700 bg-slate-900 p-6">
    <h2 class="text-lg font-semibold text-slate-100">Issue a local password reset</h2>
    <p class="mt-1 text-sm text-slate-400">Creates a one-time handle for a local member on the selected site. Deliver it through a trusted channel.</p>
    <EditForm Model="Form" OnValidSubmit="SubmitAsync" FormName="local-member-password-reset" class="mt-5 space-y-4">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-sm text-red-400" />
        <label class="block text-sm text-slate-300">External member ID
            <InputNumber @bind-Value="Form.ExternalMemberId" class="mt-1 block w-full rounded border border-slate-600 bg-slate-950 p-2" />
        </label>
        <p class="text-xs text-slate-400">The handle expires in one hour. Issuing a new handle revokes any earlier unused reset for this member.</p>
        <button type="submit" disabled="@(!Enabled || IsBusy)" class="rounded bg-indigo-600 px-4 py-2 text-sm font-semibold text-white disabled:opacity-50">
            @(IsBusy ? "Issuing…" : "Issue reset handle")
        </button>
    </EditForm>
</section>
