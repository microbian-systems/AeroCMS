@namespace Aero.Cms.Shared.Pages.Manager.ExternalMembers

<section class="rounded-lg border border-slate-700 bg-slate-900 p-6">
    <h2 class="text-lg font-semibold text-slate-100">Invite a storefront member</h2>
    <p class="mt-1 text-sm text-slate-400">Invitations grant access only to the currently selected site.</p>
    <EditForm Model="Form" OnValidSubmit="SubmitAsync" FormName="external-invitation" class="mt-5 space-y-4">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-sm text-red-400" />
        <label class="block text-sm text-slate-300">Email
            <InputText @bind-Value="Form.Email" class="mt-1 block w-full rounded border border-slate-600 bg-slate-950 p-2" />
        </label>
        <label class="block text-sm text-slate-300">Expires
            <InputDate @bind-Value="Form.ExpiresAt" class="mt-1 block w-full rounded border border-slate-600 bg-slate-950 p-2" />
        </label>
        <button type="submit" disabled="@(!Enabled || IsBusy)" class="rounded bg-indigo-600 px-4 py-2 text-sm font-semibold text-white disabled:opacity-50">
            @(IsBusy ? "Creating…" : "Create invitation")
        </button>
    </EditForm>
</section>
