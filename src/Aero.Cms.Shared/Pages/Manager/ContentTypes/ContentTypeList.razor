@page "/manager/content-types"
@attribute [Authorize]
@using Aero.Cms.Abstractions.Http.Clients

<PageTitle>Content Types</PageTitle>

<div class="pe-page-content space-y-6">
    <div class="flex items-center justify-between gap-4">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide" style="color: var(--pe-text-muted);">Structured content</p>
            <h1 class="text-2xl font-bold pe-heading">Content Types</h1>
            <p class="mt-1 text-sm pe-description">Create reusable entry forms for testimonials, FAQs, team members, and other structured content.</p>
        </div>
        <div class="flex gap-3">
            <RadzenTextBox Placeholder="Search types..."
                           Value="@_searchText"
                           ValueChanged="@OnSearchChanged"
                           class="w-64" />
            <RadzenButton Icon="add"
                          Text="New Content Type"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@CreateType" />
        </div>
    </div>

    <RadzenDataGrid @ref="_grid"
                    Data="@FilteredTypes"
                    TItem="ContentTypeSummary"
                    IsLoading="@_isLoading"
                    AllowPaging="true"
                    AllowSorting="true"
                    PageSize="10"
                    PageSizeOptions="@(new List<int> { 10, 20, 50 })"
                    PagerHorizontalAlign="HorizontalAlign.Left"
                    ShowPagingSummary="true"
                    RowClick="@OnRowClick"
                    class="aero-grid cursor-pointer"
                    EmptyText="No content types found. Create one to start building reusable content.">
        <Columns>
            <RadzenDataGridColumn TItem="ContentTypeSummary" Property="Name" Title="Type" MinWidth="280px">
                <Template Context="type">
                    <div class="flex flex-col gap-1">
                        <span class="font-medium" style="color: var(--pe-text-primary);">@type.Name</span>
                        @if (!string.IsNullOrWhiteSpace(type.Description))
                        {
                            <span class="text-sm" style="color: var(--pe-text-secondary);">@type.Description</span>
                        }
                        <code class="text-xs" style="color: var(--pe-text-muted);">@type.Alias</code>
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContentTypeSummary" Property="FieldCount" Title="Fields" Width="120px" TextAlign="TextAlign.Center">
                <Template Context="type">
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{type.FieldCount} fields")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContentTypeSummary" Property="ItemCount" Title="Entries" Width="120px" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn TItem="ContentTypeSummary" Property="AllowPublicUrl" Title="URL" Width="150px">
                <Template Context="type">
                    @if (type.AllowPublicUrl)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Public pages" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Embedded" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContentTypeSummary" Property="HasCustomTemplate" Title="Display" Width="150px">
                <Template Context="type">
                    <span style="color: var(--pe-text-secondary);">@(type.HasCustomTemplate ? "Custom template" : "Auto display")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContentTypeSummary" Property="Category" Title="Category" Width="150px">
                <Template Context="type">
                    @if (!string.IsNullOrWhiteSpace(type.Category))
                    {
                        <span style="color: var(--pe-text-secondary);">@type.Category</span>
                    }
                    else
                    {
                        <span style="color: var(--pe-text-muted);">-</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContentTypeSummary" Title="Actions" Width="180px" Sortable="false" TextAlign="TextAlign.Right">
                <Template Context="type">
                    <div class="flex items-center justify-end gap-2" @onclick:stopPropagation="true">
                        <RadzenButton Icon="edit"
                                      Text="Edit"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Size="ButtonSize.Small"
                                      Click="@(() => EditType(type.Alias))" />
                        <RadzenButton Icon="delete"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Outlined"
                                      Size="ButtonSize.Small"
                                      Click="@(() => DeleteTypeAsync(type.Alias))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>
