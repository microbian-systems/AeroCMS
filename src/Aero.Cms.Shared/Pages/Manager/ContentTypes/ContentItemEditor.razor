@page "/manager/content/{alias}/editor/{id:long?}"
@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Core
@inject NavigationManager Navigation
@inject IContentTypesHttpClient ContentTypesApi
@inject IContentItemsHttpClient ContentItemsApi
@inject DialogService DialogService
@inject NotificationService NotificationService

<div class="pe-page-content space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold pe-heading">@(Id.HasValue ? "Edit" : "New") @typeName</h1>
            <p class="mt-1 text-sm pe-description">Content type: @typeName</p>
        </div>
        <div class="flex gap-4">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@(() => Navigation.NavigateTo($"/manager/content/{Alias}"))" />
            @if (Id.HasValue) { <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@DeleteAsync" /> }
            <RadzenButton Text="Save Draft" ButtonStyle="ButtonStyle.Primary" Click="@SaveAsync" Disabled="@isSaving" />
            <RadzenButton Text="Publish" Icon="publish" ButtonStyle="ButtonStyle.Success" Click="@PublishAsync" Disabled="@(isSaving || !Id.HasValue)" />
        </div>
    </div>

    @if (typeDefinition == null)
    {
        <div class="flex items-center justify-center py-16"><span style="color: var(--pe-text-muted);" class="text-sm">Loading content type definition...</span></div>
        return;
    }

    <RadzenPanel HeaderText="Metadata" ExpandText="Expand" CollapseText="Collapse" IsExpanded="true">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4">
            <div>
                <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">Title <span class="text-red-500">*</span></label>
                <RadzenTextBox Value="@title" ValueChanged="@(v => title = v)" Placeholder="Enter title..." />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">Slug</label>
                <RadzenTextBox Value="@slug" ValueChanged="@(v => slug = v)" Placeholder="url-friendly-slug" />
            </div>
        </div>
    </RadzenPanel>

    <RadzenPanel HeaderText="Content Fields" ExpandText="Expand" CollapseText="Collapse" IsExpanded="true">
        <div class="space-y-6 p-4">
            @for (int i = 0; i < typeDefinition.Fields.Count; i++)
            {
                var f = typeDefinition.Fields[i];
                <div>
                    <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">
                        @(f.Label ?? f.Name) @if (f.Required) { <span class="text-red-500">*</span> }
                    </label>
                    @switch (f.FieldType)
                    {
                        case "text": case "image": case "url":
                            <RadzenTextBox Value="@fieldValues[f.Name]" ValueChanged="@(v => fieldValues[f.Name] = v)" Placeholder="@(f.Placeholder ?? "")" />
                            break;
                        case "richtext":
                            <RadzenTextArea Value="@fieldValues[f.Name]" ValueChanged="@(v => fieldValues[f.Name] = v)" Placeholder="@(f.Placeholder ?? "")" Rows="5" Style="width: 100%;" />
                            break;
                        case "number":
                            <RadzenNumeric TValue="decimal?" Value="@numberValues[f.Name]" ValueChanged="@(v => numberValues[f.Name] = v)" />
                            break;
                        case "boolean":
                            <RadzenCheckBox TValue="bool" CheckboxValue="@boolValues[f.Name]" CheckboxValueChanged="@((bool v) => boolValues[f.Name] = v)" />
                            break;
                        case "date":
                            <RadzenDatePicker TValue="DateTime?" Value="@dateValues[f.Name]" Change="@(args => { if (args is DateTime dt) dateValues[f.Name] = dt; })" />
                            break;
                        default:
                            <RadzenTextBox Value="@fieldValues[f.Name]" ValueChanged="@(v => fieldValues[f.Name] = v)" Placeholder="@(f.Placeholder ?? "")" />
                            break;
                    }
                </div>
            }
        </div>
    </RadzenPanel>
</div>

@code {
    [Parameter] public string Alias { get; set; } = string.Empty;
    [Parameter] public long? Id { get; set; }

    string typeName = "Content";
    ContentTypeDetail? typeDefinition;
    bool isSaving;
    string title = string.Empty;
    string slug = string.Empty;
    Dictionary<string, string> fieldValues = [];
    Dictionary<string, decimal?> numberValues = [];
    Dictionary<string, bool> boolValues = [];
    Dictionary<string, DateTime?> dateValues = [];

    protected override async Task OnInitializedAsync()
    {
        var typeResult = await ContentTypesApi.GetByAliasAsync(Alias);
        if (typeResult is Result<ContentTypeDetail, AeroError>.Ok typeOk) { typeDefinition = typeOk.Value; typeName = typeDefinition.Name; }
        else { Navigation.NavigateTo("/manager/content-types"); return; }
        InitializeFieldDictionaries();
        if (Id.HasValue)
        {
            var itemResult = await ContentItemsApi.GetByIdAsync(Alias, Id.Value);
            if (itemResult is Result<ContentItemDetail, AeroError>.Ok itemOk) { title = itemOk.Value.Title; slug = itemOk.Value.Slug; PopulateFieldValues(itemOk.Value.Fields); }
        }
    }

    void InitializeFieldDictionaries()
    {
        if (typeDefinition == null) return;
        foreach (var field in typeDefinition.Fields)
        {
            switch (field.FieldType)
            {
                case "number": numberValues.TryAdd(field.Name, null); break;
                case "boolean": boolValues.TryAdd(field.Name, false); break;
                case "date": dateValues.TryAdd(field.Name, null); break;
                default: fieldValues.TryAdd(field.Name, string.Empty); break;
            }
        }
    }

    void PopulateFieldValues(IReadOnlyDictionary<string, System.Text.Json.JsonElement> source)
    {
        if (typeDefinition == null) return;
        foreach (var field in typeDefinition.Fields)
        {
            if (!source.TryGetValue(field.Name, out var element)) continue;
            switch (field.FieldType)
            {
                case "number": numberValues[field.Name] = element.ValueKind is System.Text.Json.JsonValueKind.Null or System.Text.Json.JsonValueKind.Undefined ? null : element.GetDecimal(); break;
                case "boolean": boolValues[field.Name] = element.ValueKind == System.Text.Json.JsonValueKind.True; break;
                case "date": dateValues[field.Name] = element.ValueKind is System.Text.Json.JsonValueKind.Null or System.Text.Json.JsonValueKind.Undefined ? null : element.GetDateTime(); break;
                default: fieldValues[field.Name] = element.ValueKind is System.Text.Json.JsonValueKind.Null or System.Text.Json.JsonValueKind.Undefined ? string.Empty : element.GetString() ?? string.Empty; break;
            }
        }
    }

    Dictionary<string, object?> BuildFieldsDictionary()
    {
        var dict = new Dictionary<string, object?>();
        if (typeDefinition == null) return dict;
        foreach (var field in typeDefinition.Fields)
            dict[field.Name] = field.FieldType switch
            {
                "number" => numberValues.GetValueOrDefault(field.Name),
                "boolean" => boolValues.GetValueOrDefault(field.Name),
                "date" => dateValues.GetValueOrDefault(field.Name),
                _ => fieldValues.GetValueOrDefault(field.Name, string.Empty),
            };
        return dict;
    }

    async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(title)) { NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Validation", Detail = "Title is required.", Duration = 4000 }); return; }
        if (string.IsNullOrWhiteSpace(slug)) slug = title.ToLowerInvariant().Replace(' ', '-');
        isSaving = true;
        var request = new CreateContentItemRequest(title, slug, BuildFieldsDictionary(), null, null);
        var result = Id.HasValue ? await ContentItemsApi.UpdateAsync(Alias, Id.Value, request) : await ContentItemsApi.CreateAsync(Alias, request);
        isSaving = false;
        if (result is Result<ContentItemDetail, AeroError>.Failure fail) { NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Save Failed", Detail = fail.Error.ToString(), Duration = 4000 }); return; }
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Saved", Detail = "Content item has been saved.", Duration = 2000 });
        Navigation.NavigateTo($"/manager/content/{Alias}");
    }

    async Task PublishAsync()
    {
        if (!Id.HasValue) { await SaveAsync(); return; }
        isSaving = true;
        var result = await ContentItemsApi.PublishAsync(Alias, Id.Value);
        isSaving = false;
        if (result is Result<ContentItemDetail, AeroError>.Failure fail) { NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Publish Failed", Detail = fail.Error.ToString(), Duration = 4000 }); return; }
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Published", Detail = "Content item has been published.", Duration = 2000 });
        Navigation.NavigateTo($"/manager/content/{Alias}");
    }

    async Task DeleteAsync()
    {
        if (!Id.HasValue) return;
        var confirmed = await DialogService.Confirm("Delete this content item? This cannot be undone.", "Delete Item", new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed != true) return;
        isSaving = true;
        var result = await ContentItemsApi.DeleteAsync(Alias, Id.Value);
        isSaving = false;
        if (result is Result<bool, AeroError>.Failure fail) { NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Delete Failed", Detail = fail.Error.ToString(), Duration = 4000 }); return; }
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Deleted", Detail = "Content item has been deleted.", Duration = 2000 });
        Navigation.NavigateTo($"/manager/content/{Alias}");
    }
}
