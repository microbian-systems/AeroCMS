@page "/manager/content/{alias}/editor/{id:long?}"
@using Aero.Cms.Abstractions.Content
@using Aero.Cms.Shared.Layout
@using Aero.Cms.Shared.Components
@using Microsoft.Extensions.Localization

<PageTitle>@(Id.HasValue ? L["Edit {0}", _typeName] : L["New {0}", _typeName])</PageTitle>

<style>
    .ci-editor-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 1rem;
        align-items: start;
    }

    .ci-panel {
        background: var(--pe-bg-secondary);
        border: 1px solid var(--pe-border);
        border-radius: var(--pe-radius-md);
        padding: 1rem;
    }

    .ci-field {
        border-bottom: 1px solid var(--pe-border);
        padding-bottom: 1rem;
    }

    .ci-field:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .ci-help {
        color: var(--pe-text-secondary);
        font-size: .875rem;
    }

    .ci-muted {
        color: var(--pe-text-muted);
    }

    .ci-image-preview {
        width: 100%;
        max-width: 320px;
        aspect-ratio: 16 / 9;
        border: 1px solid var(--pe-border);
        border-radius: var(--pe-radius-md);
        object-fit: cover;
        background: var(--pe-bg-primary);
    }

    .ci-choice-list { display: grid; gap: .5rem; padding: .75rem; border: 1px solid var(--pe-border); border-radius: var(--pe-radius-md); background: var(--pe-bg-primary); }
    .ci-gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: .75rem; }
    .ci-gallery-card { position: relative; overflow: hidden; border: 1px solid var(--pe-border); border-radius: var(--pe-radius-md); background: var(--pe-bg-primary); }
    .ci-gallery-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
    .ci-gallery-remove { position: absolute; top: .35rem; right: .35rem; min-width: 2.75rem; min-height: 2.75rem; border-radius: 999px; background: color-mix(in srgb, var(--pe-bg-primary) 90%, transparent); color: var(--rz-danger); }
    .ci-gallery-order { display: flex; justify-content: center; gap: .35rem; padding: .5rem; }
    .ci-empty-composite { border: 1px dashed var(--pe-border); border-radius: var(--pe-radius-md); padding: 1rem; text-align: center; color: var(--pe-text-muted); background: var(--pe-bg-primary); }
    .ci-key-value-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; gap: .5rem; align-items: center; }
    .ci-color-control { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }

    @@media (max-width: 1024px) {
        .ci-editor-shell {
            grid-template-columns: 1fr;
        }

        .ci-key-value-row { grid-template-columns: 1fr; }
    }
</style>

<div class="pe-page-content space-y-6">
    <div class="flex items-center justify-between gap-4">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide ci-muted">@L["Content entry"]</p>
            <h1 class="text-2xl font-bold pe-heading">@(Id.HasValue ? L["Edit {0}", _typeName] : L["New {0}", _typeName])</h1>
            <p class="mt-1 text-sm pe-description">@(_allowPublicUrl ? L["This entry can have its own public page."] : L["This entry is designed to be embedded in pages and blocks."])</p>
        </div>
        <div class="flex gap-3">
            <RadzenButton Text="@L["Cancel"]" ButtonStyle="ButtonStyle.Secondary" Click="@Cancel" />
            @if (CanPreviewPublishedPage)
            {
                <button type="button"
                        class="pe-btn pe-btn-secondary"
                        @onclick="OpenPublishedPagePreview"
                        title="@L["Preview published page"]">
                    <span class="rz-button-icon-left rzi rzi-visibility"></span>
                    @L["Preview published page"]
                </button>
            }
            @if (Id.HasValue)
            {
                <RadzenButton Icon="delete" Text="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@DeleteAsync" Disabled="@_isSaving" />
            }
            <RadzenButton Icon="save" Text="@L["Save Draft"]" ButtonStyle="ButtonStyle.Primary" Click="@SaveDraftAsync" Disabled="@_isSaving" />
            @if (Id.HasValue && _publicationState == "Published")
            {
                <RadzenButton Icon="unpublished" Text="@L["Unpublish"]" ButtonStyle="ButtonStyle.Warning" Click="@UnpublishAsync" Disabled="@_isSaving" />
            }
            else
            {
                <RadzenButton Icon="publish" Text="@L["Publish"]" ButtonStyle="ButtonStyle.Success" Click="@PublishAsync" Disabled="@_isSaving" />
            }
        </div>
    </div>

    <div class="flex flex-wrap gap-2 border-b pb-2" style="border-color: var(--pe-border);">
        <button type="button"
                class="pe-btn pe-btn-sm @(_activeTab == "content" ? "pe-btn-primary" : "pe-btn-secondary")"
                @onclick='() => SwitchTab("content")'>
            @L["Content"]
        </button>
        <button type="button"
                class="pe-btn pe-btn-sm @(_activeTab == "translations" ? "pe-btn-primary" : "pe-btn-secondary")"
                @onclick='() => SwitchTab("translations")'>
            @L["Translations"]
        </button>
    </div>

    @if (_typeDefinition is null)
    {
        <div class="ci-panel text-sm ci-muted">@L["Loading entry form..."]</div>
    }
    else if (_activeTab == "content")
    {
        <div class="ci-editor-shell">
            <section class="ci-panel space-y-6" aria-label="Entry fields">
                @if (_typeDefinition.Fields.Count == 0)
                {
                    <div class="text-center py-10">
                        <p class="font-medium" style="color: var(--pe-text-primary);">@L["This content type has no fields yet."]</p>
                        <p class="text-sm mt-1 ci-muted">@L["Add fields to the content type before creating entries."]</p>
                    </div>
                }
                else
                {
                    @foreach (var field in _typeDefinition.Fields)
                    {
                        <div class="ci-field space-y-2">
                            <div>
                                <label class="pe-property-label">
                                    @FieldLabel(field)
                                    @if (field.Required)
                                    {
                                        <span style="color: var(--rz-danger);">*</span>
                                    }
                                </label>
                                @if (!string.IsNullOrWhiteSpace(field.Placeholder))
                                {
                                    <p class="ci-help mt-1">@field.Placeholder</p>
                                }
                                @if (_fieldErrors.TryGetValue(field.Name, out var error))
                                {
                                    <p class="text-sm mt-1" style="color: var(--rz-danger);">@error</p>
                                }
                            </div>

                            @switch (field.FieldType)
                            {
                                case "richtext":
                                    <RadzenTextArea Value="@_fieldValues[field.Name]" ValueChanged="@(v => _fieldValues[field.Name] = v)" Rows="10" Class="w-full" />
                                    break;
                                case "image":
                                    <div class="space-y-3">
                                        @if (!string.IsNullOrWhiteSpace(_fieldValues[field.Name]))
                                        {
                                            <img src="@_fieldValues[field.Name]" alt="" class="ci-image-preview" />
                                        }
                                        <div class="flex gap-2">
                                            <RadzenButton Icon="image" Text="@L["Choose image"]" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => OpenMediaSelector(field.Name))" />
                                            <RadzenTextBox Value="@_fieldValues[field.Name]" ValueChanged="@(v => _fieldValues[field.Name] = v)" Placeholder="@L["Image URL"]" Class="w-full" />
                                        </div>
                                    </div>
                                    break;
                                case "number":
                                    <RadzenNumeric TValue="decimal?" Value="@_numberValues[field.Name]" ValueChanged="@(v => _numberValues[field.Name] = v)" Class="w-full" />
                                    break;
                                case ContentFieldTypes.Range:
                                    var rangeStart = GetIntSetting(field, RangeContentFieldSettings.Start, 0);
                                    var rangeEnd = GetIntSetting(field, RangeContentFieldSettings.End, 10);
                                    <RadzenNumeric TValue="int?"
                                                   Min="@rangeStart"
                                                   Max="@rangeEnd"
                                                   Value="@_rangeValues[field.Name]"
                                                   ValueChanged="@(v => _rangeValues[field.Name] = v)"
                                                   Class="w-full" />
                                    <p class="ci-help">@L["Choose a whole number from {0} through {1}.", rangeStart, rangeEnd]</p>
                                    break;
                                case ContentFieldTypes.Color:
                                    <div class="ci-color-control">
                                        <RadzenColorPicker
                                            Value="@_fieldValues[field.Name]"
                                            ValueChanged="@(value => _fieldValues[field.Name] = value ?? string.Empty)"
                                            ShowHSV="true"
                                            ShowRGBA="true"
                                            ShowColors="true"
                                            ShowButton="true"
                                            ShowArrow="true"
                                            ToggleAriaLabel="@L["Choose {0}", FieldLabel(field)]" />
                                        @if (!string.IsNullOrWhiteSpace(_fieldValues[field.Name]))
                                        {
                                            <code>@_fieldValues[field.Name]</code>
                                            <RadzenButton
                                                Icon="close"
                                                Text="@L["Clear"]"
                                                ButtonStyle="ButtonStyle.Light"
                                                Size="ButtonSize.Small"
                                                Click="@(() => ClearColor(field.Name))" />
                                        }
                                    </div>
                                    break;
                                case "boolean":
                                    <label class="flex items-center gap-2 text-sm" style="color: var(--pe-text-secondary);">
                                        <RadzenCheckBox TValue="bool" @bind-Value="_boolValues[field.Name]" />
                                        @L["Yes"]
                                    </label>
                                    break;
                                case "date":
                                    <RadzenDatePicker TValue="DateTime?" Value="@_dateValues[field.Name]" Change="@(args => SetDateValue(field.Name, args))" Class="w-full" />
                                    break;
                                case "reference":
                                    @if (IsCmsDocumentReference(field))
                                    {
                                        <CmsContentReferencePicker
                                            Culture="@_culture"
                                            AllowedSources="@GetAllowedCmsReferenceSources(field)"
                                            Value="@_cmsReferenceValues[field.Name]"
                                            ValueChanged="@(value => _cmsReferenceValues[field.Name] = value)" />
                                    }
                                    else if (IsContentEntryReference(field))
                                    {
                                        <ContentEntryReferencePicker
                                            Culture="@_culture"
                                            AllowedProviders="@GetAllowedContentEntryProviders(field)"
                                            Value="@_contentEntryReferenceValues[field.Name]"
                                            ValueChanged="@(value => _contentEntryReferenceValues[field.Name] = value)" />
                                    }
                                    else if (IsHierarchyReference(field))
                                    {
                                        <ContentHierarchyReferencePicker
                                            TargetContentTypeId="@GetTargetContentTypeId(field)"
                                            Culture="@_culture"
                                            Value="@_fieldValues[field.Name]"
                                            ValueChanged="@(value => OnReferenceValueChangedAsync(field, value))"
                                            SelectLeafOnly="@GetBoolSetting(field, ReferenceContentFieldSettings.SelectLeafOnly, true)"
                                            ShowAncestors="@GetBoolSetting(field, ReferenceContentFieldSettings.ShowAncestors, true)" />
                                    }
                                    else
                                    {
                                        <ContentReferencePicker
                                            TargetContentTypeId="@GetTargetContentTypeId(field)"
                                            Culture="@_culture"
                                            Value="@_fieldValues[field.Name]"
                                            ValueChanged="@(value => OnReferenceValueChangedAsync(field, value))"
                                            FilterField="@GetStringSetting(field, ReferenceContentFieldSettings.TargetFilterField)"
                                            FilterValue="@GetDependentReferenceValue(field)"
                                            DependencyLabel="@GetDependencyLabel(field)" />
                                    }
                                    break;
                                case ContentFieldTypes.List:
                                    var allowedValues = GetAllowedValues(field);
                                    var maximumSelections = GetIntSetting(field, CompositeContentFieldSettings.MaximumItems, 50);
                                    @if (allowedValues.Count == 0)
                                    {
                                        <div class="ci-empty-composite" role="status">@L["This list has no configured choices. Edit the content type to add allowed values."]</div>
                                    }
                                    else
                                    {
                                        <div class="ci-choice-list" role="group" aria-label="@FieldLabel(field)">
                                            @foreach (var value in allowedValues)
                                            {
                                                <label class="flex items-center gap-3 text-sm" style="color: var(--pe-text-primary);">
                                                    <input type="checkbox" checked="@IsListValueSelected(field.Name, value)" @onchange="@(args => ToggleListValue(field.Name, value, args.Value))" />
                                                    <span>@value</span>
                                                </label>
                                            }
                                        </div>
                                        <p class="ci-help">@L["Choose up to {0}.", maximumSelections]</p>
                                    }
                                    break;
                                case ContentFieldTypes.Gallery:
                                    var gallery = _galleryValues.GetValueOrDefault(field.Name, []);
                                    @if (gallery.Count == 0)
                                    {
                                        <div class="ci-empty-composite">
                                            <RadzenIcon Icon="photo_library" />
                                            <p class="mt-2">@L["No images selected"]</p>
                                            <RadzenButton Icon="add_photo_alternate" Text="@L["Choose images"]" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => OpenGallerySelector(field.Name))" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ci-gallery-grid">
                                            @for (var galleryIndex = 0; galleryIndex < gallery.Count; galleryIndex++)
                                            {
                                                var imageIndex = galleryIndex;
                                                <div class="ci-gallery-card">
                                                    <img src="@gallery[imageIndex]" alt="@L["Gallery image {0}", imageIndex + 1]" />
                                                    <button type="button" class="ci-gallery-remove" title="@L["Remove image"]" aria-label="@L["Remove image {0}", imageIndex + 1]" @onclick="@(() => RemoveGalleryImage(field.Name, imageIndex))">
                                                        <RadzenIcon Icon="close" />
                                                    </button>
                                                    <div class="ci-gallery-order">
                                                        <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" Disabled="@(imageIndex == 0)" title="@L["Move image earlier"]" Click="@(() => MoveGalleryImage(field.Name, imageIndex, -1))" />
                                                        <RadzenButton Icon="arrow_forward" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" Disabled="@(imageIndex == gallery.Count - 1)" title="@L["Move image later"]" Click="@(() => MoveGalleryImage(field.Name, imageIndex, 1))" />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <RadzenButton Icon="add_photo_alternate" Text="@L["Replace selection"]" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => OpenGallerySelector(field.Name))" />
                                    }
                                    break;
                                case ContentFieldTypes.Dictionary:
                                    var dictionaryRows = _dictionaryValues.GetValueOrDefault(field.Name, []);
                                    var numericValues = GetStringSetting(field, CompositeContentFieldSettings.ValueType) == CompositeContentFieldSettings.Number;
                                    @if (dictionaryRows.Count == 0)
                                    {
                                        <div class="ci-empty-composite">@L["Add a label and its value."]</div>
                                    }
                                    @for (var rowIndex = 0; rowIndex < dictionaryRows.Count; rowIndex++)
                                    {
                                        var currentRowIndex = rowIndex;
                                        var row = dictionaryRows[currentRowIndex];
                                        <div class="ci-key-value-row">
                                            <RadzenTextBox @bind-Value="row.Key" Placeholder="@L["Key"]" Class="w-full" />
                                            @if (numericValues)
                                            {
                                                <input type="number" step="any" inputmode="decimal" class="w-full rounded-md shadow-sm sm:text-sm" style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);" @bind="row.Value" placeholder="@L["Number"]" />
                                            }
                                            else
                                            {
                                                <RadzenTextBox @bind-Value="row.Value" Placeholder="@L["Value"]" Class="w-full" />
                                            }
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small" title="@L["Remove value"]" Click="@(() => RemoveDictionaryRow(field.Name, currentRowIndex))" />
                                        </div>
                                    }
                                    <RadzenButton Icon="add" Text="@L["Add value"]" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => AddDictionaryRow(field.Name))" />
                                    break;
                                default:
                                    <RadzenTextBox Value="@_fieldValues[field.Name]" ValueChanged="@(v => _fieldValues[field.Name] = v)" Placeholder="@field.Placeholder" Class="w-full" />
                                    break;
                            }
                        </div>
                    }
                }
            </section>

            <aside class="space-y-4">
                <section class="ci-panel space-y-4" aria-label="Entry metadata">
                    <div class="flex items-center justify-between gap-3">
                        <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">@L["Details"]</h2>
                        <RadzenBadge BadgeStyle="@StatusBadgeStyle" Text="@_publicationState" />
                    </div>
                    <label class="pe-property-group">
                        <span class="pe-property-label">@L["Title"]</span>
                        <RadzenTextBox Value="@_title" ValueChanged="@OnTitleChanged" Placeholder="@L["Untitled {0}", _typeName]" Class="w-full" />
                    </label>
                    @if (_typeDefinition.Structure == ContentStructure.Hierarchical)
                    {
                        <label class="pe-property-group">
                            <span class="pe-property-label">@L["Parent entry"]</span>
                            <select class="w-full rounded-md shadow-sm sm:text-sm"
                                    style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                    @bind="_parentId">
                                <option value="">@L["(root entry)"]</option>
                                @if (_parentId.HasValue && _parentOptions.All(option => option.Id != _parentId.Value))
                                {
                                    <option value="@_parentId.Value">@L["Current parent #{0}", _parentId.Value]</option>
                                }
                                @foreach (var option in _parentOptions)
                                {
                                    <option value="@option.Id">@option.Title — @option.ContentTypeAlias — @option.Breadcrumb</option>
                                }
                            </select>
                            <span class="text-xs ci-muted">@L["Eligible parents are shown with their content type and breadcrumb."]</span>
                        </label>
                        <label class="pe-property-group">
                            <span class="pe-property-label">@L["Sibling order"]</span>
                            <input type="number"
                                   min="0"
                                   class="w-full rounded-md shadow-sm sm:text-sm"
                                   style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                   @bind="_sortOrder" />
                            <span class="text-xs ci-muted">@L["Lower values appear first; titles break ties."]</span>
                        </label>
                    }
                    @if (_allowPublicUrl)
                    {
                        <label class="pe-property-group">
                            <span class="pe-property-label">@L["Public URL slug"]</span>
                            <RadzenTextBox Value="@_slug" ValueChanged="@OnSlugChanged" Placeholder="@L["entry-url"]" Class="w-full" />
                            <span class="text-xs ci-muted">/content/@Alias/@_slug</span>
                        </label>
                    }
                    else
                    {
                        <div class="ci-panel" style="background: var(--pe-bg-primary);">
                            <h3 class="text-sm font-semibold" style="color: var(--pe-text-primary);">@L["Embedded entry"]</h3>
                            <p class="ci-help mt-1">@L["This entry will be selected from blocks or listings instead of having a standalone page."]</p>
                        </div>
                    }
                    @if (Id.HasValue)
                    {
                        <div class="grid grid-cols-2 gap-3 text-sm">
                            <div>
                                <span class="ci-muted">@L["Version"]</span>
                                <p style="color: var(--pe-text-primary);">v@_versionNumber</p>
                            </div>
                            <div>
                                <span class="ci-muted">@L["Published"]</span>
                                <p style="color: var(--pe-text-primary);">@FormatDate(_publishedOn)</p>
                            </div>
                        </div>
                    }
                </section>

                <section class="ci-panel space-y-3" aria-label="Publishing note">
                    <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">@L["Publishing"]</h2>
                    <p class="ci-help">@L["Drafts can be incomplete. Publishing checks required fields and then makes the latest version available to pages, blocks, and public URLs when enabled."]</p>
                </section>
            </aside>
        </div>
    }
    else
    {
        <section class="ci-panel space-y-6" aria-label="Entry translations">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                <div>
                    <h2 class="text-xl font-semibold" style="color: var(--pe-text-primary);">@L["Culture / Translations"]</h2>
                    <p class="text-sm mt-1 ci-muted">
                        @(Id.HasValue ? L["Manage localized versions for this entry."] : L["Save this entry before creating localized versions."])
                    </p>
                </div>
                @if (Id.HasValue)
                {
                    <RadzenButton Icon="add"
                                  Text="@L["Add Translation"]"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Click="@AddTranslationAsync"
                                  Disabled="@(_isSaving || !AvailableTranslationCultures.Any())" />
                }
            </div>

            @if (!Id.HasValue)
            {
                <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                    <p class="text-sm ci-muted">@L["Save the entry before creating translation variants."]</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                        <span class="block text-xs font-semibold uppercase tracking-wider mb-1 ci-muted">@L["Current Variant"]</span>
                        <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@FormatCulture(_culture)</span>
                    </div>
                    <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                        <span class="block text-xs font-semibold uppercase tracking-wider mb-1 ci-muted">@L["Default Culture"]</span>
                        <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@FormatCulture(_currentSite?.DefaultCulture)</span>
                    </div>
                    <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                        <span class="block text-xs font-semibold uppercase tracking-wider mb-1 ci-muted">@L["Coverage"]</span>
                        <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@_cultureVariants.Count @L["of"] @SupportedCultures.Count @L["site cultures"]</span>
                    </div>
                </div>

                @if (_translationGroupId.HasValue || Id.HasValue)
                {
                    <div class="text-xs font-mono px-2 py-1 rounded inline-flex"
                         style="background: var(--pe-bg-primary); color: var(--pe-text-muted); border: 1px solid var(--pe-border);">
                        Group @(_translationGroupId ?? Id)
                    </div>
                }

                <div class="rounded-md border overflow-hidden" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                    @if (_isLoadingTranslations)
                    {
                        <div class="p-4 text-sm ci-muted">@L["Loading translations..."]</div>
                    }
                    else if (_cultureVariants.Count == 0)
                    {
                        <div class="p-4 text-sm ci-muted">@L["No translation variants found."]</div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead style="background: var(--pe-bg-tertiary); color: var(--pe-text-muted);">
                                    <tr>
                                        <th class="px-4 py-2 text-left font-semibold">@L["Culture"]</th>
                                        <th class="px-4 py-2 text-left font-semibold">@L["Title"]</th>
                                        <th class="px-4 py-2 text-left font-semibold">@L["Slug"]</th>
                                        <th class="px-4 py-2 text-left font-semibold">@L["Status"]</th>
                                        <th class="px-4 py-2 text-right font-semibold">@L["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var variant in _cultureVariants)
                                    {
                                        var isCurrent = Id == variant.Id;
                                        <tr class="border-t" style="border-color: var(--pe-border); color: var(--pe-text-primary);">
                                            <td class="px-4 py-3">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <span class="font-semibold">@FormatCulture(variant.Culture)</span>
                                                    @if (isCurrent)
                                                    {
                                                        <span class="rounded px-2 py-0.5 text-xs font-semibold" style="background: var(--pe-bg-secondary); color: var(--pe-text-secondary);">@L["Current"]</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="px-4 py-3">@variant.Title</td>
                                            <td class="px-4 py-3"><span class="font-mono text-xs">@variant.Slug</span></td>
                                            <td class="px-4 py-3">@variant.PublicationState</td>
                                            <td class="px-4 py-3">
                                                <div class="flex justify-end gap-2">
                                                    <RadzenButton Icon="edit"
                                                                  Text="@L["Open"]"
                                                                  ButtonStyle="ButtonStyle.Secondary"
                                                                  Size="ButtonSize.Small"
                                                                  Click="@(() => OpenTranslation(variant.Id))" />
                                                    <RadzenButton Icon="delete"
                                                                  Text="@L["Delete"]"
                                                                  ButtonStyle="ButtonStyle.Danger"
                                                                  Variant="Variant.Outlined"
                                                                  Size="ButtonSize.Small"
                                                                  Disabled="@isCurrent"
                                                                  Click="@(() => DeleteTranslationAsync(variant))" />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

<PreviewOverlay Visible="@_showPublishedPagePreview"
                OnClose="ClosePublishedPagePreview"
                FrameUrl="@FrameUrl"
                UrlBarText="@PublicPath"
                SuppressBrowserLinkErrors="true"
                Title="@L["Content preview"]" />

<MediaSelectorModal Show="@_showMediaSelector"
                    MultiSelect="@(_activeGalleryField is not null)"
                    MaximumSelections="@ActiveGalleryMaximumSelections"
                    OnClose="@CloseMediaSelector"
                    OnConfirm="@ConfirmMediaSelection" />
