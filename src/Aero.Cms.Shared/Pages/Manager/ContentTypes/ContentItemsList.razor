@page "/manager/content/{alias}"
@attribute [Authorize]
@using Aero.Cms.Abstractions.Http.Clients

<PageTitle>@_typeName</PageTitle>

<div class="pe-page-content space-y-6">
    <div class="flex items-center justify-between gap-4">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide" style="color: var(--pe-text-muted);">Content entries</p>
            <h1 class="text-2xl font-bold pe-heading">@_typeName</h1>
            <p class="mt-1 text-sm pe-description">@HeaderDescription</p>
        </div>
        <div class="flex gap-3">
            <RadzenTextBox Placeholder="@($"Search {_typeName.ToLowerInvariant()}...")"
                           Value="@_searchText"
                           ValueChanged="@OnSearchChanged"
                           class="w-64" />
            <RadzenButton Icon="add"
                          Text="@($"New {_typeName}")"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@CreateItem" />
        </div>
    </div>

    <RadzenDataGrid @ref="_grid"
                    Data="@_items"
                    TItem="ContentItemSummary"
                    Count="@_count"
                    LoadData="@LoadData"
                    IsLoading="@_isLoading"
                    AllowPaging="true"
                    AllowSorting="true"
                    PageSize="10"
                    PageSizeOptions="@(new List<int> { 10, 20, 50 })"
                    PagerHorizontalAlign="HorizontalAlign.Left"
                    ShowPagingSummary="true"
                    RowClick="@OnRowClick"
                    class="aero-grid cursor-pointer"
                    EmptyText="No entries found. Create the first one when you're ready.">
        <Columns>
            <RadzenDataGridColumn TItem="ContentItemSummary" Property="Title" Title="Entry" MinWidth="260px">
                <Template Context="item">
                    <div class="flex flex-col gap-1">
                        <span class="font-medium" style="color: var(--pe-text-primary);">@item.Title</span>
                        @if (!string.IsNullOrWhiteSpace(item.FirstFieldValue))
                        {
                            <span class="text-sm" style="color: var(--pe-text-secondary);">@FormatFirstField(item.FirstFieldValue)</span>
                        }
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContentItemSummary" Property="Slug" Title="URL" Width="220px">
                <Template Context="item">
                    @if (_allowPublicUrl)
                    {
                        <code class="text-xs" style="color: var(--pe-text-muted);">/content/@Alias/@item.Slug</code>
                    }
                    else
                    {
                        <span style="color: var(--pe-text-muted);">Embedded only</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContentItemSummary" Property="PublicationState" Title="Status" Width="130px">
                <Template Context="item">
                    @if (item.PublicationState == "Published")
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Published" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Draft" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContentItemSummary" Property="PublishedOn" Title="Published" Width="150px">
                <Template Context="item">
                    <span style="color: var(--pe-text-secondary);">@FormatDate(item.PublishedOn)</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContentItemSummary" Property="VersionNumber" Title="Version" Width="110px" TextAlign="TextAlign.Center">
                <Template Context="item">
                    <code class="text-xs" style="color: var(--pe-text-muted);">v@(item.VersionNumber)</code>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContentItemSummary" Title="Actions" Width="170px" Sortable="false" TextAlign="TextAlign.Right">
                <Template Context="item">
                    <div class="flex items-center justify-end gap-2" @onclick:stopPropagation="true">
                        <RadzenButton Icon="edit"
                                      Text="Edit"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Size="ButtonSize.Small"
                                      Click="@(() => EditItem(item.Id))" />
                        <RadzenButton Icon="delete"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Outlined"
                                      Size="ButtonSize.Small"
                                      Click="@(() => DeleteItemAsync(item.Id))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>
