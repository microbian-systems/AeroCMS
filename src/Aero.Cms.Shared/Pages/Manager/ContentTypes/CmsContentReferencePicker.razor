@namespace Aero.Cms.Shared.Pages.Manager.ContentTypes

<div class="cms-reference-picker">
    <label class="pe-property-group">
        <span class="pe-property-label">@L["Content source"]</span>
        <select class="w-full rounded-md shadow-sm sm:text-sm"
                style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                value="@_selectedSource"
                disabled="@_loadingSources"
                @onchange="OnSourceChangedAsync">
            <option value="">@L["Choose a content source"]</option>
            @foreach (var source in _sources)
            {
                <option value="@source.Key">@source.DisplayName</option>
            }
        </select>
    </label>

    @if (_loadingSources || _loadingOptions)
    {
        <div class="cms-reference-state" role="status">
            <RadzenProgressBarCircular ShowValue="false" Size="ProgressBarCircularSize.Small" />
            <span>@L["Loading content…"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="cms-reference-state cms-reference-error" role="alert">
            <RadzenIcon Icon="error_outline" />
            <span>@_error</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_selectedSource))
    {
        <label class="pe-property-group">
            <span class="pe-property-label">@SourceEntryLabel</span>
            <RadzenDropDown TValue="string"
                            Data="@_options"
                            TextProperty="@nameof(CmsReferencePickerOption.DisplayText)"
                            ValueProperty="@nameof(CmsReferencePickerOption.Value)"
                            Value="@Value?.Id"
                            ValueChanged="OnOptionChangedAsync"
                            AllowClear="true"
                            AllowFiltering="true"
                            SearchText="@_searchText"
                            SearchTextChanged="OnSearchTextChangedAsync"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="@L["Search or choose content"]"
                            EmptyText="@L["No matching content"]"
                            Class="w-full" />
        </label>
        <p class="cms-reference-help">
            <RadzenIcon Icon="link" />
            @(_options.Count == 1
                ? L["1 available item"]
                : L["{0} available items", _options.Count])
        </p>
    }
</div>
