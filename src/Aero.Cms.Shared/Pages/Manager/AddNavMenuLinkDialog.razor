@using Aero.Cms.Abstractions.Http.Clients

<div class="p-6 rounded-2xl" style="background: var(--pe-bg-secondary);">
    <div class="mb-6">
        <h3 class="text-lg font-bold" style="color: var(--pe-text-primary);">@L["Add Header Link"]</h3>
        <p class="text-xs mt-1" style="color: var(--pe-text-muted);">@L["Enter a URL manually or choose an existing page."]</p>
    </div>

    <div class="space-y-4">
        <div class="flex flex-col gap-1.5">
            <label for="addNavLinkLabel" class="text-[10px] font-black uppercase tracking-widest" style="color: var(--pe-text-muted);">@L["Label"]</label>
            <RadzenTextBox id="addNavLinkLabel"
                           @bind-Value="_label"
                           Placeholder="@L["About"]"
                           class="w-full border-none rounded-xl text-sm px-4 py-2"
                           style="background: var(--pe-bg-tertiary);" />
        </div>

        <div class="flex flex-col gap-1.5">
            <label for="addNavLinkUrl" class="text-[10px] font-black uppercase tracking-widest" style="color: var(--pe-text-muted);">@L["URL"]</label>
            <div class="flex gap-2">
                <RadzenTextBox id="addNavLinkUrl"
                               Value="@_url"
                               ValueChanged="@OnUrlChanged"
                               Placeholder="@L["/about"]"
                               class="flex-1 border-none rounded-xl text-sm px-4 py-2"
                               style="background: var(--pe-bg-tertiary);" />
                <RadzenButton Icon="search"
                              Text="@L["Pages"]"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Filled"
                              Click="@TogglePageSearch" />
            </div>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm"
                   style="border: 1px solid var(--pe-border); background: var(--pe-bg-tertiary); color: var(--pe-text-primary);">
                <input type="checkbox"
                       checked="@_isExternal"
                       @onchange="OnExternalChanged" />
                <span>@L["External link"]</span>
            </label>

            <div class="flex flex-col gap-1.5">
                <label for="addNavLinkTarget" class="text-[10px] font-black uppercase tracking-widest" style="color: var(--pe-text-muted);">@L["Target"]</label>
                <select id="addNavLinkTarget"
                        @bind="_target"
                        class="w-full rounded-xl px-3 py-2 text-sm"
                        style="border: 1px solid var(--pe-border); background: var(--pe-bg-tertiary); color: var(--pe-text-primary);">
                    @foreach (var option in TargetOptions)
                    {
                        <option value="@option.Value">@option.Text (@option.Value)</option>
                    }
                </select>
            </div>
        </div>

        <div class="flex flex-col gap-1.5">
            <label for="addNavLinkAltText" class="text-[10px] font-black uppercase tracking-widest" style="color: var(--pe-text-muted);">@L["Alt Text"]</label>
            <RadzenTextBox id="addNavLinkAltText"
                           @bind-Value="_altText"
                           Placeholder="@L["Optional link description"]"
                           class="w-full border-none rounded-xl text-sm px-4 py-2"
                           style="background: var(--pe-bg-tertiary);" />
        </div>

        @if (_showPageSearch)
        {
            <div class="rounded-xl border p-4 space-y-3" style="border-color: var(--pe-border); background: var(--pe-bg-primary);">
                <div class="flex gap-2">
                    <RadzenTextBox Value="@_pageSearch"
                                   ValueChanged="@OnPageSearchChanged"
                                   Placeholder="@L["Search pages..."]"
                                   class="flex-1 border-none rounded-xl text-sm px-4 py-2"
                                   style="background: var(--pe-bg-secondary);" />
                    <RadzenButton Icon="search"
                                  Text="@L["Search"]"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Variant="Variant.Filled"
                                  Click="@SearchPagesAsync"
                                  Disabled="@_isSearching" />
                </div>

                <RadzenDataGrid Data="@_pages"
                                TItem="PageSummary"
                                IsLoading="@_isSearching"
                                AllowPaging="true"
                                PageSize="5"
                                class="aero-grid cursor-pointer"
                                RowClick="@(args => SelectPageAsync(args.Data))"
                                EmptyText="@L["No matching pages found."]">
                    <Columns>
                        <RadzenDataGridColumn TItem="PageSummary" Property="Title" Title="@L["Page"]">
                            <Template Context="pageItem">
                                <div class="flex flex-col gap-1">
                                    <span class="font-medium" style="color: var(--pe-text-primary);">@pageItem.Title</span>
                                    <span class="text-xs" style="color: var(--pe-text-secondary);">/@pageItem.Slug.TrimStart('/')</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PageSummary" Title="@L["Status"]" Width="120px">
                            <Template Context="pageItem">
                                <RadzenBadge BadgeStyle="@(pageItem.PublishedAt.HasValue ? BadgeStyle.Success : BadgeStyle.Info)"
                                             Text="@(pageItem.PublishedAt.HasValue ? L["Published"] : L["Draft"])" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
    </div>

    <div class="mt-8 pt-6 border-t flex justify-end gap-3" style="border-color: var(--pe-border);">
        <RadzenButton Text="@L["Cancel"]"
                      ButtonStyle="ButtonStyle.Light"
                      Variant="Variant.Text"
                      Click="@Cancel" />
        <RadzenButton Text="@L["Add Link"]"
                      Icon="add"
                      ButtonStyle="ButtonStyle.Primary"
                      Variant="Variant.Filled"
                      Disabled="@IsSubmitDisabled"
                      class="rounded-xl px-6 shadow-lg shadow-indigo-500/20"
                      Click="@Submit" />
    </div>
</div>
