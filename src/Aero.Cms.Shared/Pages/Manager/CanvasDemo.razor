@page "/manager/canvas-demo"
@attribute [Authorize]
@using Aero.Cms.Abstractions.Blocks.Editor
@using Aero.Cms.Abstractions.Blocks.Neo
@using Aero.Cms.Shared.Pages.Manager.PageEditor.Canvas
@using System.Text.Json
@inject IPageEditorDefinitionRegistry DefinitionRegistry

<h3 class="text-lg font-semibold mb-2">CanvasNode Demo — Full Catalog</h3>
<p class="text-sm text-gray-500 mb-4">Validates all 22 catalog definitions render via CanvasTree.</p>

@if (_demoTree is null)
{
    <p class="text-gray-400">Loading...</p>
}
else
{
    <CascadingValue Value="DefinitionRegistry">
        <CanvasTree RootNode="@_demoTree" />
    </CascadingValue>

    <div class="mt-4 text-xs text-gray-400">
        <p>@_nodeCount nodes rendered across @_definitionCount catalog definitions.</p>
    </div>
}

@code {
    private NeoPageNode? _demoTree;
    private int _nodeCount;
    private int _definitionCount;

    protected override void OnInitialized()
    {
        _demoTree = BuildDemoTree();
    }

    private NeoPageNode BuildDemoTree()
    {
        var trees = new List<NeoPageNode>
        {
            BuildSection("Leaf Primitives", BuildLeafPrimitives()),
            BuildSection("Semantic Containers", BuildSemanticContainers()),
            BuildSection("Grid System", BuildGridSystem()),
            BuildEmbed(),
        };

        // Count nodes and unique definitions
        _nodeCount = CountNodes(trees);
        _definitionCount = CountDefinitions(trees);

        return new NeoPageNode
        {
            NodeId = "demo-root",
            CatalogId = "primitive.section",
            Kind = NeoPageNodeKind.Section,
            Properties = new Dictionary<string, JsonElement>(),
            Children = trees
        };
    }

    private NeoPageNode BuildSection(string label, NeoPageNode child)
    {
        child.Properties ??= [];
        return child;
    }

    private NeoPageNode BuildSection(string label, List<NeoPageNode> children)
    {
        return new NeoPageNode
        {
            NodeId = $"demo-{label.ToLowerInvariant().Replace(" ", "-")}",
            CatalogId = "primitive.section",
            Kind = NeoPageNodeKind.Section,
            Children = children
        };
    }

    // ── Leaf primitives ──────────────────────────────────────────

    private List<NeoPageNode> BuildLeafPrimitives()
    {
        return
        [
            Node("demo-h1", "primitive.heading", NeoPageNodeKind.Primitive, new()
            {
                ["text"] = Serialize("This is a Heading"),
                ["level"] = Serialize(1)
            }),
            Node("demo-h2", "primitive.heading", NeoPageNodeKind.Primitive, new()
            {
                ["text"] = Serialize("Section Heading"),
                ["level"] = Serialize(2)
            }),
            Node("demo-text", "primitive.text", NeoPageNodeKind.Primitive, new()
            {
                ["text"] = Serialize("A paragraph of body text rendered as a primitive.")
            }),
            Node("demo-code", "primitive.code", NeoPageNodeKind.Primitive, new()
            {
                ["code"] = Serialize("Console.WriteLine(\"Hello, AeroCMS!\");"),
                ["language"] = Serialize("csharp")
            }),
            Node("demo-quote", "primitive.blockquote", NeoPageNodeKind.Primitive, new()
            {
                ["text"] = Serialize("The best way to predict the future is to create it."),
                ["citation"] = Serialize("Peter Drucker")
            }),
            Node("demo-btn", "primitive.button", NeoPageNodeKind.Primitive, new()
            {
                ["text"] = Serialize("Click Me"),
                ["url"] = Serialize("#")
            }),
            Node("demo-img", "primitive.image", NeoPageNodeKind.Primitive, new()
            {
                ["url"] = Serialize("https://images.pexels.com/photos/1181244/pexels-photo-1181244.jpeg"),
                ["alt"] = Serialize("Sample image")
            }),
            Node("demo-pill", "primitive.pill", NeoPageNodeKind.Primitive, new()
            {
                ["text"] = Serialize("New")
            }),
            Node("demo-icon", "primitive.icon", NeoPageNodeKind.Primitive, new()
            {
                ["name"] = Serialize("star")
            }),
            Node("demo-sep", "primitive.separator", NeoPageNodeKind.Primitive, new()),
        ];
    }

    // ── Semantic containers ─────────────────────────────────────

    private List<NeoPageNode> BuildSemanticContainers()
    {
        return
        [
            new NeoPageNode
            {
                NodeId = "demo-header",
                CatalogId = "primitive.header",
                Kind = NeoPageNodeKind.Container,
                Children =
                [
                    Node("demo-h3", "primitive.heading", NeoPageNodeKind.Primitive, new()
                    {
                        ["text"] = Serialize("Header Content"),
                        ["level"] = Serialize(3)
                    })
                ]
            },
            new NeoPageNode
            {
                NodeId = "demo-nav",
                CatalogId = "primitive.nav",
                Kind = NeoPageNodeKind.Container,
                Children =
                [
                    Node("demo-nav-btn", "primitive.button", NeoPageNodeKind.Primitive, new()
                    {
                        ["text"] = Serialize("Home"),
                        ["url"] = Serialize("#")
                    }),
                    Node("demo-nav-btn2", "primitive.button", NeoPageNodeKind.Primitive, new()
                    {
                        ["text"] = Serialize("About"),
                        ["url"] = Serialize("#")
                    })
                ]
            },
            new NeoPageNode
            {
                NodeId = "demo-article",
                CatalogId = "primitive.article",
                Kind = NeoPageNodeKind.Container,
                Children =
                [
                    Node("demo-art-h2", "primitive.heading", NeoPageNodeKind.Primitive, new()
                    {
                        ["text"] = Serialize("Article Title"),
                        ["level"] = Serialize(2)
                    }),
                    Node("demo-art-text", "primitive.text", NeoPageNodeKind.Primitive, new()
                    {
                        ["text"] = Serialize("Article body content goes here.")
                    })
                ]
            },
            new NeoPageNode
            {
                NodeId = "demo-aside",
                CatalogId = "primitive.aside",
                Kind = NeoPageNodeKind.Container,
                Children =
                [
                    Node("demo-aside-pill", "primitive.pill", NeoPageNodeKind.Primitive, new()
                    {
                        ["text"] = Serialize("Sidebar")
                    }),
                    Node("demo-aside-text", "primitive.text", NeoPageNodeKind.Primitive, new()
                    {
                        ["text"] = Serialize("Supplementary info.")
                    })
                ]
            },
            new NeoPageNode
            {
                NodeId = "demo-footer",
                CatalogId = "primitive.footer",
                Kind = NeoPageNodeKind.Container,
                Children =
                [
                    Node("demo-footer-text", "primitive.text", NeoPageNodeKind.Primitive, new()
                    {
                        ["text"] = Serialize("Footer — © 2026 AeroCMS")
                    })
                ]
            },
            BuildForm(),
        ];
    }

    private NeoPageNode BuildForm()
    {
        return new NeoPageNode
        {
            NodeId = "demo-form",
            CatalogId = "primitive.form",
            Kind = NeoPageNodeKind.Container,
            Children =
            [
                Node("demo-form-h3", "primitive.heading", NeoPageNodeKind.Primitive, new()
                {
                    ["text"] = Serialize("Contact Form"),
                    ["level"] = Serialize(3)
                }),
                Node("demo-form-text", "primitive.text", NeoPageNodeKind.Primitive, new()
                {
                    ["text"] = Serialize("Form fields would go here.")
                }),
                Node("demo-form-btn", "primitive.button", NeoPageNodeKind.Primitive, new()
                {
                    ["text"] = Serialize("Submit"),
                    ["url"] = Serialize("#")
                })
            ]
        };
    }

    // ── Grid system ─────────────────────────────────────────────

    private List<NeoPageNode> BuildGridSystem()
    {
        return
        [
            new NeoPageNode
            {
                NodeId = "demo-grid",
                CatalogId = "primitive.grid",
                Kind = NeoPageNodeKind.Container,
                Properties = new()
                {
                    ["columns"] = Serialize(12),
                    ["gap"] = Serialize(4)
                },
                Children =
                [
                    // Row 1
                    new NeoPageNode
                    {
                        NodeId = "demo-row-1",
                        CatalogId = "primitive.grid-row",
                        Kind = NeoPageNodeKind.Container,
                        Properties = new()
                        {
                            ["gap"] = Serialize(4)
                        },
                        Children =
                        [
                            new NeoPageNode
                            {
                                NodeId = "demo-cell-1a",
                                CatalogId = "primitive.grid-cell",
                                Kind = NeoPageNodeKind.Container,
                                Properties = new() { ["span"] = Serialize(6) },
                                Children =
                                [
                                    Node("demo-cell-1a-text", "primitive.text", NeoPageNodeKind.Primitive, new()
                                    {
                                        ["text"] = Serialize("Left column (span 6).")
                                    })
                                ]
                            },
                            new NeoPageNode
                            {
                                NodeId = "demo-cell-1b",
                                CatalogId = "primitive.grid-cell",
                                Kind = NeoPageNodeKind.Container,
                                Properties = new() { ["span"] = Serialize(6) },
                                Children =
                                [
                                    Node("demo-cell-1b-btn", "primitive.button", NeoPageNodeKind.Primitive, new()
                                    {
                                        ["text"] = Serialize("Right Column"),
                                        ["url"] = Serialize("#")
                                    })
                                ]
                            }
                        ]
                    },
                    // Row 2
                    new NeoPageNode
                    {
                        NodeId = "demo-row-2",
                        CatalogId = "primitive.grid-row",
                        Kind = NeoPageNodeKind.Container,
                        Children =
                        [
                            new NeoPageNode
                            {
                                NodeId = "demo-cell-2",
                                CatalogId = "primitive.grid-cell",
                                Kind = NeoPageNodeKind.Container,
                                Properties = new() { ["span"] = Serialize(12) },
                                Children =
                                [
                                    Node("demo-cell-2-quote", "primitive.blockquote", NeoPageNodeKind.Primitive, new()
                                    {
                                        ["text"] = Serialize("Full-width cell spanning all 12 columns."),
                                        ["citation"] = Serialize("Demo")
                                    })
                                ]
                            }
                        ]
                    }
                ]
            }
        ];
    }

    // ── Embed ────────────────────────────────────────────────────

    private NeoPageNode BuildEmbed()
    {
        return new NeoPageNode
        {
            NodeId = "demo-section-embed",
            CatalogId = "primitive.section",
            Kind = NeoPageNodeKind.Section,
            Children =
            [
                Node("demo-embed-h3", "primitive.heading", NeoPageNodeKind.Primitive, new()
                {
                    ["text"] = Serialize("Embed Block Demo"),
                    ["level"] = Serialize(3)
                }),
                new NeoPageNode
                {
                    NodeId = "demo-embed",
                    CatalogId = "primitive.embed",
                    Kind = NeoPageNodeKind.Primitive,
                    Properties = new Dictionary<string, JsonElement>
                    {
                        ["url"] = Serialize("https://www.youtube.com/watch?v=dQw4w9WgXcQ"),
                        ["aspectRatio"] = Serialize("widescreen"),
                        ["sandbox"] = Serialize("video"),
                        ["title"] = Serialize("Embedded video content")
                    }
                }
            ]
        };
    }

    // ── Helpers ──────────────────────────────────────────────────

    private static NeoPageNode Node(string id, string catalogId, NeoPageNodeKind kind,
        Dictionary<string, JsonElement>? properties = null)
    {
        return new NeoPageNode
        {
            NodeId = id,
            CatalogId = catalogId,
            Kind = kind,
            Properties = properties ?? []
        };
    }

    private static JsonElement Serialize(string value) =>
        JsonSerializer.SerializeToElement(value);

    private static JsonElement Serialize(int value) =>
        JsonSerializer.SerializeToElement(value);

    private static int CountNodes(List<NeoPageNode> nodes)
    {
        var count = nodes.Count;
        foreach (var child in nodes)
            count += CountNodes(child.Children);
        return count;
    }

    private static int CountNodes(IReadOnlyList<NeoPageNode> nodes)
    {
        var count = nodes.Count;
        foreach (var child in nodes)
            count += child.Children.Count + CountNodes(child.Children);
        return count;
    }

    private static int CountDefinitions(List<NeoPageNode> nodes)
    {
        var ids = new HashSet<string>();
        CollectIds(nodes, ids);
        return ids.Count;
    }

    private static void CollectIds(List<NeoPageNode> nodes, HashSet<string> ids)
    {
        foreach (var node in nodes)
        {
            ids.Add(node.CatalogId);
            CollectIds(node.Children, ids);
        }
    }

    private static void CollectIds(IReadOnlyList<NeoPageNode> nodes, HashSet<string> ids)
    {
        foreach (var node in nodes)
        {
            ids.Add(node.CatalogId);
            CollectIds(node.Children, ids);
        }
    }
}
