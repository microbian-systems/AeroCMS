@page "/manager/users/new"
@page "/manager/users/{Id:long}"
@namespace Aero.Cms.Shared.Pages.Manager.Users
@attribute [Authorize]

<PageTitle>@PageTitle</PageTitle>

<div class="pe-page-content space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <button type="button"
                    class="pe-btn pe-btn-ghost pe-btn-sm mb-3"
                    @onclick="@(() => Navigation.NavigateTo("/manager/users"))">
                Back to users
            </button>
            <h1 class="text-2xl font-bold pe-heading">@PageTitle</h1>
            <p class="mt-1 text-sm pe-description">Configure CRM user identity, access roles, and account status.</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <RadzenButton Icon="save"
                          Text="@SaveButtonText"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@SaveAsync"
                          Disabled="@IsSaving" />
            <RadzenButton Icon="close"
                          Text="Cancel"
                          ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => Navigation.NavigateTo("/manager/users"))"
                          Disabled="@IsSaving" />
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="rounded-lg border p-6"
             style="border-color: var(--pe-border); background: var(--pe-bg-secondary);">
            <p class="text-sm pe-description">Loading user...</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
            <section class="space-y-6">
                <div class="rounded-lg border p-5"
                     style="border-color: var(--pe-border); background: var(--pe-bg-secondary);">
                    <div class="mb-5">
                        <h2 class="text-lg font-semibold" style="color: var(--pe-text-primary);">User Details</h2>
                        <p class="mt-1 text-sm pe-description">These fields identify the CRM user in manager workflows.</p>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <label class="pe-field">
                            <span>Display name *</span>
                            <input @bind="DisplayName" placeholder="Ada Lovelace" />
                        </label>
                        <label class="pe-field">
                            <span>Email *</span>
                            <input @bind="Email" placeholder="ada@example.com" />
                        </label>
                        <label class="pe-field">
                            <span>Username *</span>
                            <input @bind="UserName" placeholder="ada" disabled="@(!IsNew)" />
                        </label>
                        @if (IsNew)
                        {
                            <label class="pe-field">
                                <span>Temporary password *</span>
                                <input @bind="Password" type="password" autocomplete="new-password" />
                            </label>
                        }
                    </div>

                    @if (!IsNew)
                    {
                        <p class="mt-3 text-xs" style="color: var(--pe-text-muted);">Usernames are fixed after account creation.</p>
                    }
                </div>

                <div class="rounded-lg border p-5"
                     style="border-color: var(--pe-border); background: var(--pe-bg-secondary);">
                    <div class="mb-5">
                        <h2 class="text-lg font-semibold" style="color: var(--pe-text-primary);">Roles</h2>
                        <p class="mt-1 text-sm pe-description">Assign manager roles for this CRM user.</p>
                    </div>

                    <div class="grid grid-cols-1 gap-3 md:grid-cols-[minmax(0,1fr)_auto]">
                        <label class="pe-field">
                            <span>Add role</span>
                            <input @bind="RoleDraft" @bind:event="oninput" placeholder="Administrator" />
                        </label>
                        <button type="button" class="pe-btn pe-btn-secondary self-end" @onclick="AddRole">Add Role</button>
                    </div>

                    @if (Roles.Count > 0)
                    {
                        <div class="mt-4 flex flex-wrap gap-2">
                            @foreach (var role in Roles)
                            {
                                <button type="button"
                                        class="rounded px-3 py-1 text-sm"
                                        style="background: var(--pe-bg-primary); color: var(--pe-text-secondary); border: 1px solid var(--pe-border);"
                                        title="Remove role"
                                        @onclick="() => RemoveRole(role)">
                                    @role ×
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mt-4 text-sm pe-description">No roles assigned.</p>
                    }
                </div>
            </section>

            <aside class="space-y-4">
                <div class="rounded-lg border p-5"
                     style="border-color: var(--pe-border); background: var(--pe-bg-secondary);">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <div>
                            <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">Account Status</h2>
                            <p class="mt-1 text-sm pe-description">@StatusDescription</p>
                        </div>
                        <RadzenBadge BadgeStyle="@(IsEnabled ? BadgeStyle.Success : BadgeStyle.Danger)"
                                     Text="@(IsEnabled ? "Active" : "Disabled")" />
                    </div>

                    <label class="flex items-center gap-3 text-sm font-medium" style="color: var(--pe-text-secondary);">
                        <input type="checkbox"
                               class="h-4 w-4 rounded"
                               checked="@IsEnabled"
                               disabled="@IsNew"
                               @onchange="@ToggleEnabled" />
                        Account enabled
                    </label>

                    @if (IsNew)
                    {
                        <p class="mt-3 text-xs" style="color: var(--pe-text-muted);">New users are created active.</p>
                    }
                </div>

                @if (!IsNew)
                {
                    <div class="rounded-lg border p-5"
                         style="border-color: var(--pe-border); background: var(--pe-bg-secondary);">
                        <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">Account Metadata</h2>
                        <dl class="mt-4 space-y-3 text-sm">
                            <div>
                                <dt style="color: var(--pe-text-muted);">Created</dt>
                                <dd style="color: var(--pe-text-primary);">@CreatedAtText</dd>
                            </div>
                            <div>
                                <dt style="color: var(--pe-text-muted);">Last login</dt>
                                <dd style="color: var(--pe-text-primary);">@LastLoginText</dd>
                            </div>
                        </dl>
                    </div>
                }
            </aside>
        </div>
    }
</div>
