@page "/manager/navigations"
@page "/manager/navigations/general"
@attribute [Authorize]

@using Aero.Cms.Abstractions.Http.Clients

<div class="pe-page-content space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h1 class="text-2xl font-bold pe-heading">Header Menu</h1>
            <p class="mt-1 text-sm pe-description">Manage the menu that appears in the public site header.</p>
        </div>
        <div class="flex items-center gap-2">
            <RadzenButton Icon="refresh"
                          Text="Refresh"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Click="@LoadMenusAsync"
                          Disabled="@_isLoading" />
            <RadzenButton Icon="add"
                          Text="New Menu"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Click="@CreateMenuAsync"
                          Disabled="@_isSaving" />
        </div>
    </div>

    <RadzenDataGrid @ref="_menuGrid"
                    Data="@_menus"
                    TItem="NavigationSummary"
                    IsLoading="@_isLoading"
                    AllowPaging="true"
                    PageSize="10"
                    class="aero-grid cursor-pointer"
                    RowClick="@(args => OpenEditor(args.Data))"
                    EmptyText="No header menus yet. Create one to begin.">
        <Columns>
            <RadzenDataGridColumn TItem="NavigationSummary" Property="Name" Title="Menu">
                <Template Context="menu">
                    <div class="flex flex-col gap-1">
                        <span class="font-medium" style="color: var(--pe-text-primary);">@menu.Name</span>
                        <span class="text-xs" style="color: var(--pe-text-secondary);">@menu.Title</span>
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="NavigationSummary" Property="State" Title="Status" Width="170px">
                <Template Context="menu">
                    <RadzenBadge BadgeStyle="@BadgeStyleFor(menu.State)" Text="@DisplayState(menu.State)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="NavigationSummary" Property="CreatedAt" Title="Created" Width="180px">
                <Template Context="menu">
                    <span style="color: var(--pe-text-secondary);">@menu.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="NavigationSummary" Title="Links" Width="100px">
                <Template Context="menu">
                    <span style="color: var(--pe-text-secondary);">@menu.ItemCount</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>
