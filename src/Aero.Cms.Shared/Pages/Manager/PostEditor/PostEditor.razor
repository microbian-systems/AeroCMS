@page "/manager/post/editor"
@page "/manager/post/editor/{id:long}"
@attribute [Authorize]
@using BlazorMonaco.Editor
@using Aero.Cms.Shared.Components
@using Aero.Cms.Shared.Components.MarkdownEditor
@using Microsoft.Extensions.Localization

<HeadContent>
    <link rel="stylesheet" href="/_content/Aero.Cms.Modules.Posts/css/blog.css" />
</HeadContent>

<style>
    #post-markdown-editor {
        height: calc(100vh - 320px);
        min-height: 400px;
    }
</style>

@* ── Header ──────────────────────────────────────────── *@
@* Inline preview icon — always visible, toggles the preview overlay *@
<button class="pe-btn pe-btn-ghost pe-btn-sm absolute top-3 left-3 z-10" @onclick="TogglePreview" title="@L["Preview post"]">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
        <circle cx="12" cy="12" r="3"/>
    </svg>
</button>

<div class="space-y-6">
    <div class="pe-page-header">
        <input class="pe-page-title-input" type="text" placeholder="@L["Post Title"]"
               value="@PostTitle" @oninput="e => OnTitleChanged(e.Value?.ToString() ?? string.Empty)"/>
        <div class="pe-page-meta">
            <div class="pe-meta-left">
                <span class="pe-meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                        @L["Last saved:"] <strong>@LastSaved</strong>
                </span>
                <span class="pe-meta-item">
                    — @L["Status:"]
                    @if (PublishedAt.HasValue)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Published" class="px-2 py-1" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Draft" class="px-2 py-1" />
                    }
                </span>
            </div>
            <div class="pe-meta-right">
                <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="TogglePreview" title="@L["Full page preview"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    @L["Preview"]
                </button>
                <button class="pe-btn @(IsSaving ? "pe-btn-secondary" : "pe-btn-primary") pe-btn-sm" @onclick="SavePost" disabled="@IsSaving">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                        <polyline points="17 21 17 13 7 13 7 21"/>
                        <polyline points="7 3 7 8 15 8"/>
                    </svg>
                    @(IsSaving ? L["Saving..."] : L["Save"])
                </button>
                @if (PublishedAt.HasValue)
                {
                    <button class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="UnpublishPost">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        @L["Unpublish"]
                    </button>
                }
                else
                {
                    <button class="pe-btn pe-btn-success pe-btn-sm" @onclick="PublishPost">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        @L["Publish"]
                    </button>
                }
            </div>
        </div>
    </div>

    @* ── Tab bar ─────────────────────────────────────── *@
    @if (ActiveTab != "preview" && !FullPreviewMode)
    {
        <div class="pe-tabs" style="background: var(--pe-bg-secondary); border-bottom: 1px solid var(--pe-border); display: flex; padding: 8px 8px 0; gap: 4px;">
            <button class="@TabBtnClass("editor")" 
                    @onclick='() => SwitchToTab("editor")'>
                @L["Editor"]
            </button>
            <button class="@TabBtnClass("code")" 
                    @onclick='() => SwitchToTab("code")'>
                @L["Code"]
            </button>
            <button class="@TabBtnClass("preview")" 
                    @onclick='() => { SwitchToTab("preview"); }'>
                @L["Preview"]
            </button>
            <button class="@TabBtnClass("metadata")" 
                    @onclick='() => SwitchToTab("metadata")'>
                @L["Metadata"]
            </button>
            <button class="@TabBtnClass("translations")"
                    @onclick='() => SwitchToTab("translations")'>
                @L["Culture / Translations"]
            </button>
        </div>
    }



        @* ── Tab: Editor (TipTap visual Markdown authoring) ── *@
        @* Kept mounted between tabs so selection, undo history, and JS state survive. *@
        <div class="pe-editor-tab" style="@(ActiveTab == "editor" ? "" : "display:none")">
            <AeroMarkdownEditor @ref="_markdownEditor"
                                EditorId="post-markdown-editor-visual"
                                Markdown="@Content"
                                MarkdownChanged="OnMarkdownEditorSynchronized"
                                ContentChanged="OnMarkdownEditorContentChanged"
                                ChooseMediaRequested="OpenBodyMediaSelector"
                                EnhanceRequested="OpenEnhancePanel"
                                AiEnabled="@(AiProviderOptions.Count > 0)"
                                AriaLabel="@L["Post body"]" />
        </div>

        @* Always rendered (CSS hidden) so Monaco stays initialized *@
        <div class="pe-editor-tab" style="@(ActiveTab == "code" ? "" : "display:none")">
            <StandaloneCodeEditor @ref="_editor"
                                  Id="post-markdown-editor"
                                  ConstructionOptions="EditorConstructionOptions"
                                  OnDidChangeModelContent="OnEditorContentChanged" />
        </div>

        @* ── Tab: Metadata ───────────────────────────── *@
        @if (ActiveTab == "metadata")
        {
            <div class="p-6 rounded-lg shadow-sm m-4 space-y-6 max-w-4xl" style="background: var(--pe-bg-secondary); color: var(--pe-text-primary);">
                <h2 class="text-xl font-semibold mb-4" style="color: var(--pe-text-primary);">@L["Post Metadata"]</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Post Title"]</label>
                            <input type="text" class="w-full rounded-md shadow-sm sm:text-sm"
                                   style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                   value="@PostTitle" @oninput="e => OnTitleChanged(e.Value?.ToString() ?? string.Empty)" placeholder="@L["e.g. My First Blog Post"]" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["URL Slug"]</label>
                            <input type="text" class="w-full rounded-md shadow-sm sm:text-sm font-mono"
                                   style="background: var(--pe-bg-primary); color: var(--pe-primary); border: 1px solid var(--pe-border);"
                                   value="@PostSlug" @oninput="e => OnSlugChanged(e.Value?.ToString() ?? string.Empty)" placeholder="@L["e.g. my-first-blog-post"]" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Summary / Excerpt"]</label>
                            <textarea rows="3" class="w-full rounded-md shadow-sm sm:text-sm"
                                      style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                      @oninput="e => OnExcerptChanged(e.Value?.ToString() ?? string.Empty)">@Excerpt</textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["SEO Title"]</label>
                            <input type="text" class="w-full rounded-md shadow-sm sm:text-sm"
                                   style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                   value="@SeoTitle" @oninput="e => OnSeoTitleChanged(e.Value?.ToString() ?? string.Empty)" placeholder="@L["Defaults to post title"]" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["SEO Description"]</label>
                            <textarea rows="3" class="w-full rounded-md shadow-sm sm:text-sm"
                                      style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                      placeholder="@L["Defaults to summary"]"
                                      @oninput="e => OnSeoDescriptionChanged(e.Value?.ToString() ?? string.Empty)">@SeoDescription</textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Featured Image URL"]</label>
                            <div class="flex gap-2">
                                <input type="text" class="flex-1 rounded-md shadow-sm sm:text-sm"
                                       style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                       value="@FeaturedImageUrl" @oninput="e => OnFeaturedImageChanged(e.Value?.ToString() ?? string.Empty)" placeholder="https://..." />
                                <button class="pe-btn pe-btn-secondary pe-btn-sm flex items-center gap-1 whitespace-nowrap"
                                        style="border: 1px solid var(--pe-border);"
                                        @onclick="OpenMediaSelector" type="button">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                        <circle cx="8.5" cy="8.5" r="1.5"/>
                                        <polyline points="21 15 16 10 5 21"/>
                                    </svg>
                                    @L["Media"]
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(FeaturedImageUrl))
                            {
                                <div class="mt-2 rounded-xl overflow-hidden shadow-sm border border-gray-100 max-w-xs">
                                    <img src="@FeaturedImageUrl" class="w-full h-32 object-cover" alt="Featured Image Preview" />
                                </div>
                            }
                        </div>
                        <div class="pt-4 border-t space-y-3" style="border-top-color: var(--pe-border);">
                            <div class="flex items-start gap-2">
                                <input type="checkbox" id="postIncludeSearch" @bind="IncludeInSearch" @bind:after="MarkDirty" class="h-4 w-4 rounded mt-0.5" />
                                <div>
                                    <label for="postIncludeSearch" class="text-sm font-medium" style="color: var(--pe-text-secondary);">@L["Include in site search"]</label>
                                    <p class="text-xs" style="color: var(--pe-text-muted);">@L["Allow the published post to appear in this site's search results."]</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-2">
                                <input type="checkbox" id="postIncludePublicAi" @bind="IncludeInPublicAi" @bind:after="MarkDirty"
                                       disabled="@(!IncludeInSearch)" class="h-4 w-4 rounded mt-0.5" />
                                <div>
                                    <label for="postIncludePublicAi" class="text-sm font-medium" style="color: var(--pe-text-secondary);">@L["Use in public AI answers"]</label>
                                    <p class="text-xs" style="color: var(--pe-text-muted);">@L["Allow published post content to ground public visitor answers."]</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Category"]</label>
                            <select class="w-full rounded-md shadow-sm sm:text-sm"
                                    style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                    value="@CategoryId" @onchange="e => OnCategoryChanged(e.Value?.ToString() ?? string.Empty)">
                                <option value="0">@L["Uncategorized"]</option>
                                @foreach (var cat in Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Series"]</label>
                            <select class="w-full rounded-md shadow-sm sm:text-sm"
                                    style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                    value="@SeriesId" @onchange="e => OnSeriesChanged(e.Value?.ToString() ?? string.Empty)">
                                @foreach (var item in Series)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                            <p class="mt-1 text-xs" style="color: var(--pe-text-muted);">@L["Series groups related posts into a single editorial sequence."]</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Tags"]</label>
                            <div class="space-y-2">
                                @foreach (var tag in AllTags)
                                {
                                    <label class="inline-flex items-center gap-2 mr-3 text-sm" style="color: var(--pe-text-primary);">
                                        <input type="checkbox" 
                                               value="@tag.Id" 
                                               checked="@SelectedTagIds.Contains(tag.Id)"
                                               @onchange="e => ToggleTag(tag.Id)" />
                                        @tag.Name
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (LoadedPost is not null)
                {
                    <div class="mt-8 pt-6 border-t" style="border-top-color: var(--pe-border);">
                        <h3 class="text-lg font-medium mb-4" style="color: var(--pe-text-primary);">@L["Publishing &amp; History"]</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4 rounded-md border" 
                             style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                            <div>
                                <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Status"]</span>
                                @if (PublishedAt.HasValue)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium" 
                                          style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                                        @L["Published"]
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium" 
                                          style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                        @L["Draft"]
                                    </span>
                                }
                            </div>
                            <div>
                                <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Date Created"]</span>
                                <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@(LoadedPost?.CreatedOn.DateTime.ToShortDateString() ?? "-")</span>
                            </div>
                            <div>
                                <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Date Modified"]</span>
                                <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@(LoadedPost?.ModifiedOn?.DateTime.ToShortDateString() ?? "-")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        @if (ActiveTab == "translations")
        {
            <div class="p-6 rounded-lg shadow-sm m-4 space-y-6 max-w-5xl" style="background: var(--pe-bg-secondary); color: var(--pe-text-primary);">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                    <div>
                        <h2 class="text-xl font-semibold" style="color: var(--pe-text-primary);">@L["Culture / Translations"]</h2>
                        <p class="text-sm mt-1" style="color: var(--pe-text-muted);">
                            @if (LoadedPost is not null)
                            {
                                @L["Manage localized versions for this post."]
                            }
                            else
                            {
                                @L["Save this post before creating localized versions."]
                            }
                        </p>
                    </div>
                    @if (LoadedPost?.TranslationGroupId is { } translationGroupId)
                    {
                        <span class="text-xs font-mono px-2 py-1 rounded"
                              style="background: var(--pe-bg-primary); color: var(--pe-text-muted); border: 1px solid var(--pe-border);">
                            Group @translationGroupId
                        </span>
                    }
                </div>

                @if (LoadedPost is null)
                {
                    <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                        <p class="text-sm" style="color: var(--pe-text-muted);">@L["Save the post before creating translation variants."]</p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                            <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Current Variant"]</span>
                            <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@FormatCulture(LoadedPost.Culture)</span>
                        </div>
                        <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                            <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Default Culture"]</span>
                            <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@FormatCulture(CurrentSite?.DefaultCulture)</span>
                        </div>
                        <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                            <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Coverage"]</span>
                            <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@string.Format(L["{0} of {1} site cultures"], PostCultureVariants.Count, SupportedCultures.Count)</span>
                        </div>
                    </div>

                    <div class="rounded-md border overflow-hidden" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                        <div class="px-4 py-3 border-b flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3" style="border-color: var(--pe-border);">
                            <div>
                                <h3 class="text-sm font-semibold" style="color: var(--pe-text-primary);">@L["Localized Versions"]</h3>
                                <p class="text-xs mt-1" style="color: var(--pe-text-muted);">@L["Open a variant to edit its translated title, slug, metadata, and content."]</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <button type="button"
                                        class="pe-btn pe-btn-success pe-btn-sm"
                                        disabled="@(IsBulkPublishingTranslations || PostCultureVariants.Count == 0)"
                                        @onclick="PublishAllTranslationsAsync">
                                    @(IsBulkPublishingTranslations ? L["Working..."] : L["Publish All"])
                                </button>
                                <button type="button"
                                        class="pe-btn pe-btn-secondary pe-btn-sm"
                                        disabled="@(IsBulkPublishingTranslations || PostCultureVariants.Count == 0)"
                                        @onclick="UnpublishAllTranslationsAsync">
                                    @(IsBulkPublishingTranslations ? L["Working..."] : L["Unpublish All"])
                                </button>
                                @if (AvailableTranslationCultures.Any())
                                {
                                    <span class="rounded bg-yellow-100 px-2 py-1 text-xs font-semibold text-yellow-800">
                                        @string.Format(L["{0} missing"], AvailableTranslationCultures.Count())
                                    </span>
                                }
                                else
                                {
                                    <span class="rounded px-2 py-1 text-xs font-semibold" style="background: var(--pe-bg-secondary); color: var(--pe-text-secondary);">
                                        @L["Complete"]
                                    </span>
                                }
                                <button type="button"
                                        class="pe-btn pe-btn-primary pe-btn-sm"
                                        disabled="@(IsTranslatingAll || IsLoadingAiProviders)"
                                        @onclick="TranslateAllCulturesAsync">
                                    @(IsTranslatingAll ? L["Translating..."] : L["AI Translate All"])
                                </button>
                                <label class="inline-flex items-center gap-2 text-xs" style="color: var(--pe-text-secondary);">
                                    <input type="checkbox" @bind="OverwriteExistingTranslations" />
                                    @L["Overwrite existing when translating a row"]
                                </label>
                            </div>
                        </div>

                        @if (IsLoadingTranslations)
                        {
                            <div class="p-4 text-sm" style="color: var(--pe-text-muted);">@L["Loading translations..."]</div>
                        }
                        else if (PostCultureVariants.Count == 0)
                        {
                            <div class="p-4 text-sm" style="color: var(--pe-text-muted);">@L["No translation variants found."]</div>
                        }
                        else
                        {
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm">
                                    <thead style="background: var(--pe-bg-tertiary); color: var(--pe-text-muted);">
                                        <tr>
                                            <th class="px-4 py-2 text-left font-semibold">@L["Culture"]</th>
                                            <th class="px-4 py-2 text-left font-semibold">@L["Title"]</th>
                                            <th class="px-4 py-2 text-left font-semibold">@L["Slug"]</th>
                                            <th class="px-4 py-2 text-left font-semibold">@L["Status"]</th>
                                            <th class="px-4 py-2 text-left font-semibold">@L["Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var variant in PostCultureVariants)
                                        {
                                            var isCurrent = LoadedPost.Id == variant.Id;
                                            var isDefault = string.Equals(CurrentSite?.DefaultCulture, variant.Culture, StringComparison.OrdinalIgnoreCase);
                                            <tr class="border-t @(isCurrent ? "bg-blue-50" : "")" style="border-color: var(--pe-border); color: var(--pe-text-primary);">
                                                <td class="px-4 py-3">
                                                    <div class="flex flex-wrap items-center gap-2">
                                                        <span class="font-semibold">@FormatCulture(variant.Culture)</span>
                                                        @if (isDefault)
                                                        {
                                                            <span class="rounded bg-blue-100 px-2 py-0.5 text-xs font-semibold text-blue-800">@L["Default"]</span>
                                                        }
                                                        @if (isCurrent)
                                                        {
                                                            <span class="rounded px-2 py-0.5 text-xs font-semibold" style="background: var(--pe-bg-secondary); color: var(--pe-text-secondary);">@L["Current"]</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">@variant.Title</td>
                                                <td class="px-4 py-3 font-mono text-xs" style="color: var(--pe-text-muted);">@variant.Slug</td>
                                                <td class="px-4 py-3">
                                                    @if (variant.PublishedOn.HasValue)
                                                    {
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">@L["Published"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">@L["Draft"]</span>
                                                    }
                                                </td>
                                                <td class="px-4 py-3">
                                                    <div class="flex gap-1">
                                                        <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="() => OpenPublicTranslation(variant)">
                                                            @L["Open"]
                                                        </button>
                                                        <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" disabled="@isCurrent" @onclick="() => OpenTranslation(variant.Id)">
                                                            @L["Edit"]
                                                        </button>
                                                        <button type="button"
                                                                class="pe-btn pe-btn-ghost pe-btn-sm"
                                                                disabled="@(isCurrent || TranslatingCultures.Contains(variant.Culture) || IsTranslatingAll)"
                                                                @onclick="() => TranslateCultureAsync(variant.Culture, OverwriteExistingTranslations)">
                                                            @(TranslatingCultures.Contains(variant.Culture) ? L["Translating..."] : L["AI Translate"])
                                                        </button>
                                                        @if (!isDefault)
                                                        {
                                                            <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="() => DeleteTranslationAsync(variant)">
                                                                @L["Delete"]
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    @if (AvailableTranslationCultures.Any())
                    {
                        <div class="rounded-md border p-4 space-y-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                            <div>
                                <h3 class="text-sm font-semibold" style="color: var(--pe-text-primary);">@L["Add Translation"]</h3>
                                <p class="text-xs mt-1" style="color: var(--pe-text-muted);">@L["Creates a draft copy that you can localize after opening the new variant."]</p>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-[220px_1fr_auto] gap-3 items-end">
                                <div>
                                    <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Target Culture"]</label>
                                    <select class="w-full rounded-md shadow-sm sm:text-sm"
                                            style="background: var(--pe-bg-secondary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                            @bind="SelectedTranslationCulture">
                                        @foreach (var culture in AvailableTranslationCultures)
                                        {
                                            <option value="@culture">@FormatCulture(culture)</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Translated Slug"]</label>
                                    <input type="text" class="w-full rounded-md shadow-sm sm:text-sm font-mono"
                                           style="background: var(--pe-bg-secondary); color: var(--pe-primary); border: 1px solid var(--pe-border);"
                                           @bind="TranslationSlug" @bind:event="oninput" placeholder="@PostSlug" />
                                    <p class="mt-1 text-xs" style="color: var(--pe-text-muted);">@L["Leave blank to copy the current slug, or enter the translated URL segment."]</p>
                                </div>
                                <button type="button"
                                        class="pe-btn pe-btn-primary pe-btn-sm"
                                        disabled="@IsCreatingTranslation"
                                        @onclick="CreateTranslationAsync">
                                    @(IsCreatingTranslation ? L["Creating..."] : L["Create Translation"])
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    @if (IsEnhancePanelOpen)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4 py-6">
            <div class="w-full max-w-4xl rounded-lg shadow-xl border overflow-hidden" style="background: var(--pe-bg-secondary); border-color: var(--pe-border); color: var(--pe-text-primary);">
                <div class="flex items-center justify-between px-5 py-4 border-b" style="border-color: var(--pe-border);">
                    <div>
                        <h2 class="text-lg font-semibold">@L["Enhance content"]</h2>
                        <p class="text-sm" style="color: var(--pe-text-muted);">@L["Review the suggestion before applying it to the editor."]</p>
                    </div>
                    <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="CloseEnhancePanel">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
                    <div class="p-5 space-y-4 border-r" style="border-color: var(--pe-border);">
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["AI provider"]</label>
                            @if (IsLoadingAiProviders)
                            {
                                <div class="rounded-md border px-3 py-2 text-sm" style="border-color: var(--pe-border); color: var(--pe-text-muted);">
                                    @L["Loading providers..."]
                                </div>
                            }
                            else if (AiProviderOptions.Count == 0)
                            {
                                <div class="rounded-md border px-3 py-2 text-sm" style="border-color: #f59e0b; color: #92400e; background: rgba(245, 158, 11, 0.08);">
                                    @L["Configure and enable an AI provider before generating suggestions."]
                                </div>
                            }
                            else
                            {
                                <select class="w-full rounded-md shadow-sm sm:text-sm"
                                        style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                        value="@SelectedAiProviderId"
                                        @onchange="e => SelectedAiProviderId = e.Value?.ToString()">
                                    @foreach (var provider in AiProviderOptions)
                                    {
                                        <option value="@provider.Id">
                                            @(provider.IsDefault ? $"{provider.DisplayName} (default)" : provider.DisplayName)
                                        </option>
                                    }
                                </select>
                            }
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Target field"]</label>
                            <select class="w-full rounded-md shadow-sm sm:text-sm"
                                    style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                    value="@EnhanceTargetField"
                                    @onchange='e => EnhanceTargetField = e.Value?.ToString() ?? "body"'>
                                @foreach (var target in EnhanceTargetOptions)
                                {
                                    <option value="@target.Value">@target.Label</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Prompt"]</label>
                            <textarea rows="5" class="w-full rounded-md shadow-sm sm:text-sm"
                                      style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                      placeholder="@L["Tell the assistant what to improve"]"
                                      @oninput="e => EnhancePrompt = e.Value?.ToString() ?? string.Empty">@EnhancePrompt</textarea>
                        </div>

                        <div class="flex flex-wrap gap-2">
                            <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick='() => UseQuickPrompt("Sharpen the writing while preserving meaning.")'>@L["Sharpen"]</button>
                            <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick='() => UseQuickPrompt("Fix grammar, spelling, and clarity issues.")'>@L["Fix grammar"]</button>
                            <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick='() => UseQuickPrompt("Make this concise without losing important details.")'>@L["Make concise"]</button>
                            <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick='() => UseQuickPrompt("Expand this with helpful detail, without inventing facts.")'>@L["Expand"]</button>
                            <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick='() => UseQuickPrompt("Improve this for SEO while keeping it accurate.")'>@L["Improve SEO"]</button>
                        </div>

                        <button class="pe-btn @(IsEnhancing ? "pe-btn-secondary" : "pe-btn-primary") w-full justify-center" @onclick="RunEnhancementAsync" disabled="@(IsEnhancing || IsLoadingAiProviders || AiProviderOptions.Count == 0)">
                            @(IsEnhancing ? L["Enhancing..."] : L["Generate suggestion"])
                        </button>
                    </div>

                    <div class="p-5 space-y-4">
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Suggestion preview"]</label>
                            <textarea rows="12" class="w-full rounded-md shadow-sm sm:text-sm font-mono"
                                      style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                      readonly>@(EnhanceSuggestion ?? string.Empty)</textarea>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(EnhanceRationale))
                        {
                            <p class="text-sm" style="color: var(--pe-text-secondary);">@EnhanceRationale</p>
                        }

                        @if (EnhanceWarnings.Count > 0)
                        {
                            <div class="rounded-md border p-3 text-sm" style="border-color: #f59e0b; color: #92400e; background: rgba(245, 158, 11, 0.08);">
                                @foreach (var warning in EnhanceWarnings)
                                {
                                    <div>@warning</div>
                                }
                            </div>
                        }

                        <div class="flex justify-end gap-2">
                            <button class="pe-btn pe-btn-ghost" @onclick="CloseEnhancePanel">@L["Discard"]</button>
                            <button class="pe-btn pe-btn-primary" @onclick="ApplyEnhancementAsync" disabled="@(IsEnhancing || string.IsNullOrWhiteSpace(EnhanceSuggestion))">@L["Apply"]</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── Toast notifications ──────────────────────────── *@
    <div class="pe-toast-container">
        @foreach (var toast in Toasts)
        {
            <div class="pe-toast @toast.Type" @onclick="() => RemoveToast(toast.Id)">
                @if (toast.Type == "success")
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                }
                else if (toast.Type == "error")
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="15" y1="9" x2="9" y2="15"/>
                        <line x1="9" y1="9" x2="15" y2="15"/>
                    </svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="16" x2="12" y2="12"/>
                        <line x1="12" y1="8" x2="12.01" y2="8"/>
                    </svg>
                }
                <span>@toast.Message</span>
            </div>
        }
    </div>

    @* ── Media selector modal ─────────────────────────── *@
    <MediaSelectorModal
        Show="MediaModalOpen"
        MultiSelect="false"
        OnClose="CloseMediaSelector"
        OnConfirm="OnConfirmMediaSelection"/>

    @* Preview overlay (modal over entire manager) *@
    <PreviewOverlay Visible="@FullPreviewMode"
                    OnClose="TogglePreview"
                    FrameUrl="@PreviewFrameUrl"
                    FrameDocument="@PreviewFrameDocument"
                    UrlBarText="@(!string.IsNullOrWhiteSpace(PreviewFrameUrl) ? PreviewFrameUrl : PreviewFragmentUrl)"
                    Error="@PreviewError"
                    IsLoading="@IsPreviewRendering"
                    SuppressBrowserLinkErrors="true"
                    Title="@L["Post preview"]" />

</div>
