@page "/manager/footers"
@page "/manager/footers/general"
@attribute [Authorize]

@using Aero.Cms.Abstractions.Http.Clients

<div class="pe-page-content space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h1 class="text-2xl font-bold pe-heading">Footer</h1>
            <p class="mt-1 text-sm pe-description">Manage the footer that appears beneath public site pages.</p>
        </div>
        <div class="flex items-center gap-2">
            <RadzenButton Icon="refresh"
                          Text="Refresh"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Click="@LoadFootersAsync"
                          Disabled="@_isLoading" />
            <RadzenButton Icon="add"
                          Text="New Footer"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Click="@CreateFooterAsync"
                          Disabled="@_isSaving" />
        </div>
    </div>

    <RadzenDataGrid @ref="_footerGrid"
                    Data="@_footers"
                    TItem="FooterSummary"
                    IsLoading="@_isLoading"
                    AllowPaging="true"
                    PageSize="10"
                    class="aero-grid cursor-pointer"
                    RowClick="@(args => OpenEditor(args.Data))"
                    EmptyText="No footers yet. Create one to begin.">
        <Columns>
            <RadzenDataGridColumn TItem="FooterSummary" Property="Name" Title="Footer">
                <Template Context="footer">
                    <div class="flex flex-col gap-1">
                        <span class="font-medium" style="color: var(--pe-text-primary);">@footer.Name</span>
                        <span class="text-xs" style="color: var(--pe-text-secondary);">@footer.Description</span>
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FooterSummary" Property="State" Title="Status" Width="170px">
                <Template Context="footer">
                    <RadzenBadge BadgeStyle="@BadgeStyleFor(footer.State)" Text="@DisplayState(footer.State)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FooterSummary" Property="CreatedAt" Title="Created" Width="180px">
                <Template Context="footer">
                    <span style="color: var(--pe-text-secondary);">@footer.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FooterSummary" Title="Groups" Width="100px">
                <Template Context="footer">
                    <span style="color: var(--pe-text-secondary);">@footer.LinkGroupCount</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>
