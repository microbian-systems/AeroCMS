@page "/manager/nav-menu/editor/{Id:long}"
@page "/manager/navigations/editor/{Id:long}"
@attribute [Authorize]


<div class="pe-page-content space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <div class="mb-3">
                <RadzenButton Icon="arrow_back"
                               Text="@L["Back to Header Menus"]"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@BackToList" />
            </div>
            <h1 class="text-2xl font-bold pe-heading">@(_selected?.Name ?? L["Header Menu"])</h1>
            <p class="mt-1 text-sm pe-description">@L["Draft changes stay private until the menu is published."]</p>
        </div>
        @if (_selected is not null)
        {
            <div class="flex flex-wrap gap-2">
                <RadzenButton Icon="save"
                               Text="@L["Save Draft"]"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small"
                              Click="@SaveDraftAsync"
                              Disabled="@_isSaving" />
                <RadzenButton Icon="publish"
                               Text="@L["Publish"]"
                              ButtonStyle="ButtonStyle.Success"
                              Size="ButtonSize.Small"
                              Click="@PublishAsync"
                              Disabled="@_isSaving" />
                <RadzenButton Icon="home"
                               Text="@L["Set Default"]"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@SetDefaultAsync"
                              Disabled="@_isSaving" />
                <RadzenButton Icon="delete"
                               Text="@L["Archive"]"
                              ButtonStyle="ButtonStyle.Danger"
                              Size="ButtonSize.Small"
                              Click="@ArchiveAsync"
                              Disabled="@_isSaving" />
            </div>
        }
    </div>

    @if (_isLoading)
    {
        <div class="flex min-h-64 items-center justify-center rounded"
             style="border: 1px solid var(--pe-border); background: var(--pe-bg-secondary);">
            <RadzenProgressBar Circular="true"
                               Value="100"
                               Mode="ProgressBarMode.Indeterminate"
                               Style="width: 48px; height: 48px" />
        </div>
    }
    else if (_selected is null)
    {
        <div class="flex min-h-64 items-center justify-center rounded"
             style="border: 1px dashed var(--pe-border); background: var(--pe-bg-secondary);">
            <div class="max-w-md text-center">
                <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">@L["Header menu not found"]</h2>
                <p class="mt-2 text-sm pe-description">@L["Return to the list and choose another menu."]</p>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-5">
            <div class="grid grid-cols-1 gap-4 rounded md:grid-cols-2"
                  style="border: 1px solid var(--pe-border); background: var(--pe-bg-secondary); padding: 16px;">
                <div>
                    <label for="editMenuName" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Name"]</label>
                    <input id="editMenuName"
                           @bind="_editName"
                           class="w-full rounded px-3 py-2"
                           style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                </div>
                <div>
                    <label for="editMenuDescription" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Description"]</label>
                    <input id="editMenuDescription"
                           @bind="_editDescription"
                           class="w-full rounded px-3 py-2"
                           style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                </div>
                <div class="md:col-span-2">
                    <label for="editSiteLogoUrl" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Site Logo URL"]</label>
                    <input id="editSiteLogoUrl"
                           @bind="_editSiteLogoUrl"
                           class="w-full rounded px-3 py-2"
                           style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);"
                           placeholder="/img/logo.svg" />
                    <p class="mt-1 text-xs pe-description">@L["Leave blank to use the built-in placeholder mark."]</p>
                </div>
            </div>

            <div class="rounded space-y-4"
                 style="border: 1px solid var(--pe-border); background: var(--pe-bg-secondary); padding: 16px;">
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">@L["Translations"]</h2>
                        <p class="mt-1 text-sm pe-description">@L["Current variant:"] @FormatCulture(_selected.Culture)</p>
                        <p class="mt-1 text-xs pe-description">@string.Format(L["{0} of {1} site cultures created."], _cultureVariants.Count, SupportedCultures.Count)</p>
                    </div>
                    @if (_selected.TranslationSetId is { } translationSetId)
                    {
                        <span class="text-xs font-mono px-2 py-1 rounded"
                              style="background: var(--pe-bg-primary); color: var(--pe-text-secondary); border: 1px solid var(--pe-border);">
                            Set @translationSetId
                        </span>
                    }
                </div>

                <div class="rounded p-4 space-y-3"
                     style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary);">
                    <div class="flex flex-wrap items-center gap-2 text-xs pe-description">
                    <span class="font-semibold uppercase tracking-wider">@L["Available variants"]</span>
                        @if (!AvailableTranslationCultures.Any())
                        {
                            <span class="rounded px-2 py-0.5" style="background: var(--pe-bg-secondary); color: var(--pe-text-secondary);">@L["Complete"]</span>
                        }
                    </div>
                    @if (_isLoadingTranslations)
                    {
                        <p class="text-sm pe-description">@L["Loading translations..."]</p>
                    }
                    else if (_cultureVariants.Count == 0)
                    {
                        <p class="text-sm pe-description">@L["No translation variants found."]</p>
                    }
                    else
                    {
                        <div class="flex flex-wrap gap-2">
                            @foreach (var variant in _cultureVariants)
                            {
                                var isCurrent = _selected.Id == variant.Id;
                                var isDefault = string.Equals(_currentSite?.DefaultCulture, variant.Culture, StringComparison.OrdinalIgnoreCase);
                                <button type="button"
                                        class="pe-btn @(isCurrent ? "pe-btn-primary" : "pe-btn-ghost") pe-btn-sm"
                                        disabled="@isCurrent"
                                        @onclick="() => OpenTranslation(variant.Id)">
                                    @FormatCulture(variant.Culture)@(isDefault ? " · " + L["Default"] : "")
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (AvailableTranslationCultures.Any())
                {
                    <div class="grid grid-cols-1 gap-3 items-end md:grid-cols-[minmax(0,1fr)_auto]">
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Target Culture"]</label>
                            <select class="w-full rounded px-3 py-2"
                                    style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);"
                                    @bind="_selectedTranslationCulture">
                                @foreach (var culture in AvailableTranslationCultures)
                                {
                                    <option value="@culture">@FormatCulture(culture)</option>
                                }
                            </select>
                        </div>
                        <RadzenButton Icon="translate"
                                       Text="@(_isCreatingTranslation ? L["Creating..."] : L["Create Translation"])"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      Click="@CreateTranslationAsync"
                                      Disabled="@_isCreatingTranslation" />
                    </div>
                }
                else
                {
                    <p class="text-sm pe-description">@L["All supported site cultures already have a header menu variant."]</p>
                }
            </div>

            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">@L["Links"]</h2>
                    <p class="mt-1 text-sm pe-description">@L["Arrange the links shown in the public site header."]</p>
                </div>
                <div class="flex items-center gap-2">
                    <RadzenButton Icon="refresh"
                                   Text="@L["Refresh"]"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@RefreshLinksAsync"
                                  Disabled="@(_isLoading || _isSaving)" />
                    <RadzenButton Icon="add"
                                  Text="@L["Add Link"]"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@AddItem"
                                  Disabled="@(_isLoading || _isSaving)" />
                </div>
            </div>

            <RadzenDataGrid @ref="_itemsGrid"
                            Data="@_items"
                            TItem="NavItemEditorModel"
                            AllowPaging="false"
                            EmptyText="@L["This menu has no links yet. Add a link to start building it."]">
                <Columns>
                    <RadzenDataGridColumn TItem="NavItemEditorModel" Title="@L["Label"]">
                        <Template Context="item">
                            <input @bind="item.Label"
                                   aria-label="Link label"
                                   class="w-full rounded px-3 py-2"
                                   style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="NavItemEditorModel" Title="@L["URL"]">
                        <Template Context="item">
                            <input @bind="item.Url"
                                   aria-label="Link URL"
                                   class="w-full rounded px-3 py-2"
                                   style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);"
                                   placeholder="/about" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="NavItemEditorModel" Title="@L["External"]" Width="110px">
                        <Template Context="item">
                            <label class="inline-flex items-center justify-center gap-2 rounded px-2 py-2"
                                   style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);">
                                <input type="checkbox"
                                       checked="@item.IsExternal"
                                       @onchange="args => OnItemExternalChanged(item, args)"
                                       aria-label="External link" />
                            </label>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="NavItemEditorModel" Title="@L["Target"]" Width="170px">
                        <Template Context="item">
                            <select @bind="item.Target"
                                    aria-label="Link target"
                                    class="w-full rounded px-3 py-2"
                                    style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);">
                                @foreach (var option in TargetOptions)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="NavItemEditorModel" Title="@L["Alt Text"]">
                        <Template Context="item">
                            <input @bind="item.AltText"
                                   aria-label="Link alternative text"
                                   class="w-full rounded px-3 py-2"
                                   style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="NavItemEditorModel" Title="@L["Order"]" Width="150px">
                        <Template Context="item">
                            <div class="flex items-center gap-1">
                                <RadzenButton Icon="keyboard_arrow_up" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => MoveItemAsync(item, -1))" />
                                <RadzenButton Icon="keyboard_arrow_down" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => MoveItemAsync(item, 1))" />
                                <span class="text-sm" style="color: var(--pe-text-secondary);">@((item.Order + 1).ToString())</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="NavItemEditorModel" Title="@L["Actions"]" Width="110px">
                        <Template Context="item">
                            <RadzenButton Icon="delete"
                                          Text="@L["Remove"]"
                                          Size="ButtonSize.ExtraSmall"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Click="@(() => RemoveItemAsync(item))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</div>
