@page "/manager/themes"
@page "/manager/themes/general"
@attribute [Authorize]

@using Aero.Cms.Abstractions.Http.Clients

<div class="pe-page-content space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h1 class="text-2xl font-bold pe-heading">@L["Themes"]</h1>
            <p class="mt-1 text-sm pe-description">@L["Browse the themes installed with this application deployment."]</p>
        </div>
        <div class="flex items-center gap-2">
            <RadzenButton Icon="language"
                          Text="@L["Sites"]"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Click="@OpenSites" />
            <RadzenButton Icon="refresh"
                          Text="@L["Refresh"]"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Click="@LoadThemesAsync"
                          Disabled="@_isLoading" />
        </div>
    </div>

    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
        @L["Theme selection is stored per site. This catalog is read-only; open a site's Design System to apply an exact theme version."]
    </RadzenAlert>

    @if (_isLoading)
    {
        <div class="flex min-h-40 items-center justify-center">
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" style="width: 14rem;" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
            @_errorMessage
        </RadzenAlert>
    }
    else if (_themes.Count == 0)
    {
        <RadzenCard class="p-8 text-center">
            <p style="color: var(--pe-text-secondary);">@L["No deployment-installed themes are available."]</p>
        </RadzenCard>
    }
    else
    {
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var theme in _themes)
            {
                <RadzenCard class="p-6 shadow-sm">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <h2 class="text-lg font-semibold" style="color: var(--pe-text-primary);">@theme.Name</h2>
                            <p class="mt-1 text-sm" style="color: var(--pe-text-secondary);">@($"{theme.Id}@{theme.Version}")</p>
                        </div>
                        @if (theme.IsSafeDefault)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@L["Safe fallback"]" />
                        }
                    </div>
                    <p class="mt-5 text-sm" style="color: var(--pe-text-secondary);">@L["By"] @theme.Author</p>
                </RadzenCard>
            }
        </div>
    }
</div>
