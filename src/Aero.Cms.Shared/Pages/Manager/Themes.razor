@page "/manager/themes"
@page "/manager/themes/general"
@attribute [Authorize]

@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Cms.Abstractions.Theming

<div class="pe-page-content space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h1 class="text-2xl font-bold pe-heading">@L["Themes"]</h1>
            <p class="mt-1 text-sm pe-description">@L["Browse the themes installed with this application deployment."]</p>
        </div>
        <div class="flex items-center gap-2">
            <RadzenButton Icon="language"
                          Text="@L["Sites"]"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Click="@OpenSites" />
            <RadzenButton Icon="refresh"
                          Text="@L["Refresh"]"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Click="@LoadThemesAsync"
                          Disabled="@_isLoading" />
        </div>
    </div>

    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
        @L["Theme selection is stored per site. This catalog is read-only; open a site's Design System to apply an exact theme version."]
    </RadzenAlert>

    @if (!_isLoading)
    {
        <section class="space-y-4" aria-labelledby="generated-themes-title">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div><h2 id="generated-themes-title" class="text-lg font-semibold" style="color: var(--pe-text-primary);">@L["Generated themes"]</h2><p class="mt-1 text-sm" style="color: var(--pe-text-muted);">@L["Draft, preview, publish, and assign closed Daisy token sets in Theme Studio."]</p></div>
                <button type="button" class="pe-btn pe-btn-primary" @onclick="@(() => OpenThemeStudio(null))"><span class="rzi rzi-palette" aria-hidden="true"></span> @(_drafts.Count == 0 ? L["Create theme draft"] : L["Open Theme Studio"])</button>
            </div>
            @if (_drafts.Count == 0)
            {
                <RadzenCard class="p-6 text-center"><p style="color: var(--pe-text-secondary);">@L["No generated drafts yet. Start from a safe token document in Theme Studio."]</p></RadzenCard>
            }
            else
            {
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                    @foreach (var draft in _drafts)
                    {
                        <RadzenCard class="p-5 shadow-sm">
                            <div class="flex items-start justify-between gap-3"><div class="min-w-0"><h3 class="truncate font-semibold" style="color: var(--pe-text-primary);">@draft.Name</h3><p class="mt-1 font-mono text-xs" style="color: var(--pe-text-muted);">@draft.Slug · r@draft.Revision</p></div><RadzenBadge BadgeStyle="@(draft.ValidationWarnings.Count == 0 ? BadgeStyle.Success : BadgeStyle.Warning)" Text="@(draft.ValidationWarnings.Count == 0 ? L["Ready"] : $"{draft.ValidationWarnings.Count} {L["warnings"]}")" /></div>
                            <p class="mt-4 line-clamp-2 text-sm" style="color: var(--pe-text-secondary);">@(string.IsNullOrWhiteSpace(draft.Description) ? L["Generated token draft"] : draft.Description)</p>
                            <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm mt-4" @onclick="@(() => OpenThemeStudio(draft.Id))">@L["Edit in Theme Studio"]</button>
                        </RadzenCard>
                    }
                </div>
            }
        </section>
        <div class="border-t" style="border-color: var(--pe-border);"></div>
        <div><h2 class="text-lg font-semibold" style="color: var(--pe-text-primary);">@L["Deployment catalog"]</h2><p class="mt-1 text-sm" style="color: var(--pe-text-muted);">@L["Immutable themes shipped with this application deployment."]</p></div>
    }

    @if (_isLoading)
    {
        <div class="flex min-h-40 items-center justify-center">
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" style="width: 14rem;" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
            @_errorMessage
        </RadzenAlert>
    }
    else if (_themes.Count == 0)
    {
        <RadzenCard class="p-8 text-center">
            <p style="color: var(--pe-text-secondary);">@L["No deployment-installed themes are available."]</p>
        </RadzenCard>
    }
    else
    {
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var theme in _themes)
            {
                <RadzenCard class="p-6 shadow-sm">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <h2 class="text-lg font-semibold" style="color: var(--pe-text-primary);">@theme.Name</h2>
                            <p class="mt-1 text-sm" style="color: var(--pe-text-secondary);">@($"{theme.Id}@{theme.Version}")</p>
                        </div>
                        @if (theme.IsSafeDefault)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@L["Safe fallback"]" />
                        }
                    </div>
                    <p class="mt-5 text-sm" style="color: var(--pe-text-secondary);">@L["By"] @theme.Author</p>
                </RadzenCard>
            }
        </div>
    }
</div>
