
@using System.Linq
@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Core
@using Aero.Core.Railway
@inject IBlogHttpClient BlogApi
@inject DialogService DialogService
@inject NavigationManager Navigation

<div class="p-6 space-y-4" style="background: var(--pe-bg-secondary); color: var(--pe-text-primary);">
    @if (post == null)
    {
        <div class="flex items-center justify-center py-20">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 gap-6">
            <div class="space-y-4 col-span-2 sm:col-span-1">
                <div>
                    <label class="block text-xs font-semibold uppercase" style="color: var(--pe-text-muted); margin-bottom: 4px;">Title</label>
                    <div class="text-lg font-bold" style="color: var(--pe-text-primary); line-height: 1.25;">@post.Title</div>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase" style="color: var(--pe-text-muted); margin-bottom: 4px;">Slug</label>
                    <div class="text-sm font-mono" style="background: color-mix(in srgb, var(--pe-info) 10%, transparent); color: var(--pe-info); padding: 4px 8px; border-radius: var(--pe-radius-md); display: inline-block;">/@post.Slug</div>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase" style="color: var(--pe-text-muted); margin-bottom: 4px;">Summary / Excerpt</label>
                    <div class="text-sm" style="color: var(--pe-text-secondary); background: var(--pe-bg-tertiary); padding: 12px; border-radius: var(--pe-radius-lg); border-left: 4px solid var(--pe-border);">
                        @(string.IsNullOrEmpty(post.Excerpt) ? "No excerpt provided." : post.Excerpt)
                    </div>
                </div>
            </div>
            <div class="space-y-4 col-span-2 sm:col-span-1">
                 @if (!string.IsNullOrEmpty(post.ImageUrl))
                 {
                    <div class="rounded-xl overflow-hidden shadow-sm" style="border: 1px solid var(--pe-border);">
                        <img src="@post.ImageUrl" class="w-full h-40 object-cover" alt="Featured Image" />
                    </div>
                 }
                <div class="pt-2">
                    <label class="block text-xs font-semibold uppercase" style="color: var(--pe-text-muted); margin-bottom: 4px;">Status</label>
                    @if (post.PublishedOn.HasValue)
                    {
                        <div class="flex items-center gap-2" style="color: var(--pe-success);">
                            <RadzenIcon Icon="check_circle" class="w-4 h-4" />
                            <span class="text-sm font-medium">Published on @post.PublishedOn?.DateTime.ToString("MMMM dd, yyyy")</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2" style="color: var(--pe-warning);">
                             <RadzenIcon Icon="edit" class="w-4 h-4" />
                             <span class="text-sm font-medium">Draft - Visibility: Private</span>
                        </div>
                    }
                </div>
                <div class="pt-4 flex gap-3">
                     <RadzenButton Icon="edit" Text="Open in Editor" ButtonStyle="ButtonStyle.Primary" Click="OnEdit" class="w-full shadow-md" />
                </div>
            </div>
        </div>

        <div class="mt-8 pt-6" style="border-top: 1px solid var(--pe-border);">
             <h3 class="text-sm font-semibold mb-4 flex items-center gap-2" style="color: var(--pe-text-primary);">
                 <RadzenIcon Icon="info" class="w-4 h-4" style="color: var(--pe-info);" />
                 Metadata & Categorization
             </h3>
             <div class="grid grid-cols-2 gap-x-12 gap-y-4 text-xs" style="color: var(--pe-text-secondary);">
                  <div class="flex justify-between" style="border-bottom: 1px solid var(--pe-border); padding-bottom: 8px;">
                       <span>Author ID</span>
                       <span class="font-medium" style="color: var(--pe-text-primary);">@post.AuthorId</span>
                  </div>
                  <div class="flex justify-between" style="border-bottom: 1px solid var(--pe-border); padding-bottom: 8px;">
                       <span>Category ID</span>
                        <span class="font-medium" style="color: var(--pe-text-primary);">@(post.CategoryIds?.FirstOrDefault() ?? 0)</span>
                  </div>
                    <div class="flex justify-between" style="border-bottom: 1px solid var(--pe-border); padding-bottom: 8px;">
                       <span>Created</span>
                        <span class="font-medium" style="color: var(--pe-text-primary);">@post.CreatedOn.DateTime.ToShortDateString()</span>
                  </div>
                  <div class="flex justify-between" style="border-bottom: 1px solid var(--pe-border); padding-bottom: 8px;">
                       <span>Last Modified</span>
                        <span class="font-medium" style="color: var(--pe-text-primary);">@(post.ModifiedOn?.DateTime.ToShortDateString() ?? "-")</span>
                  </div>
             </div>
        </div>
    }
</div>

@code {
    [Parameter] public long PostId { get; set; }
    
    private BlogDetail? post;

    protected override async Task OnInitializedAsync()
    {
        var result = await BlogApi.GetByIdAsync(PostId);
        if (result is Result<BlogDetail, AeroError>.Ok ok)
        {
             post = ok.Value;
        }
    }

    void OnEdit()
    {
        DialogService.Close();
        // Assuming there's a blog editor page similar to page editor
        Navigation.NavigateTo($"/manager/post/editor?id={PostId}");
    }
}
