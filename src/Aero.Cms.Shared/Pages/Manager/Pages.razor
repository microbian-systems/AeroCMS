@page "/manager/pages"
@page "/manager/pages/general"
@attribute [Authorize]
@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Cms.Shared.Components
@inject NavigationManager Navigation
@inject IStringLocalizer<Aero.Cms.Shared.Localization.ManagerResource> L

<PageTitle>@L["Pages"]</PageTitle>

<div class="pe-page-content space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold pe-heading">@L["Pages"]</h1>
            <p class="mt-1 text-sm pe-description">@L["Manage your page hierarchy and content."]</p>
        </div>
        <div class="flex gap-4">
            <a href="/manager/page/editor" class="pe-btn pe-btn-primary">
                <RadzenIcon Icon="add" />
                @L["Create Page"]
            </a>
        </div>
    </div>

    <PageTreeGrid OnPreview="OpenPreviewAsync" />
</div>

@if (_previewVisible && _previewPageId is not null)
{
    <PreviewOverlay Visible="true"
                    OnClose="() => _previewVisible = false"
                    FrameUrl="@_previewFrameUrl"
                    FrameDocument=""
                    UrlBarText="@_previewUrlBarText"
                    Error=""
                    IsLoading="false"
                    Title="@L["Page preview"]" />
}

@code {
    private bool _previewVisible;
    private long? _previewPageId;
    private string _previewBaseUri = "";
    private string _previewFrameUrl = "";
    private string _previewUrlBarText = "";

    protected override void OnInitialized()
    {
        // Use the current app's base URI so preview works across dev/prod environments.
        // Homepage (Path="/") → FrameUrl = "https://mysite.com/"
        // About page (Path="/about") → FrameUrl = "https://mysite.com/about"
        _previewBaseUri = Navigation.BaseUri.TrimEnd('/');
    }

    private async Task OpenPreviewAsync(PageTranslationGroupTreeItem item)
    {
        _previewVisible = true;
        _previewPageId = item.DisplayPageId;
        _previewFrameUrl = $"{_previewBaseUri}{item.Path}";
        _previewUrlBarText = item.Path;
        await InvokeAsync(StateHasChanged);
    }
}
