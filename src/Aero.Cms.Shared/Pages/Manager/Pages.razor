@page "/manager/pages"
@page "/manager/pages/general"
@attribute [Authorize]
@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Cms.Shared.Components
@inject NavigationManager Navigation
@inject Aero.Cms.Abstractions.Http.Clients.IPagesHttpClient PagesApi

<PageTitle>Pages</PageTitle>

<div class="pe-page-content space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold pe-heading">Pages</h1>
            <p class="mt-1 text-sm pe-description">Manage your page hierarchy and content.</p>
        </div>
        <div class="flex gap-4">
            <RadzenButton Icon="add" Text="Create Page" ButtonStyle="ButtonStyle.Primary"
                          Click='() => Navigation.NavigateTo("/manager/page/editor")' />
        </div>
    </div>

    <PageTreeGrid OnPreview="OpenPreviewAsync" />
</div>

@if (_previewVisible && _previewPageId is not null)
{
    <PreviewOverlay Visible="true"
                    OnClose="() => _previewVisible = false"
                    FrameUrl="@($"https://localhost:333/{_previewSlug}")"
                    FrameDocument=""
                    UrlBarText="@($"/{_previewSlug}")"
                    Error=""
                    IsLoading="false"
                    Title="Page preview" />
}

@code {
    private bool _previewVisible;
    private long? _previewPageId;
    private string _previewSlug = "";

    private async Task OpenPreviewAsync(PageTreeItem item)
    {
        _previewVisible = true;
        _previewPageId = item.Id;
        _previewSlug = item.Path.TrimStart('/');
        await InvokeAsync(StateHasChanged);
    }
}
