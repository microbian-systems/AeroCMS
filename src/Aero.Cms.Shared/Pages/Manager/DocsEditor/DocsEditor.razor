@page "/manager/docs/{SpaceId:long}"
@page "/manager/docs/{SpaceId:long}/sections/{SectionId:long}"
@attribute [Authorize]

@using Aero.Cms.Abstractions.Enums
@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Cms.Shared.Components
@using Aero.Cms.Shared.Components.MarkdownEditor
@using Microsoft.Extensions.Localization
@using NeoUI.Blazor

<PageTitle>@(Space?.Title ?? L["Docs Editor"])</PageTitle>

<div class="pe-doc-editor-shell">
    <header class="pe-doc-editor-topbar">
        <div class="pe-doc-editor-title-block">
            <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="BackToSpaces">@L["Spaces"]</button>
            <span class="pe-doc-editor-breadcrumb">/</span>
            <span class="pe-doc-editor-space-name">@(Space?.Title ?? L["Loading"])</span>
        </div>
        <div class="pe-doc-editor-actions">
            @if (Current is not null)
            {
                <a class="pe-btn pe-btn-ghost pe-btn-sm" href="@PublicUrl(Current)" target="_blank" rel="noopener noreferrer">@L["View"]</a>
                <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="TogglePreviewAsync">
                    @L["Preview"]
                </button>
                <button type="button" class="pe-btn pe-btn-primary pe-btn-sm" @onclick="SaveCurrentFromUiAsync" disabled="@_isSaving">
                    @(_isSaving ? L["Saving..."] : L["Save"])
                </button>
                @if (Current.PublicationState == ContentPublicationState.Published)
                {
                    <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="UnpublishCurrentAsync" disabled="@_isSaving">
                        @L["Unpublish"]
                    </button>
                }
                else
                {
                    <button type="button" class="pe-btn pe-btn-success pe-btn-sm" @onclick="PublishCurrentAsync" disabled="@_isSaving">
                        @L["Publish"]
                    </button>
                }
                <button type="button"
                        class="pe-btn pe-btn-ghost pe-btn-sm pe-doc-delete-btn"
                        @onclick="DeleteCurrentAsync"
                        disabled="@(IsEditingSpaceRoot || _isSaving)">
                    @L["Delete"]
                </button>
            }
        </div>
    </header>

    @if (_isLoading)
    {
        <div class="pe-doc-editor-loading">@L["Loading space..."]</div>
    }
    else if (Space is null)
    {
        <div class="pe-doc-editor-loading">@L["Space not found."]</div>
    }
    else
    {
        <div class="pe-doc-editor-layout">
            <aside class="pe-doc-editor-explorer" aria-label="Space outline">
                <div class="pe-doc-editor-panel-head">
                    <div>
                        <p class="pe-docs-kicker">@L["Explorer"]</p>
                        <h2>@Space.Title</h2>
                    </div>
                    <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="CreateChildAsync">@L["Add"]</button>
                </div>

                <div class="pe-doc-tree-tools">
                    <label class="pe-field pe-doc-tree-search">
                        <span>@L["Find"]</span>
                        <input value="@_outlineSearch" @oninput="OnOutlineSearchChanged" placeholder="@L["Search this space"]" />
                    </label>
                    <label class="pe-doc-tree-check">
                        <input type="checkbox" checked="@_multiSelect" @onchange="ToggleMultiSelect" />
                        @L["Multi-select"]
                    </label>
                    @if (_selectedIds.Count > 0)
                    {
                        <span>@string.Format(L["{0} selected"], _selectedIds.Count)</span>
                    }
                </div>

                @if (_selectedIds.Count > 0)
                {
                    <div class="pe-doc-batch-bar" aria-label="Batch actions">
                        <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="PublishSelectedAsync">@L["Publish"]</button>
                        <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="UnpublishSelectedAsync">@L["Unpublish"]</button>
                        <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm pe-doc-delete-btn" @onclick="DeleteSelectedAsync">@L["Delete"]</button>
                    </div>
                }

                <nav class="pe-doc-tree" aria-label="Docs sections">
                    @foreach (var node in VisibleOutline)
                    {
                        <ContextMenu>
                            <ContextMenuTrigger>
                                <div class="@NodeClass(node)" style="--doc-node-depth:@node.Depth">
                                    @if (_multiSelect)
                                    {
                                        <input type="checkbox"
                                               checked="@_selectedIds.Contains(node.Id)"
                                               @onchange="args => ToggleNodeSelection(node.Id, args)" />
                                    }
                                    <button type="button" class="pe-doc-tree-node-main" @onclick="() => SelectNode(node)">
                                        <span class="pe-doc-tree-node-title">@node.Title</span>
                                        <span class="pe-doc-tree-node-meta">@node.ChildCount</span>
                                    </button>
                                    <button type="button" class="pe-doc-tree-node-action" title="@L["Move up"]" @onclick="() => MoveNodeAsync(node.Id, -1)" disabled="@IsSpaceNode(node)">@L["Up"]</button>
                                    <button type="button" class="pe-doc-tree-node-action" title="@L["Move down"]" @onclick="() => MoveNodeAsync(node.Id, 1)" disabled="@IsSpaceNode(node)">@L["Down"]</button>
                                    <button type="button" class="pe-doc-tree-node-action" title="@L["Add child section"]" @onclick="() => CreateChildAsync(node.Id)">+</button>
                                </div>
                            </ContextMenuTrigger>
                            <ContextMenuContent Class="pe-doc-context-menu">
                                <ContextMenuItem OnClick="@(() => SelectNode(node))">@L["Open"]</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => CreateChildAsync(node.Id))">@L["Add child section"]</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => EditNodeAttributes(node))">@L["Edit attributes"]</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => DuplicateNodeAsync(node.Id))" Disabled="@IsSpaceNode(node)">@L["Duplicate"]</ContextMenuItem>
                                <ContextMenuSeparator />
                                <ContextMenuItem OnClick="@(() => MoveNodeAsync(node.Id, -1))" Disabled="@IsSpaceNode(node)">@L["Move up"]</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => MoveNodeAsync(node.Id, 1))" Disabled="@IsSpaceNode(node)">@L["Move down"]</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => MoveNodeToSpaceRootAsync(node.Id))" Disabled="@IsSpaceNode(node)">@L["Move to space root"]</ContextMenuItem>
                                <ContextMenuSeparator />
                                <ContextMenuItem OnClick="@(() => PublishNodeAsync(node.Id))">@L["Publish"]</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => UnpublishNodeAsync(node.Id))">@L["Unpublish"]</ContextMenuItem>
                                <ContextMenuSeparator />
                                <ContextMenuItem Class="pe-doc-context-danger" OnClick="@(() => DeleteNodeAsync(node.Id))" Disabled="@IsSpaceNode(node)">@L["Delete"]</ContextMenuItem>
                            </ContextMenuContent>
                        </ContextMenu>
                    }
                </nav>
            </aside>

            <main class="pe-doc-editor-main">
                @if (Current is null)
                {
                    <div class="pe-doc-editor-empty">@L["Select a section to start editing."]</div>
                }
                else
                {
                    <section class="pe-doc-document-surface">
                        <div class="pe-doc-document-header">
                            <div class="pe-doc-document-title-row">
                                <input class="pe-doc-title-input"
                                       value="@Current.Title"
                                       @oninput="OnTitleChanged"
                                       placeholder="@L["Untitled section"]" />
                                <span class="@StatusClass(Current.PublicationState)">@Current.PublicationState</span>
                            </div>
                            <div class="pe-doc-document-meta-row">
                                <code>/docs/@Current.Slug</code>
                                <span>@FormatCulture(Current.Culture)</span>
                                @if (HasUnpublishedChanges)
                                {
                                    <span>@L["Unpublished changes"]</span>
                                }
                            </div>
                        </div>

                        @* Translation controls live in the right document inspector. *@
                        @*
                        <div class="rounded-md border p-4 space-y-3"
                             style="border-color: var(--pe-border); background: var(--pe-bg-secondary);">
                            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                                <div>
                                    <h3 class="text-base font-semibold" style="color: var(--pe-text-primary);">@L["Translations"]</h3>
                                    <p class="mt-1 text-sm" style="color: var(--pe-text-muted);">@L["Current variant:"] @FormatCulture(Current.Culture)</p>
                                    <p class="mt-1 text-xs" style="color: var(--pe-text-muted);">@string.Format(L["{0} of {1} site cultures created."], DocCultureVariants.Count, SupportedCultures.Count)</p>
                                </div>
                                @if (Current.TranslationGroupId is { } TranslationGroupId)
                                {
                                    <span class="text-xs font-mono px-2 py-1 rounded"
                                          style="background: var(--pe-bg-primary); color: var(--pe-text-muted); border: 1px solid var(--pe-border);">
                                        Set @TranslationGroupId
                                    </span>
                                }
                            </div>

                            <div class="rounded-md border p-3"
                                 style="border-color: var(--pe-border); background: var(--pe-bg-primary);">
                                <div class="mb-3 flex flex-wrap items-center gap-2 text-xs" style="color: var(--pe-text-muted);">
                                    <span class="font-semibold uppercase tracking-wider">@L["Available variants"]</span>
                                    @if (!AvailableTranslationCultures.Any())
                                    {
                                        <span class="rounded px-2 py-0.5" style="background: var(--pe-bg-secondary); color: var(--pe-text-secondary);">@L["Complete"]</span>
                                    }
                                </div>
                                @if (IsLoadingTranslations)
                                {
                                    <p class="text-sm" style="color: var(--pe-text-muted);">@L["Loading translations..."]</p>
                                }
                                else if (DocCultureVariants.Count == 0)
                                {
                                    <p class="text-sm" style="color: var(--pe-text-muted);">@L["No translation variants found."]</p>
                                }
                                else
                                {
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var variant in DocCultureVariants)
                                        {
                                            var isCurrent = Current.Id == variant.Id;
                                            var isDefault = string.Equals(CurrentSite?.DefaultCulture, variant.Culture, StringComparison.OrdinalIgnoreCase);
                                            <button type="button"
                                                    class="pe-btn @(isCurrent ? "pe-btn-primary" : "pe-btn-ghost") pe-btn-sm"
                                                    disabled="@isCurrent"
                                                    @onclick="() => OpenTranslation(variant.Id)">
                                                @FormatCulture(variant.Culture)@(isDefault ? " · Default" : "")
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            @if (AvailableTranslationCultures.Any())
                            {
                                <div class="grid grid-cols-1 md:grid-cols-[220px_1fr_auto] gap-3 items-end">
                                    <label class="pe-field">
                                        <span>@L["Target culture"]</span>
                                        <select @bind="SelectedTranslationCulture">
                                            @foreach (var culture in AvailableTranslationCultures)
                                            {
                                                <option value="@culture">@FormatCulture(culture)</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="pe-field">
                                        <span>@L["Translated slug"]</span>
                                        <input @bind="TranslationSlug" @bind:event="oninput" placeholder="@Current.Slug" />
                                        <small>@L["Leave blank to copy the current slug, or enter the translated URL path."]</small>
                                    </label>
                                    <button type="button" class="pe-btn pe-btn-primary pe-btn-sm" @onclick="CreateTranslationAsync" disabled="@IsCreatingTranslation">
                                        @(IsCreatingTranslation ? L["Creating..."] : L["Create Translation"])
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="text-sm" style="color: var(--pe-text-muted);">@L["All supported site cultures already have a docs variant."]</p>
                            }
                        </div>
                        *@

                        <div class="pe-doc-editor-tabs" role="tablist">
                            <button type="button" class="@TabClass("content")" @onclick='() => ActiveTab = "content"'>@L["Content"]</button>
                            <button type="button" class="@TabClass("preview")" @onclick="TogglePreviewAsync">@L["Preview"]</button>
                        </div>

                        <div class="pe-doc-markdown-editor">
                            <AeroMarkdownEditor @key="Current.Id"
                                                @ref="_markdownEditor"
                                                EditorId="@($"docs-markdown-{Current.Id}")"
                                                 Markdown="@(Current.MarkdownContent ?? string.Empty)"
                                                 MarkdownChanged="OnMarkdownEditorSynchronized"
                                                 ContentChanged="OnMarkdownEditorContentChanged"
                                                 EnhanceRequested="OpenDocsAiAsync"
                                                 AiEnabled="@DocsAiEnabled"
                                                 AiUnavailableMessage="@DocsAiUnavailableMessage"
                                                 AriaLabel="@L["Documentation content"]" />
                        </div>
                    </section>
                }
            </main>

            <aside class="pe-doc-editor-inspector" aria-label="Document tools">
                <div class="pe-doc-inspector-tabs" role="tablist" aria-label="@L["Document inspector"]">
                    <button type="button"
                            class="@InspectorTabClass("structure")"
                            @onclick='() => InspectorTab = "structure"'>@L["Structure"]</button>
                    <button type="button"
                            class="@InspectorTabClass("translations")"
                            @onclick='() => InspectorTab = "translations"'>@L["Translations"]</button>
                    <button type="button"
                            class="@InspectorTabClass("attributes")"
                            @onclick='() => InspectorTab = "attributes"'>@L["Attributes"]</button>
                </div>

                @if (InspectorTab == "structure")
                {
                    <section>
                        <p class="pe-docs-kicker">@L["Structure"]</p>
                        <h2>@(Current?.Title ?? Space.Title)</h2>
                        <dl class="pe-doc-inspector-list">
                            <div>
                                <dt>@L["Space"]</dt>
                                <dd>@Space.Title</dd>
                            </div>
                            <div>
                                <dt>@L["Depth"]</dt>
                                <dd>@(SelectedNode?.Depth ?? 0)</dd>
                            </div>
                            <div>
                                <dt>@L["Children"]</dt>
                                <dd>@(SelectedNode?.ChildCount ?? 0)</dd>
                            </div>
                        </dl>
                    </section>

                    <section>
                        <p class="pe-docs-kicker">@L["Related content"]</p>
                        <div class="pe-doc-block-tray">
                            <button type="button" @onclick='() => InsertSnippet("children")'>@L["Child links"]</button>
                        </div>
                    </section>
                }
                else if (InspectorTab == "translations" && Current is not null)
                {
                    <section class="pe-doc-inspector-stack">
                        <div>
                            <p class="pe-docs-kicker">@L["Translations"]</p>
                            <h2>@FormatCulture(Current.Culture)</h2>
                            <p class="pe-doc-inspector-help">@string.Format(L["{0} of {1} site cultures created."], DocCultureVariants.Count, SupportedCultures.Count)</p>
                        </div>

                        @if (Current.TranslationGroupId is { } TranslationGroupId)
                        {
                            <code class="pe-doc-translation-set">Set @TranslationGroupId</code>
                        }

                        @if (IsLoadingTranslations)
                        {
                            <p class="pe-doc-inspector-help">@L["Loading translations..."]</p>
                        }
                        else
                        {
                            <div class="pe-doc-translation-list">
                                @foreach (var variant in DocCultureVariants)
                                {
                                    var isCurrent = Current.Id == variant.Id;
                                    var isDefault = string.Equals(CurrentSite?.DefaultCulture, variant.Culture, StringComparison.OrdinalIgnoreCase);
                                    <button type="button"
                                            class="pe-btn @(isCurrent ? "pe-btn-primary" : "pe-btn-ghost") pe-btn-sm"
                                            disabled="@isCurrent"
                                            @onclick="() => OpenTranslation(variant.Id)">
                                        @FormatCulture(variant.Culture)@(isDefault ? " · Default" : "")
                                    </button>
                                }
                            </div>
                        }

                        @if (AvailableTranslationCultures.Any())
                        {
                            <label class="pe-field">
                                <span>@L["Target culture"]</span>
                                <select @bind="SelectedTranslationCulture">
                                    @foreach (var culture in AvailableTranslationCultures)
                                    {
                                        <option value="@culture">@FormatCulture(culture)</option>
                                    }
                                </select>
                            </label>
                            <label class="pe-field">
                                <span>@L["Translated slug"]</span>
                                <input @bind="TranslationSlug" @bind:event="oninput" placeholder="@Current.Slug" />
                                <small>@L["Leave blank to copy the current slug."]</small>
                            </label>
                            <button type="button"
                                    class="pe-btn pe-btn-primary pe-btn-sm"
                                    @onclick="CreateTranslationAsync"
                                    disabled="@IsCreatingTranslation">
                                @(IsCreatingTranslation ? L["Creating..."] : L["Create Translation"])
                            </button>
                        }
                        else
                        {
                            <p class="pe-doc-inspector-help">@L["All supported site cultures already have a docs variant."]</p>
                        }
                    </section>
                }
                else if (InspectorTab == "attributes" && Current is not null)
                {
                    <section class="pe-doc-inspector-stack">
                        <p class="pe-docs-kicker">@L["Attributes"]</p>
                        <label class="pe-field">
                            <span>@L["Slug"]</span>
                            <input value="@Current.Slug" @oninput="OnSlugChanged" />
                        </label>
                        <label class="pe-field">
                            <span>@L["Parent"]</span>
                            <select value="@ParentSelectValue" @onchange="OnParentChanged" disabled="@IsEditingSpaceRoot">
                                @foreach (var option in ParentOptions)
                                {
                                    <option value="@option.Id">@option.Label</option>
                                }
                            </select>
                        </label>
                        <label class="pe-field">
                            <span>@L["Order"]</span>
                            <input type="number" value="@Current.Order" @oninput="OnOrderChanged" />
                        </label>
                        <label class="pe-field">
                            <span>@L["Summary"]</span>
                            <textarea rows="3" value="@Current.Summary" @oninput="e => UpdateCurrent(current => current.Summary = e.Value?.ToString())"></textarea>
                        </label>
                        <label class="pe-field">
                            <span>@L["SEO title"]</span>
                            <input value="@Current.SeoTitle" @oninput="e => UpdateCurrent(current => current.SeoTitle = e.Value?.ToString())" />
                        </label>
                        <label class="pe-field">
                            <span>@L["SEO description"]</span>
                            <textarea rows="3" value="@Current.SeoDescription" @oninput="e => UpdateCurrent(current => current.SeoDescription = e.Value?.ToString())"></textarea>
                        </label>
                        <label class="pe-field">
                            <span>@L["Header image URL"]</span>
                            <input value="@Current.HeaderImageUrl" @oninput="e => UpdateCurrent(current => current.HeaderImageUrl = e.Value?.ToString())" />
                        </label>
                        <label class="pe-doc-toggle">
                            <input type="checkbox" checked="@Current.ShowHeaderNavigation" @onchange="OnShowHeaderNavigationChanged" />
                            @L["Show site navigation"]
                        </label>
                        <label class="pe-doc-toggle">
                            <input type="checkbox" checked="@Current.IncludeInSearch"
                                   @onchange="e => UpdateCurrent(current => current.IncludeInSearch = e.Value is true)" />
                            <span>
                                @L["Include in site search"]
                                <small class="block">@L["Allow the published document to appear in site search."]</small>
                            </span>
                        </label>
                        <label class="pe-doc-toggle">
                            <input type="checkbox" checked="@Current.IncludeInPublicAi"
                                   disabled="@(!Current.IncludeInSearch)"
                                   @onchange="e => UpdateCurrent(current => current.IncludeInPublicAi = e.Value is true)" />
                            <span>
                                @L["Use in public AI answers"]
                                <small class="block">@L["Allow published documentation to ground public visitor answers."]</small>
                            </span>
                        </label>
                    </section>
                }

                <section class="pe-doc-danger-zone">
                    <p class="pe-docs-kicker">@L["Actions"]</p>
                    <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="DuplicateCurrentAsync" disabled="@(Current is null)">@L["Duplicate"]</button>
                </section>
            </aside>
        </div>
    }
</div>

<PreviewOverlay Visible="@PreviewMode"
                OnClose="ClosePreviewAsync"
                FrameUrl="@PreviewFrameUrl"
                UrlBarText="@PreviewFrameUrl"
                SuppressBrowserLinkErrors="true"
                Title="@L["Docs preview"]" />
