@page "/manager/docs/{SpaceId:long}"
@page "/manager/docs/{SpaceId:long}/sections/{SectionId:long}"
@attribute [Authorize]

@using Aero.Cms.Abstractions.Enums
@using Aero.Cms.Abstractions.Http.Clients
@using NeoUI.Blazor

<PageTitle>@(Space?.Title ?? "Docs Editor")</PageTitle>

<div class="pe-doc-editor-shell">
    <header class="pe-doc-editor-topbar">
        <div class="pe-doc-editor-title-block">
            <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="BackToSpaces">Spaces</button>
            <span class="pe-doc-editor-breadcrumb">/</span>
            <span class="pe-doc-editor-space-name">@(Space?.Title ?? "Loading")</span>
        </div>
        <div class="pe-doc-editor-actions">
            @if (Current is not null)
            {
                <a class="pe-btn pe-btn-ghost pe-btn-sm" href="@PublicUrl(Current)" target="_blank" rel="noopener noreferrer">View</a>
                <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="TogglePreview">
                    @(PreviewMode ? "Edit" : "Preview")
                </button>
                <button type="button" class="pe-btn pe-btn-primary pe-btn-sm" @onclick="SaveCurrentAsync" disabled="@_isSaving">
                    @(_isSaving ? "Saving..." : "Save")
                </button>
                <button type="button" class="pe-btn pe-btn-success pe-btn-sm" @onclick="PublishCurrentAsync" disabled="@_isSaving">
                    Publish
                </button>
            }
        </div>
    </header>

    @if (_isLoading)
    {
        <div class="pe-doc-editor-loading">Loading space...</div>
    }
    else if (Space is null)
    {
        <div class="pe-doc-editor-loading">Space not found.</div>
    }
    else
    {
        <div class="pe-doc-editor-layout">
            <aside class="pe-doc-editor-explorer" aria-label="Space outline">
                <div class="pe-doc-editor-panel-head">
                    <div>
                        <p class="pe-docs-kicker">Explorer</p>
                        <h2>@Space.Title</h2>
                    </div>
                    <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="CreateChildAsync">Add</button>
                </div>

                <div class="pe-doc-tree-tools">
                    <label class="pe-field pe-doc-tree-search">
                        <span>Find</span>
                        <input value="@_outlineSearch" @oninput="OnOutlineSearchChanged" placeholder="Search this space" />
                    </label>
                    <label class="pe-doc-tree-check">
                        <input type="checkbox" checked="@_multiSelect" @onchange="ToggleMultiSelect" />
                        Multi-select
                    </label>
                    @if (_selectedIds.Count > 0)
                    {
                        <span>@_selectedIds.Count selected</span>
                    }
                </div>

                @if (_selectedIds.Count > 0)
                {
                    <div class="pe-doc-batch-bar" aria-label="Batch actions">
                        <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="PublishSelectedAsync">Publish</button>
                        <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="UnpublishSelectedAsync">Unpublish</button>
                        <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm pe-doc-delete-btn" @onclick="DeleteSelectedAsync">Delete</button>
                    </div>
                }

                <nav class="pe-doc-tree" aria-label="Docs sections">
                    @foreach (var node in VisibleOutline)
                    {
                        <ContextMenu>
                            <ContextMenuTrigger>
                                <div class="@NodeClass(node)" style="--doc-node-depth:@node.Depth">
                                    @if (_multiSelect)
                                    {
                                        <input type="checkbox"
                                               checked="@_selectedIds.Contains(node.Id)"
                                               @onchange="args => ToggleNodeSelection(node.Id, args)" />
                                    }
                                    <button type="button" class="pe-doc-tree-node-main" @onclick="() => SelectNode(node)">
                                        <span class="pe-doc-tree-node-title">@node.Title</span>
                                        <span class="pe-doc-tree-node-meta">@node.ChildCount</span>
                                    </button>
                                    <button type="button" class="pe-doc-tree-node-action" title="Move up" @onclick="() => MoveNodeAsync(node.Id, -1)" disabled="@IsSpaceNode(node)">Up</button>
                                    <button type="button" class="pe-doc-tree-node-action" title="Move down" @onclick="() => MoveNodeAsync(node.Id, 1)" disabled="@IsSpaceNode(node)">Down</button>
                                    <button type="button" class="pe-doc-tree-node-action" title="Add child section" @onclick="() => CreateChildAsync(node.Id)">+</button>
                                </div>
                            </ContextMenuTrigger>
                            <ContextMenuContent Class="pe-doc-context-menu">
                                <ContextMenuItem OnClick="@(() => SelectNode(node))">Open</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => CreateChildAsync(node.Id))">Add child section</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => EditNodeAttributes(node))">Edit attributes</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => DuplicateNodeAsync(node.Id))" Disabled="@IsSpaceNode(node)">Duplicate</ContextMenuItem>
                                <ContextMenuSeparator />
                                <ContextMenuItem OnClick="@(() => MoveNodeAsync(node.Id, -1))" Disabled="@IsSpaceNode(node)">Move up</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => MoveNodeAsync(node.Id, 1))" Disabled="@IsSpaceNode(node)">Move down</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => MoveNodeToSpaceRootAsync(node.Id))" Disabled="@IsSpaceNode(node)">Move to space root</ContextMenuItem>
                                <ContextMenuSeparator />
                                <ContextMenuItem OnClick="@(() => PublishNodeAsync(node.Id))">Publish</ContextMenuItem>
                                <ContextMenuItem OnClick="@(() => UnpublishNodeAsync(node.Id))">Unpublish</ContextMenuItem>
                                <ContextMenuSeparator />
                                <ContextMenuItem Class="pe-doc-context-danger" OnClick="@(() => DeleteNodeAsync(node.Id))" Disabled="@IsSpaceNode(node)">Delete</ContextMenuItem>
                            </ContextMenuContent>
                        </ContextMenu>
                    }
                </nav>
            </aside>

            <main class="pe-doc-editor-main">
                @if (Current is null)
                {
                    <div class="pe-doc-editor-empty">Select a section to start editing.</div>
                }
                else
                {
                    <section class="pe-doc-document-surface">
                        <div class="pe-doc-document-header">
                            <div class="pe-doc-document-title-row">
                                <input class="pe-doc-title-input"
                                       value="@Current.Title"
                                       @oninput="OnTitleChanged"
                                       placeholder="Untitled section" />
                                <span class="@StatusClass(Current.PublicationState)">@Current.PublicationState</span>
                            </div>
                            <div class="pe-doc-document-meta-row">
                                <code>/docs/@Current.Slug</code>
                                <span>@FormatCulture(Current.Culture)</span>
                                @if (HasUnpublishedChanges)
                                {
                                    <span>Unpublished changes</span>
                                }
                            </div>
                        </div>

                        <div class="rounded-md border p-4 space-y-3"
                             style="border-color: var(--pe-border); background: var(--pe-bg-secondary);">
                            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                                <div>
                                    <h3 class="text-base font-semibold" style="color: var(--pe-text-primary);">Translations</h3>
                                    <p class="mt-1 text-sm" style="color: var(--pe-text-muted);">Current variant: @FormatCulture(Current.Culture)</p>
                                </div>
                                @if (Current.TranslationSetId is { } translationSetId)
                                {
                                    <span class="text-xs font-mono px-2 py-1 rounded"
                                          style="background: var(--pe-bg-primary); color: var(--pe-text-muted); border: 1px solid var(--pe-border);">
                                        Set @translationSetId
                                    </span>
                                }
                            </div>

                            <div class="rounded-md border p-3"
                                 style="border-color: var(--pe-border); background: var(--pe-bg-primary);">
                                @if (IsLoadingTranslations)
                                {
                                    <p class="text-sm" style="color: var(--pe-text-muted);">Loading translations...</p>
                                }
                                else if (DocCultureVariants.Count == 0)
                                {
                                    <p class="text-sm" style="color: var(--pe-text-muted);">No translation variants found.</p>
                                }
                                else
                                {
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var variant in DocCultureVariants)
                                        {
                                            var isCurrent = Current.Id == variant.Id;
                                            <button type="button"
                                                    class="pe-btn @(isCurrent ? "pe-btn-primary" : "pe-btn-ghost") pe-btn-sm"
                                                    disabled="@isCurrent"
                                                    @onclick="() => OpenTranslation(variant.Id)">
                                                @FormatCulture(variant.Culture)
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            @if (AvailableTranslationCultures.Any())
                            {
                                <div class="grid grid-cols-1 md:grid-cols-[220px_1fr_auto] gap-3 items-end">
                                    <label class="pe-field">
                                        <span>Target culture</span>
                                        <select @bind="SelectedTranslationCulture">
                                            @foreach (var culture in AvailableTranslationCultures)
                                            {
                                                <option value="@culture">@FormatCulture(culture)</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="pe-field">
                                        <span>Translated slug</span>
                                        <input @bind="TranslationSlug" @bind:event="oninput" placeholder="@Current.Slug" />
                                    </label>
                                    <button type="button" class="pe-btn pe-btn-primary pe-btn-sm" @onclick="CreateTranslationAsync" disabled="@IsCreatingTranslation">
                                        @(IsCreatingTranslation ? "Creating..." : "Create Translation")
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="text-sm" style="color: var(--pe-text-muted);">All supported site cultures already have a docs variant.</p>
                            }
                        </div>

                        <div class="pe-doc-editor-tabs" role="tablist">
                            <button type="button" class="@TabClass("content")" @onclick='() => ActiveTab = "content"'>Content</button>
                            <button type="button" class="@TabClass("preview")" @onclick='() => ActiveTab = "preview"'>Preview</button>
                            <button type="button" class="@TabClass("attributes")" @onclick='() => ActiveTab = "attributes"'>Attributes</button>
                        </div>

                        @if (ActiveTab == "content")
                        {
                            <div class="pe-doc-write-grid">
                                <label class="pe-field pe-doc-markdown-field">
                                    <span>Markdown</span>
                                    <textarea value="@Current.MarkdownContent"
                                              @oninput="OnMarkdownChanged"
                                              placeholder="# Start writing..."></textarea>
                                </label>
                                <div class="pe-doc-live-preview">
                                    <div class="pe-doc-preview-label">Live preview</div>
                                    <RadzenMarkdown Text="@Current.MarkdownContent" AllowHtml="true" />
                                </div>
                            </div>
                        }
                        else if (ActiveTab == "preview" || PreviewMode)
                        {
                            <article class="pe-doc-public-preview">
                                <div class="pe-doc-public-preview-inner">
                                    <p class="pe-doc-public-eyebrow">Docs</p>
                                    <h1>@Current.Title</h1>
                                    @if (!string.IsNullOrWhiteSpace(Current.Summary))
                                    {
                                        <p class="pe-doc-public-summary">@Current.Summary</p>
                                    }
                                    <RadzenMarkdown Text="@Current.MarkdownContent" AllowHtml="true" />
                                </div>
                            </article>
                        }
                        else if (ActiveTab == "attributes")
                        {
                            <div class="pe-doc-attributes-grid">
                                <label class="pe-field">
                                    <span>Slug</span>
                                    <input value="@Current.Slug" @oninput="OnSlugChanged" />
                                </label>
                                <label class="pe-field">
                                    <span>Parent</span>
                                    <select value="@ParentSelectValue" @onchange="OnParentChanged" disabled="@IsEditingSpaceRoot">
                                        @foreach (var option in ParentOptions)
                                        {
                                            <option value="@option.Id">@option.Label</option>
                                        }
                                    </select>
                                </label>
                                <label class="pe-field">
                                    <span>Order</span>
                                    <input type="number" value="@Current.Order" @oninput="OnOrderChanged" />
                                </label>
                                <label class="pe-field">
                                    <span>Status</span>
                                    <select value="@Current.PublicationState" @onchange="OnStatusChanged">
                                        <option value="@ContentPublicationState.Draft">Draft</option>
                                        <option value="@ContentPublicationState.Published">Published</option>
                                        <option value="@ContentPublicationState.Archived">Archived</option>
                                    </select>
                                </label>
                                <label class="pe-field pe-doc-attributes-wide">
                                    <span>Summary</span>
                                    <textarea rows="3" value="@Current.Summary" @oninput="e => UpdateCurrent(current => current.Summary = e.Value?.ToString())"></textarea>
                                </label>
                                <label class="pe-field">
                                    <span>SEO title</span>
                                    <input value="@Current.SeoTitle" @oninput="e => UpdateCurrent(current => current.SeoTitle = e.Value?.ToString())" />
                                </label>
                                <label class="pe-field">
                                    <span>SEO description</span>
                                    <textarea rows="3" value="@Current.SeoDescription" @oninput="e => UpdateCurrent(current => current.SeoDescription = e.Value?.ToString())"></textarea>
                                </label>
                                <label class="pe-field">
                                    <span>Header image URL</span>
                                    <input value="@Current.HeaderImageUrl" @oninput="e => UpdateCurrent(current => current.HeaderImageUrl = e.Value?.ToString())" />
                                </label>
                                <label class="pe-doc-toggle">
                                    <input type="checkbox" checked="@Current.ShowHeaderNavigation" @onchange="OnShowHeaderNavigationChanged" />
                                    Show site navigation
                                </label>
                            </div>
                        }
                    </section>
                }
            </main>

            <aside class="pe-doc-editor-inspector" aria-label="Document tools">
                <section>
                    <p class="pe-docs-kicker">Structure</p>
                    <h2>@(Current?.Title ?? Space.Title)</h2>
                    <dl class="pe-doc-inspector-list">
                        <div>
                            <dt>Space</dt>
                            <dd>@Space.Title</dd>
                        </div>
                        <div>
                            <dt>Depth</dt>
                            <dd>@(SelectedNode?.Depth ?? 0)</dd>
                        </div>
                        <div>
                            <dt>Children</dt>
                            <dd>@(SelectedNode?.ChildCount ?? 0)</dd>
                        </div>
                    </dl>
                </section>

                <section>
                    <p class="pe-docs-kicker">Content blocks</p>
                    <div class="pe-doc-block-tray">
                        <button type="button" @onclick='() => InsertSnippet("markdown")'>Markdown</button>
                        <button type="button" @onclick='() => InsertSnippet("code")'>Code</button>
                        <button type="button" @onclick='() => InsertSnippet("callout")'>Callout</button>
                        <button type="button" @onclick='() => InsertSnippet("table")'>Table</button>
                        <button type="button" @onclick='() => InsertSnippet("image")'>Image</button>
                        <button type="button" @onclick='() => InsertSnippet("children")'>Child links</button>
                    </div>
                </section>

                <section class="pe-doc-danger-zone">
                    <p class="pe-docs-kicker">Actions</p>
                    <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="DuplicateCurrentAsync" disabled="@(Current is null)">Duplicate</button>
                    <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="UnpublishCurrentAsync" disabled="@(Current is null)">Unpublish</button>
                    <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm pe-doc-delete-btn" @onclick="DeleteCurrentAsync" disabled="@IsEditingSpaceRoot">Delete</button>
                </section>
            </aside>
        </div>
    }
</div>
