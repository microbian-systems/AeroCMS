@page "/manager/login"
@namespace Aero.Cms.Shared.Pages.Manager
@inherits LoginBase
@attribute [AllowAnonymous]
@layout EmptyLayout

<div class="min-h-screen flex items-center justify-center bg-slate-100 px-6 py-12">
    <div class="w-full max-w-md rounded-3xl border border-slate-200 bg-white p-8 shadow-xl space-y-6">
        <div class="space-y-2 text-center">
            <h1 class="text-3xl font-bold text-slate-950">@L["Manager Login"]</h1>
            <p class="text-sm text-slate-500">@L["Sign in with a CMS account that has one of the Aero CMS roles."]</p>

            @if (IsDevelopment)
            {
                <div class="mt-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 border border-amber-200">
                    @L["Development Mode"]
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="p-4 rounded-xl bg-rose-50 border border-rose-100 text-rose-600 text-sm font-medium animate-in fade-in slide-in-from-top-2 duration-300">
                <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                    </svg>
                    @ErrorMessage
                </div>
            </div>
        }

        @if (IsAuthenticationModeUnavailable)
        {
            <div class="space-y-4 rounded-2xl border border-slate-200 bg-slate-50 p-5 text-sm text-slate-700">
                <p>@L["Manager authentication is temporarily unavailable. No normal sign-in method has been enabled."]</p>
                <a href="/manager/recovery" class="font-semibold text-indigo-700 hover:text-indigo-900">
                    @L["Use the local recovery administrator"]
                </a>
            </div>
        }
        else if (IsRemoteAuthenticationActive)
        {
            <div class="space-y-4 rounded-2xl border border-indigo-200 bg-indigo-50 p-5 text-sm text-slate-700">
                <p>@L["This installation uses an external provider for normal manager sign-in."]</p>
                <a href="@RemoteLoginHref" class="block rounded-xl bg-indigo-700 px-4 py-3 text-center font-bold text-white hover:bg-indigo-800">
                    Sign in with @RemoteProviderLabel
                </a>
                <a href="/manager/recovery" class="block text-center font-semibold text-indigo-700 hover:text-indigo-900">
                    @L["Use the local recovery administrator"]
                </a>
            </div>
        }
        else
        {
        @if (IsRemoteAuthenticationPending)
        {
            <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                Remote manager authentication is requested but is not active. Sign in locally, then <a href="/manager/authentication" class="font-semibold underline">configure and verify it</a>.
            </div>
        }
        <form method="post" action="/api/v1/admin/auth/local/login/form" class="space-y-4">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@SafeReturnPath" />

            <div class="space-y-2">
                <label class="text-xs font-bold text-slate-700">@L["Username or Email"]</label>
                <input name="EmailOrUserName" value="@Model.EmailOrUserName" required autocomplete="username"
                       class="h-12 w-full px-4 rounded-xl border border-slate-200 bg-slate-50/50 text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-50 outline-none transition-all" />
            </div>

            <div class="space-y-2">
                <label class="text-xs font-bold text-slate-700">@L["Password"]</label>
                <input name="Password" value="@Model.Password" type="password" required autocomplete="current-password"
                       class="h-12 w-full px-4 rounded-xl border border-slate-200 bg-slate-50/50 text-sm focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-50 outline-none transition-all" />
            </div>

            <label class="flex items-center gap-3 text-sm text-slate-600">
                <input name="RememberMe" type="checkbox" value="true" />
                <span>@L["Remember me"]</span>
            </label>

            <button type="submit" class="h-12 w-full rounded-2xl bg-slate-950 text-sm font-bold text-white transition hover:bg-slate-800 flex items-center justify-center gap-2">
                <span>@L["Sign In"]</span>
            </button>
        </form>
        }
    </div>
</div>
