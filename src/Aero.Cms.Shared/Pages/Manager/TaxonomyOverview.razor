@page "/manager/taxonomy"
@page "/manager/taxonomy/general"
@attribute [Authorize]
@using Aero.Cms.Abstractions.Http.Clients
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Aero.Cms.Shared.Localization.ManagerResource> L

<div class="pe-page-content space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h1 class="text-2xl font-bold pe-heading">@L["Taxonomy"]</h1>
            <p class="mt-1 text-sm pe-description">@L["Manage categories, tags, and blog series."]</p>
        </div>
        <div class="flex flex-wrap gap-2">
            @foreach (var option in TaxonomyOptions)
            {
                <button type="button"
                        class="@TaxonomyButtonClass(option.Key)"
                        @onclick="() => SelectTaxonomyAsync(option.Key)">
                    <RadzenIcon Icon="@option.Icon" />
                    <span>@L[option.Label]</span>
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="rounded-md border px-4 py-3 text-sm" style="border-color: #f59e0b; color: #92400e; background: rgba(245, 158, 11, 0.08);">
            @ErrorMessage
        </div>
    }

    <div class="grid grid-cols-1 xl:grid-cols-[1fr_360px] gap-6">
        <section class="rounded-md border" style="background: var(--pe-bg-secondary); border-color: var(--pe-border);">
            <div class="flex flex-col gap-3 border-b p-4 md:flex-row md:items-center md:justify-between" style="border-color: var(--pe-border);">
                <div>
                    <h2 class="text-lg font-semibold" style="color: var(--pe-text-primary);">@L[ActiveOption.Label]</h2>
                    <p class="text-sm" style="color: var(--pe-text-muted);">@L[ActiveOption.Description]</p>
                </div>
                <button type="button" class="pe-btn pe-btn-primary pe-btn-sm" @onclick="StartCreate">
                    <RadzenIcon Icon="add" />
                    @L[$"Create {ActiveOption.SingularLabel}"]
                </button>
            </div>

            <RadzenDataGrid Data="@Items"
                            TItem="TaxonomyItem"
                            AllowPaging="true"
                            AllowFiltering="true"
                            AllowSorting="true"
                            PageSize="12"
                            IsLoading="@IsLoading"
                            EmptyText="@L["No taxonomy entries found."]">
                <Columns>
                    <RadzenDataGridColumn TItem="TaxonomyItem" Property="Name" Title="@L["Name"]" />
                    <RadzenDataGridColumn TItem="TaxonomyItem" Property="Slug" Title="@L["Slug"]" />
                    <RadzenDataGridColumn TItem="TaxonomyItem" Property="Description" Title="@L["Description"]" />
                    <RadzenDataGridColumn TItem="TaxonomyItem" Property="ContentCount" Title="@L["Used"]" Width="110px" />
                    <RadzenDataGridColumn TItem="TaxonomyItem" Title="@L["Actions"]" Width="150px" Sortable="false" Filterable="false">
                        <Template Context="item">
                            <div class="flex gap-1">
                                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" title="@L["Edit"]" @onclick="() => StartEdit(item)">
                                    <RadzenIcon Icon="edit" />
                                </button>
                                @if (ActiveKind == TaxonomyKind.Series)
                                {
                                    <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" title="@L["Translations"]" @onclick="() => StartEdit(item)">
                                        <RadzenIcon Icon="translate" />
                                    </button>
                                }
                                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" title="@L["Delete"]" @onclick="() => DeleteAsync(item)">
                                    <RadzenIcon Icon="delete" />
                                </button>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </section>

        <aside class="rounded-md border p-4 space-y-4" style="background: var(--pe-bg-secondary); border-color: var(--pe-border); color: var(--pe-text-primary);">
            <div>
                <h2 class="text-lg font-semibold">@((EditingId is null ? L[$"Create {ActiveOption.SingularLabel}"] : L[$"Edit {ActiveOption.SingularLabel}"]))</h2>
                <p class="text-sm" style="color: var(--pe-text-muted);">@L["Names and slugs are stored per site."]</p>
            </div>

            <div>
                <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Name"]</label>
                <input class="w-full rounded-md shadow-sm sm:text-sm"
                       style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                       value="@DraftName"
                       @oninput="e => OnNameChanged(e.Value?.ToString() ?? string.Empty)" />
            </div>

            <div>
                <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Slug"]</label>
                <input class="w-full rounded-md shadow-sm sm:text-sm font-mono"
                       style="background: var(--pe-bg-primary); color: var(--pe-primary); border: 1px solid var(--pe-border);"
                       value="@DraftSlug"
                       @oninput="e => DraftSlug = e.Value?.ToString() ?? string.Empty" />
            </div>

            <div>
                <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Description"]</label>
                <textarea rows="4"
                          class="w-full rounded-md shadow-sm sm:text-sm"
                          style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                          @oninput="e => DraftDescription = e.Value?.ToString() ?? string.Empty">@DraftDescription</textarea>
            </div>

            @if (ActiveKind == TaxonomyKind.Series)
            {
                <div class="rounded-md border p-3 text-sm space-y-3" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                    <div>
                        <div class="font-semibold">@L["Culture / Translations"]</div>
                        <p style="color: var(--pe-text-muted);">@L["Edit the base series above. Add localized names and slugs for supported cultures here."]</p>
                    </div>

                    @if (EditingId is null)
                    {
                        <p style="color: var(--pe-text-muted);">@L["Save or select a series before editing translations."]</p>
                    }
                    else if (IsLoadingSeriesTranslations)
                    {
                        <p style="color: var(--pe-text-muted);">@L["Loading translations..."]</p>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var translation in SeriesTranslations)
                            {
                                <div class="flex items-center justify-between gap-2 rounded border px-2 py-2" style="border-color: var(--pe-border);">
                                    <div>
                                        <div class="font-medium">@FormatCulture(translation.Culture)</div>
                                        <div class="text-xs" style="color: var(--pe-text-muted);">
                                            @(translation.IsDefaultCulture ? L["Default culture"] : translation.HasTranslation ? translation.Name : L["Missing translation"])
                                        </div>
                                    </div>
                                    @if (!translation.IsDefaultCulture)
                                    {
                                        <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="() => StartSeriesTranslation(translation)">
                                            @(translation.HasTranslation ? L["Edit"] : L["Add"])
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(TranslationCulture))
                        {
                            <div class="space-y-3 border-t pt-3" style="border-color: var(--pe-border);">
                                <div class="font-semibold">@FormatCulture(TranslationCulture)</div>
                                <div>
                                    <label class="block text-xs font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Translated Name"]</label>
                                    <input class="w-full rounded-md shadow-sm sm:text-sm"
                                           style="background: var(--pe-bg-secondary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                           value="@TranslationName"
                                           @oninput="e => OnTranslationNameChanged(e.Value?.ToString() ?? string.Empty)" />
                                </div>
                                <div>
                                    <label class="block text-xs font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Translated Slug"]</label>
                                    <input class="w-full rounded-md shadow-sm sm:text-sm font-mono"
                                           style="background: var(--pe-bg-secondary); color: var(--pe-primary); border: 1px solid var(--pe-border);"
                                           value="@TranslationSlug"
                                           @oninput="e => TranslationSlug = e.Value?.ToString() ?? string.Empty" />
                                </div>
                                <div>
                                    <label class="block text-xs font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Translated Description"]</label>
                                    <textarea rows="3"
                                              class="w-full rounded-md shadow-sm sm:text-sm"
                                              style="background: var(--pe-bg-secondary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                              @oninput="e => TranslationDescription = e.Value?.ToString() ?? string.Empty">@TranslationDescription</textarea>
                                </div>
                                <div class="flex justify-between gap-2">
                                    <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" disabled>
                                        <RadzenIcon Icon="auto_awesome" />
                                        @L["AI Translate"]
                                    </button>
                                    <button type="button" class="pe-btn pe-btn-primary pe-btn-sm" disabled="@IsSavingSeriesTranslation" @onclick="SaveSeriesTranslationAsync">
                                        @(IsSavingSeriesTranslation ? L["Saving..."] : L["Save Translation"])
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            }

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" class="pe-btn pe-btn-ghost" @onclick="ResetDraft">@L["Clear"]</button>
                <button type="button" class="pe-btn pe-btn-primary" disabled="@IsSaving" @onclick="SaveAsync">
                    @(IsSaving ? L["Saving..."] : L["Save"])
                </button>
            </div>
        </aside>
    </div>
</div>
