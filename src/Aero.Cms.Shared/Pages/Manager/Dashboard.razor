        new("docs.aerocms.com/", "5.4K", 30, "pink"),
    ];

    // ── Top Regions (progress bars) ───────────────────
    private record RegionItem(string Flag, string Name, string Sessions, double Percentage, string BarColor);

    private RegionItem[] regions = [
        new("🇮🇪", "Ireland", "4.2K", 82, "violet"),
        new("🇺🇸", "United States", "3.4K", 70, "blue"),
        new("🇩🇪", "Germany", "1.6K", 60, "green"),
        new("🇮🇹", "Italy", "1.2K", 44, "orange"),
        new("🇬🇧", "United Kingdom", "912", 40, "teal"),
    ];

    // ── Top Content Table ─────────────────────────────
    private record TableItem(
        string Title, string Category, string Views, string Ctr, string Value,
        string BadgeBg, RenderFragment BadgeSvg, string[] AvatarLetters);

    private TableItem[] tableItems = [
        new("Getting Started with Aero", "Post", "20.9K", "27.4%", "$12,499",
            "rgba(99,102,241,0.15)", _badge("M24.446 19.335a2.5 2.5 0 00-3.522 3.194c-.845.63-1.87.97-2.924.971a4.979 4.979 0 01-1.113-.135 4.436 4.436 0 01-1.343 1.682 6.91 6.91 0 006.9-1.165 2.5 2.5 0 002-4.547h.002zM20.431 11.938a2.5 2.5 0 10-.4 2.014 5.027 5.027 0 012.723 3.078c.148-.018.297-.028.446-.03a4.5 4.5 0 011.7.334 7.023 7.023 0 00-4.469-5.396zM14.969 20.25a2.49 2.49 0 00-1.932-1.234A4.624 4.624 0 0113 18.5a4.97 4.97 0 011.348-3.391 4.456 4.456 0 01-.788-2.016A6.989 6.989 0 0011 18.5c.003.391.04.781.11 1.166a2.5 2.5 0 103.859.584z", "#6366f1"),
            ["AB", "CD"]),
        new("Aero CMS Documentation", "Doc", "17.9K", "22.6%", "$4,227",
            "rgba(34,197,94,0.15)", _badge("M11 22.012a1 1 0 01-.707-1.707l4.5-4.5a1 1 0 011.414 0l3.293 3.293 4.793-4.793a1 1 0 111.414 1.414l-5.5 5.5a1 1 0 01-1.414 0L15.5 17.926l-3.793 3.793a1 1 0 01-.707.293z", "#22c55e"),
            ["EF", "GH", "IJ"]),
        new("2024 Web Bootcamp", "Course", "16.1K", "22.4%", "$2,499",
            "rgba(99,102,241,0.15)", _badge("M24.446 19.335a2.5 2.5 0 00-3.522 3.194c-.845.63-1.87.97-2.924.971a4.979 4.979 0 01-1.113-.135 4.436 4.436 0 01-1.343 1.682 6.91 6.91 0 006.9-1.165 2.5 2.5 0 002-4.547h.002zM20.431 11.938a2.5 2.5 0 10-.4 2.014 5.027 5.027 0 012.723 3.078c.148-.018.297-.028.446-.03a4.5 4.5 0 011.7.334 7.023 7.023 0 00-4.469-5.396zM14.969 20.25a2.49 2.49 0 00-1.932-1.234A4.624 4.624 0 0113 18.5a4.97 4.97 0 011.348-3.391 4.456 4.456 0 01-.788-2.016A6.989 6.989 0 0011 18.5c.003.391.04.781.11 1.166a2.5 2.5 0 103.859.584z", "#6366f1"),
            ["KL"]),
        new("Digital Marketing Course", "Course", "13.0K", "22.1%", "$2,224",
            "rgba(236,72,153,0.15)", _badge("M18 26a8 8 0 118-8 8.009 8.009 0 01-8 8zm0-14a6 6 0 100 12 6 6 0 000-12z", "#ec4899"),
            ["MN", "OP"]),
        new("Form Builder PRO", "Tool", "7.1K", "17.4%", "$1,949",
            "rgba(59,130,246,0.15)", _badge("M13.05 24.363l-.707-.707a8 8 0 010-11.312l.707-.707 1.414 1.414-.707.707a6 6 0 000 8.484l.707.707-1.414 1.414zM22.95 24.363l-1.414-1.414.707-.707a6 6 0 000-8.484l-.707-.707 1.414-1.414.707.707a8 8 0 010 11.312l-.707.707z", "#3b82f6"),
            ["QR", "ST"]),
