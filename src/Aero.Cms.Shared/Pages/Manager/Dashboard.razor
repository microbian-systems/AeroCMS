@page "/manager"
@page "/manager/general"
@attribute [Authorize]

<div class="space-y-6">

    @* ── Card Grid ────────────────────────────────── *@
    <div class="pe-dashboard-grid">

        @* ════ Card 1: Stat Metrics Row ════════════════ *@
        <div class="pe-dashboard-card">
            <div class="pe-dash-card-header">
                <h2>Overview</h2>
                <a href="#">View full report &rarr;</a>
            </div>
            <div class="pe-dash-card-body">
                <div class="pe-dash-metrics">
                    @foreach (var m in metrics)
                    {
                        <div class="pe-dash-metric">
                            <div class="pe-dash-metric-top">
                                <div class="pe-dash-metric-icon" style="background: @m.IconBg;">
                                    @m.IconSvg
                                </div>
                                <div>
                                    <div class="pe-dash-metric-value">@m.Value</div>
                                    <div class="pe-dash-metric-label">@m.Label</div>
                                </div>
                                <span class="pe-dash-metric-delta @(m.IsUp ? "up" : "down")">
                                    @(m.IsUp ? "↑" : "↓") @m.Delta
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ════ Card 2: Recent Activity + Top Pages ═════ *@
        <div class="pe-dashboard-card">
            <div class="pe-dash-card-header">
                <h2>Recent Activity</h2>
                <a href="#">View all &rarr;</a>
            </div>
            <div class="pe-dash-card-body">
                <div class="pe-dash-split cols-2">

                    @* Left: Activity Feed *@
                    <div class="pe-dash-split-left">
                        <div class="pe-dash-section-label">Live Feed</div>
                        <div class="pe-dash-activity-feed">
                            @foreach (var a in activities)
                            {
                                <div class="pe-dash-activity-item">
                                    <div class="pe-dash-activity-icon" style="background: @a.IconBg;">
                                        @a.IconSvg
                                    </div>
                                    <div class="pe-dash-activity-content">
                                        <p class="pe-dash-activity-text">@a.Html</p>
                                        <div class="pe-dash-activity-time">@a.Time</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @* Right: Top Pages *@
                    <div class="pe-dash-split-right">
                        <div class="pe-dash-section-label">Top Pages</div>
                        <table class="pe-dash-pages-table">
                            <thead>
                                <tr>
                                    <th>Page</th>
                                    <th>Active Users</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in topPages)
                                {
                                    <tr>
                                        <td class="pe-dash-pages-url">@p.Url</td>
                                        <td class="pe-dash-pages-count">@p.ActiveUsers</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

        @* ── Cards 3-5: Two-column sub-grid ─────────── *@
        <div class="pe-dashboard-grid pe-dashboard-grid-cols-2">

            @* ════ Card 3: Content by Category (Radzen BarChart) ═══ *@
            <div class="pe-dashboard-card">
                <div class="pe-dash-card-header">
                    <h2>Content by Category</h2>
                </div>
                <div class="pe-dash-card-body">
                    <div class="pe-dash-chart-wrap">
                        <RadzenChart>
                             <RadzenBarSeries Data="@categoryData"
                                              CategoryProperty="Category"
                                              ValueProperty="Count"
                                              Fills="@categoryColors"
                                              Title="Count">
                                <RadzenSeriesDataLabels Visible="true" />
                            </RadzenBarSeries>
                            <RadzenCategoryAxis Visible="false" />
                            <RadzenValueAxis Visible="false" />
                        </RadzenChart>
                    </div>
                </div>
            </div>

            @* ════ Card 4: Top Content ═══════════════════ *@
            <div class="pe-dashboard-card">
                <div class="pe-dash-card-header">
                    <h2>Top Content</h2>
                </div>
                <div class="pe-dash-card-body">
                    <div class="pe-dash-report">
                        @foreach (var c in topContent)
                        {
                            <div class="pe-dash-report-item">
                                <div class="pe-dash-report-row">
                                    <span class="pe-dash-report-label">@c.Title</span>
                                    <span class="pe-dash-report-value">@c.Views</span>
                                </div>
                                <div class="pe-dash-progress-track">
                                    <div class="pe-dash-progress-fill @c.BarColor"
                                         style="width: @c.Percentage%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ════ Card 5: Top Regions ═══════════════════ *@
            <div class="pe-dashboard-card">
                <div class="pe-dash-card-header">
                    <h2>Top Regions</h2>
                </div>
                <div class="pe-dash-card-body">
                    <div class="pe-dash-report">
                        @foreach (var r in regions)
                        {
                            <div class="pe-dash-report-item">
                                <div class="pe-dash-report-row">
                                    <span class="pe-dash-report-label">@r.Flag @r.Name</span>
                                    <span class="pe-dash-report-value">@r.Sessions</span>
                                </div>
                                <div class="pe-dash-progress-track">
                                    <div class="pe-dash-progress-fill @r.BarColor"
                                         style="width: @r.Percentage%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>

        @* ════ Card 6: Top Content Table ═══════════════ *@
        <div class="pe-dashboard-card">
            <div class="pe-dash-card-header">
                <h2>Top Content</h2>
                <a href="#">View all &rarr;</a>
            </div>
            <div class="pe-dash-card-body pe-dash-table-wrap">
                <table class="pe-dash-table">
                    <thead>
                        <tr>
                            <th>Content</th>
                            <th>Author</th>
                            <th>Category</th>
                            <th>Views</th>
                            <th>CTR</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in tableItems)
                        {
                            <tr>
                                <td>
                                    <div class="pe-dash-table-title">
                                        <div class="rounded-full" style="width:36px;height:36px;background:@t.BadgeBg;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            @t.BadgeSvg
                                        </div>
                                        @t.Title
                                    </div>
                                </td>
                                <td>
                                    <div class="pe-dash-table-author-avatars">
                                        @foreach (var avatar in t.AvatarLetters)
                                        {
                                            <div style="width:28px;height:28px;border-radius:50%;background:var(--pe-bg-tertiary);border:2px solid var(--pe-bg-secondary);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:var(--pe-text-secondary);margin-right:-6px;">@avatar</div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="pe-dash-table-category">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.3 4.5c1.9-1.9 5.1-1.9 7 0 .7.7 1.2 1.7 1.4 2.7l2-.3c-.2-1.5-.9-2.8-1.9-3.8C10.1.4 5.7.4 2.9 3.1L.7.9 0 7.3l6.4-.7-2.1-2.1zM15.6 8.7l-6.4.7 2.1 2.1c-1.9 1.9-5.1 1.9-7 0-.7-.7-1.2-1.7-1.4-2.7l-2 .3c.2 1.5.9 2.8 1.9 3.8 1.4 1.4 3.1 2 4.9 2 1.8 0 3.6-.7 4.9-2l2.2 2.2.8-6.4z"/></svg>
                                        @t.Category
                                    </div>
                                </td>
                                <td style="font-weight:600;color:var(--pe-text-primary);">@t.Views</td>
                                <td class="pe-dash-table-ctr">@t.Ctr</td>
                                <td class="pe-dash-table-value">@t.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@code {

    // ── Stat Metrics ─────────────────────────────────
    private record Metric(
        string Label, string Value, string Delta, bool IsUp,
        string IconBg, RenderFragment IconSvg);

    private Metric[] metrics = [
        new("Total Posts", "24.7K", "49%", true, "rgba(99,102,241,0.15)",
            builder => { builder.AddContent(0, __svg(16, 16, "M12 4v16m8-8H4", "#6366f1")); }),
        new("Active Pages", "56.9K", "7%", true, "rgba(34,197,94,0.15)",
            builder => { builder.AddContent(0, __svg(16, 16, "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z", "#22c55e")); }),
        new("Media Files", "452", "12%", true, "rgba(245,158,11,0.15)",
            builder => { builder.AddContent(0, __svg(16, 16, "M4 16a1 1 0 01-1-1V1a1 1 0 011-1h8a1 1 0 011 1v14a1 1 0 01-1 1H4zm2-2h4V4H6v10z", "#f59e0b")); }),
        new("Users", "128", "8%", true, "rgba(59,130,246,0.15)",
            builder => { builder.AddContent(0, __svg(16, 16, "M12 4a4 4 0 1 0-8 0 4 4 0 0 0 8 0ZM2 14a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-1Z", "#3b82f6")); }),
    ];

    private static RenderFragment __svg(int w, int h, string path, string stroke) => b =>
    {
        b.OpenElement(0, "svg");
        b.AddAttribute(1, "width", w);
        b.AddAttribute(2, "height", h);
        b.AddAttribute(3, "viewBox", $"0 0 {24} {24}");
        b.AddAttribute(4, "fill", "none");
        b.AddAttribute(5, "stroke", stroke);
        b.AddAttribute(6, "stroke-width", "2");
        b.OpenElement(7, "path");
        b.AddAttribute(8, "d", path);
        b.CloseElement();
        b.CloseElement();
    };

    // ── Activity Feed ────────────────────────────────
    private record ActivityItem(RenderFragment IconSvg, string IconBg, string Html, string Time);

    private ActivityItem[] activities = [
        new(_icon("edit"), "rgba(99,102,241,0.15)",
            "<strong>New post published:</strong> \"Getting Started with Aero\"", "2 hours ago"),
        new(_icon("user-plus"), "rgba(34,197,94,0.15)",
            "<strong>New user registered:</strong> jane@example.com", "4 hours ago"),
        new(_icon("upload"), "rgba(245,158,11,0.15)",
            "<strong>Media uploaded:</strong> hero-banner-v2.jpg", "6 hours ago"),
        new(_icon("settings"), "rgba(59,130,246,0.15)",
            "<strong>Site settings updated:</strong> Default language changed", "12 hours ago"),
        new(_icon("message"), "rgba(236,72,153,0.15)",
            "<strong>Comment approved:</strong> on \"Welcome to Aero\"", "1 day ago"),
    ];

