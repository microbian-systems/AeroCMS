    private static RenderFragment _badge(string path, string fill) => b =>
    {
        b.OpenElement(0, "svg");
        b.AddAttribute(1, "width", "18");
        b.AddAttribute(2, "height", "18");
        b.AddAttribute(3, "viewBox", "0 0 36 36");
        b.AddAttribute(4, "fill", fill);
        b.OpenElement(5, "path");
        b.AddAttribute(6, "d", path);
        b.CloseElement();
        b.CloseElement();
    };
}
