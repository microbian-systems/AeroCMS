        "user-plus" => __svg(16, 16, "M12 4a4 4 0 1 0-8 0 4 4 0 0 0 8 0ZM2 14a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-1Z", "#22c55e"),
        "upload" => __svg(16, 16, "M8 1a1 1 0 0 1 1 1v7.586l2.293-2.293a1 1 0 0 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 0 1 1.414-1.414L7 9.586V2a1 1 0 0 1 1-1Z", "#f59e0b"),
        "settings" => __svg(16, 16, "M10.5 1a3.502 3.502 0 0 1 3.355 2.5H15a1 1 0 1 1 0 2h-1.145a3.502 3.502 0 0 1-6.71 0H1a1 1 0 0 1 0-2h6.145A3.502 3.502 0 0 1 10.5 1Z", "#3b82f6"),
        "message" => __svg(16, 16, "M11.92 6.851c.044-.027.09-.05.137-.07.481-.275.758-.68.908-1.256.126-.55.169-.81.357-2.058.075-.498.144-.91.217-1.264-4.122.75-7.087 2.984-9.12 6.284a18.087 18.087 0 0 0-1.985 4.585 17.07 17.07 0 0 0-.354 1.506c-.05.265-.076.448-.086.535a1 1 0 0 1-1.988-.226c.056-.49.209-1.312.502-2.357a20.063 20.063 0 0 1 2.208-5.09C5.31 3.226 9.306.494 14.913.004a1 1 0 0 1 .954 1.494c-.237.414-.375.993-.567 2.267-.197 1.306-.244 1.586-.392 2.235-.285 1.094-.789 1.853-1.552 2.363-.748 3.816-3.976 5.06-8.515 4.326a1 1 0 0 1 .318-1.974c2.954.477 4.918.025 5.808-1.556", "#ec4899"),
        _ => __svg(16, 16, "M12 4v16m8-8H4", "#6366f1"),
    };

    // ── Top Pages ────────────────────────────────────
    private record TopPage(string Url, int ActiveUsers);

    private TopPage[] topPages = [
        new("preview.aerocms.com/blog/", 94),
        new("aerocms.com/pricing/", 42),
        new("aerocms.com/docs/", 12),
        new("preview.aerocms.com/about/", 4),
    ];

    // ── Content by Category (Chart) ───────────────────
    private record CategoryDatum(string Category, int Count, string Color);

    private CategoryDatum[] categoryData = [
        new("Blog Posts", 128, "#6366f1"),
        new("Pages", 45, "#3b82f6"),
        new("Media", 452, "#6366f1"),
        new("Documents", 67, "#3b82f6"),
        new("Categories", 24, "#6366f1"),
    ];

    private string[] categoryColors => categoryData.Select(d => d.Color).ToArray();

    // ── Top Content (progress bars) ───────────────────
    private record TopContentItem(string Title, string Views, double Percentage, string BarColor);

    private TopContentItem[] topContent = [
        new("aerocms.com/", "28K", 82, "violet"),
        new("preview.aerocms.com/open-pro/", "12K", 70, "green"),
