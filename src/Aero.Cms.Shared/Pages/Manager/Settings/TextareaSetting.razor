@* Textarea with label and description *@

<div>
    <label for="@Id" class="block text-sm font-medium" style="color: var(--pe-text-secondary);">@Label</label>
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="mt-1 text-sm" style="color: var(--pe-text-muted);">@Description</p>
    }
    <textarea id="@Id" rows="@Rows" value="@Value"
              @onchange="OnChanged"
              class="mt-1 block w-full rounded-md shadow-sm py-2 px-3 text-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 @(Monospace ? "font-mono" : "")"
              style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);">@Value</textarea>
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public int Rows { get; set; } = 4;
    [Parameter] public bool Monospace { get; set; }

    private async Task OnChanged(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}
