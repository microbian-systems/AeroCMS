@page "/manager/settings"
@attribute [Authorize]
@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Core
@using Microsoft.Extensions.Localization
@inject ISettingsHttpClient SettingsClient
@inject NotificationService NotificationService
@inject IStringLocalizer<Aero.Cms.Shared.Localization.ManagerResource> L

<div class="pe-page-content" style="max-width: 900px; margin: 0 auto;">
    <div class="mb-8">
        <h1 class="text-3xl font-bold pe-heading">@L["Global Settings"]</h1>
        <p class="mt-2 text-sm pe-description">@L["Configure instance-level settings for the CMS platform. These settings apply globally across all sites."]</p>
    </div>

    <div class="space-y-8">

        @* ── Security Section ──────────────────────────────── *@
        <div style="background: var(--pe-bg-secondary); border: 1px solid var(--pe-border); border-radius: var(--pe-radius-lg);">
            <div class="px-4 py-5 sm:px-6 border-b" style="border-bottom-color: var(--pe-border);">
                <h2 class="text-lg font-semibold" style="color: var(--pe-text-primary);">@L["Security"]</h2>
                <p class="mt-1 text-sm" style="color: var(--pe-text-muted);">@L["Access control and security hardening options."]</p>
            </div>
            <div class="px-4 py-5 sm:p-6 space-y-5">
                @if (securityLoading)
                {
                    <div class="flex justify-center py-8">@SpinnerLarge()</div>
                }
                else
                {
                    <CheckboxSetting Id="disable-public-access" Label="@L["Disable Public Access"]"
                        Description="@L["When enabled, the manager interface will only be accessible from authorized IP addresses or internal networks."]"
                        @bind-Value="disablePublicAccess" />

                    <CheckboxSetting Id="require-wasm-install" Label="@L["Require WASM Install"]"
                        Description="@L["Force users to install the manager as a WebAssembly PWA for offline access and improved performance."]"
                        @bind-Value="requireWasmInstall" />

                    <CheckboxSetting Id="maintenance-mode" Label="@L["Maintenance Mode"]"
                        Description="@L["When enabled, the public site will display a maintenance page to visitors."]"
                        @bind-Value="maintenanceMode" />

                    @if (maintenanceMode)
                    {
                        <TextareaSetting Id="maintenance-message" Label="@L["Maintenance Message"]"
                            Description="@L["Message shown to visitors during maintenance. Supports basic HTML."]"
                            @bind-Value="maintenanceMessage" Rows="3" />
                    }

                    <div class="pt-3 flex justify-end border-t" style="border-top-color: var(--pe-border);">
                        <button type="button" @onclick="SaveSecurity" disabled="@securitySaving"
                            class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed">
                            @SpinnerSvg() @L["Save Security"]
                        </button>
                    </div>
                }
            </div>
        </div>

        @* ── General Section ───────────────────────────────── *@
        <div style="background: var(--pe-bg-secondary); border: 1px solid var(--pe-border); border-radius: var(--pe-radius-lg);">
            <div class="px-4 py-5 sm:px-6 border-b" style="border-bottom-color: var(--pe-border);">
                <h2 class="text-lg font-semibold" style="color: var(--pe-text-primary);">@L["General"]</h2>
                <p class="mt-1 text-sm" style="color: var(--pe-text-muted);">@L["Default locale, timezone, and admin experience settings."]</p>
            </div>
            <div class="px-4 py-5 sm:p-6 space-y-5">
                @if (generalLoading)
                {
                    <div class="flex justify-center py-8">@SpinnerLarge()</div>
                }
                else
                {
                    <TextInputSetting Id="default-locale" Label="@L["Default Locale"]"
                        Description="@L["Default culture code (e.g., en-US, es-ES, fr-FR)."]"
                        @bind-Value="defaultLocale" />

                    <TextInputSetting Id="default-timezone" Label="@L["Default Timezone"]"
                        Description="@L["Default timezone for date/time display (e.g., UTC, America/New_York)."]"
                        @bind-Value="defaultTimezone" />

                    <NumberInputSetting Id="admin-pagination" Label="@L["Admin Pagination"]"
                        Description="@L["Number of items per page in admin list views."]"
                        @bind-Value="adminPagination" Min="5" Max="100" />

                    <NumberInputSetting Id="max-upload-size" Label="@L["Max Upload Size (MB)"]"
                        Description="@L["Maximum file size allowed for media uploads."]"
                        @bind-Value="maxUploadSizeMB" Min="1" Max="500" />

                    <div class="pt-3 flex justify-end border-t" style="border-top-color: var(--pe-border);">
                        <button type="button" @onclick="SaveGeneral" disabled="@generalSaving"
                            class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed">
                            @SpinnerSvg() @L["Save General"]
                        </button>
                    </div>
                }
            </div>
        </div>

        @* ── SEO Section ───────────────────────────────────── *@
        <div style="background: var(--pe-bg-secondary); border: 1px solid var(--pe-border); border-radius: var(--pe-radius-lg);">
            <div class="px-4 py-5 sm:px-6 border-b" style="border-bottom-color: var(--pe-border);">
                <h2 class="text-lg font-semibold" style="color: var(--pe-text-primary);">@L["SEO"]</h2>
                <p class="mt-1 text-sm" style="color: var(--pe-text-muted);">@L["Search engine optimization and crawling settings."]</p>
            </div>
            <div class="px-4 py-5 sm:p-6 space-y-5">
                @if (seoLoading)
                {
                    <div class="flex justify-center py-8">@SpinnerLarge()</div>
                }
                else
                {
                    <TextareaSetting Id="robots-txt" Label="@L["robots.txt"]"
                        Description="@L["Custom robots.txt content served at /robots.txt. Leave empty for default (allow all, sitemap auto-included)."]"
                        @bind-Value="robotsTxt" Rows="8" Monospace="true" />

                    <TextInputSetting Id="default-meta-description" Label="@L["Default Meta Description"]"
                        Description="@L["Fallback meta description used when a page or post doesn't define its own."]"
                        @bind-Value="defaultMetaDescription" />

                    <TextInputSetting Id="default-og-image" Label="@L["Default OG Image URL"]"
                        Description="@L["Fallback Open Graph image URL used when content doesn't specify its own."]"
                        @bind-Value="defaultOgImage" />

                    <div class="pt-3 flex justify-end border-t" style="border-top-color: var(--pe-border);">
                        <button type="button" @onclick="SaveSeo" disabled="@seoSaving"
                            class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed">
                            @SpinnerSvg() @L["Save SEO"]
                        </button>
                    </div>
                }
            </div>
        </div>

        @* ── API Section ───────────────────────────────────── *@
        <div style="background: var(--pe-bg-secondary); border: 1px solid var(--pe-border); border-radius: var(--pe-radius-lg);">
            <div class="px-4 py-5 sm:px-6 border-b" style="border-bottom-color: var(--pe-border);">
                <h2 class="text-lg font-semibold" style="color: var(--pe-text-primary);">@L["API"]</h2>
                <p class="mt-1 text-sm" style="color: var(--pe-text-muted);">@L["Headless API and integration settings."]</p>
            </div>
            <div class="px-4 py-5 sm:p-6 space-y-5">
                @if (apiLoading)
                {
                    <div class="flex justify-center py-8">@SpinnerLarge()</div>
                }
                else
                {
                    <TextInputSetting Id="cors-origins" Label="@L["Allowed CORS Origins"]"
                        Description="@L["Comma-separated list of allowed origins for API access (e.g., https://example.com,https://admin.example.com)."]"
                        @bind-Value="corsOrigins" />

                    <NumberInputSetting Id="rate-limit" Label="@L["Rate Limit (requests/min)"]"
                        Description="@L["Maximum number of API requests per minute from a single IP."]"
                        @bind-Value="rateLimitPerMinute" Min="0" Max="10000" />

                    <CheckboxSetting Id="enable-public-api" Label="@L["Enable Public API"]"
                        Description="@L["Allow unauthenticated access to public API endpoints."]"
                        @bind-Value="enablePublicApi" />

                    <div class="pt-3 flex justify-end border-t" style="border-top-color: var(--pe-border);">
                        <button type="button" @onclick="SaveApi" disabled="@apiSaving"
                            class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed">
                            @SpinnerSvg() @L["Save API"]
                        </button>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@code {

    // ── Security ──
    private bool securityLoading = true;
    private bool securitySaving;
    private bool disablePublicAccess;
    private bool requireWasmInstall;
    private bool maintenanceMode;
    private string maintenanceMessage = string.Empty;

    // ── General ──
    private bool generalLoading = true;
    private bool generalSaving;
    private string defaultLocale = "en-US";
    private string defaultTimezone = "UTC";
    private int adminPagination = 20;
    private int maxUploadSizeMB = 50;

    // ── SEO ──
    private bool seoLoading = true;
    private bool seoSaving;
    private string robotsTxt = string.Empty;
    private string defaultMetaDescription = string.Empty;
    private string defaultOgImage = string.Empty;

    // ── API ──
    private bool apiLoading = true;
    private bool apiSaving;
    private string corsOrigins = string.Empty;
    private int rateLimitPerMinute = 60;
    private bool enablePublicApi = true;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadSecurityAsync(),
            LoadGeneralAsync(),
            LoadSeoAsync(),
            LoadApiAsync()
        );
    }

    // ── Security ─────────────────────────────────────────────

    private async Task LoadSecurityAsync()
    {
        securityLoading = true;
        var result = await SettingsClient.GetByCategoryAsync("Security");
        if (result is Result<IReadOnlyList<SettingDetail>, AeroError>.Ok ok)
        {
            disablePublicAccess = GetBool(ok.Value, "Manager.DisablePublicAccess");
            requireWasmInstall = GetBool(ok.Value, "Manager.RequireWasmInstall");
            maintenanceMode = GetBool(ok.Value, "Security.MaintenanceMode");
            maintenanceMessage = GetString(ok.Value, "Security.MaintenanceMessage");
        }
        securityLoading = false;
    }

    private async Task SaveSecurity()
    {
        securitySaving = true;
        try
        {
            var results = await Task.WhenAll(
                SettingsClient.SetAsync(new SetSettingRequest("Manager.DisablePublicAccess", disablePublicAccess.ToString().ToLower(), "Security", "bool")),
                SettingsClient.SetAsync(new SetSettingRequest("Manager.RequireWasmInstall", requireWasmInstall.ToString().ToLower(), "Security", "bool")),
                SettingsClient.SetAsync(new SetSettingRequest("Security.MaintenanceMode", maintenanceMode.ToString().ToLower(), "Security", "bool")),
                SettingsClient.SetAsync(new SetSettingRequest("Security.MaintenanceMessage", maintenanceMessage, "Security", "string"))
            );
            NotifyResult(results, "Security");
        }
        finally { securitySaving = false; }
    }

    // ── General ─────────────────────────────────────────────

    private async Task LoadGeneralAsync()
    {
        generalLoading = true;
        var result = await SettingsClient.GetByCategoryAsync("General");
        if (result is Result<IReadOnlyList<SettingDetail>, AeroError>.Ok ok)
        {
            defaultLocale = GetString(ok.Value, "General.DefaultLocale", "en-US");
            defaultTimezone = GetString(ok.Value, "General.DefaultTimezone", "UTC");
            adminPagination = GetInt(ok.Value, "General.AdminPagination", 20);
            maxUploadSizeMB = GetInt(ok.Value, "General.MaxUploadSizeMB", 50);
        }
        generalLoading = false;
    }

    private async Task SaveGeneral()
    {
        generalSaving = true;
        try
        {
            var results = await Task.WhenAll(
                SettingsClient.SetAsync(new SetSettingRequest("General.DefaultLocale", defaultLocale, "General", "string")),
                SettingsClient.SetAsync(new SetSettingRequest("General.DefaultTimezone", defaultTimezone, "General", "string")),
                SettingsClient.SetAsync(new SetSettingRequest("General.AdminPagination", adminPagination.ToString(), "General", "int")),
                SettingsClient.SetAsync(new SetSettingRequest("General.MaxUploadSizeMB", maxUploadSizeMB.ToString(), "General", "int"))
            );
            NotifyResult(results, "General");
        }
        finally { generalSaving = false; }
    }

    // ── SEO ─────────────────────────────────────────────────

    private async Task LoadSeoAsync()
    {
        seoLoading = true;
        var result = await SettingsClient.GetByCategoryAsync("SEO");
        if (result is Result<IReadOnlyList<SettingDetail>, AeroError>.Ok ok)
        {
            robotsTxt = GetString(ok.Value, "SEO.RobotsTxt");
            defaultMetaDescription = GetString(ok.Value, "SEO.DefaultMetaDescription");
            defaultOgImage = GetString(ok.Value, "SEO.DefaultOgImage");
        }
        seoLoading = false;
    }

    private async Task SaveSeo()
    {
        seoSaving = true;
        try
        {
            var results = await Task.WhenAll(
                SettingsClient.SetAsync(new SetSettingRequest("SEO.RobotsTxt", robotsTxt, "SEO", "text")),
                SettingsClient.SetAsync(new SetSettingRequest("SEO.DefaultMetaDescription", defaultMetaDescription, "SEO", "string")),
                SettingsClient.SetAsync(new SetSettingRequest("SEO.DefaultOgImage", defaultOgImage, "SEO", "string"))
            );
            NotifyResult(results, "SEO");
        }
        finally { seoSaving = false; }
    }

    // ── API ─────────────────────────────────────────────────

    private async Task LoadApiAsync()
    {
        apiLoading = true;
        var result = await SettingsClient.GetByCategoryAsync("API");
        if (result is Result<IReadOnlyList<SettingDetail>, AeroError>.Ok ok)
        {
            corsOrigins = GetString(ok.Value, "API.CorsOrigins");
            rateLimitPerMinute = GetInt(ok.Value, "API.RateLimitPerMinute", 60);
            enablePublicApi = GetBool(ok.Value, "API.EnablePublicApi");
        }
        apiLoading = false;
    }

    private async Task SaveApi()
    {
        apiSaving = true;
        try
        {
            var results = await Task.WhenAll(
                SettingsClient.SetAsync(new SetSettingRequest("API.CorsOrigins", corsOrigins, "API", "string")),
                SettingsClient.SetAsync(new SetSettingRequest("API.RateLimitPerMinute", rateLimitPerMinute.ToString(), "API", "int")),
                SettingsClient.SetAsync(new SetSettingRequest("API.EnablePublicApi", enablePublicApi.ToString().ToLower(), "API", "bool"))
            );
            NotifyResult(results, "API");
        }
        finally { apiSaving = false; }
    }

    // ── Helpers ─────────────────────────────────────────────

    private static bool GetBool(IReadOnlyList<SettingDetail> settings, string key)
        => settings.FirstOrDefault(s => s.Key == key)?.Value == "true";

    private static string GetString(IReadOnlyList<SettingDetail> settings, string key, string defaultValue = "")
        => settings.FirstOrDefault(s => s.Key == key)?.Value ?? defaultValue;

    private static int GetInt(IReadOnlyList<SettingDetail> settings, string key, int defaultValue = 0)
        => int.TryParse(settings.FirstOrDefault(s => s.Key == key)?.Value, out var val) ? val : defaultValue;

    private void NotifyResult(Result<SettingDetail, AeroError>[] results, string category)
    {
        var failures = results.OfType<Result<SettingDetail, AeroError>.Failure>().ToList();
        if (failures.Count == 0)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = $"{category} Settings Saved",
                Detail = $"{category} settings have been updated successfully.",
                Duration = 4000
            });
        }
        else
        {
            var error = failures[0].Error is AeroError.Error ae ? ae.msg : "Could not save one or more settings.";
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"{category} Save Failed",
                Detail = error,
                Duration = 4000
            });
        }
    }

    // ── Inline SVG Spinner Helpers ──────────────────────────

    private static RenderFragment SpinnerSvg() => __builder =>
    {
        <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
    };

    private static RenderFragment SpinnerLarge() => __builder =>
    {
        <svg class="animate-spin h-6 w-6 text-indigo-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
    };
}
