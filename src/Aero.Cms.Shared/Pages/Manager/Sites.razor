@page "/manager/sites"
@attribute [Authorize]
@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Cms.Abstractions.Interfaces
@using Aero.Cms.Abstractions.Models
@using Aero.Cms.Abstractions.Requests
@using Aero.Core
@using Aero.Core.Railway
@inject ISitesHttpClient SitesClient
@inject ICurrentSiteAccessor CurrentSiteAccessor
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<div class="space-y-6 px-6 py-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">Sites</h1>
            <p class="mt-1 text-sm text-gray-500">Manage all sites in the CMS.</p>
        </div>
        <div class="flex gap-3">
            <RadzenButton Text="Select Site" ButtonStyle="ButtonStyle.Secondary" Click="@(() => Navigation.NavigateTo("/manager/select-site"))" />
            <RadzenButton Text="Add Site" ButtonStyle="ButtonStyle.Primary" Click="@(() => _showCreateForm = true)" />
        </div>
    </div>

    @if (_showCreateForm)
    {
        <div class="border rounded-lg p-4 bg-gray-50 mb-4">
            <h3 class="font-semibold mb-3">Create New Site</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium mb-1">Name *</label>
                    <input @bind="@_createName" class="w-full border rounded px-3 py-2" placeholder="Site name" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Primary Host *</label>
                    <input @bind="@_createHost" class="w-full border rounded px-3 py-2" placeholder="e.g. example.com" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Additional Hosts</label>
                    <input @bind="@_createHostsText" class="w-full border rounded px-3 py-2" placeholder="Comma-separated" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Description</label>
                    <textarea @bind="@_createDescription" class="w-full border rounded px-3 py-2" rows="2" placeholder="Optional"></textarea>
                </div>
            </div>
            <div class="flex gap-3 mt-4">
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Create" Click="@HandleCreate" />
                <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Cancel" Click="@(() => _showCreateForm = false)" />
            </div>
        </div>
    }

    @if (_showEditForm && _editSite is not null)
    {
        <div class="border rounded-lg p-4 bg-blue-50 mb-4">
            <h3 class="font-semibold mb-3">Edit Site: @_editSite.Name</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium mb-1">Name *</label>
                    <input @bind="@_editName" class="w-full border rounded px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Primary Host *</label>
                    <input @bind="@_editHost" class="w-full border rounded px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Additional Hosts</label>
                    <input @bind="@_editHostsText" class="w-full border rounded px-3 py-2" placeholder="Comma-separated" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Description</label>
                    <textarea @bind="@_editDescription" class="w-full border rounded px-3 py-2" rows="2"></textarea>
                </div>
            </div>
            <div class="flex gap-3 mt-4">
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Save" Click="@HandleUpdate" />
                <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Cancel" Click="@(() => _showEditForm = false)" />
            </div>
        </div>
    }

    <RadzenDataGrid @ref="@_grid"
                    Data="@_sites"
                    TItem="SiteViewModel"
                    Count="@_count"
                    LoadData="@LoadData"
                    IsLoading="@_isLoading"
                    AllowPaging="true"
                    PageSize="10"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    ShowPagingSummary="true"
                    EmptyText="No sites found. Create your first site!">
        <Columns>
            <RadzenDataGridColumn TItem="SiteViewModel" Property="Name" Title="Name" Width="300px" Sortable="true" />
            <RadzenDataGridColumn TItem="SiteViewModel" Property="PrimaryHost" Title="Primary Host" />
            <RadzenDataGridColumn TItem="SiteViewModel" Property="IsEnabled" Title="Status">
                <Template Context="s">
                    @if (s.IsEnabled)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Active" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Disabled" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SiteViewModel" Property="DefaultCulture" Title="Culture" Width="100px" />
            <RadzenDataGridColumn TItem="SiteViewModel" Title="Actions" Width="280px">
                <Template Context="site">
                    <div class="flex gap-2">
                        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Text="Set" Click="@(() => SelectSiteAsync(site.Id))" />
                        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Text="Edit" Click="@(() => OpenEditForm(site))" />
                        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Text="Del" Click="@(() => DeleteSiteAsync(site))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private RadzenDataGrid<SiteViewModel>? _grid;
    private IReadOnlyList<SiteViewModel> _sites = [];
    private int _count;
    private bool _isLoading;
    private bool _showCreateForm;
    private bool _showEditForm;

    // Create form fields
    private string _createName = "";
    private string _createHost = "";
    private string _createHostsText = "";
    private string _createDescription = "";

    // Edit form fields
    private SiteViewModel? _editSite;
    private string _editName = "";
    private string _editHost = "";
    private string _editHostsText = "";
    private string _editDescription = "";

    private async Task LoadData(LoadDataArgs args)
    {
        _isLoading = true;
        try
        {
            var result = await SitesClient.GetAllAsync();
            if (result is Result<IReadOnlyList<SiteViewModel>, AeroError>.Ok ok)
            {
                _count = ok.Value.Count;
                _sites = ok.Value.Skip(args.Skip ?? 0).Take(args.Top ?? 10).ToList();
            }
            else if (result is Result<IReadOnlyList<SiteViewModel>, AeroError>.Failure fail)
            {
                NotificationService.Notify(NotificationSeverity.Error, fail.Error.ToString(), duration: 4000);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleCreate()
    {
        var hosts = ParseHosts(_createHostsText);
        var request = new CreateSiteRequest(
            _createName, _createHost, hosts.Any() ? hosts : null, _createDescription, false);

        var result = await SitesClient.CreateAsync(request);
        if (result is Result<SiteViewModel, AeroError>.Ok ok)
        {
            NotificationService.Notify(NotificationSeverity.Success, $"Site '{ok.Value.Name}' created");
            _showCreateForm = false;
            _createName = _createHost = _createHostsText = _createDescription = "";
            await _grid?.Reload();
        }
        else if (result is Result<SiteViewModel, AeroError>.Failure fail)
        {
            NotificationService.Notify(NotificationSeverity.Error, fail.Error.ToString(), duration: 4000);
        }
    }

    private void OpenEditForm(SiteViewModel site)
    {
        _editSite = site;
        _editName = site.Name ?? "";
        _editHost = site.PrimaryHost ?? "";
        _editHostsText = string.Join(", ", site.Hosts);
        _editDescription = "";
        _showEditForm = true;
    }

    private async Task HandleUpdate()
    {
        if (_editSite is null) return;
        var hosts = ParseHosts(_editHostsText);
        var request = new UpdateSiteRequest(
            _editSite.Id, _editName, _editHost, hosts.Any() ? hosts : null, _editDescription, false);

        var result = await SitesClient.UpdateAsync(_editSite.Id, request);
        if (result is Result<SiteViewModel, AeroError>.Ok ok)
        {
            NotificationService.Notify(NotificationSeverity.Success, $"Site '{ok.Value.Name}' updated");
            _showEditForm = false;
            _editSite = null;
            await _grid?.Reload();
        }
        else if (result is Result<SiteViewModel, AeroError>.Failure fail)
        {
            NotificationService.Notify(NotificationSeverity.Error, fail.Error.ToString(), duration: 4000);
        }
    }

    private async Task DeleteSiteAsync(SiteViewModel site)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete '{site.Name}'? This action cannot be undone.",
            "Delete Site",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed != true) return;

        var result = await SitesClient.DeleteAsync(site.Id);
        if (result is Result<bool, AeroError>.Ok)
        {
            NotificationService.Notify(NotificationSeverity.Success, $"Site '{site.Name}' deleted");
            await _grid?.Reload();
        }
        else if (result is Result<bool, AeroError>.Failure fail)
        {
            NotificationService.Notify(NotificationSeverity.Error, fail.Error.ToString(), duration: 4000);
        }
    }

    private async Task SelectSiteAsync(long siteId)
    {
        await CurrentSiteAccessor.SetCurrentSiteAsync(siteId);
        NotificationService.Notify(NotificationSeverity.Success, "Site selected");
        Navigation.NavigateTo("/manager");
    }

    private static List<string> ParseHosts(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return [];
        return text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(h => !string.IsNullOrWhiteSpace(h))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
