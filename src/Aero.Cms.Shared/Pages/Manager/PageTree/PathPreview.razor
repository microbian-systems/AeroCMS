@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Aero.Cms.Shared.Localization.ManagerResource> L

@if (_result is not null)
{
    <div class="path-preview mt-1 flex items-center gap-2">
        <RadzenIcon Icon="link" class="text-gray-400 text-xs" />
        <span class="text-xs font-mono text-gray-600 bg-gray-100 px-2 py-0.5 rounded">
            @_result.Path
        </span>
        @if (_result.IsValid)
        {
            <RadzenBadge Text="@L["valid"]" BadgeStyle="BadgeStyle.Success" />
        }
        else
        {
            <RadzenBadge Text="@(_result.ErrorMessage ?? L["invalid"])" BadgeStyle="BadgeStyle.Danger" />
        }
    </div>
}
