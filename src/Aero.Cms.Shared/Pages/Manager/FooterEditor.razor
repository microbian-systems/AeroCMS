@page "/manager/footers/editor/{Id:long}"
@attribute [Authorize]
@using Aero.Cms.Shared.Components
@using Microsoft.AspNetCore.Components.Sections
@using NeoUI.Blazor.Primitives

<style>
    .aero-canvas-column {
        grid-column: span var(--aero-mobile-span) / span var(--aero-mobile-span);
    }

    @@media (min-width: 768px) {
        .aero-canvas-column {
            grid-column: span var(--aero-tablet-span) / span var(--aero-tablet-span);
        }
    }

    @@media (min-width: 1024px) {
        .aero-canvas-column {
            grid-column: span var(--aero-desktop-span) / span var(--aero-desktop-span);
        }
    }

    .aero-editor-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 18px;
        border-bottom: 1px solid var(--pe-border);
        background: var(--pe-bg-secondary);
    }

    .aero-editor-title input {
        width: min(480px, 70vw);
        border: 0;
        background: transparent;
        color: var(--pe-text-primary);
        font-size: 20px;
        font-weight: 700;
        outline: none;
    }

    .aero-editor-subtitle {
        color: var(--pe-text-muted);
        font-size: 12px;
    }

    .aero-editor-canvas {
        min-height: calc(100vh - 170px);
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 24px clamp(24px, 4vw, 56px);
    }

    .aero-editor-canvas > .pe-blocks-list {
        width: 100%;
        max-width: none;
    }

    .aero-row-preview {
        padding: 22px;
    }

    .aero-row-preview-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .aero-row-label {
        border: 0;
        background: transparent;
        color: var(--pe-text-primary);
        font-size: 13px;
        font-weight: 700;
        outline: none;
    }

    .aero-row-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 12px;
    }

    .aero-column-canvas {
        min-height: 92px;
        padding: 12px;
        border: 1px dashed var(--pe-border);
        border-radius: var(--pe-radius-md);
        background: var(--pe-bg-primary);
    }

    .aero-column-empty {
        display: flex;
        min-height: 68px;
        align-items: center;
        justify-content: center;
        border: 1px dashed var(--pe-border);
        border-radius: var(--pe-radius-md);
        color: var(--pe-text-muted);
        font-size: 13px;
    }

    .aero-block-preview {
        border: 1px solid var(--pe-border);
        border-radius: var(--pe-radius-md);
        background: var(--pe-bg-secondary);
        padding: 12px;
        cursor: pointer;
        transition: border-color .2s, box-shadow .2s, transform .2s;
    }

    .aero-block-preview:hover,
    .aero-block-preview.selected {
        border-color: var(--pe-primary);
        box-shadow: var(--pe-shadow-sm);
        transform: translateY(-1px);
    }

    .aero-block-kicker {
        color: var(--pe-text-muted);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .aero-block-title {
        color: var(--pe-text-primary);
        font-size: 14px;
        font-weight: 700;
    }

    .aero-layout-details {
        margin-top: 14px;
        border-top: 1px solid var(--pe-border);
        padding-top: 12px;
    }

    .aero-layout-details summary {
        cursor: pointer;
        color: var(--pe-text-secondary);
        font-size: 12px;
        font-weight: 700;
    }
</style>

<div class="aero-editor-topbar">
    <div class="aero-editor-title">
        <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="BackToList">@L["Back"]</button>
        <input value="@_editName" @oninput="e => _editName = e.Value?.ToString() ?? string.Empty" aria-label="@L["Footer name"]" />
        <div class="aero-editor-subtitle">@L["Footer editor"] · @(_selected?.State ?? L["Draft"])</div>
    </div>
    @if (_selected is not null)
    {
        <div class="flex flex-wrap gap-2">
            <button class="pe-btn pe-btn-ghost pe-btn-sm" disabled="@_isSaving" @onclick="TogglePreview">@L["Preview"]</button>
            <button class="pe-btn pe-btn-primary pe-btn-sm" disabled="@_isSaving" @onclick="SaveDraftAsync">@L["Save Draft"]</button>
            <button class="pe-btn pe-btn-success pe-btn-sm" disabled="@_isSaving" @onclick="PublishAsync">@L["Publish"]</button>
            <button class="pe-btn pe-btn-secondary pe-btn-sm" disabled="@_isSaving" @onclick="SetDefaultAsync">@L["Set Default"]</button>
            <button class="pe-btn pe-btn-ghost pe-btn-sm" disabled="@_isSaving" @onclick="ArchiveAsync">@L["Archive"]</button>
        </div>
    }
</div>

@if (_isLoading)
{
    <div class="pe-blocks-container aero-editor-canvas">
        <div class="pe-empty-state">
            <h3>@L["Loading footer"]</h3>
            <p>@L["Preparing the editor canvas..."]</p>
        </div>
    </div>
}
else if (_selected is null)
{
    <div class="pe-blocks-container aero-editor-canvas">
        <div class="pe-empty-state">
            <h3>@L["Footer not found"]</h3>
            <p>@L["Return to the list and choose another footer."]</p>
        </div>
    </div>
}
else
{
    <div class="pe-blocks-container aero-editor-canvas">
        <div class="pe-blocks-list">
            <SortablePrimitive TItem="FooterCanvasRowEditorModel"
                               Items="@_rows"
                               GetItemId="row => row.ClientId"
                               Group="footer-rows"
                               OnItemsReordered="OnRowsReordered"
                               Context="rowScope">
                <SortableContentPrimitive>
                    @if (_rows.Count == 0)
                    {
                        <div class="pe-empty-state">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"
                                 style="cursor: pointer" @onclick="AddRow">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                <line x1="12" y1="8" x2="12" y2="16" />
                                <line x1="8" y1="12" x2="16" y2="12" />
                            </svg>
                            <h3>@L["Start building your footer"]</h3>
                            <p>@L["Drag blocks from the sidebar or click to add a row."]</p>
                        </div>
                    }
                    @foreach (var row in _rows.OrderBy(x => x.Order))
                    {
                        var rowIndex = row.Order;
                        <SortableItemPrimitive Value="@row.ClientId">
                            <div class="pe-block-wrapper">
                                <div class="pe-block-toolbar">
                                    <button class="pe-toolbar-btn" title="@L["Move up"]" disabled="@(rowIndex == 0)" @onclick="() => MoveRow(row, -1)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15" /></svg>
                                    </button>
                                    <button class="pe-toolbar-btn" title="@L["Move down"]" disabled="@(rowIndex == _rows.Count - 1)" @onclick="() => MoveRow(row, 1)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
                                    </button>
                                    <button class="pe-toolbar-btn" title="@L["Duplicate"]" @onclick="() => DuplicateRow(row)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                                    </button>
                                    <button class="pe-toolbar-btn delete" title="@L["Delete"]" @onclick="() => RemoveRow(row)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /></svg>
                                    </button>
                                </div>
                                <div class="pe-block-content">
                                    <div class="aero-row-preview">
                                        <div class="aero-row-preview-header">
                                            <div class="flex min-w-0 items-center gap-3">
                                                <SortableItemHandlePrimitive class="cursor-grab" />
                                                <input class="aero-row-label" @bind="row.Label" @bind:event="oninput" aria-label="@L["Footer row label"]" />
                                            </div>
                                            <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="() => AddColumn(row)">@L["Add Column"]</button>
                                        </div>

                                        <div class="aero-row-grid">
                                            @foreach (var column in row.Columns.OrderBy(x => x.Order))
                                            {
                                                <section class="aero-canvas-column aero-column-canvas" style="@ColumnGridStyle(column)">
                                                    <SortablePrimitive TItem="FooterComponentEditorModel"
                                                                       Items="@column.Blocks"
                                                                       GetItemId="block => block.ClientId"
                                                                       Group="footer-canvas"
                                                                       OnItemsReordered="blocks => OnColumnBlocksReordered(column, blocks)"
                                                                       OnItemTransferredIn="args => OnPaletteTransferredToColumn(column, args)"
                                                                       Context="blockScope">
                                                        <SortableContentPrimitive class="space-y-3">
                                                            @if (column.Blocks.Count == 0)
                                                            {
                                                                <div class="aero-column-empty">@L["Drop blocks here"]</div>
                                                            }
                                                            @foreach (var component in column.Blocks.OrderBy(x => x.Order))
                                                            {
                                                                <SortableItemPrimitive Value="@component.ClientId">
                                                                    <div class="aero-block-preview @(SelectedBlockId == component.ClientId ? "selected" : "")" @onclick="() => SelectBlock(component.ClientId)">
                                                                        <div class="flex items-center justify-between gap-2">
                                                                            <div class="min-w-0">
                                                                                <div class="aero-block-kicker">@component.Kind</div>
                                                                                <div class="aero-block-title">@component.DisplayName</div>
                                                                            </div>
                                                                            <div class="flex items-center gap-1">
                                                                                <SortableItemHandlePrimitive class="cursor-grab" />
                                                                                <button class="pe-toolbar-btn delete" title="@L["Delete"]" @onclick:stopPropagation="true" @onclick="() => RemoveBlockFromColumn(column, component)">
                                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /></svg>
                                                                                </button>
                                                                            </div>
                                                                        </div>
                                                                        @if (SelectedBlockId == component.ClientId)
                                                                        {
                                                                            <div class="mt-3">
                                                                                @RenderFooterBlockFields(component)
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </SortableItemPrimitive>
                                                            }
                                                        </SortableContentPrimitive>
                                                    </SortablePrimitive>
                                                </section>
                                            }
                                        </div>

                                        <details class="aero-layout-details">
                                            <summary>@L["Row layout"]</summary>
                                            <div class="mt-3 grid gap-2">
                                                @foreach (var column in row.Columns.OrderBy(x => x.Order))
                                                {
                                                    <div class="grid grid-cols-[auto_1fr_auto_auto_auto_auto] items-center gap-2 text-xs" style="color: var(--pe-text-secondary);">
                                                        <span>@L["Column"] @(column.Order + 1)</span>
                                                        <span></span>
                                                        <label>@L["D"] <input type="number" min="1" max="12" @bind="column.DesktopSpan" class="w-12 rounded px-1 py-0.5" /></label>
                                                        <label>@L["T"] <input type="number" min="1" max="12" @bind="column.TabletSpan" class="w-12 rounded px-1 py-0.5" /></label>
                                                        <label>@L["M"] <input type="number" min="1" max="12" @bind="column.MobileSpan" class="w-12 rounded px-1 py-0.5" /></label>
                                                        <button class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="() => RemoveColumn(row, column)">@L["Remove"]</button>
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    </div>
                                </div>
                            </div>
                        </SortableItemPrimitive>
                    }
                </SortableContentPrimitive>
            </SortablePrimitive>
        </div>
    </div>
}

<SectionContent SectionName="RightSidebar">
    <AeroSidebar Title="@L["Footer Blocks"]" Side="SidebarSide.Right" @bind-IsCollapsed="RightSidebarCollapsed">
        <div class="pe-blocks-sidebar">
            <div class="pe-category">
                <button class="pe-category-header" @onclick='() => ToggleCategory("footer")'
                        data-pe-tooltip-target
                        data-pe-tooltip="@(RightSidebarCollapsed ? L["Footer"] : null)"
                        data-pe-tooltip-placement="left">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="15" width="18" height="5" rx="1" />
                        <path d="M5 6h14M5 10h9" />
                    </svg>
                    @if (!RightSidebarCollapsed)
                    {
                        @L["Footer"]
                        <svg class="pe-chevron @(CategoryFooter ? "rotated" : "")" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    }
                </button>
                @if (CategoryFooter)
                {
                    @foreach (var block in FooterPalette)
                    {
                        <SortablePrimitive TItem="string"
                                           Items="@(new List<string> { block.Kind })"
                                           GetItemId="item => item"
                                           Group="footer-canvas"
                                           OnItemTransferredOut="@(_ => Task.CompletedTask)"
                                           class="pe-category-items"
                                           Context="paletteScope">
                            <SortableContentPrimitive>
                                <SortableItemPrimitive Value="@block.Kind" AsHandle="true" class="pe-block-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                        <path d="M12 2L2 7l10 5 10-5-10-5z" />
                                        <path d="M2 17l10 5 10-5" />
                                        <path d="M2 12l10 5 10-5" />
                                    </svg>
                                    @if (!RightSidebarCollapsed)
                                    {
                                        <span>@L[block.Label]</span>
                                    }
                                </SortableItemPrimitive>
                            </SortableContentPrimitive>
                        </SortablePrimitive>
                    }
                    <button class="pe-block-item w-full" @onclick="AddRow">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="M12 5v14" />
                        </svg>
                        @if (!RightSidebarCollapsed)
                        {
                            <span>@L["Row / Columns"]</span>
                        }
                    </button>
                }
            </div>
        </div>
    </AeroSidebar>
</SectionContent>

<PreviewOverlay Visible="@PreviewMode"
                OnClose="TogglePreview"
                FrameDocument="@PreviewFrameDocument"
                UrlBarText="@L["Footer preview"]"
                Title="@L["Footer preview"]"
                SuppressBrowserLinkErrors="true" />
