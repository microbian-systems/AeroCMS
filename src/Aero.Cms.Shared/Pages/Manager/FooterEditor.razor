@page "/manager/footers/editor/{Id:long}"
@attribute [Authorize]


<div class="pe-page-content space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <div class="mb-3">
                <RadzenButton Icon="arrow_back"
                              Text="Back to Footers"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@BackToList" />
            </div>
            <h1 class="text-2xl font-bold pe-heading">@(_selected?.Name ?? L["Footer"])</h1>
            <p class="mt-1 text-sm pe-description">@L["Draft changes stay private until the footer is published."]</p>
        </div>
        @if (_selected is not null)
        {
            <div class="flex flex-wrap gap-2">
                <RadzenButton Icon="save"
                              Text="@L["Save Draft"]"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small"
                              Click="@SaveDraftAsync"
                              Disabled="@_isSaving" />
                <RadzenButton Icon="publish"
                              Text="@L["Publish"]"
                              ButtonStyle="ButtonStyle.Success"
                              Size="ButtonSize.Small"
                              Click="@PublishAsync"
                              Disabled="@_isSaving" />
                <RadzenButton Icon="home"
                              Text="@L["Set Default"]"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@SetDefaultAsync"
                              Disabled="@_isSaving" />
                <RadzenButton Icon="delete"
                              Text="@L["Archive"]"
                              ButtonStyle="ButtonStyle.Danger"
                              Size="ButtonSize.Small"
                              Click="@ArchiveAsync"
                              Disabled="@_isSaving" />
            </div>
        }
    </div>

    @if (_isLoading)
    {
        <div class="flex min-h-64 items-center justify-center rounded"
             style="border: 1px solid var(--pe-border); background: var(--pe-bg-secondary);">
            <RadzenProgressBar Circular="true"
                               Value="100"
                               Mode="ProgressBarMode.Indeterminate"
                               Style="width: 48px; height: 48px" />
        </div>
    }
    else if (_selected is null)
    {
        <div class="flex min-h-64 items-center justify-center rounded"
             style="border: 1px dashed var(--pe-border); background: var(--pe-bg-secondary);">
            <div class="max-w-md text-center">
                <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">@L["Footer not found"]</h2>
                <p class="mt-2 text-sm pe-description">@L["Return to the list and choose another footer."]</p>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-5">
            <div class="grid grid-cols-1 gap-4 rounded md:grid-cols-2"
                 style="border: 1px solid var(--pe-border); background: var(--pe-bg-secondary); padding: 16px;">
                <div>
                    <label for="editFooterName" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Name"]</label>
                    <input id="editFooterName" @bind="_editName" class="w-full rounded px-3 py-2"
                           style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                </div>
                <div>
                    <label for="editFooterDescription" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Description"]</label>
                    <input id="editFooterDescription" @bind="_editDescription" class="w-full rounded px-3 py-2"
                           style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                </div>
                <div>
                    <label for="editCompanyName" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Company Name"]</label>
                    <input id="editCompanyName" @bind="_companyName" class="w-full rounded px-3 py-2"
                           style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                </div>
                <div>
                    <label for="editTagline" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Tagline"]</label>
                    <input id="editTagline" @bind="_tagline" class="w-full rounded px-3 py-2"
                           style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                </div>
                <div>
                    <label for="editLogoUrl" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Logo URL"]</label>
                    <input id="editLogoUrl" @bind="_logoUrl" placeholder="/img/logo.svg" class="w-full rounded px-3 py-2"
                           style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                </div>
                <div>
                    <label for="editBackgroundImageUrl" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Background Image URL"]</label>
                    <input id="editBackgroundImageUrl" @bind="_backgroundImageUrl" placeholder="/media/footer.jpg" class="w-full rounded px-3 py-2"
                           style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                </div>
                <div>
                    <label for="editOverlayOpacity" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Overlay Opacity"]</label>
                    <RadzenSlider id="editOverlayOpacity" @bind-Value="_overlayOpacity" Min="0m" Max="1m" Step="0.05m" />
                </div>
                <div>
                    <label for="editCopyright" class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Copyright Text"]</label>
                    <input id="editCopyright" @bind="_copyrightText" class="w-full rounded px-3 py-2"
                           style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                </div>
            </div>

            <div class="rounded space-y-3"
                 style="border: 1px solid var(--pe-border); background: var(--pe-bg-secondary); padding: 16px;">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">@L["Legal Links"]</h2>
                        <p class="mt-1 text-sm pe-description">@L["Privacy, terms, cookies, and other links shown in the footer bottom bar."]</p>
                    </div>
                    <RadzenButton Icon="add"
                                  Text="@L["Add Link"]"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@((Action)(() => AddLegalLink()))"
                                  Disabled="@(_isLoading || _isSaving)" />
                </div>

                @if (_legalLinks.Count == 0)
                {
                    <div class="rounded p-4 text-center"
                         style="border: 1px dashed var(--pe-border); background: var(--pe-bg-primary);">
                        <p class="text-sm pe-description">@L["No legal links yet. Add privacy, terms, or cookie policy links."]</p>
                    </div>
                }
                else
                {
                    <div class="space-y-2">
                        @for (var i = 0; i < _legalLinks.Count; i++)
                        {
                            var link = _legalLinks[i];
                            var index = i;
                            <div class="grid grid-cols-1 gap-2 rounded md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)_auto]"
                                 style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); padding: 8px;">
                                <input @bind="link.Label" aria-label="Legal link label" placeholder="@L["Label"]" class="rounded px-3 py-2"
                                       style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                                <input @bind="link.Href" aria-label="Legal link URL" placeholder="@L["/privacy"]" class="rounded px-3 py-2"
                                       style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                                <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                              Click="@(() => RemoveLegalLink(link))" />
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="rounded space-y-4"
                 style="border: 1px solid var(--pe-border); background: var(--pe-bg-secondary); padding: 16px;">
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">@L["Translations"]</h2>
                        <p class="mt-1 text-sm pe-description">@L["Current variant:"] @FormatCulture(_selected.Culture)</p>
                        <p class="mt-1 text-xs pe-description">@string.Format(L["{0} of {1} site cultures created."], _cultureVariants.Count, SupportedCultures.Count)</p>
                    </div>
                    @if (_selected.TranslationSetId is { } translationSetId)
                    {
                        <span class="text-xs font-mono px-2 py-1 rounded"
                              style="background: var(--pe-bg-primary); color: var(--pe-text-secondary); border: 1px solid var(--pe-border);">
                            Set @translationSetId
                        </span>
                    }
                </div>

                <div class="rounded p-4 space-y-3"
                     style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary);">
                    <div class="flex flex-wrap items-center gap-2 text-xs pe-description">
                        <span class="font-semibold uppercase tracking-wider">@L["Available variants"]</span>
                        @if (!AvailableTranslationCultures.Any())
                        {
                            <span class="rounded px-2 py-0.5" style="background: var(--pe-bg-secondary); color: var(--pe-text-secondary);">@L["Complete"]</span>
                        }
                    </div>
                    @if (_isLoadingTranslations)
                    {
                        <p class="text-sm pe-description">@L["Loading translations..."]</p>
                    }
                    else if (_cultureVariants.Count == 0)
                    {
                        <p class="text-sm pe-description">@L["No translation variants found."]</p>
                    }
                    else
                    {
                        <div class="flex flex-wrap gap-2">
                            @foreach (var variant in _cultureVariants)
                            {
                                var isCurrent = _selected.Id == variant.Id;
                                var isDefault = string.Equals(_currentSite?.DefaultCulture, variant.Culture, StringComparison.OrdinalIgnoreCase);
                                <button type="button"
                                        class="pe-btn @(isCurrent ? "pe-btn-primary" : "pe-btn-ghost") pe-btn-sm"
                                        disabled="@isCurrent"
                                        @onclick="() => OpenTranslation(variant.Id)">
                                    @FormatCulture(variant.Culture)@(isDefault ? " · " + L["Default"] : "")
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (AvailableTranslationCultures.Any())
                {
                    <div class="grid grid-cols-1 gap-3 items-end md:grid-cols-[minmax(0,1fr)_auto]">
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Target Culture"]</label>
                            <select class="w-full rounded px-3 py-2"
                                    style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);"
                                    @bind="_selectedTranslationCulture">
                                @foreach (var culture in AvailableTranslationCultures)
                                {
                                    <option value="@culture">@FormatCulture(culture)</option>
                                }
                            </select>
                        </div>
                        <RadzenButton Icon="translate"
                                      Text="@(_isCreatingTranslation ? L["Creating..."] : L["Create Translation"])"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      Click="@CreateTranslationAsync"
                                      Disabled="@_isCreatingTranslation" />
                    </div>
                }
                else
                {
                    <p class="text-sm pe-description">@L["All supported site cultures already have a footer variant."]</p>
                }
            </div>

            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-base font-semibold" style="color: var(--pe-text-primary);">@L["Link Groups"]</h2>
                    <p class="mt-1 text-sm pe-description">@L["Organize footer columns and their links."]</p>
                </div>
                <div class="flex items-center gap-2">
                    <RadzenButton Icon="refresh"
                                  Text="@L["Refresh"]"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@RefreshGroupsAsync"
                                  Disabled="@(_isLoading || _isSaving)" />
                    <RadzenButton Icon="add"
                                  Text="@L["Add Group"]"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@AddGroupAsync"
                                  Disabled="@(_isLoading || _isSaving)" />
                </div>
            </div>

            <RadzenDataGrid @ref="_groupsGrid"
                            Data="@_groups"
                            TItem="FooterGroupEditorModel"
                            AllowPaging="false"
                            EmptyText="@L["This footer has no link groups yet. Add a group to start building it."]">
                <Columns>
                    <RadzenDataGridColumn TItem="FooterGroupEditorModel" Title="@L["Title"]">
                        <Template Context="group">
                            <input @bind="group.Title" aria-label="Group title" class="w-full rounded px-3 py-2"
                                   style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FooterGroupEditorModel" Title="@L["Links"]">
                        <Template Context="group">
                            <div class="space-y-2">
                                @foreach (var link in group.Links.OrderBy(x => x.Order))
                                {
                                    <div class="grid grid-cols-1 gap-2 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)_auto]">
                                        <input @bind="link.Label" aria-label="Link label" placeholder="@L["Label"]" class="rounded px-3 py-2"
                                               style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                                        <input @bind="link.Href" aria-label="Link href" placeholder="@L["/about"]" class="rounded px-3 py-2"
                                               style="border: 1px solid var(--pe-border); background: var(--pe-bg-primary); color: var(--pe-text-primary);" />
                                        <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => RemoveLinkAsync(group, link))" />
                                    </div>
                                }
                                <RadzenButton Icon="add_link"
                                              Text="@L["Add Link"]"
                                              Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@(() => AddLinkAsync(group))" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FooterGroupEditorModel" Title="@L["Order"]" Width="150px">
                        <Template Context="group">
                            <div class="flex items-center gap-1">
                                <RadzenButton Icon="keyboard_arrow_up" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => MoveGroupAsync(group, -1))" />
                                <RadzenButton Icon="keyboard_arrow_down" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => MoveGroupAsync(group, 1))" />
                                <span class="text-sm" style="color: var(--pe-text-secondary);">@((group.Order + 1).ToString())</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FooterGroupEditorModel" Title="@L["Actions"]" Width="110px">
                        <Template Context="group">
                            <RadzenButton Icon="delete"
                                          Text="@L["Remove"]"
                                          Size="ButtonSize.ExtraSmall"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Click="@(() => RemoveGroupAsync(group))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</div>
