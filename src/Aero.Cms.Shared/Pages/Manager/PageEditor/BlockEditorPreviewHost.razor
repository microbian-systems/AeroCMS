        }
    };

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    /// <summary>
    /// Converts an EditorBlock to its corresponding BlockBase for property editing.
    /// Uses MapToNeoNode + block-specific mapper for Neo blocks.
    /// </summary>
    public BlockBase? GetBlockBase(EditorBlock block)
    {
        if (DefinitionRegistry.TryGetDescriptor(block.Type, out var descriptor) &&
            descriptor.LegacyDefinition is { } definition)
        {
            return definition.ToBlockBase(block);
        }

        return block.Type switch
        {
        "aero.hero.basic" => BasicHeroBlockMapper.FromNode(MapToNeoNode(block)),
        "media.image" => ImageBlockMapper.FromNode(MapToNeoNode(block)),
        "media.video" => VideoBlockMapper.FromNode(MapToNeoNode(block)),
        "media.audio" => AudioBlockMapper.FromNode(MapToNeoNode(block)),
        "media.gallery" => GalleryBlockMapper.FromNode(MapToNeoNode(block)),
        "ui.raw-html" => NeoRawHtmlBlockMapper.FromNode(MapToNeoNode(block)),
        "ui.separator" => SeparatorBlockMapper.FromNode(MapToNeoNode(block)),
        "neo.layout.columns" => NeoColumnsBlockMapper.FromNode(MapToNeoNode(block)),
        _ => null
        };
    }

