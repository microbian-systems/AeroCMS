@namespace Aero.Cms.Shared.Pages.Manager.PageEditor.Canvas
@using Aero.Cms.Abstractions.Blocks.Editor
@using Aero.Cms.Abstractions.Blocks.Neo

<div class="canvas-tree">
    <CascadingValue Value="@DefinitionRegistry">
        <CanvasContainer Node="@RootNode"
                         RootNode="@RootNode"
                         SelectedNodeId="@SelectedNodeId"
                         IsSelected="@(RootNode.NodeId == SelectedNodeId)"
                         Depth="0"
                         OnSelect="@(id => OnNodeSelected.InvokeAsync(id))"
                         OnEdit="@(id => OnNodeEditRequested.InvokeAsync(id))"
                         OnNodeChanged="@(mutation => OnNodeChanged.InvokeAsync(mutation))"
                         OnDropRejected="@(message => OnDropRejected.InvokeAsync(message))"
                         OnDrop="@(args => OnDrop.InvokeAsync(args))"
                         OnCopy="@(id => OnCopy.InvokeAsync(id))"
                         OnPaste="@(id => OnPaste.InvokeAsync(id))"
                         OnSaveAsCustom="@(id => OnSaveAsCustom.InvokeAsync(id))"
                         OnDuplicate="@(id => OnDuplicate.InvokeAsync(id))"
                         OnDelete="@(id => OnDelete.InvokeAsync(id))"
                         OnMoveUp="@(id => OnMoveUp.InvokeAsync(id))"
                         OnMoveDown="@(id => OnMoveDown.InvokeAsync(id))" />
    </CascadingValue>
</div>
