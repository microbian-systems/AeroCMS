@namespace Aero.Cms.Shared.Pages.Manager.PageEditor
@using Aero.Cms.Abstractions.Blocks
@using Aero.Cms.Abstractions.Blocks.Editor
@using Aero.Cms.Abstractions.Blocks.Neo
@using Aero.Cms.Abstractions.Blocks.Neo.Styles
@using NeoUI.Blazor
@using NeoUI.Blazor.Primitives
@using Aero.Cms.Shared.Pages.Manager.PageEditor.Canvas
@inject IStringLocalizer<Aero.Cms.Shared.Localization.ManagerResource> L
@inject IPageEditorDefinitionRegistry DefinitionRegistry

<div class="@CanvasClass">
    @* Empty state *@
    @if (RootNode.Children.Count == 0)
    {
        <div class="pe-empty-state">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"
                 style="cursor: pointer" @onclick="() => OnToggleSidebar.InvokeAsync()">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <line x1="12" y1="8" x2="12" y2="16"/>
                <line x1="8" y1="12" x2="16" y2="12"/>
            </svg>
            <h3>@L["Start building your page"]</h3>
            <p>@L["Drag blocks from the sidebar or click to add them here"]</p>
        </div>
    }
    else
    {
        <CanvasTree RootNode="@RootNode"
                    SelectedNodeId="@SelectedNodeId"
                    OnNodeSelected="@OnNodeSelected"
                    OnNodeEditRequested="@OnNodeEditRequested"
                    OnDrop="@OnCanvasDrop"
                    OnCopy="@OnNodeCopy"
                    OnPaste="@OnNodePaste"
                    OnSaveAsCustom="@OnNodeSaveAsCustom"
                    OnDuplicate="@OnNodeDuplicate"
                    OnDelete="@OnNodeDelete"
                    OnMoveUp="@OnNodeMoveUp"
                    OnMoveDown="@OnNodeMoveDown" />
    }
</div>

@code {
    [Parameter] public NeoPageNode RootNode { get; set; } = default!;
    [Parameter] public string? SelectedNodeId { get; set; }
    [Parameter] public bool PreviewMode { get; set; }

    [Parameter] public EventCallback OnToggleSidebar { get; set; }

    // Node-level operations (receive nodeId)
    [Parameter] public EventCallback<string> OnNodeSelected { get; set; }
    [Parameter] public EventCallback<string> OnNodeEditRequested { get; set; }
    [Parameter] public EventCallback<CanvasDropArgs> OnCanvasDrop { get; set; }
    [Parameter] public EventCallback<string> OnNodeCopy { get; set; }
    [Parameter] public EventCallback<string> OnNodePaste { get; set; }
    [Parameter] public EventCallback<string> OnNodeSaveAsCustom { get; set; }
    [Parameter] public EventCallback<string> OnNodeDuplicate { get; set; }
    [Parameter] public EventCallback<string> OnNodeDelete { get; set; }
    [Parameter] public EventCallback<string> OnNodeMoveUp { get; set; }
    [Parameter] public EventCallback<string> OnNodeMoveDown { get; set; }

    [CascadingParameter] public IBlockEditorCallbacks Editor { get; set; } = default!;

    private string CanvasClass => $"pe-blocks-container {(PreviewMode ? "pe-hidden" : "")}";
}
