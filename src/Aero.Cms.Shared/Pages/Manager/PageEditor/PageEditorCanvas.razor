@namespace Aero.Cms.Shared.Pages.Manager.PageEditor
@using Aero.Cms.Abstractions.Blocks
@using Aero.Cms.Abstractions.Blocks.Neo.Styles
@using NeoUI.Blazor
@using NeoUI.Blazor.Primitives
@inject IStringLocalizer<Aero.Cms.Shared.Localization.ManagerResource> L

<Sortable TItem="EditorBlock"
          Items="Blocks"
          GetItemId="block => block.EditorId"
          Group="page-editor"
          OnItemsReordered="OnCanvasReordered"
          OnItemTransferredIn="OnCatalogItemTransferred"
          Class="@CanvasClass">
    <SortableContentPrimitive class="pe-blocks-list">
        @* Empty state *@
        @if (Blocks.Count == 0)
        {
            <div class="pe-empty-state">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"
                     style="cursor: pointer" @onclick="() => OnToggleSidebar.InvokeAsync()">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <line x1="12" y1="8" x2="12" y2="16"/>
                    <line x1="8" y1="12" x2="16" y2="12"/>
                </svg>
                <h3>@L["Start building your page"]</h3>
                <p>@L["Drag blocks from the sidebar or click to add them here"]</p>
            </div>
        }

        @* Block list *@
        @for (var i = 0; i < Blocks.Count; i++)
        {
            var block = Blocks[i];
            var index = i;
            var isSelected = SelectedBlockId == block.EditorId;

            <SortableItemPrimitive Value="@block.EditorId">
                <EditorBlockFrame BlockEditorId="@block.EditorId"
                                  Index="@index"
                                  TotalCount="@Blocks.Count"
                                  IsSelected="@isSelected"
                                  Dragging="false"
                                  IsDragOver="false"
                                  OnSelect="() => OnSelectBlock.InvokeAsync(block.EditorId)"
                                  OnOpenEditor="() => OnOpenBlockEditor.InvokeAsync(block.EditorId)"
                                  OnMoveUp="(i) => OnMoveBlockUp.InvokeAsync(i)"
                                  OnMoveDown="(i) => OnMoveBlockDown.InvokeAsync(i)"
                                  OnDuplicate="(i) => OnDuplicateBlock.InvokeAsync(i)"
                                  OnDelete="(i) => OnDeleteBlock.InvokeAsync(i)">
                    <ToolbarActions>
                        @if (SupportsBackgroundImage(block))
                        {
                            <button class="pe-toolbar-btn"
                                    title="@(string.IsNullOrWhiteSpace(block.BackgroundImage) ? L["Add background image"] : L["Change background image"])"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => SelectBackground(block)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <path d="m21 15-5-5L5 21"/>
                                </svg>
                            </button>
                            @if (!string.IsNullOrWhiteSpace(block.BackgroundImage))
                            {
                                <button class="pe-toolbar-btn delete"
                                        title="@L["Remove background image"]"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => RemoveBackground(block)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 6h18"/>
                                        <path d="M8 6V4h8v2"/>
                                        <path d="m19 6-1 14H6L5 6"/>
                                    </svg>
                                </button>
                            }
                        }
                    </ToolbarActions>
                    <ChildContent>
                        <div style="@EditorStyle(block)">
                            <BlockEditorPreviewHost Block="@block" IsSelected="@isSelected" />
                        </div>
                    </ChildContent>
                </EditorBlockFrame>
            </SortableItemPrimitive>
        }
    </SortableContentPrimitive>
</Sortable>

@code {
    [Parameter] public List<EditorBlock> Blocks { get; set; } = [];
    [Parameter] public string SelectedBlockId { get; set; } = string.Empty;
    [Parameter] public bool PreviewMode { get; set; }

    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback<string> OnSelectBlock { get; set; }
    [Parameter] public EventCallback<string> OnOpenBlockEditor { get; set; }
    [Parameter] public EventCallback<int> OnMoveBlockUp { get; set; }
    [Parameter] public EventCallback<int> OnMoveBlockDown { get; set; }
    [Parameter] public EventCallback<int> OnDuplicateBlock { get; set; }
    [Parameter] public EventCallback<int> OnDeleteBlock { get; set; }
    [Parameter] public EventCallback<IList<EditorBlock>> OnCanvasReordered { get; set; }
    [Parameter] public EventCallback<SortableTransferArgs> OnCatalogItemTransferred { get; set; }
    [CascadingParameter] public IBlockEditorCallbacks Editor { get; set; } = default!;

    private string CanvasClass => $"pe-blocks-container {(PreviewMode ? "pe-hidden" : "")}";

    private static string EditorStyle(EditorBlock block) =>
        NodeStyleCssRenderer.Render(block.Style, EditorBreakpoint.Desktop);

    private static bool SupportsBackgroundImage(EditorBlock block) =>
        block.Type is "boring_hero" or "hero" or "aero.hero.basic";

    private void RemoveBackground(EditorBlock block)
    {
        block.BackgroundImage = string.Empty;
        Editor.BlockChanged(block);
    }

    private void SelectBackground(EditorBlock block) =>
        Editor.OpenMediaSelector(block, false, "background");
}
