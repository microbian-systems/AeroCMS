@namespace Aero.Cms.Shared.Pages.Manager.PageEditor.Palette
@using NeoUI.Blazor
@using NeoUI.Blazor.Primitives
@using Aero.Cms.Shared.Pages.Manager.PageEditor.Catalog

<Sortable TItem="NeoEditorCatalogItem"
          Items="Items"
          GetItemId="item => item.CatalogId"
          Group="page-editor"
          OnItemTransferredOut="OnTransferOut"
          Class="pe-category-items">
    <SortableContent>
        @foreach (var item in Items)
        {
            <SortableItem Value="@item.CatalogId" AsHandle="true" Class="pe-block-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                    <path d="M2 17l10 5 10-5"/>
                    <path d="M2 12l10 5 10-5"/>
                </svg>
                @if (!IsCollapsed)
                {
                    <span>@item.DisplayName</span>
                }
            </SortableItem>
        }
    </SortableContent>
</Sortable>

@code {
    [Parameter, EditorRequired] public IList<NeoEditorCatalogItem> Items { get; set; } = [];
    [Parameter] public bool IsCollapsed { get; set; }

    private Task OnTransferOut(SortableTransferArgs args)
    {
        // No-op — palette is a copy source, items stay in place
        return Task.CompletedTask;
    }
}
