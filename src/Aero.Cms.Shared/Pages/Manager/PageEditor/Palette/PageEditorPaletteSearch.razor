@namespace Aero.Cms.Shared.Pages.Manager.PageEditor.Palette

<div class="pe-palette-search" data-testid="palette-search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
    </svg>
    <input type="search"
           value="@Query"
           @oninput="OnInput"
           placeholder="@Placeholder"
           aria-label="@AriaLabel"
           data-testid="palette-search-input" />
    @if (!string.IsNullOrWhiteSpace(Query))
    {
        <button type="button"
                title="@ClearLabel"
                aria-label="@ClearLabel"
                data-testid="palette-search-clear"
                @onclick="Clear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    }
</div>

@if (!HasResults)
{
    <p class="px-3 pb-3 text-xs"
       style="color: var(--pe-text-muted);"
       role="status"
       data-testid="palette-search-empty">
        @NoResultsText
    </p>
}

@code {
    [Parameter] public string Query { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> QueryChanged { get; set; }
    [Parameter] public bool HasResults { get; set; } = true;
    [Parameter] public string Placeholder { get; set; } = "Search blocks...";
    [Parameter] public string AriaLabel { get; set; } = "Search blocks";
    [Parameter] public string ClearLabel { get; set; } = "Clear search";
    [Parameter] public string NoResultsText { get; set; } =
        "No blocks match your search.";

    private Task OnInput(ChangeEventArgs eventArgs) =>
        QueryChanged.InvokeAsync(eventArgs.Value?.ToString() ?? string.Empty);

    private Task Clear() => QueryChanged.InvokeAsync(string.Empty);
}
