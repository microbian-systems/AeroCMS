@using Aero.Cms.Abstractions.Blocks.Neo

<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Image URL</label>
        <RadzenTextBox @bind-Value="Block.Src" Class="w-full" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Alt Text</label>
        <RadzenTextBox @bind-Value="Block.Alt" Class="w-full" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Caption</label>
        <RadzenTextBox @bind-Value="Block.Caption" Class="w-full" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Media ID</label>
        <RadzenTextBox Value="@ImageMediaIdDisplay" Class="w-full" ReadOnly="true" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ImageBlock Block { get; set; } = default!;

    private string ImageMediaIdDisplay => Block.ImageMediaId.ToString();
}
