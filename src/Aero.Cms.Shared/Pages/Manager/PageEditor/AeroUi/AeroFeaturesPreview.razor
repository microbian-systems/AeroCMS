@using Aero.Cms.Abstractions.Blocks
@using Aero.Cms.Abstractions.Blocks
@using Aero.Cms.Abstractions.Blocks.Common
@using Aero.Cms.Abstractions.Blocks.Editor
@using Aero.Cms.Abstractions.Blocks.Neo
@using Aero.Cms.Shared.Blocks.Rendering

<AeroFeaturesRenderer Block="PreviewBlock" />

@code {
    [Parameter] public NeoPageNode? Node { get; set; }
    [Parameter] public EditorBlock OwnerBlock { get; set; } = default!;

    private AeroFeaturesBlock PreviewBlock => new()
    {
        Title = OwnerBlock.MainText,
        SubTitle = OwnerBlock.SubText,
        Items = OwnerBlock.FeatureItems
    };
}
