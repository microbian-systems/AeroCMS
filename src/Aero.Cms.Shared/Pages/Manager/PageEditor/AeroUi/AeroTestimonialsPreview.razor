@using Aero.Cms.Abstractions.Blocks
@using Aero.Cms.Abstractions.Blocks
@using Aero.Cms.Abstractions.Blocks.Common
@using Aero.Cms.Abstractions.Blocks.Editor
@using Aero.Cms.Abstractions.Blocks.Neo
@using Aero.Cms.Shared.Blocks.Rendering

<AeroTestimonialsRenderer Block="PreviewBlock" />

@code {
    [Parameter] public NeoPageNode? Node { get; set; }
    [Parameter] public EditorBlock OwnerBlock { get; set; } = default!;

    private AeroTestimonialsBlock PreviewBlock => new()
    {
        Title = FirstNonEmpty(OwnerBlock.MainText, OwnerBlock.SectionTitle),
        Description = OwnerBlock.Description,
        Testimonials = OwnerBlock.Testimonials
    };

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? string.Empty;
}
