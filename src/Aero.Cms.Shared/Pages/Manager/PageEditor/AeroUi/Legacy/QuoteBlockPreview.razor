@using Aero.Cms.Abstractions.Blocks
@using Aero.Cms.Abstractions.Blocks.Editor
@using Aero.Cms.Shared.Blocks.Rendering
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Aero.Cms.Shared.Localization.ManagerResource> L

@{
    var block = OwnerBlock;
}

@if (IsSelected && OnBlockChanged.HasDelegate)
{
    <div class="pe-property-panel">
        <textarea class="w-full rounded-md"
                  style="min-height: 120px; background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border); padding: 12px;"
                  @onkeydown:stopPropagation="true"
                  value="@block.Content"
                  placeholder="@L["Quote..."]"
                  @oninput="e => Update(value => block.Content = value, e.Value?.ToString() ?? string.Empty)"></textarea>
        <input class="w-full rounded-md mt-2"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border); padding: 8px 12px;"
               @onkeydown:stopPropagation="true"
               value="@block.Author"
               placeholder="@L["Author"]"
               @oninput="e => Update(value => block.Author = value, e.Value?.ToString() ?? string.Empty)" />
    </div>
}
else
{
    <QuoteBlockRenderer Block="new QuoteBlock { Content = block.Content, Author = block.Author }" />
}

@code {
    [Parameter] public EditorBlock OwnerBlock { get; set; } = default!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<EditorBlock> OnBlockChanged { get; set; }

    private void Update<T>(Action<T> setValue, T value)
    {
        setValue(value);
        _ = OnBlockChanged.InvokeAsync(OwnerBlock);
    }
}
