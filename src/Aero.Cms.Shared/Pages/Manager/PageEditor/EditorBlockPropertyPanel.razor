    private static decimal? GetPixels(CssLength? length) =>
        length is { Unit: CssLengthUnit.Pixels } ? length.Value.Value : null;

    private RenderFragment ColorField(
        string? label,
        CssColor? value,
        Action<string?> setValue) => @<div class="pe-property-group">
        @if (!string.IsNullOrWhiteSpace(label))
        {
            <label class="pe-property-label">@L[label]</label>
        }
