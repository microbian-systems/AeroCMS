    private void SetGradientStartPosition(NeoPageNode node, string? value) =>
        SetGradientStopPosition(node, value, true);

    private void SetGradientEndPosition(NeoPageNode node, string? value) =>
        SetGradientStopPosition(node, value, false);

    private void SetGradientStopPosition(
        NeoPageNode node,
        string? value,
        bool isStart)
    {
        var gradient = CurrentStyle(node).BackgroundGradient;
        if (gradient is null ||
            !decimal.TryParse(
                value,
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture,
                out var position))
        {
            return;
        }

        position = Math.Clamp(position, 0m, 100m);
        SetBackgroundGradient(
            node,
            isStart
                ? gradient with
                {
                    StartPosition = Math.Min(position, gradient.EndPosition)
                }
                : gradient with
                {
                    EndPosition = Math.Max(position, gradient.StartPosition)
                });
    }

