    private void SetStyleValue(
        NeoPageNode node,
        Func<NodeStyle, NodeStyle> updateBase,
        Func<NodeStyleOverride, NodeStyleOverride> updateOverride)
    {
        switch (_styleBreakpoint)
        {
            case EditorBreakpoint.Desktop:
                node.Style.Base = updateBase(node.Style.Base);
                break;
            case EditorBreakpoint.Tablet:
                node.Style.Tablet = updateOverride(node.Style.Tablet ?? new());
                break;
            case EditorBreakpoint.Mobile:
                node.Style.Mobile = updateOverride(node.Style.Mobile ?? new());
                break;
        }
    }

    private static LogicalSpacing UniformSpacing(CssLength? length) =>
        new()
        {
            BlockStart = length,
            BlockEnd = length,
            InlineStart = length,
            InlineEnd = length
        };

    private static LogicalSpacingOverride UniformSpacingOverride(CssLength? length) =>
        new()
        {
            BlockStart = length,
            BlockEnd = length,
            InlineStart = length,
            InlineEnd = length
        };

    private static CssLength? ParsePixels(string? value) =>
        decimal.TryParse(
            value,
            System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture,
            out var pixels)
            ? new CssLength(Math.Max(0, pixels), CssLengthUnit.Pixels)
            : null;

    private static CssColor? ParseColor(string? value)
    {
        var normalized = value?.Trim();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return null;
        }

        var color = new CssColor(normalized);
        return CssColorValidator.IsValid(color) ? color : null;
    }

    private static string ToRgba(CssColor? color) =>
        color?.Value ?? "rgba(0, 0, 0, 1.00)";

    private static string GradientPositionLabel(RadialGradientPosition position) =>
        position switch
        {
            RadialGradientPosition.TopRight => "Top right",
            RadialGradientPosition.BottomRight => "Bottom right",
            RadialGradientPosition.BottomLeft => "Bottom left",
            RadialGradientPosition.TopLeft => "Top left",
            _ => position.ToString()
        };

    private static readonly (decimal Angle, string Label)[] GradientDirections =
    [
        (0m, "Bottom to top"),
        (45m, "Bottom left to top right"),
        (90m, "Left to right"),
        (135m, "Top left to bottom right"),
        (180m, "Top to bottom"),
        (225m, "Top right to bottom left"),
        (270m, "Right to left"),
        (315m, "Bottom right to top left")
    ];

    private static bool Supports(
        EditorCapabilitySet capabilities,
        EditorCapabilitySet capability) =>
        capabilities.HasFlag(capability);

    private static readonly EditorCapabilitySet CannedBlockCapabilities =
        EditorCapabilitySet.Typography |
        EditorCapabilitySet.Spacing |
        EditorCapabilitySet.Dimensions |
        EditorCapabilitySet.Alignment |
        EditorCapabilitySet.Foreground |
        EditorCapabilitySet.Background |
        EditorCapabilitySet.Border |
        EditorCapabilitySet.Effects |
        EditorCapabilitySet.Visibility |
        EditorCapabilitySet.Direction;

    private NeoPageNode CannedStyleNode() =>
        new()
        {
            NodeId = Block?.EditorId ?? string.Empty,
            CatalogId = Block?.Type ?? string.Empty,
            Kind = NeoPageNodeKind.Block,
            Style = Block?.Style ?? new()
        };

    private string GetCompositionString(string propertyName)
    {
        var node = Block?.CompositionNodes.FirstOrDefault();
        return node is not null &&
               node.Properties.TryGetValue(propertyName, out var value) &&
               value.ValueKind == System.Text.Json.JsonValueKind.String
            ? value.GetString() ?? string.Empty
            : string.Empty;
    }

    private void SetCompositionString(string propertyName, string value)
    {
        var node = Block?.CompositionNodes.FirstOrDefault();
        if (node is null)
        {
            return;
        }

        node.Properties[propertyName] =
            System.Text.Json.JsonSerializer.SerializeToElement(value);
    }
}
