    private EditorBreakpoint _styleBreakpoint = EditorBreakpoint.Desktop;

    private NodeStyle CurrentStyle(NeoPageNode node) =>
        node.Style.Resolve(_styleBreakpoint);

    private static bool HasOverride(
        NeoPageNode node,
        EditorBreakpoint breakpoint) =>
        breakpoint switch
        {
            EditorBreakpoint.Tablet => node.Style.Tablet is not null,
            EditorBreakpoint.Mobile => node.Style.Mobile is not null,
            _ => true
        };

    private void ResetBreakpoint(NeoPageNode node)
    {
        switch (_styleBreakpoint)
        {
            case EditorBreakpoint.Tablet:
                node.Style.Tablet = null;
                break;
            case EditorBreakpoint.Mobile:
                node.Style.Mobile = null;
                break;
        }

        NotifyChanged();
    }

