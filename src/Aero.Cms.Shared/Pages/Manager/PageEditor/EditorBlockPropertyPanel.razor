                </div>
                <div class="pe-property-group">
                    <label class="pe-property-label">@L["Background repeat"]</label>
                    <select class="w-full rounded-md"
                            value="@image.Repeat"
                            @onchange="e => SetBackgroundImageRepeat(node, e.Value?.ToString())">
                        @foreach (var repeat in Enum.GetValues<BackgroundImageRepeat>())
                        {
                            <option value="@repeat">@L[BackgroundRepeatLabel(repeat)]</option>
                        }
