@using Aero.Cms.Abstractions.Blocks
@using Aero.Cms.Abstractions.Blocks.Common
@using Aero.Cms.Abstractions.Blocks.Editor
@using Aero.Cms.Abstractions.Blocks.Neo
@using Aero.Cms.Abstractions.Blocks.Neo.Styles
@using NeoUI.Blazor
@inject IStringLocalizer<Aero.Cms.Shared.Localization.ManagerResource> L
@inject IPageEditorDefinitionRegistry DefinitionRegistry

<div class="pe-property-panel-shell">
    @if (ShowHeader)
    {
        <div class="pe-property-panel-header">
            <h3 class="pe-property-panel-title">@L["Properties"]</h3>
        </div>
    }
    <div class="pe-property-panel-content">
        @if (Block is null)
        {
            <div class="pe-property-panel p-4 text-muted-foreground text-sm">
                <p>@L["Select a block to edit its properties."]</p>
            </div>
        }
        else
        {
            @if (TryGetNativeDefinition(out var nativeDefinition, out var nativeNode))
            {
                @if (ActiveTab == "content")
                {
                    <div class="pe-property-panel">
                        @if (nativeDefinition.Catalog.PropertyEditorComponentType is { } editorType)
                        {
                            <DynamicComponent Type="editorType"
                                              Parameters="NativeEditorParameters(nativeNode)" />
                        }
                        else
                        {
                            @CompositeContentPanel(nativeNode)
                        }
                    </div>
                }
                else if (ActiveTab == "design")
                {
                    @NativeDesignPanel(nativeDefinition.Catalog.EditorCapabilities, nativeNode)
                }
                else
                {
                    @NativeAdvancedPanel(nativeDefinition.Catalog.EditorCapabilities, nativeNode)
                }
            }
            else if (ActiveTab == "content")
            {
                <div class="pe-property-panel">
                @switch (Block.Type)
                {
                    case "primitive.text":
                        @TextAreaField(
                            "Text",
                            GetCompositionString("text"),
                            value => SetCompositionString("text", value),
                            5)
                        break;
                    case "neo.hero.centered":
                        @TextField("Eyebrow", Block.Eyebrow, value => Block.Eyebrow = value)
                        @TextField("Title", Block.MainText, value => Block.MainText = value)
                        @TextField("Highlight", Block.Highlight, value => Block.Highlight = value)
                        @TextAreaField("Description", Block.SubText, value => Block.SubText = value)
                        @TextField("Primary Button Text", Block.CtaText, value => Block.CtaText = value)
                        @TextField("Primary Button URL", Block.CtaUrl, value => Block.CtaUrl = value)
                        @TextField("Secondary Button Text", Block.CtaText2, value => Block.CtaText2 = value)
                        @TextField("Secondary Button URL", Block.CtaUrl2, value => Block.CtaUrl2 = value)
                        @TextAreaField("Trust Markers (comma separated)", string.Join(", ", Block.TrustMarkers), SetTrustMarkers)
                        break;
                    case "neo.hero.split":
                        @TextField("Eyebrow", Block.Eyebrow, value => Block.Eyebrow = value)
                        @TextField("Title", Block.MainText, value => Block.MainText = value)
                        @TextAreaField("Description", Block.SubText, value => Block.SubText = value)
                        @TextField("Primary Button Text", Block.CtaText, value => Block.CtaText = value)
                        @TextField("Primary Button URL", Block.CtaUrl, value => Block.CtaUrl = value)
                        @TextField("Secondary Button Text", Block.CtaText2, value => Block.CtaText2 = value)
                        @TextField("Secondary Button URL", Block.CtaUrl2, value => Block.CtaUrl2 = value)
                        @TextField("Footnote", Block.AlternativeLinkText, value => Block.AlternativeLinkText = value)
                        break;
                    case "neo.cta.banner":
                        @TextField("Title", Block.MainText, value => Block.MainText = value)
                        @TextAreaField("Description", Block.SubText, value => Block.SubText = value)
                        @TextField("Primary Button Text", Block.CtaText, value => Block.CtaText = value)
                        @TextField("Primary Button URL", Block.CtaUrl, value => Block.CtaUrl = value)
                        @TextField("Secondary Button Text", Block.CtaText2, value => Block.CtaText2 = value)
                        @TextField("Secondary Button URL", Block.CtaUrl2, value => Block.CtaUrl2 = value)
                        break;
                    case "neo.newsletter":
                        @TextField("Title", Block.MainText, value => Block.MainText = value)
                        @TextAreaField("Description", Block.SubText, value => Block.SubText = value)
                        @TextField("Placeholder", Block.SectionTitle, value => Block.SectionTitle = value)
                        @TextField("Button Text", Block.CtaText, value => Block.CtaText = value)
                        @TextField("Privacy Text", Block.AlternativeLinkText, value => Block.AlternativeLinkText = value)
                        break;
                    case "neo.stats.row":
                        @TextAreaField("Stats (value:label, comma separated)", string.Join(", ", Block.TrustMarkers), SetTrustMarkers)
                        break;
                    case "aero.hero.01":
                        @TextField("Eyebrow", Block.Eyebrow, value => Block.Eyebrow = value)
                        @TextField("Title", Block.MainText, value => Block.MainText = value)
                        @TextField("Highlight", Block.Highlight, value => Block.Highlight = value)
                        @TextAreaField("Description", Block.SubText, value => Block.SubText = value)
                        @TextField("Primary Button Text", Block.CtaText, value => Block.CtaText = value)
                        @TextField("Primary Button URL", Block.CtaUrl, value => Block.CtaUrl = value)
                        @TextField("Secondary Button Text", Block.CtaText2, value => Block.CtaText2 = value)
                        @TextField("Secondary Button URL", Block.CtaUrl2, value => Block.CtaUrl2 = value)
                        @TextAreaField("Trust Markers", string.Join(", ", Block.TrustMarkers), SetTrustMarkers)
                        break;
                    case "hyper.pricing.1":
                        @TextField("Title", Block.MainText, value => Block.MainText = value)
                        @TextAreaField("Description", FirstNonEmpty(Block.Description, Block.SubText), value => { Block.Description = value; Block.SubText = value; })
                        @PricingPlansField()
                        break;
                    case "aero.hero.basic":
                    case "boring_hero":
                    case "hero":
                        @TextField("Title", Block.MainText, value => Block.MainText = value)
                        @TextAreaField("Summary", Block.SubText, value => Block.SubText = value)
                        @TextField("Primary Button Text", Block.CtaText, value => Block.CtaText = value)
                        @TextField("Primary Button URL", Block.CtaUrl, value => Block.CtaUrl = value)
                        @TextField("Background Image URL", Block.BackgroundImage, value => Block.BackgroundImage = value)
                        @MediaButtonField(
                            string.IsNullOrWhiteSpace(Block.BackgroundImage) ? "Add Background Image" : "Change Background Image",
                            () => Editor?.OpenMediaSelector(Block, false, "background"))
                        @if (!string.IsNullOrWhiteSpace(Block.BackgroundImage))
                        {
                            @ActionButtonField("Remove Background", () => Update(value => Block.BackgroundImage = value, string.Empty))
                        }
                        @BoolField("Full Screen", Block.FullScreen, value => Block.FullScreen = value)
                        @NumberField("Height", Block.Height, value => Block.Height = value, 240, 1600)
                        break;
                    case "media.image":
                    case "image":
                        @TextField("Image URL", Block.Src, value => Block.Src = value)
                        @TextField("Alt Text", Block.Alt, value => Block.Alt = value)
                        @TextField("Caption", Block.Caption, value => Block.Caption = value)
                        break;
                    case "media.video":
                    case "video":
                        @TextField("Video URL", FirstNonEmpty(Block.Src, Block.Url), value => { Block.Src = value; Block.Url = value; })
                        @BoolField("Autoplay", Block.AutoPlay, value => Block.AutoPlay = value)
                        break;
                    case "media.audio":
                    case "audio":
                        @TextField("Audio URL", Block.Src, value => Block.Src = value)
                        break;
                    case "media.gallery":
                    case "gallery":
                    case "carousel":
                        @BoolField("Autoscroll", Block.AutoPlay, value => Block.AutoPlay = value)
                        @BoolField("Show Arrows", Block.ShowArrows, value => Block.ShowArrows = value)
                        @NumberField("Interval", Block.CarouselInterval, value => Block.CarouselInterval = value, 1000, 30000)
                        @TextField("Controls", Block.ControlLocation, value => Block.ControlLocation = value)
                        break;
                    case "ui.raw-html":
                    case "raw_html":
                        @TextAreaField("HTML", Block.Content, value => Block.Content = value, 8)
                        break;
                    case "neo.template.scriban":
                    case "dynamic_template":
                        @TextAreaField("Scriban Template", Block.ScribanTemplate, value => Block.ScribanTemplate = value, 8)
                        @TextAreaField("Preview Data JSON", Block.ScribanDataJson, value => Block.ScribanDataJson = value, 5)
                        break;
                    case "neo.layout.columns":
                    case "columns":
                        @SliderField("Columns", Block.ColumnCount, value => UpdateColumnCount(value), 1, 12)
                        @SliderField("Gap", Block.Gap, value => Block.Gap = Math.Clamp(value, 0, 64), 0, 64, "px")
                        break;
                    case "text":
                    case "content":
                    case "markdown":
                        @TextAreaField("Content", Block.Content, value => Block.Content = value, 8)
                        break;
                    case "quote":
                        @TextAreaField("Quote", Block.Content, value => Block.Content = value, 5)
                        @TextField("Author", Block.Author, value => Block.Author = value)
                        break;
                    default:
                        @TextField("Title", Block.MainText, value => Block.MainText = value)
                        @TextAreaField("Description", FirstNonEmpty(Block.Description, Block.SubText), value => { Block.Description = value; Block.SubText = value; })
                        @TextField("Button Text", Block.CtaText, value => Block.CtaText = value)
                        @TextField("Button URL", Block.CtaUrl, value => Block.CtaUrl = value)
                        break;
                }
                </div>
            }
            else if (ActiveTab == "design")
            {
                @NativeDesignPanel(CannedBlockCapabilities, CannedStyleNode())
            }
            else
            {
                @NativeAdvancedPanel(CannedBlockCapabilities, CannedStyleNode())
            }
        }
    </div>
</div>

@code {
    [Parameter] public EditorBlock? Block { get; set; }
    [Parameter] public EventCallback<EditorBlock> OnChanged { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public string ActiveTab { get; set; } = "content";
    [Parameter] public string? TargetNodeId { get; set; }
    [CascadingParameter] public IBlockEditorCallbacks? Editor { get; set; }

    private RenderFragment TextField(string label, string? value, Action<string> setValue) => @<div class="pe-property-group">
        <label class="pe-property-label">@L[label]</label>
        <input class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@value"
               @oninput="e => Update(setValue, e.Value?.ToString() ?? string.Empty)" />
    </div>;

    private RenderFragment TextAreaField(string label, string? value, Action<string> setValue, int rows = 3) => @<div class="pe-property-group">
        <label class="pe-property-label">@L[label]</label>
        <textarea rows="@rows" class="w-full rounded-md shadow-sm sm:text-sm"
                  style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                  value="@value"
                  @oninput="e => Update(setValue, e.Value?.ToString() ?? string.Empty)"></textarea>
    </div>;

    private RenderFragment BoolField(string label, bool value, Action<bool> setValue) => @<div class="pe-property-group">
        <label class="pe-field-label" style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox"
                   checked="@value"
                   @onchange="e => Update(setValue, e.Value is true)" />
            @L[label]
        </label>
    </div>;

    private RenderFragment NumberField(string label, int value, Action<int> setValue, int min, int max) => @<div class="pe-property-group">
        <label class="pe-property-label">@L[label]</label>
        <input type="number" min="@min" max="@max" class="w-full rounded-md shadow-sm sm:text-sm"
               style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
               value="@value"
               @oninput="e => Update(setValue, int.TryParse(e.Value?.ToString(), out var next) ? next : value)" />
    </div>;

    private RenderFragment SliderField(string label, int value, Action<int> setValue, int min, int max, string suffix = "") => @<div class="pe-property-group">
        <label class="pe-property-label">@L[label]: @value@suffix</label>
        <input type="range" min="@min" max="@max" class="w-full"
               value="@value"
               @oninput="e => Update(setValue, int.TryParse(e.Value?.ToString(), out var next) ? next : value)" />
    </div>;

    private RenderFragment MediaButtonField(string label, Action? action) => @<div class="pe-property-group">
        <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm"
                @onclick="() => InvokeAction(action)">
            @L[label]
        </button>
    </div>;

    private RenderFragment ActionButtonField(string label, Action action) => @<div class="pe-property-group">
        <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm"
                @onclick="action">
            @L[label]
        </button>
    </div>;

    private RenderFragment PricingPlansField() => @<div class="pe-property-group">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px;">
            <label class="pe-property-label" style="margin: 0;">@L["Plans"]</label>
            <button type="button" class="pe-btn pe-btn-secondary pe-btn-sm" @onclick="AddPricingPlan">@L["Add Plan"]</button>
        </div>
        @if (Block?.PricingPlans.Count == 0)
        {
            <p class="text-muted-foreground text-sm">@L["Add at least one plan."]</p>
        }
        @for (var index = 0; index < (Block?.PricingPlans.Count ?? 0); index++)
        {
            var plan = Block!.PricingPlans[index];
            var currentIndex = index;
            <div class="pe-property-panel" style="margin-bottom: 12px; padding: 12px; border: 1px solid var(--pe-border); border-radius: 8px;">
                @TextField("Name", plan.Name, value => { plan.Name = value; NotifyChanged(); })
                @TextField("Price", plan.Price, value => { plan.Price = value; NotifyChanged(); })
                @TextField("Period", plan.Period, value => { plan.Period = value; NotifyChanged(); })
                @TextField("Button Text", plan.CtaText, value => { plan.CtaText = value; NotifyChanged(); })
                @TextField("Button URL", plan.CtaUrl, value => { plan.CtaUrl = value; NotifyChanged(); })
                @BoolField("Highlighted", plan.IsPopular, value => { plan.IsPopular = value; NotifyChanged(); })
                @TextAreaField("Features", string.Join(Environment.NewLine, plan.Features), value => SetPricingFeatures(plan, value), 5)
                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="() => RemovePricingPlan(currentIndex)">@L["Remove Plan"]</button>
            </div>
        }
    </div>;

    private void InvokeAction(Action? action)
    {
        action?.Invoke();
    }

    private void SetTrustMarkers(string value)
    {
        if (Block is null)
        {
            return;
        }

        Block.TrustMarkers = value
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    private void Update<T>(Action<T> setValue, T value)
    {
        if (Block is null)
        {
            return;
        }

        setValue(value);
        NotifyChanged();
    }

    private void NotifyChanged()
    {
        if (Block is not null)
        {
            _ = OnChanged.InvokeAsync(Block);
        }
    }

    private void UpdateColumnCount(int count)
    {
        if (Block is null)
        {
            return;
        }

        var next = Math.Clamp(count, 1, 12);
        Block.ColumnCount = next;

        while (Block.EditorColumns.Count < next)
        {
            Block.EditorColumns.Add(new EditorColumn());
        }

        while (Block.EditorColumns.Count > next)
        {
            Block.EditorColumns.RemoveAt(Block.EditorColumns.Count - 1);
        }

        NotifyChanged();
    }

    private void AddPricingPlan()
    {
        if (Block is null)
        {
            return;
        }

        Block.PricingPlans.Add(new AeroPricingPlan
        {
            Name = "New Plan",
            Price = "$0",
            Period = "/month",
            Features = ["Feature one", "Feature two"],
            CtaText = "Get Started",
            CtaUrl = "#"
        });
        NotifyChanged();
    }

    private void RemovePricingPlan(int index)
    {
        if (Block is null || index < 0 || index >= Block.PricingPlans.Count)
        {
            return;
        }

        Block.PricingPlans.RemoveAt(index);
        NotifyChanged();
    }

    private void SetPricingFeatures(AeroPricingPlan plan, string value)
    {
        plan.Features = value
            .Split(['\r', '\n', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        NotifyChanged();
    }

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private bool TryGetNativeDefinition(
        out PageEditorDefinitionDescriptor definition,
        out NeoPageNode node)
    {
        if (Block is not null &&
            FindTargetNode(Block.CompositionNodes) is { } compositionNode &&
            DefinitionRegistry.TryGetDescriptor(
                string.IsNullOrWhiteSpace(TargetNodeId) ? Block.Type : compositionNode.CatalogId,
                out definition!) &&
            definition.LegacyDefinition is null)
        {
            node = compositionNode;
            return true;
        }

        definition = default!;
        node = default!;
        return false;
    }

    private NeoPageNode? FindTargetNode(IEnumerable<NeoPageNode> roots)
    {
        if (string.IsNullOrWhiteSpace(TargetNodeId))
        {
            return roots.FirstOrDefault();
        }

        foreach (var root in roots)
        {
            var match = FindNode(root, TargetNodeId);
            if (match is not null)
            {
                return match;
            }
        }

        return null;
    }

    private static NeoPageNode? FindNode(NeoPageNode node, string nodeId)
    {
        if (string.Equals(node.NodeId, nodeId, StringComparison.Ordinal))
        {
            return node;
        }

        foreach (var child in node.Children)
        {
            var match = FindNode(child, nodeId);
            if (match is not null)
            {
                return match;
            }
        }

        return null;
    }

    private Dictionary<string, object?> NativeEditorParameters(NeoPageNode node)
    {
        var parameters = new Dictionary<string, object?>
        {
            ["Node"] = node,
            ["Changed"] = EventCallback.Factory.Create(this, NotifyChanged)
        };

        if (string.Equals(
                node.CatalogId,
                "primitive.image",
                StringComparison.OrdinalIgnoreCase))
        {
            parameters["SelectMedia"] = EventCallback.Factory.Create(
                this,
                () => OpenNativePropertyMediaSelector(node, "url"));
        }

        return parameters;
    }

    private RenderFragment CompositeContentPanel(NeoPageNode node) => @<div class="pe-composite-content">
        <div class="pe-property-intro">
            <strong>@L["Card content"]</strong>
            <span>@L["Edit the elements inside this component. You can also double-click an element directly on the canvas."]</span>
        </div>
        @if (node.Children.Count == 0)
        {
            <div class="pe-property-empty">@L["This component has no editable child content."]</div>
        }
        @foreach (var child in node.Children)
        {
            if (DefinitionRegistry.TryGetDescriptor(child.CatalogId, out var childDefinition) &&
                childDefinition.Catalog.PropertyEditorComponentType is { } childEditorType)
            {
                <section class="pe-property-section">
                    <div class="pe-property-section-heading">
                        <span>@childDefinition.Catalog.DisplayName</span>
                        <code>@child.CatalogId</code>
                    </div>
                    <DynamicComponent Type="childEditorType"
                                      Parameters="NativeEditorParameters(child)" />
                </section>
            }
        }
    </div>;

    private void OpenNativePropertyMediaSelector(
        NeoPageNode node,
        string propertyName)
    {
        if (Block is not null)
        {
            Editor?.OpenNodeMediaSelector(
                Block,
                node.NodeId,
                $"property:{propertyName}",
                _styleBreakpoint);
        }
    }

    private RenderFragment NativeDesignPanel(
        EditorCapabilitySet capabilities,
        NeoPageNode node) => @<div class="pe-property-panel pe-design-panel">
        <section class="pe-property-section pe-breakpoint-section">
        <div class="pe-property-group">
            <label class="pe-property-label">@L["Breakpoint"]</label>
            <div class="flex gap-1">
                @foreach (var breakpoint in Enum.GetValues<EditorBreakpoint>())
                {
                    <button type="button"
                            class="pe-btn pe-btn-sm @(_styleBreakpoint == breakpoint ? "pe-btn-primary" : "pe-btn-ghost")"
                            @onclick="() => _styleBreakpoint = breakpoint">
                        @L[breakpoint.ToString()]
                    </button>
                }
            </div>
            @if (_styleBreakpoint != EditorBreakpoint.Desktop)
            {
                <div class="mt-2 flex items-center justify-between gap-2">
                    <span class="text-xs text-muted-foreground">
                        @(HasOverride(node, _styleBreakpoint)
                            ? L["Override active"]
                            : L["Inheriting from larger breakpoint"])
                    </span>
                    <button type="button"
                            class="pe-btn pe-btn-ghost pe-btn-sm"
                            disabled="@(!HasOverride(node, _styleBreakpoint))"
                            @onclick="() => ResetBreakpoint(node)">
                        @L["Reset"]
                    </button>
                </div>
            }
        </div>
        </section>
        <section class="pe-property-section">
        <div class="pe-property-section-heading"><span>@L["Size and spacing"]</span></div>
        <div class="pe-property-grid">
        <div class="pe-property-group">
            <label class="pe-property-label">@L["Width"]</label>
            <input type="number" min="0" class="w-full rounded-md"
                   value="@GetPixels(CurrentStyle(node).Width)"
                   @oninput="e => SetWidth(node, e.Value?.ToString())" />
        </div>
        <div class="pe-property-group">
            <label class="pe-property-label">@L["Height"]</label>
            <input type="number" min="0" class="w-full rounded-md"
                   value="@GetPixels(CurrentStyle(node).Height)"
                   @oninput="e => SetHeight(node, e.Value?.ToString())" />
        </div>
        <div class="pe-property-group">
            <label class="pe-property-label">@L["Padding"]</label>
            <input type="number" min="0" class="w-full rounded-md"
                   value="@GetPixels(CurrentStyle(node).Padding.BlockStart)"
                   @oninput="e => SetUniformPadding(node, e.Value?.ToString())" />
        </div>
        <div class="pe-property-group">
            <label class="pe-property-label">@L["Margin"]</label>
            <input type="number" min="0" class="w-full rounded-md"
                   value="@GetPixels(CurrentStyle(node).Margin.BlockStart)"
                   @oninput="e => SetUniformMargin(node, e.Value?.ToString())" />
        </div>
        <div class="pe-property-group">
            <div class="pe-property-heading-row">
                <label class="pe-property-label">@L["Opacity"]</label>
                <span class="text-xs text-muted-foreground">
                    @($"{(CurrentStyle(node).Opacity ?? 1m) * 100m:0}%")
                </span>
            </div>
            <input type="range" min="0" max="1" step="0.05" class="w-full"
                   value="@(CurrentStyle(node).Opacity ?? 1m)"
                   @oninput="e => SetOpacity(node, e.Value?.ToString())" />
        </div>
        </div>
        </section>
        <section class="pe-property-section">
        <div class="pe-property-section-heading"><span>@L["Appearance"]</span></div>
        @if (Supports(capabilities, EditorCapabilitySet.Foreground))
        {
            @ColorField("Text color", CurrentStyle(node).ForegroundColor, value => SetForegroundColor(node, value))
        }
        @if (Supports(capabilities, EditorCapabilitySet.Background))
        {
            <div class="pe-property-heading-row">
                <span class="pe-property-label">@L["Background color"]</span>
                <label class="pe-gradient-toggle">
                    <input type="checkbox"
                           checked="@(CurrentStyle(node).BackgroundGradient is { Enabled: true })"
                           @onchange="e => ToggleBackgroundGradient(node, e.Value is true)" />
                    <span>@L["Gradient"]</span>
                </label>
            </div>
            @ColorField(null, CurrentStyle(node).BackgroundColor, value => SetBackgroundColor(node, value))
            @ColorField(
                "Background mask",
                CurrentStyle(node).BackgroundOverlayColor,
                value => SetBackgroundOverlayColor(node, value))
            <p class="text-xs text-muted-foreground">
                @L["Use the alpha channel to darken or tint the background without fading the content."]
            </p>
            @if (CurrentStyle(node).BackgroundImage is { Enabled: true } image)
            {
                <div class="pe-property-group">
                    <label class="pe-property-label">@L["Background image"]</label>
                    <input class="w-full rounded-md font-mono"
                           value="@image.Url"
                           readonly />
                </div>
                <div class="pe-property-group">
                    <label class="pe-property-label">@L["Background size"]</label>
                    <select class="w-full rounded-md"
                            value="@image.Size"
                            @onchange="e => SetBackgroundImageSize(node, e.Value?.ToString())">
                        @foreach (var size in Enum.GetValues<BackgroundImageSize>())
                        {
                            <option value="@size">@L[size.ToString()]</option>
                        }
                    </select>
                </div>
                <div class="pe-property-group">
                    <label class="pe-property-label">@L["Background position"]</label>
                    <select class="w-full rounded-md"
                            value="@image.Position"
                            @onchange="e => SetBackgroundImagePosition(node, e.Value?.ToString())">
                        @foreach (var position in Enum.GetValues<BackgroundImagePosition>())
                        {
                            <option value="@position">@L[BackgroundPositionLabel(position)]</option>
                        }
