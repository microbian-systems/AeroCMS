                <button type="button" class="btn btn-sm btn-outline"
                        @onclick="() => OpenBackgroundImageSelector(node)">
                    @L["Change background image"]
                </button>
                <button type="button" class="btn btn-sm btn-outline"
                        @onclick="() => RemoveBackgroundImage(node)">
                    @L["Remove background image"]
                </button>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline"
                        @onclick="() => OpenBackgroundImageSelector(node)">
                    @L["Choose background image"]
                </button>
            }
            @if (CurrentStyle(node).BackgroundGradient is { Enabled: true } gradient)
            {
                <div class="pe-gradient-editor">
                <div class="pe-property-grid">
                <div class="pe-property-group">
                    <label class="pe-property-label">@L["Gradient type"]</label>
                    <select class="w-full rounded-md"
                            value="@gradient.Type"
                            @onchange="e => SetGradientType(node, e.Value?.ToString())">
                        @foreach (var type in Enum.GetValues<GradientType>())
                        {
                            <option value="@type">@L[type.ToString()]</option>
                        }
                    </select>
                </div>
                @if (gradient.Type == GradientType.Linear)
                {
                    <div class="pe-property-group">
                        <label class="pe-property-label">@L["Direction"]</label>
                        <select class="w-full rounded-md"
                                value="@gradient.Angle"
                                @onchange="e => SetGradientAngle(node, e.Value?.ToString())">
                            @foreach (var direction in GradientDirections)
                            {
                                <option value="@direction.Angle">@L[direction.Label]</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="pe-property-group">
                        <label class="pe-property-label">@L["Shape"]</label>
                        <select class="w-full rounded-md"
                                value="@gradient.RadialShape"
                                @onchange="e => SetGradientShape(node, e.Value?.ToString())">
                            @foreach (var shape in Enum.GetValues<RadialGradientShape>())
                            {
                                <option value="@shape">@L[shape.ToString()]</option>
                            }
                        </select>
                    </div>
                    <div class="pe-property-group">
                        <label class="pe-property-label">@L["Origin"]</label>
                        <select class="w-full rounded-md"
                                value="@gradient.RadialPosition"
                                @onchange="e => SetGradientPosition(node, e.Value?.ToString())">
                            @foreach (var position in Enum.GetValues<RadialGradientPosition>())
                            {
                                <option value="@position">@L[GradientPositionLabel(position)]</option>
                            }
                        </select>
                    </div>
                }
                </div>
                @ColorField("Gradient start", gradient.StartColor, value => SetGradientStart(node, value))
                @ColorField("Gradient end", gradient.EndColor, value => SetGradientEnd(node, value))
                <div class="pe-property-grid">
                    @RangeField("Start position", gradient.StartPosition, value => SetGradientStartPosition(node, value))
                    @RangeField("End position", gradient.EndPosition, value => SetGradientEndPosition(node, value))
                </div>
                </div>
            }
        }
        @if (Supports(capabilities, EditorCapabilitySet.Border))
        {
            @ColorField("Border color", CurrentStyle(node).BorderColor, value => SetBorderColor(node, value))
            @PixelField("Border width", CurrentStyle(node).BorderWidth, value => SetBorderWidth(node, value))
            @PixelField("Border radius", CurrentStyle(node).BorderRadius, value => SetBorderRadius(node, value))
        }
        @if (Supports(capabilities, EditorCapabilitySet.Typography))
        {
            @PixelField("Font size", CurrentStyle(node).FontSize, value => SetFontSize(node, value))
            <div class="pe-property-group">
                <label class="pe-property-label">@L["Font weight"]</label>
                <select class="w-full rounded-md"
                        value="@CurrentStyle(node).FontWeight"
                        @onchange="e => SetFontWeight(node, e.Value?.ToString())">
                    @foreach (var weight in Enum.GetValues<FontWeight>())
                    {
                        <option value="@weight">@L[weight.ToString()]</option>
                    }
                </select>
            </div>
            <div class="pe-property-group">
                <label class="pe-property-label">@L["Line height"]</label>
                <input type="number" min="0.5" max="5" step="0.1"
                       class="w-full rounded-md"
                       value="@CurrentStyle(node).LineHeight"
                       @oninput="e => SetLineHeight(node, e.Value?.ToString())" />
            </div>
            @PixelField("Letter spacing", CurrentStyle(node).LetterSpacing, value => SetLetterSpacing(node, value))
        }
        @if (Supports(capabilities, EditorCapabilitySet.Alignment))
        {
            <div class="pe-property-group">
                <label class="pe-property-label">@L["Text alignment"]</label>
                <select class="w-full rounded-md"
                        value="@CurrentStyle(node).TextAlignment"
                        @onchange="e => SetTextAlignment(node, e.Value?.ToString())">
                    @foreach (var alignment in Enum.GetValues<TextAlignment>())
                    {
                        <option value="@alignment">@L[alignment.ToString()]</option>
                    }
                </select>
            </div>
        }
        @if (Supports(capabilities, EditorCapabilitySet.Effects))
        {
            @if (CurrentStyle(node).Shadow is { Enabled: true } shadow)
            {
                @NumberField("Shadow horizontal offset", shadow.OffsetX, -200m, 200m, value => SetShadowNumber(node, value, ShadowValue.OffsetX))
                @NumberField("Shadow vertical offset", shadow.OffsetY, -200m, 200m, value => SetShadowNumber(node, value, ShadowValue.OffsetY))
                @NumberField("Shadow blur", shadow.Blur, 0m, 200m, value => SetShadowNumber(node, value, ShadowValue.Blur))
                @NumberField("Shadow spread", shadow.Spread, -100m, 100m, value => SetShadowNumber(node, value, ShadowValue.Spread))
                @ColorField("Shadow color", shadow.Color, value => SetShadowColor(node, value))
                <button type="button" class="btn btn-sm btn-outline"
                        @onclick="() => RemoveShadow(node)">
                    @L["Remove shadow"]
                </button>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline"
                        @onclick="() => SetShadow(node, new BoxShadow())">
                    @L["Add shadow"]
                </button>
            }
        }
        </section>
    </div>;

