        {
            SetShadow(node, shadow with { Color = color.Value });
        }
    }

    private void SetShadowNumber(
        NeoPageNode node,
        string? value,
        ShadowValue property)
    {
        var shadow = CurrentStyle(node).Shadow;
        if (shadow is null ||
            !decimal.TryParse(
                value,
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture,
                out var number))
        {
            return;
        }

        var updated = property switch
        {
            ShadowValue.OffsetX => shadow with
            {
                OffsetX = Math.Clamp(number, -200m, 200m)
            },
            ShadowValue.OffsetY => shadow with
            {
                OffsetY = Math.Clamp(number, -200m, 200m)
            },
            ShadowValue.Blur => shadow with
            {
                Blur = Math.Clamp(number, 0m, 200m)
            },
            ShadowValue.Spread => shadow with
            {
                Spread = Math.Clamp(number, -100m, 100m)
            },
            _ => shadow
        };

        SetShadow(node, updated);
    }

    private void SetShadow(NeoPageNode node, BoxShadow shadow)
    {
        SetStyleValue(
            node,
            style => style with { Shadow = shadow },
            style => style with { Shadow = shadow });
        NotifyChanged();
    }

    private enum ShadowValue
    {
        OffsetX,
        OffsetY,
        Blur,
        Spread
    }

