@namespace Aero.Cms.Shared.Pages.Manager.PageEditor.LivingStandard

<section class="aero-content-type-palette" aria-labelledby="aero-content-type-palette-title">
    <header class="aero-content-type-palette__header">
        <div>
            <h2 id="aero-content-type-palette-title">Structured content</h2>
            <p>Browse reusable content without copying it into the page.</p>
        </div>
        <button type="button"
                class="aero-content-type-palette__refresh"
                disabled="@IsLoading"
                title="Refresh content types"
                @onclick="RefreshAsync">
            ↻
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="aero-content-type-palette__error" role="alert">@ErrorMessage</div>
    }

    <label class="aero-content-type-palette__selector">
        <span>Content type</span>
        <select value="@SelectedAlias"
                disabled="@(IsLoading || ContentTypes.Count == 0)"
                @onchange="OnTypeChangedAsync">
            @if (ContentTypes.Count == 0)
            {
                <option value="">@(IsLoading ? "Loading content types…" : "No content types available")</option>
            }
            else
            {
                @foreach (var contentType in ContentTypes)
                {
                    <option @key="contentType.Alias" value="@contentType.Alias">@contentType.Name</option>
                }
            }
        </select>
    </label>

    @if (SelectedContentType is { } selectedType)
    {
        var listRequest = CreateListRequest(selectedType);
        var selectedItem = SelectedContentItem;

        <div class="aero-content-type-palette__summary">
            <strong>@selectedType.Name</strong>
            <code>@selectedType.Alias</code>
            @if (!string.IsNullOrWhiteSpace(selectedType.Description))
            {
                <p>@selectedType.Description</p>
            }
        </div>

        <div class="aero-content-type-palette__item-picker">
            <label class="aero-content-type-palette__selector">
                <span>Content item</span>
                <select value="@SelectedContentItemId"
                        disabled="@(IsItemsLoading || ContentItems.Count == 0)"
                        @onchange="OnItemChangedAsync">
                    @if (ContentItems.Count == 0)
                    {
                        <option value="">@(IsItemsLoading ? "Loading content items…" : "No content items available")</option>
                    }
                    else
                    {
                        @foreach (var itemOption in ContentItems)
                        {
                            <option @key="itemOption.Id" value="@itemOption.Id">
                                @itemOption.Title — /@itemOption.Slug (@itemOption.Culture)
                            </option>
                        }
                    }
                </select>
            </label>

            <div class="aero-content-type-palette__search">
                <input type="search"
                       value="@PendingItemSearchText"
                       placeholder="Search content items"
                       disabled="@IsItemsLoading"
                       @oninput="OnItemSearchInput" />
                <button type="button" disabled="@IsItemsLoading" @onclick="SearchItemsAsync">Search</button>
            </div>

            <div class="aero-content-type-palette__pager">
                <button type="button"
                        disabled="@(IsItemsLoading || !CanLoadPreviousItems)"
                        @onclick="LoadPreviousItemsAsync">
                    Previous
                </button>
                <span>Page @CurrentItemPage of @TotalItemPages · @ContentItemTotalCount total</span>
                <button type="button"
                        disabled="@(IsItemsLoading || !CanLoadNextItems)"
                        @onclick="LoadNextItemsAsync">
                    Next
                </button>
            </div>
        </div>

        <div class="aero-content-type-palette__section">
            <h3>Content scopes</h3>
            <div class="aero-content-type-palette__scope-grid" aria-label="Content scope types">
                <button type="button"
                        disabled="@(selectedType.Id <= 0)"
                        title="Click to add or drag a pageable content list onto the page"
                        data-aero-palette-kind="contentlist"
                        data-aero-palette-value="@listRequest.ToToken()"
                        @onclick="() => RequestAsync(listRequest)">
                    <strong>Content list</strong>
                    <span>Pageable entries</span>
                </button>
                @if (selectedItem is { } selectedScopeItem)
                {
                    var itemRequest = CreateItemRequest(selectedType, selectedScopeItem);
                    <button type="button"
                            disabled="@(selectedType.Id <= 0)"
                            title="Click to add or drag the selected content item onto the page"
                            data-aero-palette-kind="contentitem"
                            data-aero-palette-value="@itemRequest.ToToken()"
                            @onclick="() => RequestAsync(itemRequest)">
                        <strong>Content item</strong>
                        <span>Resolve @selectedScopeItem.Title</span>
                    </button>
                }
                else
                {
                    <button type="button" disabled title="Select a content item first">
                        <strong>Content item</strong>
                        <span>Select one entry</span>
                    </button>
                }
            </div>
        </div>

        <div class="aero-content-type-palette__section">
            <div class="aero-content-type-palette__section-heading">
                <h3>Fields</h3>
                <span>@selectedType.Fields.Count</span>
            </div>

            @if (selectedType.Fields.Count == 0)
            {
                <p class="aero-content-type-palette__empty">This content type has no fields.</p>
            }
            else
            {
                <div class="aero-content-type-palette__fields">
                    @foreach (var field in selectedType.Fields)
                    {
                        var fieldRequest = CreateFieldRequest(selectedType, field);
                        <button @key="field.Name"
                                type="button"
                                disabled="@(selectedType.Id <= 0)"
                                title="Click to add or drag this field inside a matching content scope"
                                data-aero-palette-kind="contentfield"
                                data-aero-palette-value="@fieldRequest.ToToken()"
                                @onclick="() => RequestAsync(fieldRequest)">
                            <span>
                                <strong>@(string.IsNullOrWhiteSpace(field.Label) ? field.Name : field.Label)</strong>
                                <code>@field.Name</code>
                            </span>
                            <span class="aero-content-type-palette__field-type">@field.FieldType</span>
                        </button>
                    }
                </div>
            }

            <p class="aero-content-type-palette__guidance">
                Lists repeat their article template with paging. Fields can only be placed inside the nearest scope of the same content type.
            </p>
        </div>
    }
</section>
