@page "/manager/page/editor"
@page "/manager/page/editor/{Id:long}"
@attribute [Authorize]

@using Aero.Cms.Abstractions.Enums
@using Aero.Cms.Shared.Pages.Manager.PageTree
@using Microsoft.AspNetCore.Components.Sections
@using Aero.Cms.Shared.Components
@using Aero.Cms.Shared.Pages.Manager.PageEditor.LivingStandard
@using Aero.Cms.Html

@* ── Orchestrator: composes sub-components and owns page-level state ── *@
<CascadingValue Value="this">
<nav class="pe-tabs" aria-label="@L["Page editor sections"]" style="background: var(--pe-bg-secondary); border-bottom: 1px solid var(--pe-border); display: flex; padding: 8px 8px 0; gap: 4px;">
    <button type="button" aria-pressed="@(ActiveTab == "editor")" class="@TabBtnClass("editor")"
            @onclick='() => ActiveTab = "editor"'>
        @L["Content Editor"]
    </button>
    <button type="button" aria-pressed="@(ActiveTab == "metadata")" class="@TabBtnClass("metadata")"
            @onclick='() => ActiveTab = "metadata"'>
        @L["Metadata"]
    </button>
    <button type="button" aria-pressed="@(ActiveTab == "translations")" class="@TabBtnClass("translations")"
            @onclick='() => ActiveTab = "translations"'>
        @L["Culture / Translations"]
    </button>
</nav>

@if (ActiveTab == "editor")
{
    @if (HtmlEditor is not null)
    {
        @if (!PreviewMode)
        {
            <PageEditorHeader Title="@PageTitle"
                              LastSaved="@LastSaved"
                              Author="@Author"
                              IsSaving="@IsSaving"
                              IsDirty="@(_pageState == PageState.Dirty)"
                              PublicationState="@PublicationState"
                              OnTitleChanged="OnTitleChanged"
                              OnTogglePreview="TogglePreview"
                              OnSave="SavePage"
                              OnPublish="PublishPage"
                              OnUnpublish="UnpublishPage" />

            <div class="pe-living-toolbar" role="toolbar" aria-label="Page editing commands">
                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm"
                        aria-keyshortcuts="Control+Z Meta+Z"
                        disabled="@(!HtmlEditor.CanUndo)" @onclick="UndoHtmlChangeAsync">
                    @L["Undo"]
                </button>
                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm"
                        aria-keyshortcuts="Control+Y Meta+Y Control+Shift+Z Meta+Shift+Z"
                        disabled="@(!HtmlEditor.CanRedo)" @onclick="RedoHtmlChangeAsync">
                    @L["Redo"]
                </button>
                <span class="pe-living-toolbar__divider" aria-hidden="true"></span>
                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm"
                        aria-keyshortcuts="Control+D Meta+D"
                        disabled="@(HtmlEditor.SelectedNodeId is null)" @onclick="DuplicateSelectedHtmlNodeAsync">
                    @L["Duplicate element"]
                </button>
                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm"
                        aria-keyshortcuts="Delete Backspace"
                        disabled="@(HtmlEditor.SelectedNodeId is null)" @onclick="RemoveSelectedHtmlNodeAsync">
                    @L["Delete element"]
                </button>
                <span class="pe-living-toolbar__divider" aria-hidden="true"></span>
                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="OpenMarkdownImportAsync">
                    @L["Import Markdown"]
                </button>
                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="OpenMarkdownExportAsync">
                    @L["Export Markdown"]
                </button>
                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="TogglePreview">
                    @L["Preview"]
                </button>
            </div>
        }

        <HtmlPageEditorCanvas Content="HtmlEditor.Content"
                              Catalog="HtmlCatalog"
                              ContentPolicy="HtmlContentPolicy"
                              SelectedNodeId="HtmlEditor.SelectedNodeId"
                              CompiledStyles="HtmlEditor.CompiledStyles"
                              PreviewMode="PreviewMode"
                              SelectionChanged="SelectHtmlNodeAsync"
                              NodeEditRequested="OpenHtmlRichTextForNodeAsync"
                              SortMoveRequested="MoveHtmlNodeAsync"
                              PaletteInsertRequested="InsertHtmlPaletteItemAsync"
                              EditorCommandRequested="ApplyHtmlEditorCommandAsync"
                              ElementRequested="AddHtmlElementAsync" />
    }
}
else if (ActiveTab == "metadata")
{
    <div class="p-6 rounded-lg shadow-sm m-4 space-y-6 max-w-4xl" style="background: var(--pe-bg-secondary); color: var(--pe-text-primary);">
        <h2 class="text-xl font-semibold mb-4" style="color: var(--pe-text-primary);">@L["Page Metadata"]</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Page Title"]</label>
                    <input type="text" class="w-full rounded-md shadow-sm sm:text-sm"
                           style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                           value="@PageTitle" @oninput="e => OnTitleChanged(e.Value?.ToString() ?? string.Empty)" placeholder="@L["e.g. About Us"]" />
                </div>
                <div>
                    <div class="mb-1 flex items-center justify-between gap-3">
                        <label class="block text-sm font-medium" style="color: var(--pe-text-secondary);">@L["URL Slug"]</label>
                        <button type="button"
                                class="text-xs font-medium"
                                style="color: var(--pe-primary);"
                                @onclick="UseTitleForSlug">
                            @L["Use page title"]
                        </button>
                    </div>
                    <div class="flex items-center" style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border); border-radius: 0.375rem;">
                        @if (ParentId.HasValue && ParentId > 0)
                        {
                            <span class="inline-flex items-center px-2 py-1 text-xs font-mono rounded-l-md"
                                  style="background: var(--pe-primary); color: white; flex-shrink: 0;">
                                @ParentSlugPrefix/
                            </span>
                        }
                        <input type="text" class="flex-1 rounded-r-md shadow-none border-0 text-sm font-mono"
                               style="background: transparent; color: var(--pe-primary);"
                               value="@PageSlug"
                               @oninput="e => OnSlugChanged(e.Value?.ToString() ?? string.Empty)"
                               @onblur="_ => NormalizePageSlug()"
                               placeholder="@L["e.g. about-us"]" />
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Parent Page"]</label>
                    <PageTreeSelect @bind-SelectedParentId="ParentId"
                                    @bind-SelectedParentId:after="MarkRouteDirty"
                                    ExcludePageId="@Id"
                                    Placeholder="@L["(root — no parent)"]" />
                    <PathPreview ParentId="ParentId" Slug="@PageSlug" ExcludePageId="@Id" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Summary / Excerpt"]</label>
                    <textarea rows="3" class="w-full rounded-md shadow-sm sm:text-sm"
                              style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                              @bind="Summary" @bind:after="MarkDirty" placeholder="@L["Brief description..."]"></textarea>
                </div>
                <div class="flex items-center gap-2 pt-2">
                    <input type="checkbox" id="metaChkNav" @bind="ShowInNavMenu" @bind:after="MarkDirty" class="h-4 w-4 rounded"
                           style="background: var(--pe-bg-primary); border-color: var(--pe-border); color: var(--pe-primary);" />
                    <label for="metaChkNav" class="text-sm font-medium" style="color: var(--pe-text-secondary);">@L["Show in Navigation Menu"]</label>
                </div>
                <div class="flex items-center gap-2 pt-2">
                    <input type="checkbox" id="metaChkHeaderNav" @bind="ShowHeaderNavigation" @bind:after="MarkDirty" class="h-4 w-4 rounded"
                           style="background: var(--pe-bg-primary); border-color: var(--pe-border); color: var(--pe-primary);" />
                    <label for="metaChkHeaderNav" class="text-sm font-medium" style="color: var(--pe-text-secondary);">@L["Show Site Navigation"]</label>
                </div>
                <div class="flex items-center gap-2 pt-2">
                    <input type="checkbox" id="metaChkFooter" @bind="HideFooter" @bind:after="MarkDirty" class="h-4 w-4 rounded"
                           style="background: var(--pe-bg-primary); border-color: var(--pe-border); color: var(--pe-primary);" />
                    <label for="metaChkFooter" class="text-sm font-medium" style="color: var(--pe-text-secondary);">@L["Hide Footer"]</label>
                </div>
                <div class="flex items-center gap-2 pt-2">
                    <input type="checkbox" id="metaChkChat" @bind="ShowChatAgent" @bind:after="MarkDirty" class="h-4 w-4 rounded"
                           style="background: var(--pe-bg-primary); border-color: var(--pe-border); color: var(--pe-primary);" />
                    <label for="metaChkChat" class="text-sm font-medium" style="color: var(--pe-text-secondary);">@L["Show Chat Agent"]</label>
                </div>
            </div>
            
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["SEO Meta Title"]</label>
                    <input type="text" class="w-full rounded-md shadow-sm sm:text-sm"
                           style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                           @bind="SeoTitle" @bind:after="MarkDirty" placeholder="@L["Custom Browser Title"]" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["SEO Meta Description"]</label>
                    <textarea rows="3" class="w-full rounded-md shadow-sm sm:text-sm"
                              style="background: var(--pe-bg-primary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                              @bind="SeoDescription" @bind:after="MarkDirty" placeholder="@L["Description for search engines..."]"></textarea>
                </div>
            </div>
        </div>

        <div class="mt-8 pt-6 border-t" style="border-top-color: var(--pe-border);">
            <h3 class="text-lg font-medium mb-4" style="color: var(--pe-text-primary);">@L["Publishing"]</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4 rounded-md border" 
                 style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                <div>
                    <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Status"]</span>
                    @if (PublicationState == ContentPublicationState.Published)
                    {
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium" 
                              style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                            @L["Published"]
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium" 
                              style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                            @L["Draft"]
                        </span>
                    }
                </div>
                <div>
                    <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Date Created"]</span>
                    <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@(LoadedPage?.CreatedAt.ToShortDateString() ?? "-")</span>
                </div>
                <div>
                    <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Date Modified"]</span>
                    <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@(LoadedPage?.UpdatedAt.ToShortDateString() ?? "-")</span>
                </div>
            </div>
        </div>
    </div>
}
else if (ActiveTab == "translations")
{
    <div class="p-6 rounded-lg shadow-sm m-4 space-y-6 max-w-5xl" style="background: var(--pe-bg-secondary); color: var(--pe-text-primary);">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
            <div>
                <h2 class="text-xl font-semibold" style="color: var(--pe-text-primary);">@L["Culture / Translations"]</h2>
                <p class="text-sm mt-1" style="color: var(--pe-text-muted);">
                    @if (Id.HasValue)
                    {
                        @L["Manage localized versions for this page."]
                    }
                    else
                    {
                        @L["Save this page before creating localized versions."]
                    }
                </p>
            </div>
            @if (LoadedPage?.TranslationGroupId is { } translationGroupId)
            {
                <span class="text-xs font-mono px-2 py-1 rounded"
                      style="background: var(--pe-bg-primary); color: var(--pe-text-muted); border: 1px solid var(--pe-border);">
                    Group @translationGroupId
                </span>
            }
        </div>

        @if (!Id.HasValue)
        {
            <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                <p class="text-sm" style="color: var(--pe-text-muted);">@L["Save the page before creating translation variants."]</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                    <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Current Variant"]</span>
                    <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@FormatCulture(LoadedPage?.Culture)</span>
                </div>
                <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                    <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Default Culture"]</span>
                    <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@FormatCulture(CurrentSite?.DefaultCulture)</span>
                </div>
                <div class="rounded-md border p-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                    <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--pe-text-muted);">@L["Coverage"]</span>
                    <span class="text-sm font-medium" style="color: var(--pe-text-primary);">@L["{0} of {1} site cultures", PageCultureVariants.Count, SupportedCultures.Count]</span>
                </div>
            </div>

            <div class="rounded-md border overflow-hidden" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                <div class="px-4 py-3 border-b flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3" style="border-color: var(--pe-border);">
                    <div>
                        <h3 class="text-sm font-semibold" style="color: var(--pe-text-primary);">@L["Localized Versions"]</h3>
                        <p class="text-xs mt-1" style="color: var(--pe-text-muted);">@L["Open a variant to edit its translated title, slug, metadata, and content."]</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <button type="button"
                                class="pe-btn pe-btn-success pe-btn-sm"
                                disabled="@(IsBulkPublishingTranslations || PageCultureVariants.Count == 0)"
                                @onclick="PublishAllTranslationsAsync">
                            @(IsBulkPublishingTranslations ? L["Working..."] : L["Publish All"])
                        </button>
                        <button type="button"
                                class="pe-btn pe-btn-secondary pe-btn-sm"
                                disabled="@(IsBulkPublishingTranslations || PageCultureVariants.Count == 0)"
                                @onclick="UnpublishAllTranslationsAsync">
                            @(IsBulkPublishingTranslations ? L["Working..."] : L["Unpublish All"])
                        </button>
                        @if (AvailableTranslationCultures.Any())
                        {
                            <span class="rounded bg-yellow-100 px-2 py-1 text-xs font-semibold text-yellow-800">
                                @L["{0} missing", AvailableTranslationCultures.Count()]
                            </span>
                        }
                        else
                        {
                            <span class="rounded px-2 py-1 text-xs font-semibold" style="background: var(--pe-bg-secondary); color: var(--pe-text-secondary);">
                                @L["Complete"]
                            </span>
                        }
                        <button type="button"
                                class="pe-btn pe-btn-primary pe-btn-sm"
                                disabled="@IsTranslatingAll"
                                @onclick="TranslateAllCulturesAsync">
                            @(IsTranslatingAll ? L["Translating..."] : L["AI Translate All"])
                        </button>
                        <label class="inline-flex items-center gap-2 text-xs" style="color: var(--pe-text-secondary);">
                            <input type="checkbox" @bind="OverwriteExistingTranslations" />
                            @L["Overwrite existing translations"]
                        </label>
                    </div>
                </div>

                @if (IsLoadingTranslations)
                {
                    <div class="p-4 text-sm" style="color: var(--pe-text-muted);">@L["Loading translations..."]</div>
                }
                else if (PageCultureVariants.Count == 0)
                {
                    <div class="p-4 text-sm" style="color: var(--pe-text-muted);">@L["No translation variants found."]</div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead style="background: var(--pe-bg-tertiary); color: var(--pe-text-muted);">
                                <tr>
                                    <th class="px-4 py-2 text-left font-semibold">@L["Culture"]</th>
                                    <th class="px-4 py-2 text-left font-semibold">@L["Title"]</th>
                                    <th class="px-4 py-2 text-left font-semibold">@L["Path"]</th>
                                    <th class="px-4 py-2 text-left font-semibold">@L["Status"]</th>
                                    <th class="px-4 py-2 text-left font-semibold">@L["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var variant in PageCultureVariants)
                                {
                                    var isCurrent = LoadedPage?.Id == variant.Id;
                                    var isDefault = string.Equals(CurrentSite?.DefaultCulture, variant.Culture, StringComparison.OrdinalIgnoreCase);
                                    <tr class="border-t @(isCurrent ? "bg-blue-50" : "")" style="border-color: var(--pe-border); color: var(--pe-text-primary);">
                                        <td class="px-4 py-3">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <span class="font-semibold">@FormatCulture(variant.Culture)</span>
                                                @if (isDefault)
                                                {
                                                    <span class="rounded bg-blue-100 px-2 py-0.5 text-xs font-semibold text-blue-800">@L["Default"]</span>
                                                }
                                                @if (isCurrent)
                                                {
                                                    <span class="rounded px-2 py-0.5 text-xs font-semibold" style="background: var(--pe-bg-secondary); color: var(--pe-text-secondary);">@L["Current"]</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="px-4 py-3">@variant.Title</td>
                                        <td class="px-4 py-3 font-mono text-xs" style="color: var(--pe-text-muted);">@variant.Path</td>
                                        <td class="px-4 py-3">
                                            @if (variant.PublicationState == ContentPublicationState.Published)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">@L["Published"]</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">@L["Draft"]</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="flex gap-1">
                                                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="() => OpenPublicTranslation(variant)">
                                                    @L["Open"]
                                                </button>
                                                <button type="button"
                                                        class="pe-btn pe-btn-ghost pe-btn-sm"
                                                        disabled="@(isCurrent || TranslatingCultures.Contains(variant.Culture))"
                                                        @onclick="() => TranslateCultureAsync(variant)">
                                                    @(TranslatingCultures.Contains(variant.Culture) ? L["Translating..."] : L["AI Translate"])
                                                </button>
                                                <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" disabled="@isCurrent" @onclick="() => OpenTranslation(variant.Id)">
                                                    @L["Edit"]
                                                </button>
                                                @if (!isDefault)
                                                {
                                                    <button type="button" class="pe-btn pe-btn-ghost pe-btn-sm" @onclick="() => DeleteTranslationAsync(variant)">
                                                        @L["Delete"]
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (AvailableTranslationCultures.Any())
            {
                <div class="rounded-md border p-4 space-y-4" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                    <div>
                        <h3 class="text-sm font-semibold" style="color: var(--pe-text-primary);">@L["Add Translation"]</h3>
                        <p class="text-xs mt-1" style="color: var(--pe-text-muted);">@L["Creates a draft copy that you can localize after opening the new variant."]</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-[220px_1fr_auto] gap-3 items-end">
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Target Culture"]</label>
                            <select class="w-full rounded-md shadow-sm sm:text-sm"
                                    style="background: var(--pe-bg-secondary); color: var(--pe-text-primary); border: 1px solid var(--pe-border);"
                                    @bind="SelectedTranslationCulture">
                                @foreach (var culture in AvailableTranslationCultures)
                                {
                                    <option value="@culture">@FormatCulture(culture)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1" style="color: var(--pe-text-secondary);">@L["Translated Slug"]</label>
                            <input type="text" class="w-full rounded-md shadow-sm sm:text-sm font-mono"
                                   style="background: var(--pe-bg-secondary); color: var(--pe-primary); border: 1px solid var(--pe-border);"
                                   @bind="TranslationSlug" @bind:event="oninput" placeholder="@PageSlug" />
                            <p class="mt-1 text-xs" style="color: var(--pe-text-muted);">@L["Leave blank to copy the current slug, or enter the translated URL segment."]</p>
                        </div>
                        <button type="button"
                                class="pe-btn pe-btn-primary pe-btn-sm"
                                disabled="@IsCreatingTranslation"
                                @onclick="CreateTranslationAsync">
                            @(IsCreatingTranslation ? L["Creating..."] : L["Create Translation"])
                        </button>
                    </div>
                </div>
            }
        }
    </div>
}

@* Right sidebar content *@
<SectionContent SectionName="RightSidebar">
    <AeroSidebar Title="@(HtmlEditor.SelectedNode is null ? L["Elements"] : L["Inspector"])"
                 Side="SidebarSide.Right"
                 IsCollapsed="RightSidebarCollapsed"
                 IsCollapsedChanged="OnRightSidebarCollapsedChanged">
        @if (ActiveTab == "editor")
        {
            <HtmlPageEditorOutline Content="HtmlEditor.Content"
                                   SelectedNodeId="HtmlEditor.SelectedNodeId"
                                   SelectionChanged="SelectHtmlNodeAsync" />

            @if (HtmlEditor.SelectedNode is { } selectedNode
                && SelectedHtmlDefinition is { } selectedDefinition)
            {
                <HtmlElementPropertyPanel Node="selectedNode"
                                          Definition="selectedDefinition"
                                          ErrorMessage="HtmlPropertyError"
                                          PropertiesChanged="ApplyHtmlPropertiesAsync"
                                          SelectionCleared="ClearHtmlSelectionAsync"
                                          RichTextRequested="OpenHtmlRichTextEditorAsync"
                                          CollectionActionRequested="ApplyHtmlCollectionActionAsync"
                                          DuplicateRequested="DuplicateSelectedHtmlNodeAsync"
                                          RemoveRequested="RemoveSelectedHtmlNodeAsync"
                                          MediaRequested="OpenHtmlMediaSelectorAsync" />
            }
            else
            {
                <HtmlElementPalette Elements="HtmlElementDefinitions"
                                    ElementRequested="AddHtmlElementAsync"
                                    LayoutRequested="AddHtmlLayoutAsync"
                                    ComponentRequested="AddHtmlComponentAsync"
                                    ImportRequested="OpenHtmlFragmentImportAsync" />
            }
        }
    </AeroSidebar>
</SectionContent>

@if (HtmlRichTextEditorOpen && HtmlEditor.SelectedNode is { } richTextNode)
{
    <HtmlRichTextEditorDialog @key="richTextNode.NodeId"
                              Node="richTextNode"
                              ErrorMessage="HtmlRichTextError"
                              Closed="CloseHtmlRichTextEditorAsync"
                              ContentSaved="ApplyHtmlRichTextAsync" />
}

@if (HtmlFragmentImportOpen)
{
    <HtmlFragmentImportDialog ErrorMessage="HtmlFragmentImportError"
                              ImportRequested="ImportHtmlFragmentAsync"
                              Closed="CloseHtmlFragmentImportAsync" />
}

@if (MarkdownInterchangeOpen)
{
    <MarkdownInterchangeDialog Mode="MarkdownMode"
                                 InitialValue="MarkdownInterchangeText"
                                 ErrorMessage="MarkdownInterchangeError"
                                 ImportRequested="ImportMarkdownAsync"
                                 Closed="CloseMarkdownInterchangeAsync" />
}

<MediaSelectorModal Show="HtmlMediaSelectorOpen"
                    MultiSelect="false"
                    OnClose="CloseHtmlMediaSelectorAsync"
                    OnConfirm="ApplyHtmlMediaSelectionAsync" />

@* ── Toast notifications ─────────────────────────────────── *@
<div class="pe-toast-container" aria-live="polite" aria-label="@L["Page editor notifications"]">
    @foreach (var toast in Toasts)
    {
        <div class="pe-toast @toast.Type" role="@(toast.Type == "error" ? "alert" : "status")">
            @if (toast.Type == "success")
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            }
            else if (toast.Type == "error")
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="15" y1="9" x2="9" y2="15"/>
                    <line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
            }
            else
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="16" x2="12" y2="12"/>
                    <line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
            }
            <span>@toast.Message</span>
            <button type="button"
                    class="pe-toast__close"
                    aria-label="@L["Dismiss notification"]"
                    @onclick="() => RemoveToast(toast.Id)">×</button>
        </div>
    }
</div>
@* ... (Toasts and Modals retained) ... *@

@* Preview overlay (modal over entire manager) *@
<PreviewOverlay Visible="@PreviewMode"
                OnClose="TogglePreview"
                FrameUrl="@PreviewFrameUrl"
                FrameDocument="@PreviewFrameDocument"
                UrlBarText="@(!string.IsNullOrWhiteSpace(PreviewFrameUrl) ? PreviewFrameUrl : PreviewFragmentUrl)"
                Error="@PreviewError"
                IsLoading="@IsPreviewRendering"
                SuppressBrowserLinkErrors="true"
                Title="@L["Page preview"]" />

</CascadingValue>

@* Page editor root ends here. *@

