@namespace Aero.Cms.Shared.Pages.Manager.PageEditor

<div class="pe-block-wrapper @(IsSelected ? "selected" : "") @(Dragging ? "dragging" : "") @(IsDragOver ? "drag-over" : "")"
     @onclick="() => OnSelect.InvokeAsync()"
     draggable="true"
    @ondragstart='() => OnDragStart.InvokeAsync(new DragStartEventArgs { EditorId = BlockEditorId, Index = Index })'
    @ondragover='() => OnDragOver.InvokeAsync(Index)'
    @ondragover:preventDefault
    @ondrop='() => OnDrop.InvokeAsync(Index)'
    @ondrop:stopPropagation>

    @* Toolbar *@
    @if (IsSelected)
    {
        <div class="pe-block-toolbar">
            <button class="pe-toolbar-btn" title="Move up"
                    disabled="@(Index == 0)"
                    @onclick:stopPropagation="true"
                    @onclick="() => OnMoveUp.InvokeAsync(Index)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="18 15 12 9 6 15"/>
                </svg>
            </button>
            <button class="pe-toolbar-btn" title="Move down"
                    disabled="@(Index == TotalCount - 1)"
                    @onclick:stopPropagation="true"
                    @onclick="() => OnMoveDown.InvokeAsync(Index)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </button>
            <button class="pe-toolbar-btn" title="Duplicate"
                    @onclick:stopPropagation="true"
                    @onclick="() => OnDuplicate.InvokeAsync(Index)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
            </button>
            <button class="pe-toolbar-btn delete" title="Delete"
                    @onclick:stopPropagation="true"
                    @onclick="() => OnDelete.InvokeAsync(Index)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                </svg>
            </button>
        </div>
    }

    <div class="pe-block-content">
        @ChildContent
    </div>
</div>
