@using Aero.Cms.Abstractions.Http.Clients
@using Aero.Core
@inject IMediaHttpClient MediaClient
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject IStringLocalizer<Aero.Cms.Shared.Localization.ManagerResource> L

<div class="media-detail-dialog overflow-hidden" style="background: var(--pe-bg-secondary);">
    @if (media == null)
    {
        <div class="h-96 flex items-center justify-center">
            <RadzenProgressBar Circular="true" Value="100" Mode="ProgressBarMode.Indeterminate" Style="@("width: 32px; height: 32px")" />
        </div>
    }
    else
    {
        <div class="flex h-[600px]">
            <!-- Left: Preview -->
            <div class="w-1/2 flex flex-col border-r" style="background: var(--pe-bg-primary); border-color: var(--pe-border);">
                <div class="flex-1 flex items-center justify-center p-8 overflow-hidden">
                    @if (IsImage(media.MimeType))
                    {
                        <img src="@media.Url" class="max-w-full max-h-full object-contain rounded-lg shadow-2xl shadow-black/10 transition-transform hover:scale-105 duration-500" alt="@media.AltText" />
                    }
                    else
                    {
                        <div class="flex flex-col items-center gap-4">
                            <div class="w-24 h-24 rounded-3xl shadow-xl flex items-center justify-center" style="background: var(--pe-bg-secondary);">
                                <RadzenIcon Icon="@("insert_drive_file")" class="w-12 h-12 text-gray-300" />
                            </div>
                            <span class="text-xs font-bold text-gray-400 uppercase tracking-widest">@media.MimeType</span>
                        </div>
                    }
                </div>
                
                <div class="p-6 backdrop-blur-sm border-t" style="background: color-mix(in srgb, var(--pe-bg-secondary) 50%, transparent); border-color: var(--pe-border);">
                     <div class="flex items-center justify-between mb-4">
                        <div class="flex flex-col">
                             <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">@L["File Info"]</span>
                            <span class="text-xs font-bold mt-1" style="color: var(--pe-text-primary);">@media.FileName</span>
                        </div>
                        <div class="px-3 py-1 rounded-full border" style="background: color-mix(in srgb, var(--pe-primary) 15%, transparent); border-color: color-mix(in srgb, var(--pe-primary) 25%, transparent);">
                            <span class="text-[10px] font-bold" style="color: var(--pe-primary);">@FormatSize(media.FileSize)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Metadata & Actions -->
            <div class="w-1/2 flex flex-col" style="background: var(--pe-bg-secondary);">
                <div class="p-8 flex-1 overflow-y-auto space-y-8 scrollbar-thin">
                    <div class="space-y-6">
                        <div class="space-y-2">
                             <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">@L["Public Access URL"]</label>
                             <div class="flex items-center gap-2">
                                 <RadzenTextBox Value="@media.Url" ReadOnly="true" class="flex-1 border-none rounded-xl text-xs font-mono" style="background: var(--pe-bg-tertiary);" />
                                 <RadzenButton Icon="@("link")" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" class="rounded-xl" Click="@(() => OpenUrl(media.Url))" />
                                 <RadzenButton Icon="@("content_copy")" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" class="rounded-xl" Click="@(() => CopyToClipboard(media.Url))" />
                             </div>
                        </div>

                        <div class="space-y-4">
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">@L["Display Name"]</label>
                                <RadzenTextBox @bind-Value="@fileName" class="w-full border-none rounded-xl text-sm px-4 py-2" style="background: var(--pe-bg-tertiary);" />
                            </div>

                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">@L["Alt Text (SEO)"]</label>
                                <RadzenTextBox @bind-Value="@altText" Placeholder="@L["Describe this asset for accessibility..."]" class="w-full border-none rounded-xl text-sm px-4 py-2" style="background: var(--pe-bg-tertiary);" />
                            </div>

                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">@L["Description"]</label>
                                <RadzenTextArea @bind-Value="@description" Rows="4" Placeholder="@L["Internal notes or context..."]" class="w-full border-none rounded-xl text-sm px-4 py-2" style="background: var(--pe-bg-tertiary);" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-8 border-t flex items-center justify-between" style="border-color: var(--pe-border);">
                    <RadzenButton Text="@L["Delete Asset"]" Icon="@("delete")" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@OnDelete" class="text-xs font-bold" />
                    
                    <div class="flex items-center gap-3">
                        <RadzenButton Text="@L["Discard"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => DialogService.Close())" class="text-xs font-bold px-4" />
                        <RadzenButton Text="@L["Apply Changes"]" Icon="@("save")" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" 
                                     Click="@OnUpdate" class="rounded-xl px-6 shadow-xl shadow-indigo-500/20 text-xs font-bold py-2.5" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The ID of the media asset to display details for.
    /// </summary>
    [Parameter] public long MediaId { get; set; }

    MediaDetail? media;

    // Local mutable state for record binding
    string? fileName;
    string? altText;
    string? description;

    /// <summary>
    /// Initializes the component by loading media details.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var result = await MediaClient.GetByIdAsync(MediaId);
        if (result is Result<MediaDetail, AeroError>.Ok ok)
        {
            media = ok.Value;
            fileName = media.FileName;
            altText = media.AltText;
            description = media.Description;
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, L["Error"], L["Could not load media details"]);
            DialogService.Close();
        }
    }

    async Task OnUpdate()
    {
        if (media == null) return;

        var req = new UploadMediaRequest(fileName ?? media.FileName, media.MimeType, media.FileSize, altText, description, media.ParentId);
        var res = await MediaClient.UpdateAsync(MediaId, req);

        if (res is Result<MediaDetail, AeroError>.Ok)
        {
            NotificationService.Notify(NotificationSeverity.Success, L["Updated"], L["Media metadata saved successfully"]);
            DialogService.Close(true);
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, L["Fail"], L["Failed to update media record"]);
        }
    }

    async Task OnDelete()
    {
        var confirm = await DialogService.Confirm(L["Permanently delete this asset? This cannot be undone."], L["Delete Media"], 
            new ConfirmOptions { OkButtonText = L["Delete Forever"], CancelButtonText = L["Keep Asset"] });

        if (confirm == true)
        {
            var res = await MediaClient.DeleteAsync(MediaId);
            if (res is Result<bool, AeroError>.Ok)
            {
                NotificationService.Notify(NotificationSeverity.Success, L["Deleted"], L["Asset removed from library"]);
                DialogService.Close(true);
            }
        }
    }

    async Task CopyToClipboard(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        NotificationService.Notify(NotificationSeverity.Info, L["Copied"], L["URL copied to clipboard"]);
    }

    async Task OpenUrl(string url)
    {
        await JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    bool IsImage(string mimeType) => mimeType?.StartsWith("image/") == true;

    string FormatSize(long bytes)
    {
        string[] suffix = { "B", "KB", "MB", "GB", "TB" };
        int i;
        double dblSByte = bytes;
        for (i = 0; i < suffix.Length && bytes >= 1024; i++, bytes /= 1024)
        {
            dblSByte = bytes / 1024.0;
        }
        return $"{dblSByte:0.##} {suffix[i]}";
    }
}
