<Project>
	<!--
	  Aero.Cms.Abstractions and Aero.Cms.Shared have different server and browser
	  compile surfaces. Keep the AeroCmsBrowserClient project instances isolated
	  so a WASM build cannot overwrite the server assembly (or its generated files)
	  in a parallel graph build.
	-->
	<PropertyGroup Condition="'$(AeroCmsBrowserClient)' == 'true' AND '$(UseArtifactsOutput)' == 'true' AND
		('$(MSBuildProjectName)' == 'Aero.Cms.Abstractions' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Client' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Shared' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Modules.Commerce.Client' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Web.Client')">
		<!--
		  The SDK's artifact layout keys output paths by ArtifactsProjectName. A
		  browser compilation is a separate project instance, so it needs a
		  distinct key from the server instance. Directory.Build.props loads before
		  the SDK supplies its default, which also lets us reject a caller-provided
		  global key that would collapse different browser projects into one path.
		-->
		<AeroCmsBrowserArtifactsProjectNameWasProvided Condition="'$(ArtifactsProjectName)' != ''">true</AeroCmsBrowserArtifactsProjectNameWasProvided>
		<ArtifactsProjectName Condition="'$(ArtifactsProjectName)' == ''">$(MSBuildProjectName).Browser</ArtifactsProjectName>
	</PropertyGroup>
	<PropertyGroup Condition="('$(MSBuildProjectName)' == 'Aero.Cms.Abstractions' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Client' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Shared' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Modules.Commerce.Client')">
		<DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
	</PropertyGroup>
	<PropertyGroup Condition="'$(AeroCmsBrowserClient)' == 'true' AND
		('$(MSBuildProjectName)' == 'Aero.Cms.Abstractions' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Client' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Shared' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Modules.Commerce.Client' OR
		 ('$(MSBuildProjectName)' == 'Aero.Cms.Web.Client' AND '$(UseArtifactsOutput)' == 'true'))">
		<!-- Static Web Assets re-enters the browser project instance after discovery. -->
		<StaticWebAssetsAdditionalBuildProperties>$(StaticWebAssetsAdditionalBuildProperties);AeroCmsBrowserClient=true</StaticWebAssetsAdditionalBuildProperties>
		<StaticWebAssetsAdditionalPublishProperties>$(StaticWebAssetsAdditionalPublishProperties);AeroCmsBrowserClient=true</StaticWebAssetsAdditionalPublishProperties>
	</PropertyGroup>
	<PropertyGroup Condition="'$(AeroCmsBrowserClient)' == 'true' AND '$(UseArtifactsOutput)' != 'true' AND
		('$(MSBuildProjectName)' == 'Aero.Cms.Abstractions' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Client' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Shared' OR
		 '$(MSBuildProjectName)' == 'Aero.Cms.Modules.Commerce.Client')">
		<BaseOutputPath>bin\browser\</BaseOutputPath>
		<BaseIntermediateOutputPath>obj\browser\</BaseIntermediateOutputPath>
	</PropertyGroup>
	<PropertyGroup>
		<!--
		  The browser-specific Shared/Abstractions graph is a distinct MSBuild
		  graph instance. Its ordinary dependencies may also be top-level solution
		  projects, so give the recursive browser dependency graph separate output
		  paths to prevent concurrent compiler writes during a clean build.
		-->
		<AeroCmsBrowserDependencyProperties Condition="'$(AeroCmsBrowserClient)' == 'true' AND '$(UseArtifactsOutput)' != 'true'">OutputPath=bin\browser-dependencies\$(Configuration)\$(TargetFramework)\;IntermediateOutputPath=obj\browser-dependencies\$(Configuration)\$(TargetFramework)\</AeroCmsBrowserDependencyProperties>
	</PropertyGroup>

	<PropertyGroup>
		<!--
      Skip TargetFramework for MAUI projects — they self-define multi-targeted
      TargetFrameworks (net10.0-android, net10.0-ios, net10.0-maccatalyst, etc.)
      and setting this would clobber that.
    -->
		<TargetFramework
			Condition="'$(UseMaui)' != 'true' AND
                 '$(ManageTargetFrameworkIndependently)' != 'true' AND
                 '$(TargetFrameworks)' == ''">net10.0</TargetFramework>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup Label="Package information">
		<Version>0.0.9.4-alpha</Version>
		<Authors>Aero Cms</Authors>
		<Company>Microbian Systems</Company>
		<Copyright>Copyright (c) 2025 Microbians</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>cms mvc razorpages aspnetcore</PackageTags>
		<PackageIcon>aero-logo-new.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)../assets/aero-logo-new.png" Pack="true" PackagePath="\" />
		<None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<PropertyGroup>
		<PackageProjectUrl>https://github.com/microbian-systems/Aero.core</PackageProjectUrl>
		<RepositoryUrl>https://github.com/microbian-systems/Aero.core</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup Condition="'$(AeroCmsSkipWebCoreReference)' != 'true' AND '$(MSBuildProjectName)' != 'Aero.Cms.Web.Core' AND '$(MSBuildProjectName)' != 'Aero.Cms.Core' AND '$(MSBuildProjectName)' != 'Aero.Cms.Modules.Modules' AND ($(MSBuildProjectName.StartsWith('Aero.Cms.Modules')) OR $(MSBuildProjectName.StartsWith('Aero.Cms.Banners')) OR $(MSBuildProjectName.StartsWith('Aero.Cms.CookiePolicy')))">
		<ProjectReference Include="$(MSBuildThisFileDirectory)Aero.Cms.Web.Core\Aero.Cms.Web.Core.csproj" />
	</ItemGroup>


	<!--
    Source Generator & Analyzer: Wire Aero.Cms.SourceGenerators to every project
    in src/ so ModuleManifestGenerator, WolverineHandlerGenerator, and AERO002 analyzer
    run where needed. Each generator activates only when its conditions are met:
    - ModuleManifestGenerator: activates when [Module] attribute is found
    - WolverineHandlerGenerator: activates when [WolverineHandler] attribute is found
    - HostModuleCatalogGenerator: activates only in a C# assembly that explicitly applies
      [assembly: AeroCmsHostCatalogGeneration]
  -->
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Aero.Cms.SourceGenerators'">
		<ProjectReference Include="$(MSBuildThisFileDirectory)Aero.Cms.SourceGenerators\Aero.Cms.SourceGenerators.csproj"
			OutputItemType="Analyzer"
			GlobalPropertiesToRemove="AeroCmsBrowserClient"
			ReferenceOutputAssembly="false" />
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\AeroDB\src\AeroDB.Analyzers\AeroDB.Analyzers.csproj"
			OutputItemType="Analyzer"
			GlobalPropertiesToRemove="AeroCmsBrowserClient"
			ReferenceOutputAssembly="false" />
	</ItemGroup>

	<Target Name="RejectAeroCmsBrowserArtifactProjectNameCollision"
			BeforeTargets="Restore;PrepareForBuild"
			Condition="'$(AeroCmsBrowserClient)' == 'true' AND '$(UseArtifactsOutput)' == 'true' AND '$(AeroCmsBrowserArtifactsProjectNameWasProvided)' == 'true'">
		<Error Text="Artifact-mode AeroCMS browser builds cannot use a caller-supplied ArtifactsProjectName. The browser instance derives a unique per-project name to keep it isolated from server and other browser builds." />
	</Target>

</Project>
