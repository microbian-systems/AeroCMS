@page
@section cssPartial {
    <link rel="stylesheet" href="/_content/Aero.Cms.Modules.Posts/css/blog.css" />
}
@using Aero.Cms.Modules.Posts.Models
@using Aero.Cms.Shared.Localization
@using Aero.Core
@using Aero.Services.Images

@inject Aero.Services.Images.IStaticPhotosClient StaticPhotos

@model Aero.Cms.Modules.Posts.Areas.Blog.Pages.PostsDetailPageModel

@{
    ViewBag.Title = (Model.Post?.SeoTitle ?? Model.Post?.Title ?? "Blog Post") + " | Aero CMS";
    var post = Model.Post!;
}

@section headPartial {
    <link rel="canonical" href="@Model.CanonicalUrl" />
    @foreach (var link in Model.AlternateLinks)
    {
        <link rel="alternate" hreflang="@link.Hreflang" href="@link.Href" />
    }
}

@{
    var headerImageUrl = post.ImageUrl ?? StaticPhotos.GetPhotoUrl("blurred", "1200x630");
}
<article class="blog-article mx-auto px-4 py-8 sm:px-6 lg:px-8">
    @* Header Image *@
    <div class="mb-10 overflow-hidden rounded-2xl shadow-2xl">
        <img src="@headerImageUrl"
             alt="Header background"
             class="w-full h-80 object-cover transition-transform duration-700 hover:scale-110"/>
    </div>

    @* Header Section *@
    <header class="mb-10">
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4 leading-tight tracking-tight">
            @post.Title
        </h1>
        
        @if (!string.IsNullOrEmpty(post.Excerpt))
        {
            <p class="text-xl text-gray-600 italic mb-6 leading-relaxed">
                @post.Excerpt
            </p>
        }
        
        @* Meta information row *@
        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500 border-t border-b border-gray-200 py-4">
            @if (post.PublishedOn.HasValue)
            {
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <time datetime="@post.PublishedOn.Value.ToString("yyyy-MM-dd")">
                        @post.PublishedOn.Value.ToString("MMMM d, yyyy")
                    </time>
                </div>
            }
            
            @if (Model.PostAuthor is { } author)
            {
                var avatarUrl = author.AvatarUrl;
                var name = author.Name;
                var bio = author.Bio;
                <div class="flex items-center gap-3">
                    <span class="text-gray-400">|</span>
                    @if (!string.IsNullOrEmpty(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="@name" class="w-8 h-8 rounded-full object-cover"/>
                    }
                    else
                    {
                        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-sm font-medium">
                            @(name?.FirstOrDefault())
                        </div>
                    }
                    <div class="flex flex-col">
                        <span class="font-medium text-gray-900">@name</span>
                        @if (!string.IsNullOrEmpty(bio))
                        {
                            <span class="text-xs text-gray-500 hidden sm:inline">@bio</span>
                        }
                    </div>
                </div>
            }
        </div>
    </header>

    <div class="blog-article-layout @(Model.TableOfContents.Count > 0 ? "blog-article-layout--with-toc" : string.Empty)">
        @if (Model.TableOfContents.Count > 0)
        {
            <aside class="blog-article-toc" aria-label="On this page">
                <p class="blog-article-toc__title">On this page</p>
                <nav aria-label="Article sections">
                    <ol class="blog-article-toc__list">
                        @foreach (var item in Model.TableOfContents)
                        {
                            <li class="@(item.Level == 3 ? "blog-article-toc__item--nested" : string.Empty)">
                                <a href="#@item.AnchorId">@item.Text</a>
                            </li>
                        }
                    </ol>
                </nav>
            </aside>
        }

        <div class="blog-article-reading">
            @* Markdown content *@
            <div id="article-content" class="blog-article-content prose prose-lg">
                @if (!string.IsNullOrWhiteSpace(Model.RenderedMarkdown))
                {
                    @Html.Raw(Model.RenderedMarkdown)
                }
                else
                {
                    <div class="text-gray-500 italic py-8 text-center">
                        No content available for this post.
                    </div>
                }
            </div>

            @* Footer with tags *@
            @if (post.TagIds?.Count > 0)
            {
                <footer class="mt-12 pt-6 border-t border-gray-200">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-sm font-medium text-gray-700">Tags:</span>
                        @foreach (var tagId in post.TagIds)
                        {
                            <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">
                                @(Model.TagNames.GetValueOrDefault(tagId, $"Tag #{tagId}"))
                            </span>
                        }
                    </div>
                </footer>
            }
        </div>
    </div>
</article>
