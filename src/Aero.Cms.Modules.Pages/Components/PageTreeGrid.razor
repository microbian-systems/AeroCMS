@page "/_cms/manager/pages/tree"
@using Microsoft.AspNetCore.Authorization
@using Radzen
@using Radzen.Blazor
@using Aero.Cms.Abstractions.Enums
@attribute [Authorize]

<PageTitle>Page Tree</PageTitle>

<div class="p-6">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold">Page Hierarchy</h2>
        <div class="flex gap-2">
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadTreeAsync" />
            <RadzenButton Text="New Page" Icon="add" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => NavigationManager.NavigateTo("/_cms/manager/pages/new"))" />
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4">@_error</div>
    }

    @if (_allNodes.Count == 0 && _error is null)
    {
        <div class="text-center py-12 text-gray-400">
            <RadzenIcon Icon="layers" class="text-4xl mb-2" />
            <p>No pages yet. Create your first page to get started.</p>
        </div>
    }
    else
    {
        <RadzenDataGrid TItem="TreeNodeModel"
                        Data="@_allNodes"
                        AllowRowSelectOnRowClick="true"
                        RowClick="@(args => _selectedNode = args.Data)"
                        AllowColumnResize="true"
                        style="max-height: 70vh; overflow-y: auto;">
            <Columns>
                <RadzenDataGridColumn TItem="TreeNodeModel" Title="" Width="50px" Sortable="false">
                    <Template Context="node">
                        <span class="@GetIndentClass(node.Depth)">
                            @if (node.HasChildren)
                            { <RadzenIcon Icon="folder_open" class="text-yellow-500" /> }
                            else
                            { <RadzenIcon Icon="description" class="text-gray-400" /> }
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TreeNodeModel" Property="Title" Title="Title" Width="250px" Sortable="true">
                    <Template Context="node">
                        <span class="@GetIndentClass(node.Depth)">@node.Title</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TreeNodeModel" Property="Slug" Title="Slug" Width="180px" Sortable="true" />
                <RadzenDataGridColumn TItem="TreeNodeModel" Title="Path" Width="300px" Sortable="true">
                    <Template Context="node">
                        <span class="text-gray-500 text-sm font-mono">@node.Path</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TreeNodeModel" Title="Status" Width="100px" Sortable="true">
                    <Template Context="node">
                        <RadzenBadge Text="@node.PublicationState.ToString()"
                                     BadgeStyle="@GetBadgeStyle(node.PublicationState)" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TreeNodeModel" Property="Depth" Title="Depth" Width="70px" Sortable="true" />
                <RadzenDataGridColumn TItem="TreeNodeModel" Title="Hidden" Width="70px" Sortable="true">
                    <Template Context="node">
                        @if (node.IsHidden)
                        { <RadzenIcon Icon="visibility_off" class="text-gray-400" /> }
                        else
                        { <RadzenIcon Icon="visibility" class="text-green-500" /> }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TreeNodeModel" Title="Actions" Width="150px" Sortable="false">
                    <Template Context="node">
                        <div class="flex gap-1">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => EditNodeAsync(node))" />
                            <RadzenButton Icon="@(node.IsHidden ? "visibility" : "visibility_off")"
                                          Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => ToggleHiddenAsync(node))" />
                            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => ConfirmDeleteAsync(node))" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }

    @if (_selectedNode is not null)
    {
        <div class="mt-4 p-3 bg-gray-50 rounded border">
            <span class="text-sm font-medium">Selected: </span>
            <span class="text-sm">@_selectedNode.Title</span>
            <span class="text-xs text-gray-400 ml-2 font-mono">@_selectedNode.Path</span>
        </div>
    }
</div>
