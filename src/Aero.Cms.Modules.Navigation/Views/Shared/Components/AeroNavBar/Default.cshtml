@model Aero.Cms.Modules.Navigation.Rendering.NavMenuContext
@using Aero.Cms.Modules.Navigation.Rendering
@inject INavMenuHtmlRenderer NavRenderer

@{
    var siteLogoUrl = Model.SiteLogoUrl;
    var hasSiteLogo = !string.IsNullOrWhiteSpace(siteLogoUrl);
}

<style>
    .aero-nav-canvas-column {
        grid-column: span 12 / span 12;
    }

    @@media (min-width: 768px) {
        .aero-nav-canvas-column {
            grid-column: span var(--aero-tablet-span) / span var(--aero-tablet-span);
        }
    }

    @@media (min-width: 1024px) {
        .aero-nav-canvas-column {
            grid-column: span var(--aero-desktop-span) / span var(--aero-desktop-span);
        }
    }
</style>

<header class="bg-white/80 backdrop-blur-md border-b border-slate-200 sticky top-0 z-50 transition-all duration-300">
    <div class="mx-auto px-4 sm:px-6 lg:px-12">
        <div class="flex min-h-20 justify-between gap-4 py-3 items-center">
            <div class="flex-shrink-0 flex items-center">
                <a href="/" class="group flex items-center gap-2">
                    @if (hasSiteLogo)
                    {
                        <img src="@siteLogoUrl"
                             alt="Site logo"
                             class="h-10 max-w-48 object-contain transition-transform group-hover:scale-105" />
                    }
                    else
                    {
                        <div class="h-10 w-10 flex items-center justify-center rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-600 shadow-lg shadow-indigo-500/20 group-hover:scale-110 transition-transform">
                            <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                        <span class="text-xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-slate-900 to-slate-600">
                            Aero<span class="text-indigo-600">CMS</span>
                        </span>
                    }
                </a>
            </div>

            @if (Model.Rows.Count > 0)
            {
                <div class="hidden min-w-0 flex-1 space-y-2 md:block">
                    @foreach (var row in Model.Rows.OrderBy(x => x.Order))
                    {
                        <div class="grid grid-cols-12 items-center gap-3">
                            @foreach (var column in row.Columns.OrderBy(x => x.Order))
                            {
                                <nav class="aero-nav-canvas-column flex min-w-0 items-center gap-1" style="@ColumnStyle(column)">
                                    @foreach (var block in column.Blocks.OrderBy(x => x.Order))
                                    {
                                        @NavRenderer.Render(block.Component, NavMenuRenderMode.Desktop)
                                    }
                                </nav>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <nav class="hidden md:flex md:items-center md:gap-1">
                    @foreach (var component in Model.Left)
                    {
                        @NavRenderer.Render(component, NavMenuRenderMode.Desktop)
                    }
                </nav>

                <nav class="hidden md:flex md:items-center md:gap-1">
                    @foreach (var component in Model.Center)
                    {
                        @NavRenderer.Render(component, NavMenuRenderMode.Desktop)
                    }
                </nav>

                <nav class="hidden md:ml-auto md:flex md:items-center md:gap-1">
                    @foreach (var component in Model.Right)
                    {
                        @NavRenderer.Render(component, NavMenuRenderMode.Desktop)
                    }
                </nav>
            }

            <div class="flex items-center ml-4 md:hidden">
                <label for="mobile-menu-toggle" class="inline-flex items-center justify-center p-2.5 rounded-xl text-slate-500 hover:bg-slate-100 transition-colors cursor-pointer">
                    <span class="sr-only">Open menu</span>
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </label>
            </div>
        </div>
    </div>
</header>

@* Hidden checkbox toggles mobile menu via CSS peer-checked — no JS / Alpine needed *@
<input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />

<div class="fixed inset-0 z-[60] hidden peer-checked:block md:hidden">
    @* Backdrop — clicking closes the menu (label wraps the backdrop) *@
    <label for="mobile-menu-toggle" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm cursor-pointer"></label>

    @* Slide-in panel *@
    <div class="fixed inset-y-0 right-0 w-full max-w-sm bg-white shadow-2xl flex flex-col
                translate-x-full peer-checked:translate-x-0
                transition-transform duration-300 ease-out">

        <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100">
            <span class="text-xl font-bold text-slate-900">Navigation</span>
            <label for="mobile-menu-toggle" class="p-2 -mr-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-50 transition-colors cursor-pointer">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </label>
        </div>

        <div class="flex-grow py-6 px-4 space-y-2 overflow-y-auto">
            @foreach (var component in MobileComponents())
            {
                @NavRenderer.Render(component, NavMenuRenderMode.Mobile)
            }
        </div>

        <div class="p-6 border-t border-slate-100 bg-slate-50/50 text-center">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Aero CMS Platform</p>
        </div>
    </div>
</div>

@functions {
    private IEnumerable<Aero.Cms.Modules.Navigation.Domain.INavMenuComponent> MobileComponents()
        => Model.Rows.Count > 0
            ? Model.Rows
                .OrderBy(row => row.Order)
                .SelectMany(row => row.Columns.OrderBy(column => column.Order))
                .SelectMany(column => column.Blocks.OrderBy(block => block.Order).Select(block => block.Component))
            : Model.Left.Concat(Model.Center).Concat(Model.Right);

    private static string ColumnStyle(Aero.Cms.Modules.Navigation.Domain.NavCanvasColumn column)
        => $"--aero-tablet-span:{Math.Clamp(column.TabletSpan, 1, 12)};--aero-desktop-span:{Math.Clamp(column.DesktopSpan, 1, 12)};";
}
