@{
    var showHeaderNavigation = ViewBag.ShowHeaderNavigation as bool? ?? true;
    var navMenuOverrideId = ViewBag.NavMenuOverrideId as long?;
    var hideFooter = ViewBag.HideFooter as bool? ?? false;
}
<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await RenderSectionAsync("metaPartial", required: false)
    
    @* Google Fonts - Inter for UI / Display fallbacks *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    @* Per-module CSS (processed first — must appear before Tailwind script) *@
    @await RenderSectionAsync("cssPartial", required: false)

    @* Tailwind CSS v4 Engine - Web Client Only *@
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss" src="/css/aero.css"></style>
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <title>@ViewBag.Title</title>
    @await RenderSectionAsync("headPartial", required:false)
    <script src="/lib/htmx/htmx.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <meta name="hydro-config" />
    <script defer src="~/hydro/hydro.js" asp-append-version="true"></script>
    <script defer src="~/hydro/alpine.js" asp-append-version="true"></script>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col font-sans text-slate-900 antialiased" x-data="{ mobileMenuOpen: false }">
    @if (showHeaderNavigation)
    {
        @await Component.InvokeAsync("AeroNavBar", new { pageOverrideId = navMenuOverrideId })
    }

    <main class="flex-grow">
        @RenderBody()
    </main>

    @if (!hideFooter)
    {
        @await Component.InvokeAsync("AeroFooter")
    }

    <script src="/js/app.js" type="module"></script>
    @await RenderSectionAsync("Scripts", required:false)
    
    <mini-profiler />
</body>
</html>
