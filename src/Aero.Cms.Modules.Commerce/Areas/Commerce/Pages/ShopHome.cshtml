@model ShopHomeModel
@{
    ViewData["Title"] = "Shop";
    ViewData["IsHome"] = true;
    ViewData["HeaderTitle"] = "Welcome to the shop";
    ViewData["HeaderSubtitle"] = "Browse products selected for this site.";
}

<div class="eshop-catalog">
    <div class="eshop-catalog-main">
        <div class="eshop-welcome">
            <h2>Featured products</h2>
            <p>Explore a selection of products currently available from this store.</p>
        </div>

        @if (Model.LoadFailed)
        {
            <div class="eshop-state eshop-state-error" role="alert">
                The catalog is temporarily unavailable. Please try again later.
            </div>
        }
        else if (Model.FeaturedProducts.Count > 0)
        {
            <div class="eshop-catalog-items">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <partial name="/Areas/Commerce/Shared/_CatalogItemPartial.cshtml" model="product" />
                }
            </div>
        }
        else
        {
            <div class="eshop-state">No featured products are available yet.</div>
        }

        @if (!Model.LoadFailed && Model.RecentProducts.Count > 0)
        {
            <h2 class="eshop-section-heading">Recently added</h2>
            <div class="eshop-catalog-items">
                @foreach (var product in Model.RecentProducts)
                {
                    <partial name="/Areas/Commerce/Shared/_CatalogItemPartial.cshtml" model="product" />
                }
            </div>
        }

        <div class="eshop-home-action">
            <a href="/shop/products" class="eshop-button eshop-button-primary">
                Browse All Products
            </a>
        </div>
    </div>
</div>
