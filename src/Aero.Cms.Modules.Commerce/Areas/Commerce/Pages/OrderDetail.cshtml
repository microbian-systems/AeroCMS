@page "/shop/orders/{id:long}"
@model OrderDetailModel
@{
    ViewData["Title"] = $"Order #{Model.Order?.Id}";
    ViewData["HeaderTitle"] = $"Order #{Model.Order?.Id}";
    ViewData["HeaderSubtitle"] = Model.Order?.Status.ToString() ?? "";
}

@if (Model.Order is null)
{
    <div class="eshop-orders">
        <p class="eshop-orders-empty">Order not found.</p>
    </div>
}
else
{
    <div class="eshop-orders" style="padding:0 10rem;">
        <p><strong>Placed:</strong> @Model.Order.CreatedOn.ToString("MMMM dd, yyyy h:mm tt")</p>
        <p><strong>Status:</strong> <span class="status @Model.Order.Status.ToString().ToLowerInvariant()">@Model.Order.Status</span></p>
        <p><strong>Total:</strong> $@Model.Order.TotalAmount.ToString("0.00")</p>

        @if (Model.Order.ShippingAddress is not null)
        {
            <h3>Shipping Address</h3>
            <p>@Model.Order.ShippingAddress.Street<br />@Model.Order.ShippingAddress.City, @Model.Order.ShippingAddress.State @Model.Order.ShippingAddress.PostalCode<br />@Model.Order.ShippingAddress.Country</p>
        }

        <h3>Items</h3>
        <table style="width:100%;border-collapse:collapse;">
            <thead>
                <tr style="border-bottom:1px solid #D2D2D2;text-align:left;">
                    <th style="padding:0.5rem 0;">Product</th>
                    <th style="padding:0.5rem 0;">Qty</th>
                    <th style="padding:0.5rem 0;text-align:right;">Price</th>
                    <th style="padding:0.5rem 0;text-align:right;">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Order.Items)
                {
                    <tr style="border-bottom:1px solid #D2D2D2;">
                        <td style="padding:0.75rem 0;">@item.ProductName</td>
                        <td style="padding:0.75rem 0;">@item.Quantity</td>
                        <td style="padding:0.75rem 0;text-align:right;">$@item.UnitPrice.ToString("0.00")</td>
                        <td style="padding:0.75rem 0;text-align:right;">$@item.TotalPrice.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" style="padding:0.75rem 0;text-align:right;font-weight:600;">Total</td>
                    <td style="padding:0.75rem 0;text-align:right;font-weight:600;">$@Model.Order.TotalAmount.ToString("0.00")</td>
                </tr>
            </tfoot>
        </table>

        <p style="margin-top:2rem;"><a href="/shop/orders">&larr; Back to orders</a></p>
    </div>
}
