@page "/shop/cart"
@model CartModel
@{
    ViewData["Title"] = "Shopping Bag";
    ViewData["HeaderTitle"] = "Shopping bag";
    ViewData["HeaderSubtitle"] = "";
}

<div class="eshop-cart">
    @if (Model.Items is null)
    {
        <p class="eshop-loading">Loading...</p>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="eshop-empty-cart">
            <p>Your shopping bag is empty. <a href="/shop/products">Continue shopping.</a></p>
        </div>
    }
    else
    {
        <div class="eshop-cart-items">
            <div class="eshop-cart-item-header">
                <div class="cart-item-info">Products</div>
                <div class="cart-item-quantity">Quantity</div>
                <div class="cart-item-total">Total</div>
            </div>
            @foreach (var item in Model.Items)
            {
                <div class="eshop-cart-item">
                    <div class="cart-item-info">
                        <img alt="@item.ProductName"
                             src="@(item.ImageUrl ?? $"https://static.photos/blurred/640x360/{item.ProductId % 1000}")" />
                        <div class="cart-item-content">
                            <p class="name">@item.ProductName</p>
                            <p class="price">$@item.UnitPrice.ToString("0.00")</p>
                        </div>
                    </div>
                    <div class="cart-item-quantity">
                        <form method="post" asp-page-handler="UpdateQuantity">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="listingId" value="@item.ListingId" />
                            <input aria-label="product quantity" type="number"
                                   name="quantity" value="@item.Quantity" min="0" />
                            <button type="submit" class="eshop-button eshop-button-secondary">Update</button>
                        </form>
                    </div>
                    <div class="cart-item-total">
                        $@item.TotalPrice.ToString("0.00")
                    </div>
                </div>
            }
        </div>

        <div class="eshop-cart-summary">
            <div class="eshop-cart-summary-container">
                <div class="eshop-cart-summary-header">
                    <img role="presentation" src="~/icons/cart.svg" alt="" />
                    Your shopping bag
                    <span class="filter-badge">@Model.TotalQuantity</span>
                </div>
                <div class="eshop-cart-summary-total">
                    <div>Total</div>
                    <div>$@Model.TotalPrice?.ToString("0.00")</div>
                </div>
                <a href="/shop/checkout" class="eshop-button eshop-button-primary">Check out</a>
                <a href="/shop/products" class="eshop-cart-summary-link">
                    <img role="presentation" src="~/icons/arrow-left.svg" alt="" />
                    <p>Continue shopping</p>
                </a>
            </div>
        </div>
    }
</div>
