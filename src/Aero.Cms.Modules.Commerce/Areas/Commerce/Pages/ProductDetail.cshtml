@model ProductDetailModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "Product not found";
    ViewData["HeaderTitle"] = Model.Product?.Name ?? "Not found";
    ViewData["HeaderSubtitle"] = Model.Product?.Category ?? "";
}

@if (Model.LoadFailed)
{
    <div class="eshop-item-details">
        <div class="eshop-state eshop-state-error" role="alert">This product is temporarily unavailable. Please try again later.</div>
    </div>
}
else if (Model.Product is not null)
{
    <div class="eshop-item-details">
        @if (!string.IsNullOrWhiteSpace(Model.Product.ImageUrl))
        {
            <img alt="@Model.Product.Name" src="@Model.Product.ImageUrl" />
        }
        else
        {
            <div class="eshop-image-placeholder eshop-image-placeholder-detail" role="img" aria-label="No image available for @Model.Product.Name">@Model.Product.Name</div>
        }
        <div class="description">
            <p>@Model.Product.Description</p>
            @if (!string.IsNullOrEmpty(Model.Product.Category))
            {
                <p>Category: <strong>@Model.Product.Category</strong></p>
            }

            <div class="eshop-add-to-cart">
                <span class="price">$@Model.Product.Price.ToString("0.00")</span>

                @if (Model.MemberState == Aero.Cms.Modules.Commerce.Storefront.StorefrontMemberStateKind.Authorized)
                {
                    <form method="post" asp-page-handler="AddToCart">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="listingId" value="@Model.Product.Id" />
                        <button type="submit" title="Add to basket">Add to shopping bag</button>
                    </form>
                }
                else if (Model.MemberState == Aero.Cms.Modules.Commerce.Storefront.StorefrontMemberStateKind.NotCurrentSiteMember)
                {
                    <p class="eshop-account-note">Your account does not have access to purchase from this store.</p>
                }
                else
                {
                    <p class="eshop-account-note">Customer sign-in is required to add products to the shopping bag.</p>
                }
            </div>

            @if (Model.ItemCount > 0)
            {
                <p class="eshop-in-cart"><strong>@Model.ItemCount</strong> in <a href="/shop/cart">shopping bag</a></p>
            }
        </div>
    </div>
}
