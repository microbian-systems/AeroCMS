@inject IBasketService BasketService
@inject Aero.Core.Http.ISiteContext SiteContext
@inject Aero.Cms.Modules.Commerce.Storefront.IStorefrontMemberAccessor StorefrontMember
@{
    var member = await StorefrontMember.GetAsync();
    var basketResult = member.IsAuthorized
        ? await BasketService.GetAsync(SiteContext.TenantId, SiteContext.SiteId, member.MemberId!.Value)
        : null;
    var itemCount = basketResult is Result<BasketDocument?, AeroError>.Ok(var b) && b is not null ? b.Items.Sum(i => i.Quantity) : 0;
}
@if (member.IsAuthorized)
{
<a class="eshop-cart-link" aria-label="Shopping bag" href="/shop/cart">
    Bag
    @if (itemCount > 0)
    {
        <span class="eshop-cart-badge">@itemCount</span>
    }
</a>
}
else
{
    <span class="eshop-account-state">Bag</span>
}
