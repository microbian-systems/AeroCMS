@model PublicListingResponse

<div class="eshop-catalog-item">
    <a class="eshop-catalog-product" href="/shop/products/@Model.Slug">
        <span class="eshop-catalog-product-image">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img alt="@Model.Name" src="@Model.ImageUrl" />
            }
            else
            {
                <span class="eshop-image-placeholder" role="img" aria-label="No image available for @Model.Name">@Model.Name</span>
            }
        </span>
        <span class="eshop-catalog-product-content">
            <span class="name">@Model.Name</span>
            <span class="price">$@Model.Price.ToString("0.00")</span>
        </span>
    </a>
</div>
