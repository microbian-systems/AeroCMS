@model CatalogSearchViewModel

<div class="eshop-catalog-search">
    <div class="eshop-catalog-search-header">
        Search and filter
    </div>
    <form method="get" action="/shop/products" class="eshop-search-form">
        <label for="catalog-search">Search products</label>
        <input id="catalog-search" name="search" type="search" value="@Model.Search" maxlength="200" />
        @if (!string.IsNullOrWhiteSpace(Model.CurrentCategory))
        {
            <input type="hidden" name="category" value="@Model.CurrentCategory" />
        }
        <button type="submit" class="eshop-button eshop-button-primary">Search</button>
    </form>
    <div class="eshop-catalog-search-types">
        <div class="eshop-catalog-search-group">
            <h3>Category</h3>
            <div class="eshop-catalog-search-group-tags">
                <a href="@Model.CategoryUri(null)" class="eshop-catalog-search-tag @(Model.CurrentCategory is null ? "active" : "")">All</a>
                @foreach (var cat in Model.Categories)
                {
                    <a href="@Model.CategoryUri(cat)" class="eshop-catalog-search-tag @(Model.CurrentCategory == cat ? "active" : "")">@cat</a>
                }
            </div>
        </div>
        @* Price range could be added here *@
    </div>
</div>
