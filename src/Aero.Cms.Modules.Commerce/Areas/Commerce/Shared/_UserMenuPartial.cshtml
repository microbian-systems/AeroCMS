@inject Aero.Cms.Modules.Commerce.Storefront.IStorefrontMemberAccessor StorefrontMember
@{
    var storefrontMember = await StorefrontMember.GetAsync();
}
@if (storefrontMember.IsAuthorized)
{
    <div class="eshop-dropdown-menu">
        <button type="button" class="eshop-dropdown-button">Account</button>
        <div class="eshop-dropdown-content">
            <a class="eshop-dropdown-item" href="/shop/orders">My orders</a>
            <form class="eshop-dropdown-item" method="post" action="/api/v1/member/logout">
                @Html.AntiForgeryToken()
                <button type="submit">Log out</button>
            </form>
        </div>
    </div>
}
else
{
    <span class="eshop-account-state">Guest</span>
}
