@* User menu — follows eShop's UserMenu.razor pattern *@
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="eshop-dropdown-menu">
        <span class="eshop-dropdown-button">
            <img role="presentation" src="~/icons/user.svg" alt="User" />
        </span>
        <div class="eshop-dropdown-content">
            <a class="eshop-dropdown-item" href="/shop/orders">My orders</a>
            <form class="eshop-dropdown-item" method="post" action="/user/logout">
                @Html.AntiForgeryToken()
                <button type="submit">Log out</button>
            </form>
        </div>
    </div>
}
else
{
    <a aria-label="Sign in" href="/user/login?returnUrl=@Context.Request.Path">
        <img role="presentation" src="~/icons/user.svg" alt="Sign in" />
    </a>
}
