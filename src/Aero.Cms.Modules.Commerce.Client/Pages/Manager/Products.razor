@page "/manager/commerce/products"
@attribute [Authorize]

<PageTitle>Commerce products</PageTitle>

<div class="pe-page-content space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold pe-heading">Products &amp; inventory</h1>
            <p class="mt-1 text-sm pe-description">Inventory is shared by every site in the selected site's tenant.</p>
        </div>
        <RadzenButton Icon="add" Text="New product" ButtonStyle="ButtonStyle.Primary" Click="CreateProduct" />
    </div>

    <div class="flex gap-3">
        <RadzenTextBox @bind-Value="SearchText" Placeholder="Search name or SKU" Style="width: min(28rem, 100%);" />
        <RadzenButton Icon="search" Text="Search" Click="SearchAsync" Disabled="@IsLoading" />
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="rounded border border-red-500 p-3 text-sm text-red-600">@ErrorMessage</div>
    }

    @if (IsLoading)
    {
        <p class="pe-description">Loading products…</p>
    }
    else if (ProductRows.Count == 0)
    {
        <div class="rounded-lg border p-6 text-center pe-description" style="border-color: var(--pe-border);">No products found.</div>
    }
    else
    {
        <div class="overflow-x-auto rounded-lg border" style="border-color: var(--pe-border);">
            <table class="w-full border-collapse text-sm">
                <thead><tr style="background: var(--pe-bg-secondary);"><th class="p-3 text-left">Product</th><th class="p-3 text-left">SKU</th><th class="p-3 text-right">Stock</th><th class="p-3 text-left">Status</th><th class="p-3 text-right">Actions</th></tr></thead>
                <tbody>
                @foreach (var product in ProductRows)
                {
                    <tr class="border-t" style="border-color: var(--pe-border);">
                        <td class="p-3 font-medium">@product.Name</td><td class="p-3">@product.Sku</td><td class="p-3 text-right">@product.StockQuantity</td>
                        <td class="p-3">@(product.IsActive ? "Active" : "Inactive")</td>
                        <td class="p-3 text-right"><RadzenButton Size="ButtonSize.Small" Icon="edit" Text="Edit" Click="@(() => EditProduct(product.Id))" /><RadzenButton class="ml-2" Size="ButtonSize.Small" Icon="delete" Text="Delete" ButtonStyle="ButtonStyle.Danger" Click="@(() => DeleteProductAsync(product))" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between text-sm pe-description">
            <span>Showing @(Skip + 1)–@(Skip + ProductRows.Count) of @TotalCount</span>
            <div class="flex gap-2"><RadzenButton Text="Previous" Disabled="@(Skip == 0 || IsLoading)" Click="PreviousPageAsync" /><RadzenButton Text="Next" Disabled="@(!CanLoadNext || IsLoading)" Click="NextPageAsync" /></div>
        </div>
    }
</div>
