@page "/manager/commerce/subscriptions/{Id:long}"
@attribute [Authorize]

<PageTitle>Subscription receipt</PageTitle>

<div class="pe-page-content space-y-6">
    <div class="flex items-center justify-between"><div><h1 class="text-2xl font-bold pe-heading">Subscription receipt</h1><p class="mt-1 text-sm pe-description">Read-only commercial snapshot and confirmed billing cycles.</p></div><RadzenButton Text="Back" Click="Back" /></div>
    @if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <div class="rounded border border-red-500 p-3 text-sm text-red-600">@ErrorMessage</div> }
    else if (IsLoading) { <p class="pe-description">Loading subscription…</p> }
    else if (Receipt is null) { <p class="pe-description">Subscription not found for the selected site.</p> }
    else
    {
        <dl class="grid gap-3 rounded-lg border p-4 text-sm md:grid-cols-3" style="border-color: var(--pe-border);"><div><dt class="pe-description">Order</dt><dd class="font-medium">#@Receipt.Subscription.OrderId</dd></div><div><dt class="pe-description">Provider</dt><dd class="font-medium">@Receipt.Subscription.Provider</dd></div><div><dt class="pe-description">Status</dt><dd class="font-medium">@(Receipt.Subscription.RequiresManualReview ? "Manual review needed" : Receipt.Subscription.State)</dd></div><div><dt class="pe-description">Current period ends</dt><dd class="font-medium">@(Receipt.Subscription.CurrentPeriodEndsOn?.ToString("MMM dd, yyyy") ?? "Awaiting provider confirmation")</dd></div><div><dt class="pe-description">Amount</dt><dd class="font-medium">@Receipt.Subscription.Amount.ToString("C") @Receipt.Subscription.Currency / @Receipt.Subscription.IntervalDays days</dd></div></dl>
        <section><h2 class="text-lg font-semibold pe-heading">Recurring items</h2><div class="mt-3 overflow-x-auto rounded-lg border" style="border-color: var(--pe-border);"><table class="w-full border-collapse text-sm"><thead><tr style="background: var(--pe-bg-secondary);"><th class="p-3 text-left">Item</th><th class="p-3 text-left">SKU</th><th class="p-3 text-right">Quantity</th><th class="p-3 text-right">Unit</th><th class="p-3 text-right">Total</th></tr></thead><tbody>@foreach (var line in Receipt.Lines) { <tr class="border-t" style="border-color: var(--pe-border);"><td class="p-3">@line.ListingName</td><td class="p-3">@line.Sku</td><td class="p-3 text-right">@line.Quantity</td><td class="p-3 text-right">@line.UnitAmount.ToString("C")</td><td class="p-3 text-right">@line.TotalAmount.ToString("C")</td></tr> }</tbody></table></div></section>
        <section><h2 class="text-lg font-semibold pe-heading">Billing cycles</h2><div class="mt-3 overflow-x-auto rounded-lg border" style="border-color: var(--pe-border);"><table class="w-full border-collapse text-sm"><thead><tr style="background: var(--pe-bg-secondary);"><th class="p-3 text-left">Cycle</th><th class="p-3 text-left">Period</th><th class="p-3 text-right">Amount</th><th class="p-3 text-left">Status</th></tr></thead><tbody>@if (Receipt.Cycles.Count == 0) { <tr><td class="p-3 pe-description" colspan="4">No confirmed billing cycles are available yet.</td></tr> } @foreach (var cycle in Receipt.Cycles) { <tr class="border-t" style="border-color: var(--pe-border);"><td class="p-3">@cycle.CycleNumber</td><td class="p-3">@cycle.PeriodStartsOn.ToString("MMM dd, yyyy") – @cycle.PeriodEndsOn.ToString("MMM dd, yyyy")</td><td class="p-3 text-right">@cycle.Amount.ToString("C") @cycle.Currency</td><td class="p-3">@(cycle.RequiresManualReview ? "Manual review needed" : cycle.State)</td></tr> }</tbody></table></div></section>
    }
</div>
