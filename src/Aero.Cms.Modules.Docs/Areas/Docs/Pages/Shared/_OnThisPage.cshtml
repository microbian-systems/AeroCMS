@* _OnThisPage.cshtml — Right panel "On This Page" TOC from Markdig AST headings *@
@model IEnumerable<Aero.Cms.Modules.Docs.Areas.Docs.Models.HeadingItem>

<aside class="hidden xl:block w-[240px] min-w-[240px] pt-12 pr-4">
    <div class="sticky top-16 w-[220px]">
        <p class="flex items-center gap-2 text-xs font-medium text-slate-500 uppercase tracking-wider mb-3">
            <i class="ph ph-list"></i> On this page
        </p>
        <nav class="space-y-1 mb-8">
            @foreach (var item in Model)
            {
                <a href="#@item.AnchorId"
                   class="block text-sm text-slate-500 hover:text-slate-900 py-0.5 transition-colors @(item.Level == 3 ? "pl-3" : "")">
                    @item.Text
                </a>
            }
        </nav>

        @* Was this helpful? (static for now, emoji feedback planned) *@
        <div class="border-t border-slate-200 pt-4">
            <p class="text-sm text-slate-500 mb-3">Was this helpful?</p>
            <div class="flex items-center gap-2">
                <button class="text-xl text-slate-400 hover:text-slate-600 transition-colors hover:scale-110 transform" title="Yes">
                    <i class="ph ph-smiley"></i>
                </button>
                <button class="text-xl text-slate-400 hover:text-slate-600 transition-colors hover:scale-110 transform" title="Somewhat">
                    <i class="ph ph-smiley-meh"></i>
                </button>
                <button class="text-xl text-slate-400 hover:text-slate-600 transition-colors hover:scale-110 transform" title="No">
                    <i class="ph ph-smiley-sad"></i>
                </button>
            </div>
        </div>
    </div>
</aside>
