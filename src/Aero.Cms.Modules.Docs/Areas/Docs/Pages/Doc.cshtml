@page "/docs/{*slug}"
@using Markdig
@using Markdig.Extensions.AutoIdentifiers
@using Aero.Cms.Modules.Docs.Areas.Docs.Models
@model Aero.Cms.Modules.Docs.Areas.Docs.Pages.DocModel
@{
    var pageDoc = Model.MarkdownPage;
    ViewBag.Title = pageDoc?.SeoTitle ?? pageDoc?.Title ?? "Docs";
    ViewBag.ShowHeaderNavigation = pageDoc?.ShowHeaderNavigation ?? true;
    ViewBag.ActiveDocId = pageDoc?.Id ?? 0;

    // Build Markdig pipeline with auto-identifiers for heading anchors
    var pipeline = new MarkdownPipelineBuilder()
        .UseAutoIdentifiers()
        .Build();
}

@* ── Left Sidebar ──────────────────────────────────────────────────────── *@
@section sidebarPartial {
    @await Html.PartialAsync("_DocsSidebar", Model.SidebarTree)
}

@* ── Right Panel "On This Page" ─────────────────────────────────────────── *@
@if (Model.OnThisPage.Count > 0)
{
    @section rightPanelPartial {
        @await Html.PartialAsync("_OnThisPage", Model.OnThisPage)
    }
}

@* ── Page Content ───────────────────────────────────────────────────────── *@
@if (pageDoc is null)
{
    <div class="min-h-screen flex items-center justify-center bg-slate-50">
        <div class="text-center">
            <h1 class="text-4xl font-bold text-slate-900 mb-4">Documentation Not Found</h1>
            <p class="text-slate-600">The requested documentation page could not be found.</p>
            <a href="/docs" class="mt-6 inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-700 font-medium">
                <i class="ph ph-arrow-left"></i> Back to Docs
            </a>
        </div>
    </div>
}
else
{
    <div class="page-fade">
        @* ── Breadcrumb ────────────────────────────────────────────────────── *@
        @if (Model.Breadcrumbs.Count > 0)
        {
            <p class="text-xs font-medium text-indigo-600 uppercase tracking-wider mb-2 px-6 md:px-12 lg:px-16 pt-8">
                <a href="/docs" class="hover:underline">Docs</a>
                @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
                {
                    var crumb = Model.Breadcrumbs[i];
                    var isCurrent = i == Model.Breadcrumbs.Count - 1;
                    <span class="text-slate-400 mx-1">/</span>
                    if (isCurrent)
                    {
                        <span>@crumb.Title</span>
                    }
                    else
                    {
                        <a href="/@crumb.Slug" class="hover:underline">@crumb.Title</a>
                    }
                }
            </p>
        }

        @* ── Title + Summary ───────────────────────────────────────────────── *@
        <div class="max-w-[900px] mx-auto px-6 md:px-12 lg:px-16 pt-2 pb-6">
            <h1 class="text-3xl md:text-[32px] font-semibold text-slate-900 mb-2 leading-tight">
                @pageDoc.Title
            </h1>
            @if (!string.IsNullOrEmpty(pageDoc.Summary))
            {
                <p class="text-base text-slate-600 leading-relaxed">@pageDoc.Summary</p>
            }
        </div>

        @* ── Feature Cards (space overview mode — page has children) ────────── *@
        @if (Model.ChildPages.Count > 0)
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-[900px] mx-auto px-6 md:px-12 lg:px-16 pb-8">
                @foreach (var child in Model.ChildPages)
                {
                    <a href="/@child.Slug" class="card-hover group block border border-slate-200 rounded-lg overflow-hidden bg-white transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-indigo-300">
                        <div class="h-32 bg-gradient-to-br from-indigo-50 to-indigo-100 flex items-center justify-center">
                            <i class="ph ph-file-text text-3xl text-indigo-400 group-hover:text-indigo-600 transition-colors"></i>
                        </div>
                        <div class="px-5 py-5">
                            <h3 class="text-base font-semibold text-slate-900 mb-2 group-hover:text-indigo-600 transition-colors">@child.Title</h3>
                            @if (!string.IsNullOrEmpty(child.Summary))
                            {
                                <p class="text-sm text-slate-500 leading-relaxed line-clamp-2">@child.Summary</p>
                            }
                        </div>
                    </a>
                }
            </div>
        }

        @* ── Markdown Content ──────────────────────────────────────────────── *@
        @if (!string.IsNullOrEmpty(pageDoc.MarkdownContent))
        {
            <div class="max-w-[900px] mx-auto px-6 md:px-12 lg:px-16 pb-16">
                <div class="prose prose-slate max-w-none prose-headings:scroll-mt-20 prose-headings:font-semibold prose-a:text-indigo-600 prose-img:rounded-lg prose-pre:bg-slate-900 prose-pre:rounded-lg">
                    @Html.Raw(Markdown.ToHtml(pageDoc.MarkdownContent, pipeline))
                </div>
            </div>
        }
    </div>
}
