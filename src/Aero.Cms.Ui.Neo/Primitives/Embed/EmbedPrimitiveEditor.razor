@using System.Text.Json

<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Embed URL</label>
        <RadzenTextArea Value="@Url" Change="OnUrlChanged" Class="w-full" Rows="2" Placeholder="https://www.youtube.com/watch?v=..." />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Title <span class="text-gray-400">(required for accessibility)</span></label>
        <RadzenTextArea Value="@Title" Change="OnTitleChanged" Class="w-full" Rows="1" Placeholder="Embedded content" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Aspect Ratio</label>
        <select class="w-full border rounded px-2 py-1.5 text-sm" value="@Aspect" @onchange="OnAspectChanged">
            <option value="widescreen">16:9 — Widescreen</option>
            <option value="standard">4:3 — Standard</option>
            <option value="square">1:1 — Square</option>
            <option value="ultrawide">21:9 — Ultrawide</option>
        </select>
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Sandbox Policy</label>
        <select class="w-full border rounded px-2 py-1.5 text-sm" value="@Sandbox" @onchange="OnSandboxChanged">
            <option value="strict">Strict — No permissions</option>
            <option value="video">Video — Scripts + Same Origin</option>
            <option value="form">Form — Scripts + Same Origin + Forms</option>
            <option value="full">Full — All permissions</option>
        </select>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public NeoPageNode Node { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }

    private string Url =>
        Node.Properties.TryGetValue("url", out var v) ? v.GetString() ?? "" : "";

    private string Title =>
        Node.Properties.TryGetValue("title", out var v) ? v.GetString() ?? "" : "";

    private string Aspect =>
        Node.Properties.TryGetValue("aspectRatio", out var v) ? v.GetString() ?? "widescreen" : "widescreen";

    private string Sandbox =>
        Node.Properties.TryGetValue("sandbox", out var v) ? v.GetString() ?? "video" : "video";

    private async Task OnUrlChanged(string value) {
        Node.Properties["url"] = JsonSerializer.SerializeToElement(value);
        await Changed.InvokeAsync();
    }

    private async Task OnTitleChanged(string value) {
        Node.Properties["title"] = JsonSerializer.SerializeToElement(value);
        await Changed.InvokeAsync();
    }

    private async Task OnAspectChanged(ChangeEventArgs e) {
        Node.Properties["aspectRatio"] = JsonSerializer.SerializeToElement(e.Value?.ToString() ?? "widescreen");
        await Changed.InvokeAsync();
    }

    private async Task OnSandboxChanged(ChangeEventArgs e) {
        Node.Properties["sandbox"] = JsonSerializer.SerializeToElement(e.Value?.ToString() ?? "video");
        await Changed.InvokeAsync();
    }
}
