@namespace Aero.Cms.Ui.Neo.Primitives.Embed
@using Aero.Cms.Abstractions.Blocks.Neo
@using System.Text.Json

@{
    var url = "";
    var aspectLabel = "16:9";
    var sandboxLabel = "Video";

    if (Node?.Properties is { } props)
    {
        if (props.TryGetValue("url", out var u))
            url = u.GetString() ?? "";

        if (props.TryGetValue("aspectRatio", out var a))
        {
            aspectLabel = a.GetString() switch
            {
                "standard" or "4:3" => "4:3",
                "square" or "1:1" => "1:1",
                "ultrawide" or "21:9" => "21:9",
                _ => "16:9"
            };
        }

        if (props.TryGetValue("sandbox", out var s))
            sandboxLabel = s.GetString() ?? "Video";
    }

    var displayUrl = string.IsNullOrWhiteSpace(url)
        ? "No URL set"
        : (url.Length > 50 ? url[..47] + "..." : url);
}

<div class="border-2 border-dashed border-amber-200 rounded-lg overflow-hidden bg-amber-50/20">
    <div class="flex items-center justify-between px-3 py-2 bg-amber-100/50 border-b border-amber-200">
        <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-amber-700 uppercase tracking-wider">Embed</span>
            <span class="text-[10px] text-amber-500 bg-amber-100 px-1.5 py-0.5 rounded">&lt;iframe&gt;</span>
        </div>
        <div class="flex items-center gap-2">
            <span class="text-[10px] text-amber-600 bg-amber-100 px-1.5 py-0.5 rounded">@aspectLabel</span>
            <span class="text-[10px] text-amber-600 bg-amber-100 px-1.5 py-0.5 rounded">@sandboxLabel</span>
        </div>
    </div>
    <div class="p-4 text-center">
        <span class="text-xs text-amber-400 font-mono">@displayUrl</span>
    </div>
</div>

@code {
    [Parameter] public NeoPageNode? Node { get; set; }
}
