@namespace Aero.Cms.Ui.Neo.Primitives.Code
@using Aero.Cms.Abstractions.Blocks.Neo
@using System.Text.Json

@{
    var code = "// Your code here";
    var language = "csharp";
    if (Node?.Properties is { } props)
    {
        if (props.TryGetValue("code", out var c))
            code = c.GetString() ?? "// Your code here";
        if (props.TryGetValue("language", out var l))
            language = l.GetString() ?? "csharp";
    }

    var displayCode = code.Length > 120 ? code[..117] + "..." : code;
}

<div class="border border-gray-200 rounded-lg overflow-hidden bg-gray-900">
    <div class="flex items-center gap-2 px-3 py-1.5 bg-gray-800 border-b border-gray-700">
        <span class="text-[10px] font-semibold text-gray-300 uppercase tracking-wider">@language</span>
    </div>
    <pre class="px-3 py-2 text-xs font-mono text-gray-200 leading-relaxed overflow-hidden"><code>@displayCode</code></pre>
</div>

@code {
    [Parameter] public NeoPageNode? Node { get; set; }
}
