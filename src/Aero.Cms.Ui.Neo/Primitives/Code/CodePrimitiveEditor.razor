@using System.Text.Json

<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Language</label>
        <select class="w-full border rounded px-2 py-1.5 text-sm font-mono" value="@Language" @onchange="OnLanguageChanged">
            <option value="csharp">C#</option>
            <option value="javascript">JavaScript</option>
            <option value="typescript">TypeScript</option>
            <option value="python">Python</option>
            <option value="html">HTML</option>
            <option value="css">CSS</option>
            <option value="sql">SQL</option>
            <option value="json">JSON</option>
            <option value="bash">Bash</option>
            <option value="plaintext">Plain Text</option>
        </select>
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Code</label>
        <RadzenTextArea Value="@Code" Change="OnCodeChanged" Class="w-full font-mono text-sm" Rows="10" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public NeoPageNode Node { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }

    private string Code =>
        Node.Properties.TryGetValue("code", out var v) ? v.GetString() ?? "" : "";

    private string Language =>
        Node.Properties.TryGetValue("language", out var v) ? v.GetString() ?? "csharp" : "csharp";

    private async Task OnCodeChanged(string value) {
        Node.Properties["code"] = JsonSerializer.SerializeToElement(value);
        await Changed.InvokeAsync();
    }

    private async Task OnLanguageChanged(ChangeEventArgs e) {
        Node.Properties["language"] = JsonSerializer.SerializeToElement(e.Value?.ToString() ?? "csharp");
        await Changed.InvokeAsync();
    }
}
