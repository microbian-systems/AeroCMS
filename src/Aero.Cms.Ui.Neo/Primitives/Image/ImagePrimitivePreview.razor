<figure class="m-0 overflow-hidden rounded-lg border bg-muted">
    @if (string.IsNullOrWhiteSpace(Url))
    {
        <button type="button"
                class="flex min-h-40 w-full items-center justify-center rounded-lg border-0 bg-transparent text-sm text-muted-foreground transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary/40"
                @onclick:stopPropagation="true"
                @ondblclick:stopPropagation="true"
                @onpointerdown:stopPropagation="true"
                @onclick="SelectMedia">
            Select an image
        </button>
    }
    else
    {
        <img src="@Url" alt="@Alt" class="block h-auto w-full object-cover" />
    }
    @if (!string.IsNullOrWhiteSpace(Caption))
    {
        <figcaption class="px-3 py-2 text-sm text-muted-foreground">@Caption</figcaption>
    }
</figure>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    [Parameter]
    public EventCallback SelectMedia { get; set; }

    private string Url => GetString("url");
    private string Alt => GetString("alt");
    private string Caption => GetString("caption");

    private string GetString(string name) =>
        Node.Properties.TryGetValue(name, out var value)
            ? value.GetString() ?? string.Empty
            : string.Empty;
}
