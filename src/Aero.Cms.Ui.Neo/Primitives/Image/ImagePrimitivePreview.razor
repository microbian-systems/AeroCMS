<figure class="neo-primitive-image-preview">
    @if (string.IsNullOrWhiteSpace(Url))
    {
        <button type="button"
                class="neo-primitive-image-preview__picker"
                @onclick:stopPropagation="true"
                @ondblclick:stopPropagation="true"
                @onpointerdown:stopPropagation="true"
                @onclick="SelectMedia">
            Select an image
        </button>
    }
    else
    {
        <img src="@Url" alt="@Alt" class="neo-primitive-image-preview__image" />
    }
    @if (!string.IsNullOrWhiteSpace(Caption))
    {
        <figcaption class="neo-primitive-image-preview__caption">@Caption</figcaption>
    }
</figure>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    [Parameter]
    public EventCallback SelectMedia { get; set; }

    private string Url => GetString("url");
    private string Alt => GetString("alt");
    private string Caption => GetString("caption");

    private string GetString(string name) =>
        Node.Properties.TryGetValue(name, out var value)
            ? value.GetString() ?? string.Empty
            : string.Empty;
}
