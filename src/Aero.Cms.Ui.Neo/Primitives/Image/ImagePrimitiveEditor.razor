<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Image URL</label>
        <RadzenTextBox Value="@Url" Change="OnUrlChanged" Class="w-full" />
        <RadzenButton Text="Choose from media library"
                      Icon="image"
                      ButtonStyle="Radzen.ButtonStyle.Secondary"
                      Size="Radzen.ButtonSize.Small"
                      Click="SelectMedia" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Alternative text</label>
        <RadzenTextBox Value="@Alt" Change="OnAltChanged" Class="w-full" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Caption</label>
        <RadzenTextBox Value="@Caption" Change="OnCaptionChanged" Class="w-full" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public EventCallback SelectMedia { get; set; }

    private string Url => GetString("url");
    private string Alt => GetString("alt");
    private string Caption => GetString("caption");

    private Task OnUrlChanged(string value) => SetString("url", value);
    private Task OnAltChanged(string value) => SetString("alt", value);
    private Task OnCaptionChanged(string value) => SetString("caption", value);

    private async Task SetString(string name, string value)
    {
        Node.Properties[name] = JsonSerializer.SerializeToElement(value);
        await Changed.InvokeAsync();
    }

    private string GetString(string name) =>
        Node.Properties.TryGetValue(name, out var value)
            ? value.GetString() ?? string.Empty
            : string.Empty;
}
