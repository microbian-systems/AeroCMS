@namespace Aero.Cms.Ui.Neo.Primitives.Heading
@using Aero.Cms.Abstractions.Blocks.Neo
@using System.Text.Json

@{
    var text = "Heading";
    var level = 2;
    if (Node?.Properties is { } props)
    {
        if (props.TryGetValue("text", out var t))
            text = t.GetString() ?? "Heading";
        if (props.TryGetValue("level", out var l) && l.ValueKind == JsonValueKind.Number)
            level = Math.Clamp(l.GetInt32(), 1, 6);
    }

    var fontSize = level switch
    {
        1 => "text-3xl",
        2 => "text-2xl",
        3 => "text-xl",
        4 => "text-lg",
        5 => "text-base",
        6 => "text-sm",
        _ => "text-xl"
    };
}

<div class="flex items-start gap-2">
    <span class="text-[10px] font-mono text-gray-400 bg-gray-100 px-1 py-0.5 rounded mt-0.5">h@(level)</span>
    <span class="@fontSize font-semibold text-gray-800 leading-tight">@text</span>
</div>

@code {
    [Parameter] public NeoPageNode? Node { get; set; }
}
