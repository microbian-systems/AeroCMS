@namespace Aero.Cms.Ui.Neo.Primitives.Grid
@using Aero.Cms.Abstractions.Blocks.Neo
@using System.Text.Json

@{
    var span = 6;
    if (Node?.Properties is { } props
        && props.TryGetValue("span", out var s)
        && s.ValueKind == JsonValueKind.Number)
        span = Math.Clamp(s.GetInt32(), 1, 12);
}

<SortableCompositionSurface Node="Node"
                            RootNode="RootNode"
                            OwnerBlock="OwnerBlock"
                            NodeChanged="NodeChanged"
                            NodeEditRequested="NodeEditRequested"
                            DropRejected="DropRejected"
                            DropZoneId="cell-content"
                            CssClass="@($"neo-primitive-grid-cell col-span-{span}")"
                            ContentCssClass="neo-composition-surface--grid-cell"
                            EmptyText="Drop content here" />

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    [Parameter]
    public NeoPageNode? RootNode { get; set; }

    [Parameter]
    public EditorBlock? OwnerBlock { get; set; }

    [Parameter]
    public EventCallback<CompositionMutation> NodeChanged { get; set; }

    [Parameter]
    public EventCallback<string> NodeEditRequested { get; set; }

    [Parameter]
    public EventCallback<string> DropRejected { get; set; }
}
