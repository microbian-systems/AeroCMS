@namespace Aero.Cms.Ui.Neo.Primitives.Grid
@using Aero.Cms.Abstractions.Blocks.Neo
@using System.Text.Json

@{
    var columns = 12;
    var gap = 4;
    if (Node?.Properties is { } props)
    {
        if (props.TryGetValue("columns", out var c) && c.ValueKind == JsonValueKind.Number)
            columns = Math.Clamp(c.GetInt32(), 1, 12);
        if (props.TryGetValue("gap", out var g) && g.ValueKind == JsonValueKind.Number)
            gap = g.GetInt32();
    }
}

<div class="border-2 border-dashed border-indigo-200 rounded-lg p-4 min-h-[80px] bg-indigo-50/20">
    <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider">Grid</span>
        <span class="text-[10px] text-indigo-400 bg-indigo-100 px-1.5 py-0.5 rounded">@columns cols</span>
    </div>
    <div class="border border-dashed border-indigo-100 rounded p-3 text-center">
        <span class="text-xs text-indigo-300">Add rows to this grid</span>
    </div>
</div>

@code {
    [Parameter] public NeoPageNode? Node { get; set; }
}
