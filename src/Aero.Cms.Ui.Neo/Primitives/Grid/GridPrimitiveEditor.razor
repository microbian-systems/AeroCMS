@using System.Text.Json

<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Columns</label>
        <input type="number" class="w-full border rounded px-2 py-1.5 text-sm" min="1" max="12"
               value="@Columns" @onchange="OnColumnsChanged" />
        <span class="text-xs text-gray-400">Number of columns in the grid (1–12)</span>
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Gap</label>
        <input type="number" class="w-full border rounded px-2 py-1.5 text-sm" min="0" max="32"
               value="@Gap" @onchange="OnGapChanged" />
        <span class="text-xs text-gray-400">Spacing between rows and cells (0–32)</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public NeoPageNode Node { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }

    private int Columns =>
        Node.Properties.TryGetValue("columns", out var v) && v.ValueKind == JsonValueKind.Number
            ? v.GetInt32() : 12;

    private int Gap =>
        Node.Properties.TryGetValue("gap", out var v) && v.ValueKind == JsonValueKind.Number
            ? v.GetInt32() : 4;

    private async Task OnColumnsChanged(ChangeEventArgs e) {
        if (int.TryParse(e.Value?.ToString(), out var val)) {
            Node.Properties["columns"] = JsonSerializer.SerializeToElement(Math.Clamp(val, 1, 12));
            await Changed.InvokeAsync();
        }
    }

    private async Task OnGapChanged(ChangeEventArgs e) {
        if (int.TryParse(e.Value?.ToString(), out var val)) {
            Node.Properties["gap"] = JsonSerializer.SerializeToElement(Math.Clamp(val, 0, 32));
            await Changed.InvokeAsync();
        }
    }
}
