@inject IEnumerable<IPageEditorDefinitionProvider> DefinitionProviders
@namespace Aero.Cms.Ui.Neo.Primitives
@using Aero.Cms.Shared.Pages.Manager.PageEditor

<Sortable TItem="NeoPageNode"
          Items="Node.Children"
          GetItemId="child => child.NodeId"
          Group="page-editor"
          OnItemsReordered="OnReordered"
          OnItemTransferredIn="OnTransferredIn"
          OnItemTransferredOut="OnTransferredOut"
          Class="@CssClass">
    <SortableContentPrimitive class="@ContentCssClass">
        @if (Node.Children.Count == 0)
        {
            <div class="text-sm text-muted-foreground">@EmptyText</div>
        }
        @foreach (var child in Node.Children)
        {
            <SortableItemPrimitive Value="@child.NodeId">
                <div class="neo-composition-child relative @(SelectedNodeId == child.NodeId ? "is-selected ring-2 ring-primary rounded-md" : "")"
                     style="@NodeStyleCssRenderer.Render(child.Style, Breakpoint)"
                     @onclick:stopPropagation="true"
                     @onclick="() => SelectNode(child.NodeId)"
                     @ondblclick:stopPropagation="true"
                     @ondblclick="() => RequestEdit(child.NodeId)"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true"
                     @oncontextmenu="() => SelectNode(child.NodeId)">
                    @if (IsTextPrimitive(child))
                    {
                        <input class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30"
                               value="@GetPropertyString(child, "text")"
                               aria-label="Text primitive content"
                               @onclick:stopPropagation="true"
                               @ondblclick:stopPropagation="true"
                               @onpointerdown:stopPropagation="true"
                               @onmousedown:stopPropagation="true"
                               @onkeydown:stopPropagation="true"
                               @oninput="e => UpdateTextNode(child, e.Value?.ToString() ?? string.Empty)" />
                    }
                    else if (TryGetDefinition(child.CatalogId, out var definition) &&
                        definition.Catalog.PreviewComponentType is { } previewType)
                    {
                        <DynamicComponent Type="previewType"
                                          Parameters="NodeParameters(child, definition)" />
                    }
                    @if (SelectedNodeId == child.NodeId)
                    {
                        <div class="absolute right-2 top-2 z-50 flex max-w-[calc(100%-1rem)] items-center gap-1 rounded-lg border border-slate-700 bg-slate-950 p-1 text-white shadow-xl"
                             @onclick:stopPropagation="true"
                             @ondblclick:stopPropagation="true"
                             @onpointerdown:stopPropagation="true"
                             @onmousedown:stopPropagation="true"
                             @oncontextmenu:preventDefault="true"
                             @oncontextmenu:stopPropagation="true">
                            <button type="button" class="rounded-md px-2.5 py-1.5 text-xs font-semibold text-white transition hover:bg-white/15 focus:bg-white/15 focus:outline-none"
                                    title="Edit"
                                    aria-label="Edit primitive"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true"
                                    @onpointerdown:stopPropagation="true"
                                    @onmousedown:stopPropagation="true"
                                    @onclick="() => RequestEdit(child.NodeId)">Edit</button>
                            <button type="button" class="rounded-md px-2.5 py-1.5 text-xs font-semibold text-white transition hover:bg-white/15 focus:bg-white/15 focus:outline-none"
                                    title="Duplicate"
                                    aria-label="Duplicate primitive"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true"
                                    @onpointerdown:stopPropagation="true"
                                    @onmousedown:stopPropagation="true"
                                    @onclick="() => DuplicateNode(child.NodeId)">Duplicate</button>
                            <button type="button" class="rounded-md px-2.5 py-1.5 text-xs font-semibold text-white transition hover:bg-white/15 focus:bg-white/15 focus:outline-none"
                                    title="Copy"
                                    aria-label="Copy primitive"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true"
                                    @onpointerdown:stopPropagation="true"
                                    @onmousedown:stopPropagation="true"
                                    @onclick="() => CopyNode(child.NodeId)">Copy</button>
                            <button type="button" class="rounded-md px-2.5 py-1.5 text-xs font-semibold text-white transition hover:bg-white/15 focus:bg-white/15 focus:outline-none disabled:cursor-not-allowed disabled:opacity-40"
                                    title="Paste"
                                    aria-label="Paste primitive after this item"
                                    disabled="@(_nodeClipboard is null)"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true"
                                    @onpointerdown:stopPropagation="true"
                                    @onmousedown:stopPropagation="true"
                                    @onclick="() => PasteNodeAfter(child.NodeId)">Paste</button>
                            <button type="button" class="rounded-md px-2.5 py-1.5 text-xs font-semibold text-white transition hover:bg-red-600 focus:bg-red-600 focus:outline-none"
                                    title="Delete"
                                    aria-label="Delete primitive"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true"
                                    @onpointerdown:stopPropagation="true"
                                    @onmousedown:stopPropagation="true"
                                    @onclick="() => DeleteNode(child.NodeId)">Delete</button>
                        </div>
                    }
                </div>
            </SortableItemPrimitive>
        }
    </SortableContentPrimitive>
</Sortable>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    [Parameter]
    public NeoPageNode? RootNode { get; set; }

    [Parameter]
    public EditorBlock? OwnerBlock { get; set; }

    [Parameter]
    public EventCallback<CompositionMutation> NodeChanged { get; set; }

    [Parameter]
    public EventCallback<string> NodeEditRequested { get; set; }

    [Parameter]
    public EventCallback<string> DropRejected { get; set; }

    [Parameter, EditorRequired]
    public string DropZoneId { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public string ContentCssClass { get; set; } = string.Empty;

    [Parameter]
    public string EmptyText { get; set; } = "Drop primitives here";

    [Parameter]
    public EditorBreakpoint Breakpoint { get; set; } = EditorBreakpoint.Desktop;

    [CascadingParameter]
    public IBlockEditorCallbacks? Editor { get; set; }

    private string? SelectedNodeId { get; set; }
    private NeoPageNode? _nodeClipboard;

    private IDictionary<string, object> NodeParameters(
        NeoPageNode node,
        PageEditorDefinitionDescriptor definition)
    {
        var parameters = new Dictionary<string, object> { ["Node"] = node };
        if (definition.Catalog.Composition.CanContainChildren)
        {
            parameters["RootNode"] = RootNode ?? Node;
            if (OwnerBlock is not null)
            {
                parameters["OwnerBlock"] = OwnerBlock;
            }
            parameters["NodeChanged"] =
                EventCallback.Factory.Create<CompositionMutation>(
                    this,
                    ForwardMutation);
            parameters["NodeEditRequested"] =
                EventCallback.Factory.Create<string>(
                    this,
                    RequestEdit);
            parameters["DropRejected"] =
                EventCallback.Factory.Create<string>(
                    this,
                    message => DropRejected.InvokeAsync(message));
        }
        else if (IsImagePrimitive(node) && OwnerBlock is not null && Editor is not null)
        {
            parameters["SelectMedia"] =
                EventCallback.Factory.Create(
                    this,
                    () => Editor.OpenNodeMediaSelector(
                        OwnerBlock,
                        node.NodeId,
                        "property:url",
                        Breakpoint));
        }

        return parameters;
    }

    private async Task OnReordered(IList<NeoPageNode> children)
    {
        var root = RootNode ?? Node;
        var before = EditorNodeMemento.Capture(root).Restore();
        if (children.Count == 0)
        {
            Node.Children = [];
            await NotifyRootChanged(before, root);
            return;
        }

        var transferredNode = children.FirstOrDefault(child =>
            Node.Children.All(existing => existing.NodeId != child.NodeId));
        if (transferredNode is null)
        {
            Node.Children = children.ToList();
            await NotifyRootChanged(before, root);
        }
    }

    private async Task OnTransferredIn(SortableTransferArgs args)
    {
        var root = RootNode ?? Node;
        var before = EditorNodeMemento.Capture(root).Restore();
        var node = Find(root, args.ActiveId);

        if (node is null && TryGetDefinition(args.ActiveId, out var definition))
        {
            node = definition.NodeFactory.CreateDefaultNode();
        }

        if (node is null)
        {
            return;
        }

        var editor = CreateTreeEditor();
        var result = editor.Drop(
            [root],
            new CompositionDropRequest(
                node,
                Node.NodeId,
                DropZoneId,
                args.Index));

        if (result is Result<IReadOnlyList<NeoPageNode>, AeroError>.Ok ok)
        {
            CopyInto(root, ok.Value[0]);
            await NotifyRootChanged(before, root);
        }
        else if (result is Result<IReadOnlyList<NeoPageNode>, AeroError>.Failure failure)
        {
            await DropRejected.InvokeAsync(failure.Error.ToString());
        }
    }

    private Task OnTransferredOut(SortableTransferArgs _) => Task.CompletedTask;

    private Task NotifyRootChanged(NeoPageNode before, NeoPageNode after) =>
        NodeChanged.InvokeAsync(
            new CompositionMutation(
                before,
                EditorNodeMemento.Capture(after).Restore()));

    private Task ForwardMutation(CompositionMutation mutation) =>
        NodeChanged.InvokeAsync(mutation);

    private void SelectNode(string nodeId) => SelectedNodeId = nodeId;

    private static bool IsTextPrimitive(NeoPageNode node) =>
        string.Equals(
            node.CatalogId,
            "primitive.text",
            StringComparison.OrdinalIgnoreCase);

    private static bool IsImagePrimitive(NeoPageNode node) =>
        string.Equals(
            node.CatalogId,
            "primitive.image",
            StringComparison.OrdinalIgnoreCase);

    private static string GetPropertyString(NeoPageNode node, string propertyName) =>
        node.Properties.TryGetValue(propertyName, out var value)
            ? value.GetString() ?? string.Empty
            : string.Empty;

    private async Task UpdateTextNode(NeoPageNode node, string value)
    {
        var root = RootNode ?? Node;
        var before = EditorNodeMemento.Capture(root).Restore();
        node.Properties["text"] = JsonSerializer.SerializeToElement(value);
        await NodeChanged.InvokeAsync(
            new CompositionMutation(
                before,
                EditorNodeMemento.Capture(root).Restore(),
                $"text:{node.NodeId}"));
    }

    private Task RequestEdit(string nodeId)
    {
        SelectedNodeId = nodeId;
        if (OwnerBlock is not null && Editor is not null)
        {
            Editor.OpenNodeEditor(OwnerBlock, nodeId);
            return Task.CompletedTask;
        }

        if (NodeEditRequested.HasDelegate)
        {
            return NodeEditRequested.InvokeAsync(nodeId);
        }

        return Task.CompletedTask;
    }

    private async Task DeleteNode(string nodeId)
    {
        var root = RootNode ?? Node;
        var before = EditorNodeMemento.Capture(root).Restore();
        var result = CreateTreeEditor().Remove([root], nodeId);

        if (result is Result<IReadOnlyList<NeoPageNode>, AeroError>.Ok ok)
        {
            CopyInto(root, ok.Value[0]);
            SelectedNodeId = null;
            await NotifyRootChanged(before, root);
        }
        else if (result is Result<IReadOnlyList<NeoPageNode>, AeroError>.Failure failure)
        {
            await DropRejected.InvokeAsync(failure.Error.ToString());
        }
    }

    private async Task DuplicateNode(string nodeId)
    {
        var root = RootNode ?? Node;
        var source = Find(root, nodeId);
        if (source is null)
        {
            return;
        }

        var before = EditorNodeMemento.Capture(root).Restore();
        var duplicate = CloneWithFreshIds(source);
        var sourceIndex = Node.Children.FindIndex(child => child.NodeId == nodeId);
        var result = CreateTreeEditor().Drop(
            [root],
            new CompositionDropRequest(
                duplicate,
                Node.NodeId,
                DropZoneId,
                sourceIndex < 0 ? Node.Children.Count : sourceIndex + 1));

        if (result is Result<IReadOnlyList<NeoPageNode>, AeroError>.Ok ok)
        {
            CopyInto(root, ok.Value[0]);
            SelectedNodeId = duplicate.NodeId;
            await NotifyRootChanged(before, root);
        }
    }

    private void CopyNode(string nodeId)
    {
        var root = RootNode ?? Node;
        var source = Find(root, nodeId);
        if (source is not null)
        {
            _nodeClipboard = CustomComponentTemplate.Capture(source);
        }
    }

    private async Task PasteNodeAfter(string nodeId)
    {
        if (_nodeClipboard is null)
        {
            return;
        }

        var root = RootNode ?? Node;
        var targetIndex = Node.Children.FindIndex(child => child.NodeId == nodeId);
        if (targetIndex < 0)
        {
            await DropRejected.InvokeAsync("The selected paste target is no longer available.");
            return;
        }

        var before = EditorNodeMemento.Capture(root).Restore();
        var pasted = CustomComponentTemplate.CreateInstance(_nodeClipboard);
        var result = CreateTreeEditor().Drop(
            [root],
            new CompositionDropRequest(
                pasted,
                Node.NodeId,
                DropZoneId,
                targetIndex + 1));

        if (result is Result<IReadOnlyList<NeoPageNode>, AeroError>.Ok ok)
        {
            CopyInto(root, ok.Value[0]);
            SelectedNodeId = pasted.NodeId;
            await NotifyRootChanged(before, root);
        }
        else if (result is Result<IReadOnlyList<NeoPageNode>, AeroError>.Failure failure)
        {
            await DropRejected.InvokeAsync(failure.Error.ToString());
        }
    }

    private CompositionTreeEditor CreateTreeEditor() =>
        new(
            new CompositionPolicy(
                new ProviderCapabilityResolver(DefinitionProviders)));

    private bool TryGetDefinition(
        string catalogId,
        out PageEditorDefinitionDescriptor definition)
    {
        definition = DefinitionProviders
            .SelectMany(provider => provider.GetEditorDefinitions())
            .LastOrDefault(item => string.Equals(
                item.CatalogId,
                catalogId,
                StringComparison.OrdinalIgnoreCase))!;
        return definition is not null;
    }

    private static NeoPageNode? Find(NeoPageNode node, string nodeId)
    {
        if (string.Equals(node.NodeId, nodeId, StringComparison.Ordinal))
        {
            return node;
        }

        foreach (var child in node.Children)
        {
            var match = Find(child, nodeId);
            if (match is not null)
            {
                return match;
            }
        }

        return null;
    }

    private static void CopyInto(NeoPageNode target, NeoPageNode source)
    {
        target.NodeId = source.NodeId;
        target.CatalogId = source.CatalogId;
        target.Kind = source.Kind;
        target.Properties = source.Properties;
        target.Style = source.Style;
        target.Children = source.Children;
    }

    private static NeoPageNode CloneWithFreshIds(NeoPageNode node)
    {
        var clone = EditorNodeMemento.Capture(node).Restore();
        AssignFreshIds(clone);
        return clone;
    }

    private static void AssignFreshIds(NeoPageNode node)
    {
        node.NodeId = Guid.NewGuid().ToString("N");
        foreach (var child in node.Children)
        {
            AssignFreshIds(child);
        }
    }

    private sealed class ProviderCapabilityResolver(
        IEnumerable<IPageEditorDefinitionProvider> providers)
        : ICompositionCapabilityResolver
    {
        private readonly IReadOnlyDictionary<string, ICompositionCapabilities> _capabilities =
            providers
                .SelectMany(provider => provider.GetEditorDefinitions())
                .GroupBy(definition => definition.CatalogId, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    group => group.Key,
                    group => group.Last().Catalog.Composition,
                    StringComparer.OrdinalIgnoreCase);

        public bool TryGet(
            string catalogId,
            out ICompositionCapabilities capabilities) =>
            _capabilities.TryGetValue(catalogId, out capabilities!);
    }
}
