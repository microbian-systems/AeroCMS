<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Lucide icon name</label>
        <RadzenTextBox Value="@Name" Change="OnNameChanged" Class="w-full" />
        @if (!IsKnownIcon)
        {
            <div class="text-xs text-amber-600">
                This icon name is not available in the installed Lucide set.
            </div>
        }
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Choose an icon</label>
        <RadzenTextBox Value="@_search"
                       Change="OnSearchChanged"
                       Placeholder="Search icons"
                       Class="w-full" />
        <div class="grid max-h-56 grid-cols-6 gap-1 overflow-y-auto rounded-md border p-2"
             role="listbox"
             aria-label="Available Lucide icons">
            @foreach (var iconName in FilteredIcons)
            {
                <button type="button"
                        class="@GetIconButtonClass(iconName)"
                        title="@iconName"
                        aria-label="@($"Use {iconName} icon")"
                        aria-selected="@(string.Equals(Name, iconName, StringComparison.OrdinalIgnoreCase))"
                        @onclick="() => SelectIcon(iconName)">
                    <LucideIcon Name="@iconName" Size="20" />
                </button>
            }
        </div>
        @if (FilteredIcons.Count == 0)
        {
            <div class="text-xs text-muted-foreground">No icons match this search.</div>
        }
        else if (HasMoreIcons)
        {
            <div class="text-xs text-muted-foreground">
                Showing the first @MaximumVisibleIcons matches. Refine the search to see more.
            </div>
        }
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Accessible label</label>
        <RadzenTextBox Value="@Label" Change="OnLabelChanged" Class="w-full" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    [Parameter]
    public EventCallback Changed { get; set; }

    private const int MaximumVisibleIcons = 120;
    private static readonly IReadOnlyList<string> AvailableIcons =
        LucideIconData.GetAvailableIcons()
            .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private string _search = string.Empty;

    private string Name => GetString("name", "sparkles");
    private string Label => GetString("label", "Sparkles");
    private bool IsKnownIcon => LucideIconData.IconExists(Name);
    private bool HasMoreIcons => MatchingIconCount > MaximumVisibleIcons;
    private int MatchingIconCount => AvailableIcons.Count(MatchesSearch);
    private IReadOnlyList<string> FilteredIcons =>
        AvailableIcons
            .Where(MatchesSearch)
            .Take(MaximumVisibleIcons)
            .ToArray();

    private Task OnNameChanged(string value) => SetString("name", value);
    private Task OnLabelChanged(string value) => SetString("label", value);
    private void OnSearchChanged(string value) => _search = value?.Trim() ?? string.Empty;
    private Task SelectIcon(string iconName) => SetString("name", iconName);

    private bool MatchesSearch(string iconName) =>
        string.IsNullOrWhiteSpace(_search) ||
        iconName.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private string GetIconButtonClass(string iconName) =>
        string.Equals(Name, iconName, StringComparison.OrdinalIgnoreCase)
            ? "flex aspect-square items-center justify-center rounded border border-primary bg-primary/10 text-primary"
            : "flex aspect-square items-center justify-center rounded border border-transparent hover:border-border hover:bg-muted";

    private async Task SetString(string name, string value)
    {
        Node.Properties[name] = JsonSerializer.SerializeToElement(value);
        await Changed.InvokeAsync();
    }

    private string GetString(string name, string fallback) =>
        Node.Properties.TryGetValue(name, out var value)
            ? value.GetString() ?? fallback
            : fallback;
}
