<a href="@Url"
   class="neo-primitive-button-preview">
    @Text
</a>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private string Text => GetString("text", "Button");
    private string Url => GetString("url", "#");

    private string GetString(string name, string fallback) =>
        Node.Properties.TryGetValue(name, out var value)
            ? value.GetString() ?? fallback
            : fallback;
}
