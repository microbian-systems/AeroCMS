<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Label</label>
        <RadzenTextBox Value="@Text" Change="OnTextChanged" Class="w-full" />
    </div>
    <div class="pe-property-group">
        <label class="pe-property-label">Link</label>
        <RadzenTextBox Value="@Url" Change="OnUrlChanged" Class="w-full" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    [Parameter]
    public EventCallback Changed { get; set; }

    private string Text => GetString("text", "Button");
    private string Url => GetString("url", "#");

    private async Task OnTextChanged(string value)
    {
        Node.Properties["text"] = JsonSerializer.SerializeToElement(value);
        await Changed.InvokeAsync();
    }

    private async Task OnUrlChanged(string value)
    {
        Node.Properties["url"] = JsonSerializer.SerializeToElement(value);
        await Changed.InvokeAsync();
    }

    private string GetString(string name, string fallback) =>
        Node.Properties.TryGetValue(name, out var value)
            ? value.GetString() ?? fallback
            : fallback;
}
