<span class="inline-flex items-center rounded-full border bg-secondary px-2.5 py-0.5 text-xs font-semibold text-secondary-foreground">
    @Text
</span>

@code {
    [Parameter, EditorRequired]
    public NeoPageNode Node { get; set; } = default!;

    private string Text =>
        Node.Properties.TryGetValue("text", out var value)
            ? value.GetString() ?? string.Empty
            : string.Empty;
}
