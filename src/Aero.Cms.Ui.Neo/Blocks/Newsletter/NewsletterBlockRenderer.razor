@* NewsletterBlockRenderer - Public page renderer *@

@if (Block != null)
{
    <section class="flex flex-col items-center justify-center w-full bg-background px-6 py-16 text-center">
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-foreground max-w-3xl leading-tight mb-4">
            @Block.Title
        </h2>

        <p class="text-lg text-muted-foreground max-w-xl leading-relaxed mb-8">
            @Block.Description
        </p>

        <div class="flex flex-row items-center gap-3 w-full max-w-md">
            <input type="email" placeholder="@Block.Placeholder"
                   class="flex-1 rounded-lg border border-input bg-background px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
            <Button Size="ButtonSize.Small" Class="gap-2 px-6 whitespace-nowrap">
                <LucideIcon Name="mail" Size="16" />
                @Block.ButtonText
            </Button>
        </div>

        <small class="mt-4 flex items-center gap-1.5 text-xs text-muted-foreground">
            <LucideIcon Name="lock" Size="12" />
            @Block.PrivacyText
        </small>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public NewsletterBlock? Block { get; set; }
}
