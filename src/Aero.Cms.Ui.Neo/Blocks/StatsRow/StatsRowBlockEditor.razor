<div class="pe-property-panel">
    <div class="pe-property-group">
        <label class="pe-property-label">Stats (value:label per stat, comma separated)</label>
        <RadzenTextArea @bind-Value="StatsText" Class="w-full font-mono text-sm" Rows="4" />
        <span class="pe-property-hint">Example: 10,000+:Happy Users, $2M+:ARR Generated</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public StatsRowBlock Block { get; set; } = default!;

    private string StatsText
    {
        get => string.Join(", ", Block.Stats.Select(s => $"{s.Value}:{s.Label}"));
        set
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                Block.Stats =
                [
                    new("10,000+", "Happy Users"),
                    new("$2M+", "ARR Generated"),
                    new("99.9%", "Uptime SLA"),
                    new("4.9/5", "Average Rating"),
                ];
                return;
            }

            Block.Stats = value
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(part =>
                {
                    var colonIndex = part.IndexOf(':');
                    return colonIndex > 0
                        ? new StatItem(part[..colonIndex].Trim(), part[(colonIndex + 1)..].Trim())
                        : new StatItem(part, string.Empty);
                })
                .ToList();
        }
    }
}
