@* CtaBannerBlockRenderer - Public page renderer *@

@if (Block != null)
{
    <section class="flex flex-col items-center justify-center w-full bg-muted px-6 py-16 text-center">
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-foreground max-w-3xl leading-tight mb-4">
            @Block.Title
        </h2>

        <p class="text-lg text-muted-foreground max-w-xl leading-relaxed mb-8">
            @Block.Description
        </p>

        <div class="flex flex-col md:flex-row items-center gap-3">
            <Button Size="ButtonSize.Large" Class="gap-2 px-6">
                @Block.PrimaryText
            </Button>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Large" Class="gap-2 px-6">
                @Block.SecondaryText
            </Button>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public CtaBannerBlock? Block { get; set; }
}
