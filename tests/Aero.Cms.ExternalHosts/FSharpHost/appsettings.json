{
  "AllowedHosts": "*",
  "AeroCms": {
    "Setup": {
      "RunHandoff": false
    },
    "Bootstrap": {
      "State": "Running",
      "SetupComplete": true,
      "SeedComplete": true,
      "HasBootstrapConfig": true,
      "RequestedManagerAuthenticationProvider": "local",
      "RequestedMemberAuthenticationProvider": "local"
    },
    "Infrastructure": {
      "DatabaseMode": "Embedded",
      "CacheMode": "Local",
      "SecretProvider": "Local Certificate"
    },
    "TickerQ": {
      "Dashboard": {
        "Enabled": false
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

