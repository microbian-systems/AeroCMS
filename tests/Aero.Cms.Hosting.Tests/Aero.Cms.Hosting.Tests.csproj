<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableTestingPlatform>true</EnableTestingPlatform>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="TUnit" Version="1.58.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Aero.Cms.Core.Tests\TestRunConfiguration.cs"
             Link="Regression\TestRunConfiguration.cs" />
    <Compile Include="..\Aero.Cms.Core.Tests\Integration\BootstrapCompletionWriterTests.cs"
             Link="Regression\BootstrapCompletionWriterTests.cs" />
    <Compile Include="..\Aero.Cms.Core.Tests\Integration\LoadingExperienceAssetTests.cs"
             Link="Regression\LoadingExperienceAssetTests.cs" />
    <Compile Include="..\Aero.Cms.Core.Tests\Integration\SetupAuthenticationHandoffTests.cs"
             Link="Regression\SetupAuthenticationHandoffTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aero.Cms.Hosting.Abstractions\Aero.Cms.Hosting.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Aero.Cms.Hosting.Defaults\Aero.Cms.Hosting.Defaults.csproj" />
    <ProjectReference Include="..\..\src\Aero.Cms.SourceGenerators\Aero.Cms.SourceGenerators.csproj"
                      ReferenceOutputAssembly="true"
                      OutputItemType="" />
  </ItemGroup>

</Project>
